@code {
    private int totalClientes;
    private int totalProductos;
    private int productosSinStock;
    private int productosStockBajo;
    private string? dashboardError;
    private List<ActividadItem> actividadReciente = [];
    private Dictionary<string, int> porCategoria = [];
    private Dictionary<string, (int Clientes, int Productos)> altasPorMes = [];

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var user = (await AuthenticationStateTask).User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            var clientes = await ClienteApiClient.ListAsync();
            var productos = await ProductoApiClient.ListAsync();

            totalClientes = clientes.Count;
            totalProductos = productos.Count;
            productosSinStock = productos.Count(p => p.Stock <= 0);
            productosStockBajo = productos.Count(p => p.Stock is > 0 and <= 5);

            actividadReciente = clientes
                .Select(c => new ActividadItem("Cliente", $"{c.Nombre} {c.Apellido}", c.UpdatedAtUtc ?? c.CreatedAtUtc))
                .Concat(productos.Select(p => new ActividadItem("Producto", p.Nombre, p.UpdatedAtUtc ?? p.CreatedAtUtc)))
                .OrderByDescending(a => a.Fecha)
                .Take(5)
                .ToList();

            porCategoria = productos
                .GroupBy(p => p.CategoriaCodigo)
                .OrderByDescending(g => g.Count())
                .Take(6)
                .ToDictionary(g => g.First().CategoriaNombre, g => g.Count());

            var culture = CultureInfo.GetCultureInfo("es-ES");
            var hoy = DateTime.UtcNow;
            altasPorMes = Enumerable.Range(0, 6)
                .Select(offset => new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-5 + offset))
                .ToDictionary(
                    mes => culture.TextInfo.ToTitleCase(mes.ToString("MMM yyyy", culture)),
                    mes => (
                        clientes.Count(c => c.CreatedAtUtc.Year == mes.Year && c.CreatedAtUtc.Month == mes.Month),
                        productos.Count(p => p.CreatedAtUtc.Year == mes.Year && p.CreatedAtUtc.Month == mes.Month)));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load dashboard data.");
            dashboardError = "No fue posible cargar los indicadores en este momento.";
        }
    }

    private sealed record ActividadItem(string Tipo, string Descripcion, DateTime Fecha);
}
