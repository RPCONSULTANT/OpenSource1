@page "/"
@using System.Globalization
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Components
@using OpenSource1.Blazor.Services
@inject IClienteApiClient ClienteApiClient
@inject IProductoApiClient ProductoApiClient
@inject ILogger<Home> Logger

<PageTitle>Inicio – AxionERP</PageTitle>

<!-- ══════════════════════════════════════════════════════════════
     HERO
═══════════════════════════════════════════════════════════════ -->
<div class="relative rounded-2xl bg-gradient-to-br from-brand-700 via-brand-600 to-brand-800 text-white px-8 py-12 mb-6 shadow-lg overflow-hidden animate-fade-in">
    <div class="absolute top-0 right-0 w-72 h-72 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>

    <div class="relative z-10">
        <div class="flex items-center gap-3 mb-4 animate-slide-in-left">
            <div class="flex size-12 items-center justify-center rounded-xl bg-white/15 backdrop-blur-sm animate-pulse-glow">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="white" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
                </svg>
            </div>
            <div>
                <p class="text-xs font-bold tracking-widest uppercase text-brand-200">Sistema Integral</p>
                <h1 class="text-2xl font-extrabold tracking-tight leading-tight">AxionERP</h1>
            </div>
        </div>
        <p class="text-brand-100 text-sm max-w-xl leading-relaxed animate-slide-up">
            Centralice la operación de su empresa: equipo, procesos y registros en un único panel
            con acceso controlado por roles y trazabilidad completa.
        </p>
    </div>
</div>

<AuthorizeView>

    <!-- ══════════════════════════════════════════════════════════
         VISTA AUTENTICADA
    ═══════════════════════════════════════════════════════════ -->
    <Authorized Context="auth">

        <!-- Bienvenida + Rol -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="md:col-span-2 rounded-2xl border border-slate-200 bg-white shadow-sm px-6 py-5 animate-slide-up flex items-center gap-4 dark:border-slate-700 dark:bg-slate-800">
                <div class="flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 shrink-0 dark:bg-brand-500/10">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5 dark:text-slate-500">Sesión activa</p>
                    <p class="text-lg font-bold text-slate-900 dark:text-slate-100">Bienvenido, @auth.User.Identity?.Name</p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Tiene acceso habilitado según los permisos de su rol.</p>
                </div>
            </div>
            <div class="rounded-2xl border border-brand-200 bg-brand-50 shadow-sm px-6 py-5 animate-pop flex flex-col justify-center dark:border-brand-500/30 dark:bg-brand-500/10">
                <p class="text-xs font-bold tracking-widest uppercase text-brand-500 mb-2">Rol asignado</p>
                @foreach (var role in auth.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))
                {
                    <div class="flex items-center gap-2 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-brand-600 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                        </svg>
                        <span class="text-base font-extrabold text-brand-800 dark:text-brand-400">@role</span>
                    </div>
                }
            </div>
        </div>

        <!-- ── Dashboard: indicadores en vivo ── -->
        <div class="mb-2 flex items-center gap-2 animate-fade-in">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-brand-500 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
            </svg>
            <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wide dark:text-slate-300">Panel general</h2>
        </div>
        @if (dashboardError is not null)
        {
            <div class="mb-8"><MessageBox Type="warning" Message="@dashboardError" /></div>
        }
        else
        {
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8 animate-slide-up">
                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm px-5 py-4 dark:border-slate-700 dark:bg-slate-800">
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Clientes</p>
                    <p class="mt-1 text-2xl font-extrabold text-slate-900 dark:text-slate-100">@totalClientes</p>
                    <a href="/dashboard/clientes" class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400">
                        Ver detalle
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" /></svg>
                    </a>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm px-5 py-4 dark:border-slate-700 dark:bg-slate-800">
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Productos</p>
                    <p class="mt-1 text-2xl font-extrabold text-slate-900 dark:text-slate-100">@totalProductos</p>
                    <a href="/dashboard/productos" class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400">
                        Ver detalle
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" /></svg>
                    </a>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm px-5 py-4 dark:border-slate-700 dark:bg-slate-800">
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Sin stock</p>
                    <p class="mt-1 text-2xl font-extrabold @(productosSinStock > 0 ?"text-red-600 dark:text-red-400" : "text-slate-900 dark:text-slate-100")">@productosSinStock</p>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm px-5 py-4 dark:border-slate-700 dark:bg-slate-800">
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Stock bajo (&le;5)</p>
                    <p class="mt-1 text-2xl font-extrabold @(productosStockBajo > 0 ?"text-amber-600 dark:text-amber-400" : "text-slate-900 dark:text-slate-100")">@productosStockBajo</p>
                </div>
            </div>

            @if (porCategoria.Count > 0 || altasPorMes.Count > 0)
            {
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-8 animate-slide-up">
                    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-5 dark:border-slate-700 dark:bg-slate-800">
                        <h3 class="mb-4 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Productos por categoría</h3>
                        <ChartCanvas Id="chart-home-categoria" Type="doughnut" Height="220px" Labels="@porCategoria.Keys.ToList()"
                                     Datasets="@(new List<ChartDataset> { new("Productos", porCategoria.Values.Select(v => (double)v).ToList(), porCategoria.Keys.Select((_, i) => ChartPalette.Pick(i)).ToList()) })" />
                    </div>
                    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-5 dark:border-slate-700 dark:bg-slate-800">
                        <h3 class="mb-4 text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Altas por mes (clientes y productos)</h3>
                        <ChartCanvas Id="chart-home-altas" Type="bar" Height="220px" Labels="@altasPorMes.Keys.ToList()"
                                     Datasets="@(new List<ChartDataset> {
                                         new("Clientes", altasPorMes.Values.Select(v => (double)v.Clientes).ToList(), [ChartPalette.Pick(1)]),
                                         new("Productos", altasPorMes.Values.Select(v => (double)v.Productos).ToList(), [ChartPalette.Pick(0)])
                                     })" />
                    </div>
                </div>
            }

            @if (actividadReciente.Count > 0)
            {
                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8 animate-slide-up dark:border-slate-700 dark:bg-slate-800">
                    <div class="px-5 py-3 border-b border-slate-100 bg-slate-50 dark:border-slate-700/60 dark:bg-slate-900/40"><h3 class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Actividad reciente</h3></div>
                    <ul class="divide-y divide-slate-100 dark:divide-slate-700/60">
                        @foreach (var item in actividadReciente)
                        {
                            <li class="flex items-center justify-between gap-3 px-5 py-3 text-sm">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="inline-flex items-center rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-bold uppercase text-brand-700 shrink-0 dark:bg-brand-500/10 dark:text-brand-400">@item.Tipo</span>
                                    <span class="font-semibold text-slate-800 truncate dark:text-slate-200">@item.Descripcion</span>
                                </div>
                                <span class="text-xs text-slate-400 shrink-0 dark:text-slate-500">@item.Fecha.ToLocalTime().ToString("g")</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        }

        <!-- ── Área de trabajo ── -->
        <div class="mb-2 flex items-center gap-2 animate-fade-in">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-brand-500 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
            </svg>
            <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wide dark:text-slate-300">Tu área de trabajo</h2>
        </div>

        <!-- ── Grid de módulos ── -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">

            <!-- MÓDULO: Gestión de Usuarios — solo Administrador -->
            <AuthorizeView Roles="@ApplicationRoles.Administrator">
                <Authorized>
                    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md hover:border-brand-200 transition-all duration-200 flex flex-col overflow-hidden animate-pop dark:border-slate-700 dark:bg-slate-800">
                        <div class="h-1 bg-gradient-to-r from-brand-400 to-brand-600"></div>
                        <div class="p-5 flex-1">
                            <div class="flex items-start justify-between mb-3">
                                <div class="flex size-10 items-center justify-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/10">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                                    </svg>
                                </div>
                                <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-semibold text-green-700">Disponible</span>
                            </div>
                            <p class="font-bold text-slate-900 mb-1 text-sm dark:text-slate-100">Gestión de Usuarios</p>
                            <p class="text-xs text-slate-500 mb-4 leading-relaxed dark:text-slate-400">Administre el equipo del sistema: revise cuentas, asigne roles por área y controle quién tiene acceso al sistema.</p>
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5 space-y-1.5 select-none pointer-events-none mb-4 dark:border-slate-700 dark:bg-slate-900/40">
                                @foreach (var initial in new[]{"C","A","M"})
                                {
                                    <div class="flex items-center gap-2 bg-white rounded-lg border border-slate-100 px-2 py-1.5 dark:bg-slate-800 dark:border-slate-700/60">
                                        <div class="size-6 rounded-full bg-brand-100 flex items-center justify-center text-[9px] font-bold text-brand-600 shrink-0">@initial</div>
                                        <div class="flex-1 min-w-0">
                                            <div class="h-1.5 bg-slate-200 rounded w-20 mb-0.5"></div>
                                            <div class="h-1 bg-slate-100 rounded w-28 dark:bg-slate-700"></div>
                                        </div>
                                        <div class="h-4 w-12 rounded-md bg-brand-500 opacity-50"></div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="border-t border-slate-100 px-5 py-3 dark:border-slate-700/60">
                            <a href="/admin/users" class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-xs font-semibold text-white hover:bg-brand-700 transition-all duration-150">
                                Ir al módulo
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                            </a>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>

        </div>

        <!-- ── Guía de inicio rápido ── -->
        <div class="rounded-2xl border border-brand-100 bg-brand-50/50 px-6 py-6 animate-slide-up-slow dark:border-brand-500/20 dark:bg-brand-500/10">
            <div class="flex items-center gap-2 mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-brand-500 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" />
                </svg>
                <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wide dark:text-slate-300">¿Cómo empezar?</h2>
            </div>

            <!-- Guía Administrador -->
            <AuthorizeView Roles="@ApplicationRoles.Administrator">
                <Authorized>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        @foreach (var (num, title, desc) in new[]{
                            ("1", "Revise las cuentas registradas",   "Acceda a Gestión de Usuarios y verifique que todas las cuentas estén activas y tengan el rol correcto asignado."),
                            ("2", "Asigne roles por responsabilidad", "Abra el perfil de cada usuario y asigne el rol que corresponde a su área: Supervisor o Ejecutor."),
                            ("3", "Gestione catálogos operativos",    "Use los módulos activos del sistema para registrar, consultar y mantener la información que soporte su operación diaria.")
                        })
                        {
                            <div class="flex gap-3 bg-white rounded-xl border border-brand-100 p-4 shadow-sm dark:bg-slate-800 dark:border-brand-500/20">
                                <span class="flex size-7 items-center justify-center rounded-full bg-brand-600 text-white text-xs font-extrabold shrink-0 mt-0.5">@num</span>
                                <div>
                                    <p class="text-sm font-bold text-slate-800 mb-1 dark:text-slate-200">@title</p>
                                    <p class="text-xs text-slate-500 leading-relaxed dark:text-slate-400">@desc</p>
                                </div>
                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>

            <!-- Guía Supervisor -->
            <AuthorizeView Roles="@ApplicationRoles.Supervisor">
                <Authorized>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var (num, title, desc) in new[]{
                            ("1", "Consulte los catálogos",          "Revise clientes y productos para confirmar que la información operativa esté correcta."),
                            ("2", "Modifique cuando sea necesario",  "Actualice registros existentes desde los módulos activos según la necesidad del negocio.")
                        })
                        {
                            <div class="flex gap-3 bg-white rounded-xl border border-brand-100 p-4 shadow-sm dark:bg-slate-800 dark:border-brand-500/20">
                                <span class="flex size-7 items-center justify-center rounded-full bg-brand-600 text-white text-xs font-extrabold shrink-0 mt-0.5">@num</span>
                                <div>
                                    <p class="text-sm font-bold text-slate-800 mb-1 dark:text-slate-200">@title</p>
                                    <p class="text-xs text-slate-500 leading-relaxed dark:text-slate-400">@desc</p>
                                </div>
                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>

            <!-- Guía Ejecutor -->
            <AuthorizeView Roles="@ApplicationRoles.Executor">
                <Authorized>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var (num, title, desc) in new[]{
                            ("1", "Consulte la información",         "Acceda a clientes y productos para revisar la información disponible del sistema."),
                            ("2", "Agregue nuevos registros",       "Si necesita registrar nuevos datos, use los formularios de agregar dentro de los módulos activos.")
                        })
                        {
                            <div class="flex gap-3 bg-white rounded-xl border border-brand-100 p-4 shadow-sm dark:bg-slate-800 dark:border-brand-500/20">
                                <span class="flex size-7 items-center justify-center rounded-full bg-brand-600 text-white text-xs font-extrabold shrink-0 mt-0.5">@num</span>
                                <div>
                                    <p class="text-sm font-bold text-slate-800 mb-1 dark:text-slate-200">@title</p>
                                    <p class="text-xs text-slate-500 leading-relaxed dark:text-slate-400">@desc</p>
                                </div>
                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>

        </div>

    </Authorized>

    <!-- ══════════════════════════════════════════════════════════
         VISTA PÚBLICA
    ═══════════════════════════════════════════════════════════ -->
    <NotAuthorized>
        <!-- CTA -->
        <div class="rounded-2xl border border-slate-200 bg-white px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm animate-slide-up mb-6 dark:border-slate-700 dark:bg-slate-800">
            <div>
                <h2 class="text-lg font-bold text-slate-800 mb-1 dark:text-slate-200">Bienvenido a AxionERP</h2>
                <p class="text-sm text-slate-500 max-w-sm leading-relaxed dark:text-slate-400">
                    Inicie sesión para acceder a su panel de trabajo según el rol que le fue asignado.
                </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 shrink-0">
                <a href="/account/register"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-brand-200 bg-brand-50 px-5 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-100 transition-all duration-150 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-400 dark:hover:bg-brand-500/20">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4">
