@page "/account/change-password"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using OpenSource1.Application.Services.Auth.Dtos
@using OpenSource1.Blazor.Services
@inject IAuthApiClient AuthApiClient

<PageTitle>Cambiar contraseña – AxionERP</PageTitle>

<div class="mx-auto max-w-lg">
    <div class="mb-6">
        <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Seguridad</p>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Cambiar contraseña</h1>
        <p class="mt-1 text-sm text-slate-500">Actualice su contraseña ingresando primero la contraseña actual.</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="px-6 py-5">
            @if (errors.Count > 0)
            {
                <div class="mb-5"><MessageBox Type="danger" Errors="errors" /></div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="mb-5"><MessageBox Type="success" Message="@successMessage" /></div>
            }

            <EditForm Model="Input" FormName="change-password" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="currentPassword">Contraseña actual</label>
                    <InputText id="currentPassword" type="password" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 shadow-sm focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25" @bind-Value="Input!.CurrentPassword" autocomplete="current-password" />
                    <ValidationMessage For="() => Input!.CurrentPassword" />
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="newPassword">Nueva contraseña</label>
                    <InputText id="newPassword" type="password" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 shadow-sm focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25" @bind-Value="Input!.NewPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => Input!.NewPassword" />
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="confirmPassword">Confirmar nueva contraseña</label>
                    <InputText id="confirmPassword" type="password" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 shadow-sm focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25" @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => Input!.ConfirmPassword" />
                </div>

                <div class="flex items-center gap-3">
                    <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 transition-colors">
                        Guardar nueva contraseña
                    </button>
                    <a href="/" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-colors shadow-sm">Cancelar</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordInput? Input { get; set; }

    private IReadOnlyList<string> errors = [];
    private string? successMessage;

    protected override void OnInitialized() => Input ??= new();

    private async Task SubmitAsync()
    {
        errors = [];
        successMessage = null;

        var result = await AuthApiClient.ChangePasswordAsync(new ChangePasswordRequest
        {
            CurrentPassword = Input!.CurrentPassword,
            NewPassword = Input.NewPassword
        });

        if (!result.Succeeded || result.Response is null)
        {
            errors = result.Errors.Count > 0 ? result.Errors : ["No fue posible cambiar la contraseña."];
            return;
        }

        successMessage = result.Response.Message;
        Input = new();
    }

    private sealed class ChangePasswordInput
    {
        [Required(ErrorMessage = "Debe ingresar su contraseña actual.")]
        [MaxLength(100)]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe ingresar la nueva contraseña.")]
        [MinLength(8, ErrorMessage = "La contraseña debe tener al menos 8 caracteres.")]
        [MaxLength(100)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe confirmar la nueva contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
