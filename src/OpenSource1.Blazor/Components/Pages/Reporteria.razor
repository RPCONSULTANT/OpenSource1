@page "/reporteria"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Reportería – AxionERP</PageTitle>

<div class="mb-6">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Reportería</p>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Reportes históricos</h1>
    <p class="text-sm text-slate-500 mt-1">Genere reportes PDF de clientes o productos aplicando filtros previos.</p>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6"><MessageBox Type="@messageType" Message="@message" /></div>
}

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-5xl">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50"><h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide">Generador de reportes</h2></div>
    <div class="p-6">
        <form method="get" action="/reporteria" data-enhance class="mb-6 flex items-end gap-4">
            <div class="w-full max-w-sm"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Entidad</label><select name="entity" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20"><option value="clientes" selected="@(Entity == "clientes")">Clientes</option><option value="productos" selected="@(Entity == "productos")">Productos</option></select></div>
            <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Cambiar</button>
        </form>
        @if (Entity == "productos")
        {
            <form method="post" action="/reports/productos/history" class="space-y-5"><AntiforgeryToken /><div class="grid grid-cols-1 md:grid-cols-1 gap-4"><div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Stock</label><select name="StockState" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20"><option value="all">Todos</option><option value="with-stock">Con stock</option><option value="without-stock">Sin stock</option></select></div></div><button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Generar PDF de productos</button></form>
        }
        else
        {
            <form method="post" action="/reports/clientes/history" class="space-y-5"><AntiforgeryToken /><div class="grid grid-cols-1 md:grid-cols-1 gap-4"><div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Estado</label><select name="Status" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20"><option value="all">Todos</option><option value="active">Activos</option><option value="inactive">Inactivos</option></select></div></div><button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Generar PDF de clientes</button></form>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "entity")] private string? Entity { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    private string? message; private string messageType = "warning";
    protected override void OnInitialized(){Entity ??= "clientes"; if(Ok=="report-no-data") message = "No hay datos para generar el reporte solicitado.";}
}
