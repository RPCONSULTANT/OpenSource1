@page "/series"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Series.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@using OpenSource1.Core.Enums
@inject ISerieApiClient SerieApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<Series> Logger
@inject NavigationManager Nav

<PageTitle>Series de numeración – AxionERP</PageTitle>

<PageToolbar Titulo="Series de numeración" Subtitulo="Series por tipo de documento: último número usado, próximo número y avisos."
             Migas="@Migas" Permisos="@permisos"
             NuevoHref="/series/nueva" NuevoTexto="Nueva serie" NuevoPermiso="@ApplicationPolicies.CanAdministrar"
             SeleccionId="@Seleccionada?.Id.ToString()"
             EditarUrl="@(id => $"/series/{id}")" EditarPermiso="@ApplicationPolicies.CanConsult"
             EliminarUrl="@(id => Url(sel: id, deleteId: id))" EliminarPermiso="@ApplicationPolicies.CanAdministrar"
             EliminarDeshabilitadoMotivo="@MotivoNoEliminable">
    <a href="/configuracion/numeracion" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Configuración</a>
</PageToolbar>

@if (!string.IsNullOrWhiteSpace(message) || errores.Count > 0)
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" Errors="@errores" />
        }
    </div>
}

<!-- ── Filtros ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/series" data-enhance class="p-4 sm:p-6" data-testid="filtros-series">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2 max-w-2xl">
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-500" for="filtroCodigo">Código</label>
                    <input id="filtroCodigo" name="codigo" value="@Codigo" placeholder="ej. FV" class="@VentasCss.Filtro" />
                </div>
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-500" for="filtroTipo">Tipo de documento</label>
                    <select id="filtroTipo" name="tipo" class="@VentasCss.Filtro">
                        <option value="" selected="@(Tipo is null)">Todos</option>
                        @foreach (var t in TipoDocumentoSerieNombres.Todos)
                        {
                            <option value="@((short)t)" selected="@(Tipo == (short)t)">@TipoDocumentoSerieNombres.Nombre(t)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Consultar</button>
                <a href="/series" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Limpiar campos</a>
            </div>
        </div>
    </form>
</div>

@if (truncada)
{
    <div class="mb-6" data-testid="series-truncadas"><MessageBox Type="info" Message="@($"Se muestran las primeras {series.Count} de {totalSeries} series: filtre por código o tipo para ver las demás.")" /></div>
}

<!-- ── Tabla de series ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-700">Series</h2>
        <p class="mt-1 text-xs text-slate-500">@series.Count serie(s).</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm" data-testid="tabla-series">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3"><span class="sr-only">Seleccionar</span></th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Código</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Descripción</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Tipo</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Activa</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Último usado</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Próximo</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (cargaFallida)
                {
                    <tr><td colspan="7" class="px-6 py-8 text-center text-sm text-slate-400">No fue posible cargar las series.</td></tr>
                }
                else if (series.Count == 0)
                {
                    <tr><td colspan="7" class="px-6 py-8 text-center text-sm text-slate-400">No hay series con esos criterios.</td></tr>
                }
                @foreach (var s in series)
                {
                    var marcada = s.Id == Seleccionada?.Id;
                    <tr @key="s.Id" class="@SeleccionFila.ClaseFila transition-colors @(marcada ? SeleccionFila.ClaseFilaSeleccionada : null)">
                        <td class="px-4 py-3"><SeleccionFila Href="@Url(sel: s.Id.ToString())" Seleccionada="@marcada" Etiqueta="@s.Codigo" /></td>
                        <td class="px-4 py-3 font-mono text-xs font-semibold text-brand-700"><a class="hover:underline" href="@($"/series/{s.Id}")">@s.Codigo</a></td>
                        <td class="px-4 py-3 text-slate-700">@s.Descripcion</td>
                        <td class="px-4 py-3 text-xs text-slate-600">@s.TipoNombre</td>
                        <td class="px-4 py-3 text-xs text-slate-600">@(s.Activa ? "Sí" : "No")@(s.Asignada ? " · predeterminada" : "")</td>
                        <td class="px-4 py-3 font-mono text-xs">@(s.UltimoNumeroUsado ?? "—")</td>
                        <td class="px-4 py-3 font-mono text-xs">
                            @(s.ProximoNumero ?? "—")
                            @if (s.Aviso is not null)
                            {
                                <p class="font-sans text-amber-700" data-testid="aviso-serie">@s.Aviso</p>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (MuestraDialogoBorrar)
{
    <ConfirmDialog Title="Eliminar serie" Variant="danger" CancelHref="@Url(sel: DeleteIdTexto)"
                   Message="@($"Se eliminará la serie {serieAEliminar!.Codigo}. Una serie usada o predeterminada no se puede eliminar: desactívela o asigne otra.")">
        <EditForm Model="DeleteInput" FormName="delete-serie" OnValidSubmit="DeleteAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.Id" value="@serieAEliminar.Id" />
            <input type="hidden" name="DeleteInput.Xmin" value="@serieAEliminar.Xmin" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">Sí, eliminar</button>
        </EditForm>
    </ConfirmDialog>
}
else
{
    @* Siempre en el árbol: un POST forzado u obsoleto llega al handler y muestra el mensaje real de la API (403/409). *@
    <EditForm Model="DeleteInput" FormName="delete-serie" OnValidSubmit="DeleteAsync"></EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "codigo")] private string? Codigo { get; set; }
    [SupplyParameterFromQuery(Name = "tipo")] private int? Tipo { get; set; }
    [SupplyParameterFromQuery(Name = "sel")] private string? SelTexto { get; set; }
    [SupplyParameterFromQuery(Name = "deleteId")] private string? DeleteIdTexto { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    [SupplyParameterFromForm(FormName = "delete-serie")] private IdForm? DeleteInput { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IReadOnlyList<SerieResponse> series = [];
    private SerieResponse? serieAEliminar;
    private PermisosPagina? permisos;
    private bool puedeAdministrar;
    private bool cargaFallida;
    private bool truncada;
    private long totalSeries;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string> errores = [];

    private Guid? DeleteId => InventarioVistasOpciones.ParseGuid(DeleteIdTexto);
    private Guid? Sel => InventarioVistasOpciones.ParseGuid(SelTexto);
    private SerieResponse? Seleccionada => series.FirstOrDefault(s => s.Id == Sel);
    private bool MuestraDialogoBorrar => puedeAdministrar && serieAEliminar is not null;
    private IReadOnlyList<Miga> Migas => [new("Configuración", "/modulos/configuracion"), new("Series de numeración")];

    /// <summary>
    /// NS5/NS6: la serie usada, predeterminada o usada por plantillas/lotes de diario no se elimina (la API responde 409); Eliminar
    /// sale deshabilitado con el motivo.
    /// </summary>
    private string? MotivoNoEliminable => Seleccionada switch
    {
        { Asignada: true } => "La serie es la predeterminada de su tipo: asigne otra en la configuración de numeración.",
        { Usada: true } => "La serie ya emitió números: no se puede eliminar; desactívela.",
        { Referenciada: true } => MotivoReferenciada,
        _ => null,
    };

    public const string MotivoReferenciada = "La serie la usan plantillas o lotes de diario de inventario: no se puede eliminar.";

    protected override async Task OnInitializedAsync()
    {
        DeleteInput ??= new();
        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);
        puedeAdministrar = await permisos.PuedeAsync(ApplicationPolicies.CanAdministrar);
        try
        {
            var pagina = await SerieApiClient.ListAsync(new SerieFiltro(Codigo, Tipo, null), new PageRequest(1, PageRequest.TamanoMaximo, "Codigo", Descendente: false));
            series = pagina.Items;
            totalSeries = pagina.Total;
            truncada = pagina.Total > pagina.Items.Count;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load series.");
            cargaFallida = true;
        }

        serieAEliminar = DeleteId is { } id ? series.FirstOrDefault(s => s.Id == id) : null;
        if (Ok == "eliminada")
        {
            (messageType, message) = ("success", "Serie eliminada satisfactoriamente.");
        }
    }

    private async Task DeleteAsync()
    {
        // R17: el destino se decide dentro del try y NavigateTo va fuera.
        string? destino = null;
        try
        {
            // El xmin que se mostró: si la serie cambió desde entonces, la API responde 409 (un POST forzado sin él envía 0).
            var result = await SerieApiClient.DeleteAsync(DeleteInput!.Id, DeleteInput.Xmin);
            if (result.Succeeded)
            {
                destino = Url(ok: "eliminada");
            }
            else
            {
                (messageType, message, errores) = ("warning", result.Message, result.Errors ?? []);
                serieAEliminar = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not delete serie {Id}.", DeleteInput!.Id);
            (messageType, message) = ("danger", "No fue posible eliminar la serie.");
            serieAEliminar = null;
        }

        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private string Url(string? sel = null, string? deleteId = null, string? ok = null)
    {
        var p = new List<string>();
        if (!string.IsNullOrWhiteSpace(Codigo)) p.Add($"codigo={Uri.EscapeDataString(Codigo)}");
        if (Tipo is { } t) p.Add($"tipo={t}");
        if (sel is not null) p.Add($"sel={Uri.EscapeDataString(sel)}");
        if (deleteId is not null) p.Add($"deleteId={Uri.EscapeDataString(deleteId)}");
        if (ok is not null) p.Add($"ok={ok}");
        return p.Count == 0 ? "/series" : $"/series?{string.Join("&", p)}";
    }

    public sealed class IdForm
    {
        public Guid Id { get; set; }
        public long Xmin { get; set; }
    }
}
