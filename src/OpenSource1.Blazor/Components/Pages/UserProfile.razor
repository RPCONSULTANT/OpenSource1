@page "/admin/users/{UserId}"
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@using System.ComponentModel.DataAnnotations
@using OpenSource1.Application.Security
@using OpenSource1.Application.Features.Users.Dtos
@using OpenSource1.Blazor.Services
@inject IUserAdminApiClient UserAdminApi
@inject NavigationManager Nav

<PageTitle>Perfil de Usuario – AxionERP</PageTitle>

<!-- ── Migas de pan ── -->
<nav class="flex items-center gap-1.5 text-sm text-slate-500 mb-5 animate-fade-in dark:text-slate-400">
    <a href="/admin/users" class="hover:text-brand-600 transition-colors font-medium">Usuarios</a>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5 text-slate-400 dark:text-slate-500">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
    </svg>
    <span class="text-slate-800 font-semibold truncate dark:text-slate-200">@(user?.FullName ?? UserId)</span>
</nav>

@if (loadError is not null)
{
    <MessageBox Type="danger" Message="@loadError" />
    <div class="mt-4">
        <a href="/admin/users" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:underline">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
            </svg>
            Volver a la lista
        </a>
    </div>
}
else if (user is null)
{
    <!-- Skeleton -->
    <div class="animate-pulse space-y-4">
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-6 flex items-center gap-4 dark:border-slate-700 dark:bg-slate-800">
            <div class="size-16 rounded-full bg-slate-200 shrink-0"></div>
            <div class="flex-1 space-y-2">
                <div class="h-5 bg-slate-200 rounded w-1/3"></div>
                <div class="h-3 bg-slate-200 rounded w-1/2"></div>
                <div class="h-3 bg-slate-200 rounded w-1/4"></div>
            </div>
        </div>
    </div>
}
else
{
    <!-- ── Feedback ── -->
    @if (feedbackMessage is not null)
    {
        <div class="mb-5">
            @if (feedbackType == "success")
            {
                <ActionFeedback Type="success" Message="@feedbackMessage" />
            }
            else
            {
                <MessageBox Type="@feedbackType" Message="@feedbackMessage" />
            }
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 animate-slide-up">

        <!-- ── Tarjeta de datos del usuario ── -->
        <div class="lg:col-span-1">
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden dark:border-slate-700 dark:bg-slate-800">
                <div class="h-1.5 bg-gradient-to-r from-brand-400 to-brand-600"></div>
                <div class="p-6 text-center">
                    <!-- Avatar grande -->
                    <div class="mx-auto mb-4 flex size-20 items-center justify-center rounded-full bg-brand-100 text-brand-700 font-extrabold text-3xl dark:text-brand-400">
                        @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                    </div>
                    <p class="text-lg font-extrabold text-slate-900 mb-0.5 dark:text-slate-100">@user.FullName</p>
                    <p class="text-sm text-slate-400 break-all dark:text-slate-500">@user.Email</p>

                    <!-- Estado -->
                    <div class="mt-3">
                        @if (user.IsActive)
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800">
                                <span class="size-2 rounded-full bg-green-500 inline-block"></span>
                                Cuenta activa
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                                <span class="size-2 rounded-full bg-red-400 inline-block"></span>
                                Cuenta inactiva
                            </span>
                        }
                    </div>

                    <!-- Roles actuales -->
                    <div class="mt-4 flex flex-wrap justify-center gap-1.5">
                        @if (user.Roles.Count == 0)
                        {
                            <span class="text-xs text-slate-400 italic dark:text-slate-500">Sin rol asignado</span>
                        }
                        else
                        {
                            @foreach (var role in user.Roles)
                            {
                                <span class="inline-flex items-center rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-semibold text-brand-800 dark:text-brand-400">@role</span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Panel de acciones ── -->
        <div class="lg:col-span-2 space-y-5">

            <!-- ── Editar datos ── -->
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-6 dark:border-slate-700 dark:bg-slate-800">
                <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wide mb-4 flex items-center gap-2 dark:text-slate-300">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-brand-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                    </svg>
                    Editar datos
                </h2>
                <EditForm Model="EditInput" FormName="edit-user" OnValidSubmit="UpdateUserAsync" class="flex items-end gap-3 flex-wrap">
                    <DataAnnotationsValidator />
                    <div class="flex-1 min-w-[12rem]">
                        <label class="block text-xs font-semibold text-slate-700 mb-1 dark:text-slate-300">Nombre completo</label>
                        <InputText @bind-Value="EditInput!.FullName" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200" />
                        <ValidationMessage For="() => EditInput!.FullName" />
                    </div>
                    <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Guardar</button>
                </EditForm>
            </div>

            <!-- ── Restablecer contraseña ── -->
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-6 dark:border-slate-700 dark:bg-slate-800">
                <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wide mb-4 flex items-center gap-2 dark:text-slate-300">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-amber-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                    </svg>
                    Restablecer contraseña
                </h2>
                <EditForm Model="ResetPasswordInput" FormName="reset-password" OnValidSubmit="PrepareResetPasswordConfirmation" class="flex items-end gap-3 flex-wrap">
                    <DataAnnotationsValidator />
                    <div class="flex-1 min-w-[12rem]">
                        <label class="block text-xs font-semibold text-slate-700 mb-1 dark:text-slate-300">Nueva contraseña</label>
                        <InputText @bind-Value="ResetPasswordInput!.NewPassword" type="password" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200" />
                        <ValidationMessage For="() => ResetPasswordInput!.NewPassword" />
                    </div>
                    <button type="submit" class="btn-press rounded-lg bg-amber-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-700">Restablecer</button>
                </EditForm>
            </div>

            <!-- ── Asignar rol ── -->
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-6 dark:border-slate-700 dark:bg-slate-800">
                <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wide mb-4 flex items-center gap-2 dark:text-slate-300">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-brand-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    Asignar rol
                </h2>
                <EditForm Model="AssignRoleInput" FormName="assign-role" OnValidSubmit="PrepareAssignRoleConfirmation">
                    <input type="hidden" name="AssignRoleInput.UserId" value="@UserId" />
                    <div class="flex items-center gap-3 flex-wrap">
                        <InputSelect @bind-Value="AssignRoleInput!.Role"
                                     class="flex-1 min-w-[10rem] rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-300">
                            @foreach (var role in ApplicationRoles.All)
                            {
                                <option value="@role">@role</option>
                            }
                        </InputSelect>
                        <button type="submit"
                                class="btn-press rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 active:scale-95 transition-all duration-150 shrink-0">
                            Revisar asignación
                        </button>
                    </div>
                </EditForm>
            </div>

            <!-- ── Quitar rol ── -->
            @if (user.Roles.Count > 0)
            {
                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-6 dark:border-slate-700 dark:bg-slate-800">
                    <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wide mb-4 flex items-center gap-2 dark:text-slate-300">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-red-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                        Quitar rol
                    </h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var role in user.Roles)
                        {
                            <!-- Un form por rol; mismo @formname "remove-role":
                                 el handler discrimina por el campo Role en el body -->
                            <a href="/admin/users/@UserId?confirm=removeRole&role=@Uri.EscapeDataString(role)"
                               class="btn-press inline-flex items-center gap-1.5 rounded-full border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100 active:scale-95 transition-all duration-150">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3.5">
                                        <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
                                    </svg>
                                    @role
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- ── Toggle activo/inactivo ── -->
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-6 dark:border-slate-700 dark:bg-slate-800">
                <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wide mb-4 flex items-center gap-2 dark:text-slate-300">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-slate-400 dark:text-slate-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                    </svg>
                    Estado de la cuenta
                </h2>
                <p class="text-sm text-slate-500 mb-4 dark:text-slate-400">
                    @if (user.IsActive)
                    {
                        <span>La cuenta está <strong class="text-green-700">activa</strong>. El usuario puede iniciar sesión.</span>
                    }
                    else
                    {
                        <span>La cuenta está <strong class="text-red-700">inactiva</strong>. El usuario no puede iniciar sesión.</span>
                    }
                </p>
                <a href="/admin/users/@UserId?confirm=toggleActive"
                   class="@(user.IsActive ?"inline-flex items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-5 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-100 active:scale-95 transition-all duration-150 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-400 dark:hover:bg-red-500/20"
                                : "inline-flex items-center gap-2 rounded-lg border border-green-200 bg-green-50 px-5 py-2.5 text-sm font-semibold text-green-700 hover:bg-green-100 active:scale-95 transition-all duration-150 dark:border-green-500/30 dark:bg-green-500/10 dark:text-green-400 dark:hover:bg-green-500/20")">
                        @if (user.IsActive)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
                            </svg>
                            <span>Desactivar cuenta</span>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            <span>Activar cuenta</span>
                        }
                </a>
            </div>

            <!-- ── Eliminar usuario ── -->
            <div class="rounded-2xl border border-red-200 bg-red-50/40 shadow-sm p-6">
                <h2 class="text-sm font-bold text-red-700 uppercase tracking-wide mb-4 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-red-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                    Eliminar usuario
                </h2>
                <p class="text-sm text-red-900/80 mb-4">Esta acción elimina la cuenta de forma permanente y no se puede deshacer.</p>
                <a href="/admin/users/@UserId?confirm=delete" class="btn-press inline-flex items-center gap-2 rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-red-700 active:scale-95 transition-all duration-150">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                    Eliminar usuario
                </a>
            </div>

        </div>
    </div>
}

@if (showAssignRoleConfirmation)
{
    <ConfirmDialog Title="Confirmar asignación de rol" Message="Está a punto de asignar un rol a este usuario." Variant="success" CancelHref="@($"/admin/users/{UserId}")">
        <p class="rounded-xl border border-green-100 bg-green-50 px-4 py-3 text-sm text-green-900"><strong>@AssignRoleInput!.Role</strong> para @user?.FullName</p>
        <EditForm Model="ConfirmAssignRoleInput" FormName="confirm-assign-role" OnValidSubmit="AssignRoleAsync" class="mt-4">
            <input type="hidden" name="ConfirmAssignRoleInput.UserId" value="@UserId" />
            <input type="hidden" name="ConfirmAssignRoleInput.Role" value="@AssignRoleInput.Role" />
            <button type="submit" class="btn-press rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-700">Sí, asignar rol</button>
            <a href="/admin/users/@UserId" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@if (Confirm == "removeRole" && !string.IsNullOrWhiteSpace(Role) && user is not null)
{
    <ConfirmDialog Title="Confirmar retiro de rol" Message="Está a punto de quitar un rol. Esta acción puede reducir los permisos del usuario." Variant="danger" CancelHref="@($"/admin/users/{UserId}")">
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-900"><strong>@Role</strong> de @user.FullName</p>
        <EditForm Model="RemoveRoleInput" FormName="remove-role" OnValidSubmit="RemoveRoleAsync" class="mt-4">
            <input type="hidden" name="RemoveRoleInput.UserId" value="@UserId" />
            <input type="hidden" name="RemoveRoleInput.Role" value="@Role" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, quitar rol</button>
            <a href="/admin/users/@UserId" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@if (Confirm == "toggleActive" && user is not null)
{
    <ConfirmDialog Title="Confirmar cambio de estado" Message="Está a punto de cambiar el acceso de este usuario al sistema." Variant="warning" CancelHref="@($"/admin/users/{UserId}")">
        <p class="rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm text-amber-900">La cuenta de <strong>@user.FullName</strong> será @(user.IsActive ? "desactivada" : "activada").</p>
        <EditForm Model="ToggleActiveInput" FormName="toggle-active" OnValidSubmit="ToggleActiveAsync" class="mt-4">
            <input type="hidden" name="ToggleActiveInput.UserId" value="@UserId" />
            <button type="submit" class="btn-press rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-700">Sí, cambiar estado</button>
            <a href="/admin/users/@UserId" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@if (showResetPasswordConfirmation && user is not null)
{
    <ConfirmDialog Title="Confirmar restablecimiento" Message="Está a punto de establecer una nueva contraseña para este usuario." Variant="warning" CancelHref="@($"/admin/users/{UserId}")">
        <p class="rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm text-amber-900">Se cambiará la contraseña de <strong>@user.FullName</strong>.</p>
        <EditForm Model="ConfirmResetPasswordInput" FormName="confirm-reset-password" OnValidSubmit="ResetPasswordAsync" class="mt-4">
            <input type="hidden" name="ConfirmResetPasswordInput.UserId" value="@UserId" />
            <input type="hidden" name="ConfirmResetPasswordInput.NewPassword" value="@ResetPasswordInput!.NewPassword" />
            <button type="submit" class="btn-press rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-700">Sí, restablecer</button>
            <a href="/admin/users/@UserId" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@if (Confirm == "delete" && user is not null)
{
    <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará al usuario y no se puede deshacer." Variant="danger" CancelHref="@($"/admin/users/{UserId}")">
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-semibold text-red-900">@user.FullName (@user.Email)</p>
        @if (deleteError is not null)
        {
            <div class="mt-4"><MessageBox Type="warning" Message="@deleteError" /></div>
        }
        <EditForm Model="DeleteInput" FormName="delete-user" OnValidSubmit="DeleteUserAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.UserId" value="@UserId" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">Sí, eliminar</button>
            <a href="/admin/users/@UserId" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "ok")]  private string? OkMessage  { get; set; }
    [SupplyParameterFromQuery(Name = "err")] private string? ErrMessage { get; set; }
    [SupplyParameterFromQuery(Name = "confirm")] private string? Confirm { get; set; }
    [SupplyParameterFromQuery(Name = "role")] private string? Role { get; set; }

    [SupplyParameterFromForm(FormName = "assign-role")]
    private AssignRoleModel? AssignRoleInput { get; set; }

    [SupplyParameterFromForm(FormName = "confirm-assign-role")]
    private AssignRoleModel? ConfirmAssignRoleInput { get; set; }

    [SupplyParameterFromForm(FormName = "remove-role")]
    private RemoveRoleModel? RemoveRoleInput { get; set; }

    [SupplyParameterFromForm(FormName = "toggle-active")]
    private ToggleActiveModel? ToggleActiveInput { get; set; }

    [SupplyParameterFromForm(FormName = "edit-user")]
    private EditUserModel? EditInput { get; set; }

    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetPasswordModel? ResetPasswordInput { get; set; }

    [SupplyParameterFromForm(FormName = "confirm-reset-password")]
    private ResetPasswordModel? ConfirmResetPasswordInput { get; set; }

    [SupplyParameterFromForm(FormName = "delete-user")]
    private DeleteUserModel? DeleteInput { get; set; }

    private UserSummaryResponse? user;
    private string? loadError;
    private string feedbackType = "success";
    private string? feedbackMessage;
    private bool showAssignRoleConfirmation;
    private bool showResetPasswordConfirmation;
    private string? deleteError;

    protected override void OnInitialized()
    {
        AssignRoleInput  ??= new() { UserId = UserId, Role = ApplicationRoles.Executor };
        ConfirmAssignRoleInput ??= new() { UserId = UserId, Role = ApplicationRoles.Executor };
        RemoveRoleInput  ??= new() { UserId = UserId };
        ToggleActiveInput??= new() { UserId = UserId };
        EditInput ??= new();
        ResetPasswordInput ??= new() { UserId = UserId };
        ConfirmResetPasswordInput ??= new() { UserId = UserId };
        DeleteInput ??= new() { UserId = UserId };
    }

    protected override async Task OnInitializedAsync()
    {
        // Mensajes de feedback via query string (redireccionados desde acciones POST)
        if (OkMessage is not null)
        {
            feedbackType = "success";
            feedbackMessage = Uri.UnescapeDataString(OkMessage);
        }
        else if (ErrMessage is not null)
        {
            feedbackType = "danger";
            feedbackMessage = Uri.UnescapeDataString(ErrMessage);
        }

        await LoadUserAsync();
    }

    private async Task LoadUserAsync()
    {
        var (result, error) = await UserAdminApi.GetByIdAsync(UserId);
        if (error is not null)
            loadError = error;
        else
        {
            user = result;
            if (user is not null && string.IsNullOrEmpty(EditInput!.FullName))
                EditInput.FullName = user.FullName;
        }
    }

    private async Task UpdateUserAsync()
    {
        var input = EditInput!;
        var (success, error) = await UserAdminApi.UpdateAsync(UserId, input.FullName);
        var msg = success
            ? Uri.EscapeDataString("Datos actualizados satisfactoriamente.")
            : Uri.EscapeDataString(error ?? "No se pudo actualizar el usuario.");

        Nav.NavigateTo($"/admin/users/{UserId}?{(success ? "ok" : "err")}={msg}", forceLoad: false);
    }

    private Task PrepareResetPasswordConfirmation()
    {
        ConfirmResetPasswordInput!.NewPassword = ResetPasswordInput!.NewPassword;
        showResetPasswordConfirmation = true;
        return Task.CompletedTask;
    }

    private async Task ResetPasswordAsync()
    {
        var input = ConfirmResetPasswordInput!;
        var (success, error) = await UserAdminApi.ResetPasswordAsync(input.UserId, input.NewPassword);
        var msg = success
            ? Uri.EscapeDataString("Contraseña restablecida satisfactoriamente.")
            : Uri.EscapeDataString(error ?? "No se pudo restablecer la contraseña.");

        Nav.NavigateTo($"/admin/users/{UserId}?{(success ? "ok" : "err")}={msg}", forceLoad: false);
    }

    private async Task DeleteUserAsync()
    {
        var input = DeleteInput!;
        var (success, error) = await UserAdminApi.DeleteAsync(input.UserId);
        if (success)
            Nav.NavigateTo($"/admin/users?ok={Uri.EscapeDataString("Usuario eliminado satisfactoriamente.")}", forceLoad: false);
        else
            deleteError = error ?? "No se pudo eliminar el usuario.";
    }

    private Task PrepareAssignRoleConfirmation()
    {
        showAssignRoleConfirmation = true;
        return Task.CompletedTask;
    }

    private async Task AssignRoleAsync()
    {
        var input = ConfirmAssignRoleInput!;
        var (success, error) = await UserAdminApi.AssignRoleAsync(input.UserId, input.Role);
        var msg = success
            ? Uri.EscapeDataString($"Rol '{input.Role}' asignado satisfactoriamente.")
            : Uri.EscapeDataString(error ?? "No se pudo asignar el rol.");

        Nav.NavigateTo($"/admin/users/{UserId}?{(success ? "ok" : "err")}={msg}", forceLoad: false);
    }

    private async Task RemoveRoleAsync()
    {
        var input = RemoveRoleInput!;
        var (success, error) = await UserAdminApi.RemoveRoleAsync(input.UserId, input.Role);
        var msg = success
            ? Uri.EscapeDataString($"Rol '{input.Role}' eliminado satisfactoriamente.")
            : Uri.EscapeDataString(error ?? "No se pudo quitar el rol.");

        Nav.NavigateTo($"/admin/users/{UserId}?{(success ? "ok" : "err")}={msg}", forceLoad: false);
    }

    private async Task ToggleActiveAsync()
    {
        var input = ToggleActiveInput!;
        var (success, error) = await UserAdminApi.ToggleActiveAsync(input.UserId);

        string msg;
        if (success)
        {
            // Determinamos el nuevo estado tras el toggle
            var newState = user?.IsActive == true ? "desactivada" : "activada";
            msg = Uri.EscapeDataString($"Cuenta {newState} satisfactoriamente.");
        }
        else
        {
            msg = Uri.EscapeDataString(error ?? "No se pudo cambiar el estado de la cuenta.");
        }

        Nav.NavigateTo($"/admin/users/{UserId}?{(success ? "ok" : "err")}={msg}", forceLoad: false);
    }

    // Modelos ligeros para los forms
    private sealed class AssignRoleModel
    {
        public string UserId { get; set; } = string.Empty;
        public string Role   { get; set; } = string.Empty;
    }

    private sealed class RemoveRoleModel
    {
        public string UserId { get; set; } = string.Empty;
        public string Role   { get; set; } = string.Empty;
    }

    private sealed class ToggleActiveModel
    {
        public string UserId { get; set; } = string.Empty;
    }

    private sealed class EditUserModel
    {
        [Required(ErrorMessage = "El nombre completo es requerido.")]
        public string FullName { get; set; } = string.Empty;
    }

    private sealed class ResetPasswordModel
    {
        public string UserId { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es requerida.")]
        [MinLength(6, ErrorMessage = "La contraseña debe tener al menos 6 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;
    }

    private sealed class DeleteUserModel
    {
        public string UserId { get; set; } = string.Empty;
    }
}
