@using OpenSource1.Blazor.Components.Pages

@*
    TerminoPagoFields — campos reutilizables para crear / modificar un TerminoPago.

    Requiere el parámetro Prefix con el nombre exacto de la propiedad
    [SupplyParameterFromForm] del componente padre:
      - Agregar:   Prefix="SaveInput"
      - Modificar: Prefix="UpdateInput"

    El FormDataMapper de Blazor SSR usa el nombre del parámetro como prefijo.
*@

<div class="space-y-4">
    <div>
        <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_Codigo")">
            Código <span class="text-red-500">*</span>
        </label>
        <input id="@($"{Prefix}_Codigo")"
               type="text"
               name="@($"{Prefix}.Codigo")"
               value="@Model.Codigo"
               maxlength="20"
               placeholder="ej. NET30"
               class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
        <ValidationMessage For="() => Model.Codigo" />
    </div>

    <div>
        <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_Descripcion")">
            Descripción <span class="text-red-500">*</span>
        </label>
        <input id="@($"{Prefix}_Descripcion")"
               type="text"
               name="@($"{Prefix}.Descripcion")"
               value="@Model.Descripcion"
               maxlength="200"
               placeholder="ej. Neto a 30 días"
               class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
        <ValidationMessage For="() => Model.Descripcion" />
    </div>

    <div class="grid grid-cols-2 gap-3">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_DiasVencimiento")">
                Días vencimiento <span class="text-red-500">*</span>
            </label>
            <input id="@($"{Prefix}_DiasVencimiento")"
                   type="number"
                   min="0"
                   name="@($"{Prefix}.DiasVencimiento")"
                   value="@Model.DiasVencimiento"
                   class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
            <ValidationMessage For="() => Model.DiasVencimiento" />
        </div>

        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_DiasDescuento")">
                Días descuento <span class="text-red-500">*</span>
            </label>
            <input id="@($"{Prefix}_DiasDescuento")"
                   type="number"
                   min="0"
                   name="@($"{Prefix}.DiasDescuento")"
                   value="@Model.DiasDescuento"
                   class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
            <ValidationMessage For="() => Model.DiasDescuento" />
        </div>
    </div>

    <div>
        <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_PorcentajeDescuento")">
            Porcentaje descuento (%) <span class="text-red-500">*</span>
        </label>
        <input id="@($"{Prefix}_PorcentajeDescuento")"
               type="number"
               min="0"
               max="100"
               step="0.01"
               name="@($"{Prefix}.PorcentajeDescuento")"
               value="@Model.PorcentajeDescuento"
               class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
        <ValidationMessage For="() => Model.PorcentajeDescuento" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TerminosPago.TerminoPagoForm Model { get; set; } = default!;
    /// <summary>
    /// Nombre exacto del parámetro [SupplyParameterFromForm] en el componente padre.
    /// Ej: "SaveInput" o "UpdateInput"
    /// </summary>
    [Parameter, EditorRequired] public string Prefix { get; set; } = default!;
}
