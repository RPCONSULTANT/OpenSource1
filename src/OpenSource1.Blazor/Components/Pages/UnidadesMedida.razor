@page "/unidades-medida"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.UnidadesMedida.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@inject IUnidadMedidaApiClient UnidadMedidaApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<UnidadesMedida> Logger
@inject NavigationManager Nav

<PageTitle>Unidades de Medida – AxionERP</PageTitle>

<div class="mb-6">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Mantenimiento</p>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Unidades de Medida</h1>
    <p class="text-sm text-slate-500 mt-1">Catálogo de unidades de medida y sus decimales de redondeo.</p>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" />
        }
    </div>
}

<!-- ── Filtros ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/unidades-medida" data-enhance class="p-4 sm:p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2 max-w-2xl">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroCodigo">Código</label>
                    <input id="filtroCodigo" type="text" name="codigo" value="@SearchCodigo" placeholder="ej. KG"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroNombre">Nombre</label>
                    <input id="filtroNombre" type="text" name="nombre" value="@SearchNombre" placeholder="ej. kilo"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m0 0A7.95 7.95 0 1 0 5.4 5.4a7.95 7.95 0 0 0 11.25 11.25Z" /></svg>
                    Consultar
                </button>
                <a href="/unidades-medida" title="Limpiar campos" class="btn-press inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                    Limpiar campos
                </a>
            </div>
        </div>
    </form>
</div>

<!-- ── Tabla de unidades de medida ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-700">Registros actuales</h2>
        <p class="mt-1 text-xs text-slate-500">@totalUnidades resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1).</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Código</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Nombre</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Decimales</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actualizado</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (unidades.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-slate-400 text-sm">
                            No hay unidades de medida registradas con esos criterios.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var unidad in unidades)
                    {
                        <tr @key="unidad.Id" class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-3 font-mono text-xs font-semibold text-brand-700">@unidad.Codigo</td>
                            <td class="px-6 py-3 text-slate-700">@unidad.Nombre</td>
                            <td class="px-6 py-3 text-right text-slate-700">@unidad.Decimales</td>
                            <td class="px-6 py-3 text-slate-400 text-xs">
                                @(unidad.UpdatedAtUtc?.ToLocalTime().ToString("g") ?? unidad.CreatedAtUtc.ToLocalTime().ToString("g"))
                            </td>
                            <td class="px-6 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @if (canModify)
                                    {
                                        <a href="@BuildListUrl(editId: unidad.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-amber-200 bg-amber-50 text-amber-600 hover:bg-amber-100" title="Editar unidad de medida">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z" /></svg>
                                        </a>
                                    }
                                    @if (canDelete)
                                    {
                                        <a href="@BuildListUrl(deleteId: unidad.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100" title="Eliminar unidad de medida">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79" /></svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
            <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
            <div class="flex items-center gap-2">
                @if (Pagina > 1)
                {
                    <a href="@BuildListUrl(pagina: Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                }
                @if (Pagina < totalPaginas)
                {
                    <a href="@BuildListUrl(pagina: Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                }
            </div>
        </div>
    }
</div>

<!-- ── Formularios de operación ── -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Agregar -->
    @if (canAdd)
    {
        <div id="agregar" class="rounded-2xl border border-green-200 bg-white shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-green-50 border-b border-green-100 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-green-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <h2 class="text-sm font-bold text-green-800">Agregar unidad de medida</h2>
            </div>
            <div class="px-6 py-5">
                <EditForm Model="SaveInput" FormName="save-unidadmedida" OnValidSubmit="PrepareCreateConfirmation">
                    <DataAnnotationsValidator />
                    <UnidadMedidaFields Model="SaveInput!" Prefix="SaveInput" />
                    <div class="mt-5">
                        <button type="submit"
                                class="btn-press flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 transition-colors shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            Revisar y agregar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Modificar -->
    @if (canModify)
    {
        <div id="modificar" class="rounded-2xl border border-amber-200 bg-white shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-amber-50 border-b border-amber-100 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-amber-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                </svg>
                <h2 class="text-sm font-bold text-amber-800">Modificar unidad de medida</h2>
            </div>
            <div class="px-6 py-5">
                @if (EditId.HasValue && UpdateInput?.Id != EditId)
                {
                    <MessageBox Type="warning" Message="No se encontró la unidad de medida seleccionada. Puede haber sido eliminado por otro usuario." />
                }
                <EditForm Model="UpdateInput" FormName="update-unidadmedida" OnValidSubmit="PrepareUpdateConfirmation">
                    <DataAnnotationsValidator />
                    <input type="hidden" name="UpdateInput.Id" value="@UpdateInput!.Id" />
                    <UnidadMedidaFields Model="UpdateInput!" Prefix="UpdateInput" />
                    <div class="mt-5">
                        <button type="submit"
                                class="btn-press flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600 transition-colors shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                            </svg>
                            Revisar modificación
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

</div>

@if (showCreateConfirmation)
{
    <ConfirmDialog Title="Confirmar creación" Message="Está a punto de crear una unidad de medida." Variant="success" CancelHref="/unidades-medida">
        <p class="rounded-xl border border-green-100 bg-green-50 px-4 py-3 text-sm font-mono text-green-900">@SaveInput!.Codigo — @SaveInput.Nombre</p>
        <EditForm Model="ConfirmSaveInput" FormName="confirm-save-unidadmedida" OnValidSubmit="CreateAsync" class="mt-4">
            <input type="hidden" name="ConfirmSaveInput.Codigo" value="@SaveInput.Codigo" />
            <input type="hidden" name="ConfirmSaveInput.Nombre" value="@SaveInput.Nombre" />
            <input type="hidden" name="ConfirmSaveInput.Decimales" value="@SaveInput.Decimales" />
            <button type="submit" class="btn-press rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-700">Sí, crear unidad de medida</button>
            <a href="/unidades-medida" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@if (showUpdateConfirmation)
{
    <ConfirmDialog Title="Confirmar modificación" Message="Está a punto de modificar una unidad de medida." Variant="warning" CancelHref="/unidades-medida">
        <p class="rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm font-mono text-amber-900">@UpdateInput!.Codigo — @UpdateInput.Nombre</p>
        <EditForm Model="ConfirmUpdateInput" FormName="confirm-update-unidadmedida" OnValidSubmit="UpdateAsync" class="mt-4">
            <input type="hidden" name="ConfirmUpdateInput.Id" value="@UpdateInput.Id" />
            <input type="hidden" name="ConfirmUpdateInput.Codigo" value="@UpdateInput.Codigo" />
            <input type="hidden" name="ConfirmUpdateInput.Nombre" value="@UpdateInput.Nombre" />
            <input type="hidden" name="ConfirmUpdateInput.Decimales" value="@UpdateInput.Decimales" />
            <button type="submit" class="btn-press rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-700">Sí, guardar cambios</button>
            <a href="/unidades-medida" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@if (DeleteId.HasValue && canDelete)
{
    <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará la unidad de medida seleccionada y no se puede deshacer." Variant="danger" CancelHref="/unidades-medida">
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-mono text-red-900">@((itemToDelete is null) ? DeleteId.Value.ToString() : $"{itemToDelete.Codigo} — {itemToDelete.Nombre}")</p>
        <EditForm Model="DeleteInput" FormName="delete-unidadmedida" OnValidSubmit="DeleteAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.Id" value="@DeleteId" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, eliminar</button>
            <a href="/unidades-medida" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@code {
    [SupplyParameterFromForm(FormName = "save-unidadmedida")]
    private UnidadMedidaForm? SaveInput { get; set; }

    [SupplyParameterFromForm(FormName = "confirm-save-unidadmedida")]
    private UnidadMedidaForm? ConfirmSaveInput { get; set; }

    [SupplyParameterFromForm(FormName = "update-unidadmedida")]
    private UnidadMedidaForm? UpdateInput { get; set; }

    [SupplyParameterFromForm(FormName = "confirm-update-unidadmedida")]
    private UnidadMedidaForm? ConfirmUpdateInput { get; set; }

    [SupplyParameterFromForm(FormName = "delete-unidadmedida")]
    private DeleteForm? DeleteInput { get; set; }

    [SupplyParameterFromQuery(Name = "codigo")]
    private string? SearchCodigo { get; set; }

    [SupplyParameterFromQuery(Name = "nombre")]
    private string? SearchNombre { get; set; }

    [SupplyParameterFromQuery(Name = "editId")]
    private Guid? EditId { get; set; }

    [SupplyParameterFromQuery(Name = "deleteId")]
    private Guid? DeleteId { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int Pagina { get; set; } = 1;

    private IReadOnlyList<UnidadMedidaResponse> unidades = [];
    // Registro a eliminar, cargado fresco con GetByIdAsync (no buscado en la página de la lista).
    private UnidadMedidaResponse? itemToDelete;
    private long totalUnidades;
    private int totalPaginas;
    private string? message;
    private string messageType = "info";
    private bool showCreateConfirmation;
    private bool showUpdateConfirmation;

    // Permisos computados sincrónicamente en OnInitializedAsync
    private bool canAdd;
    private bool canModify;
    private bool canDelete;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        SaveInput ??= new();
        ConfirmSaveInput ??= new();
        UpdateInput ??= new();
        ConfirmUpdateInput ??= new();
        DeleteInput ??= new();

        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            var user = authState.User;
            canAdd = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanAdd)).Succeeded;
            canModify = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanModify)).Succeeded;
            canDelete = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanDelete)).Succeeded;
        }

        await LoadAsync();

        if (Ok is not null)
        {
            (messageType, message) = Ok switch
            {
                "created" => ("success", "Unidad de medida creada satisfactoriamente."),
                "updated" => ("success", "Unidad de medida modificada satisfactoriamente."),
                "deleted" => ("success", "Unidad de medida eliminada satisfactoriamente."),
                _ => ("info", null)
            };
        }

        if (DeleteId.HasValue && canDelete)
        {
            try
            {
                itemToDelete = await UnidadMedidaApiClient.GetByIdAsync(DeleteId.Value);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load unidad de medida {DeleteId} from API.", DeleteId);
            }
        }

        if (EditId.HasValue && UpdateInput.Id == Guid.Empty)
        {
            try
            {
                var unidad = await UnidadMedidaApiClient.GetByIdAsync(EditId.Value);
                if (unidad is not null)
                {
                    UpdateInput.Id = unidad.Id;
                    UpdateInput.Codigo = unidad.Codigo;
                    UpdateInput.Nombre = unidad.Nombre;
                    UpdateInput.Decimales = unidad.Decimales;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load unidad de medida {EditId} from API.", EditId);
                Show("danger", "No fue posible cargar la unidad de medida a modificar.");
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var filter = new UnidadMedidaSearchFilter(EmptyAsNull(SearchCodigo), EmptyAsNull(SearchNombre));
            var pagina = await UnidadMedidaApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto));
            unidades = pagina.Items;
            totalUnidades = pagina.Total;
            totalPaginas = pagina.TotalPaginas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load unidades de medida from API.");
            Show("danger", "No fue posible cargar los unidades de medida.");
        }
    }

    private string BuildListUrl(int? pagina = null, Guid? editId = null, Guid? deleteId = null)
    {
        var parameters = new List<string>();
        AddParameter(parameters, "codigo", SearchCodigo);
        AddParameter(parameters, "nombre", SearchNombre);
        var paginaEfectiva = pagina ?? Pagina;
        if (paginaEfectiva > 1) parameters.Add($"pagina={paginaEfectiva}");
        if (editId.HasValue) parameters.Add($"editId={editId.Value}");
        if (deleteId.HasValue) parameters.Add($"deleteId={deleteId.Value}");
        return parameters.Count == 0 ? "/unidades-medida" : $"/unidades-medida?{string.Join("&", parameters)}";
    }

    private static void AddParameter(List<string> parameters, string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value)) parameters.Add($"{key}={Uri.EscapeDataString(value)}");
    }

    private Task PrepareCreateConfirmation() { showCreateConfirmation = true; return Task.CompletedTask; }
    private Task PrepareUpdateConfirmation() { showUpdateConfirmation = true; return Task.CompletedTask; }

    private async Task CreateAsync() => await ExecuteAsync(() => UnidadMedidaApiClient.CreateAsync(ToInput(ConfirmSaveInput!)), "created");
    private async Task UpdateAsync() => await ExecuteAsync(() => UnidadMedidaApiClient.UpdateAsync(ConfirmUpdateInput!.Id, ToInput(ConfirmUpdateInput!)), "updated");
    private async Task DeleteAsync() => await ExecuteAsync(() => UnidadMedidaApiClient.DeleteAsync(DeleteInput!.Id), "deleted");

    private async Task ExecuteAsync(Func<Task<UnidadMedidaOperationResult>> operation, string successCode)
    {
        try
        {
            var result = await operation();
            if (result.Succeeded)
                Nav.NavigateTo($"/unidades-medida?ok={successCode}");
            else
                Show("warning", result.Message);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not complete unidad de medida operation.");
            Show("danger", "No fue posible completar la operación.");
        }
    }

    private void Show(string type, string text) { messageType = type; message = text; }

    private static UnidadMedidaInput ToInput(UnidadMedidaForm form) => new(
        form.Codigo.Trim(), form.Nombre.Trim(), form.Decimales);

    private static string? EmptyAsNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    public sealed class UnidadMedidaForm
    {
        public Guid Id { get; set; }

        [Required(ErrorMessage = "El código es obligatorio.")]
        [MaxLength(10, ErrorMessage = "El código no puede superar los 10 caracteres.")]
        public string Codigo { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [MaxLength(50, ErrorMessage = "El nombre no puede superar los 50 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [Range(0, 6, ErrorMessage = "Los decimales deben estar entre 0 y 6.")]
        public short Decimales { get; set; }
    }

    public sealed class DeleteForm
    {
        public Guid Id { get; set; }
    }
}
