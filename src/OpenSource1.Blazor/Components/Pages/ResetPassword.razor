@page "/account/reset-password"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using OpenSource1.Application.Services.Auth.Dtos
@using OpenSource1.Blazor.Services
@inject IAuthApiClient AuthApiClient

<PageTitle>Restablecer contraseña – AxionERP</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-slate-100 via-brand-50 to-white flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md animate-fade-in">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
            <div class="h-1 w-full bg-gradient-to-r from-brand-500 to-brand-700"></div>
            <div class="px-8 py-8">
                <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-2">Nueva contraseña</p>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Restablecer contraseña</h1>
                <p class="mt-2 text-sm text-slate-500">Use el enlace seguro recibido. El código de recuperación no se muestra en pantalla.</p>

                @if (errors.Count > 0)
                {
                    <div class="mt-5"><MessageBox Type="danger" Errors="errors" /></div>
                }

                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="mt-5"><MessageBox Type="success" Message="@successMessage" /></div>
                }

                @if (string.IsNullOrWhiteSpace(Input?.Token))
                {
                    <div class="mt-5">
                        <MessageBox Type="warning" Message="El enlace de recuperación no incluye un código válido. Solicite una nueva recuperación de contraseña." />
                    </div>
                    <div class="mt-5">
                        <a href="/account/forgot-password" class="btn-press inline-flex w-full items-center justify-center rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">
                            Solicitar nuevo enlace
                        </a>
                    </div>
                }
                else
                {
                <EditForm Model="Input" FormName="reset-password" OnValidSubmit="SubmitAsync" class="mt-6">
                    <DataAnnotationsValidator />
                    <input type="hidden" name="Input.Token" value="@Input!.Token" />

                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="userNameOrEmail">Usuario o correo</label>
                        <InputText id="userNameOrEmail" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 shadow-sm focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25" @bind-Value="Input!.UserNameOrEmail" autocomplete="username" />
                        <ValidationMessage For="() => Input!.UserNameOrEmail" />
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="newPassword">Nueva contraseña</label>
                        <InputText id="newPassword" type="password" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 shadow-sm focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25" @bind-Value="Input!.NewPassword" autocomplete="new-password" />
                        <ValidationMessage For="() => Input!.NewPassword" />
                    </div>

                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="confirmPassword">Confirmar contraseña</label>
                        <InputText id="confirmPassword" type="password" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 shadow-sm focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25" @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
                        <ValidationMessage For="() => Input!.ConfirmPassword" />
                    </div>

                    <button type="submit" class="btn-press w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 transition-colors">
                        Restablecer contraseña
                    </button>
                </EditForm>
                }
            </div>
            <div class="border-t border-slate-100 bg-slate-50 px-8 py-4 text-center text-sm text-slate-500">
                <a href="/account/login" class="font-semibold text-brand-600 hover:text-brand-700 hover:underline">Volver a iniciar sesión</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetPasswordInput? Input { get; set; }

    [SupplyParameterFromQuery(Name = "userNameOrEmail")]
    private string? UserNameOrEmail { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private IReadOnlyList<string> errors = [];
    private string? successMessage;

    protected override void OnInitialized()
    {
        Input ??= new();
        if (string.IsNullOrWhiteSpace(Input.UserNameOrEmail)) Input.UserNameOrEmail = UserNameOrEmail ?? string.Empty;
        if (string.IsNullOrWhiteSpace(Input.Token)) Input.Token = Token ?? string.Empty;
    }

    private async Task SubmitAsync()
    {
        errors = [];
        successMessage = null;

        var result = await AuthApiClient.ResetPasswordAsync(new ResetPasswordRequest
        {
            UserNameOrEmail = Input!.UserNameOrEmail.Trim(),
            Token = Input.Token,
            NewPassword = Input.NewPassword
        });

        if (!result.Succeeded || result.Response is null)
        {
            errors = result.Errors.Count > 0 ? result.Errors : ["No fue posible restablecer la contraseña."];
            return;
        }

        successMessage = result.Response.Message;
    }

    private sealed class ResetPasswordInput
    {
        [Required(ErrorMessage = "Debe ingresar su usuario o correo electrónico.")]
        [MaxLength(256)]
        public string UserNameOrEmail { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe ingresar el token de recuperación.")]
        public string Token { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe ingresar la nueva contraseña.")]
        [MinLength(8, ErrorMessage = "La contraseña debe tener al menos 8 caracteres.")]
        [MaxLength(100)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe confirmar la nueva contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
