@page "/grupos-cliente-contable"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.CuentasContables.Dtos
@using OpenSource1.Application.Features.GruposClienteContable.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@using OpenSource1.Core.Enums
@inject IGrupoClienteContableApiClient GrupoClienteContableApiClient
@inject ICuentaContableApiClient CuentaContableApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<GruposClienteContable> Logger
@inject NavigationManager Nav

<PageTitle>Grupos contables de cliente – AxionERP</PageTitle>

<div class="mb-6">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Contabilidad</p>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Grupos contables de cliente</h1>
    <p class="text-sm text-slate-500 mt-1">Cuenta por cobrar (y, opcionalmente, de descuentos e intereses) de cada grupo de clientes.</p>
</div>

@if (cuentasCargaFallida && (canAdd || canModify))
{
    <div class="mb-6"><MessageBox Type="danger" Message="No fue posible cargar las cuentas contables. Por seguridad no se puede agregar ni modificar un grupo hasta que carguen; recargue la página." /></div>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" Errors="@errores" />
        }
    </div>
}

<!-- ── Filtros ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/grupos-cliente-contable" data-enhance class="p-4 sm:p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2 max-w-3xl">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroCodigo">Código</label>
                    <input id="filtroCodigo" type="text" name="codigo" value="@SearchCodigo" placeholder="ej. GENERAL"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroDescripcion">Descripción</label>
                    <input id="filtroDescripcion" type="text" name="descripcion" value="@SearchDescripcion" placeholder="ej. clientes"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Consultar</button>
                <a href="/grupos-cliente-contable" title="Limpiar campos" class="btn-press inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Limpiar campos</a>
            </div>
        </div>
    </form>
</div>

<!-- ── Tabla ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-700">Registros actuales</h2>
        <p class="mt-1 text-xs text-slate-500">@total resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1).</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Código / Descripción</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Cuenta por cobrar</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Descuentos</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Intereses</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (grupos.Count == 0)
                {
                    <tr><td colspan="5" class="px-6 py-8 text-center text-slate-400 text-sm">No hay grupos registrados con esos criterios.</td></tr>
                }
                else
                {
                    @foreach (var grupo in grupos)
                    {
                        <tr @key="grupo.Id" class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-3"><span class="font-mono text-xs font-semibold text-brand-700">@grupo.Codigo</span><span class="ml-2 text-slate-700">@grupo.Descripcion</span></td>
                            <td class="px-6 py-3 text-slate-600 text-xs">@Cuenta(grupo.CuentaCxCId, grupo.CuentaCxCNumero, grupo.CuentaCxCNombre)</td>
                            <td class="px-6 py-3 text-slate-600 text-xs">@Cuenta(grupo.CuentaDescuentoId, grupo.CuentaDescuentoNumero, grupo.CuentaDescuentoNombre)</td>
                            <td class="px-6 py-3 text-slate-600 text-xs">@Cuenta(grupo.CuentaInteresId, grupo.CuentaInteresNumero, grupo.CuentaInteresNombre)</td>
                            <td class="px-6 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @if (canModify)
                                    {
                                        <a href="@BuildListUrl(editId: grupo.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-amber-200 bg-amber-50 text-amber-600 hover:bg-amber-100" title="Editar grupo">✎</a>
                                    }
                                    @if (canDelete)
                                    {
                                        <a href="@BuildListUrl(deleteId: grupo.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100" title="Eliminar grupo">🗑</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
            <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
            <div class="flex items-center gap-2">
                @if (Pagina > 1)
                {
                    <a href="@BuildListUrl(pagina: Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                }
                @if (Pagina < totalPaginas)
                {
                    <a href="@BuildListUrl(pagina: Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                }
            </div>
        </div>
    }
</div>

<!-- ── Formularios de operación ── -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    @if (canAdd)
    {
        <div id="agregar" class="rounded-2xl border border-green-200 bg-white shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-green-50 border-b border-green-100"><h2 class="text-sm font-bold text-green-800">Agregar grupo contable de cliente</h2></div>
            <div class="px-6 py-5">
                <EditForm Model="SaveInput" FormName="save-grupo-cliente-contable" OnValidSubmit="CreateAsync" Enhance="true">
                    <DataAnnotationsValidator />
                    <GrupoContableFields Model="SaveInput!" Prefix="SaveInput" />
                    @CamposCuentas(SaveInput!, "SaveInput", null)
                    @if (!cuentasCargaFallida)
                    {
                        <div class="mt-5"><button type="submit" class="btn-press rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 shadow-sm">Agregar</button></div>
                    }
                </EditForm>
            </div>
        </div>
    }

    @if (canModify)
    {
        <div id="modificar" class="rounded-2xl border border-amber-200 bg-white shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-amber-50 border-b border-amber-100"><h2 class="text-sm font-bold text-amber-800">Modificar grupo contable de cliente</h2></div>
            <div class="px-6 py-5">
                @if (EditId.HasValue && UpdateInput?.Id != EditId)
                {
                    <MessageBox Type="warning" Message="No se encontró el grupo seleccionado. Puede haber sido eliminado por otro usuario." />
                }
                <EditForm Model="UpdateInput" FormName="update-grupo-cliente-contable" OnValidSubmit="UpdateAsync" Enhance="true">
                    <DataAnnotationsValidator />
                    <input type="hidden" name="UpdateInput.Id" value="@UpdateInput!.Id" />
                    <input type="hidden" name="UpdateInput.Xmin" value="@UpdateInput.Xmin" />
                    <GrupoContableFields Model="UpdateInput!" Prefix="UpdateInput" />
                    @CamposCuentas(UpdateInput, "UpdateInput", grupoEnEdicion)
                    @if (!cuentasCargaFallida)
                    {
                        <div class="mt-5"><button type="submit" class="btn-press rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600 shadow-sm">Guardar cambios</button></div>
                    }
                </EditForm>
            </div>
        </div>
    }
</div>

@if (DeleteId.HasValue && canDelete)
{
    <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará el grupo contable de cliente seleccionado y no se puede deshacer." Variant="danger" CancelHref="/grupos-cliente-contable">
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-mono text-red-900">@(itemToDelete is null ? DeleteId.Value.ToString() : $"{itemToDelete.Codigo} — {itemToDelete.Descripcion}")</p>
        <EditForm Model="DeleteInput" FormName="delete-grupo-cliente-contable" OnValidSubmit="DeleteAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.Id" value="@DeleteId" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, eliminar</button>
            <a href="/grupos-cliente-contable" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@code {
    private const string InputCss = "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20";

    [SupplyParameterFromForm(FormName = "save-grupo-cliente-contable")]
    private GrupoClienteContableForm? SaveInput { get; set; }

    [SupplyParameterFromForm(FormName = "update-grupo-cliente-contable")]
    private GrupoClienteContableForm? UpdateInput { get; set; }

    [SupplyParameterFromForm(FormName = "delete-grupo-cliente-contable")]
    private DeleteForm? DeleteInput { get; set; }

    [SupplyParameterFromQuery(Name = "codigo")]
    private string? SearchCodigo { get; set; }

    [SupplyParameterFromQuery(Name = "descripcion")]
    private string? SearchDescripcion { get; set; }

    [SupplyParameterFromQuery(Name = "editId")]
    private Guid? EditId { get; set; }

    [SupplyParameterFromQuery(Name = "deleteId")]
    private Guid? DeleteId { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int Pagina { get; set; } = 1;

    private IReadOnlyList<GrupoClienteContableResponse> grupos = [];
    private GrupoClienteContableResponse? itemToDelete;
    // Grupo en edición tal como está guardado: rotula sus cuentas vigentes aunque ya no sean elegibles (bloqueadas, no de posteo).
    private GrupoClienteContableResponse? grupoEnEdicion;
    // Cuentas elegibles: de Posteo y no bloqueadas (las únicas que la API acepta al asignar o cambiar una cuenta).
    private IReadOnlyList<CuentaContableResponse> cuentas = [];
    private bool cuentasCargaFallida;
    private long total;
    private int totalPaginas;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string> errores = [];
    private bool canAdd;
    private bool canModify;
    private bool canDelete;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        SaveInput ??= new();
        UpdateInput ??= new();
        DeleteInput ??= new();

        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            canAdd = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanAdd)).Succeeded;
            canModify = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanModify)).Succeeded;
            canDelete = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanDelete)).Succeeded;
        }

        await LoadAsync();

        if (canAdd || canModify)
        {
            await CargarCuentasAsync();
        }

        if (Ok is not null)
        {
            (messageType, message) = Ok switch
            {
                "created" => ("success", "Grupo contable de cliente creado satisfactoriamente."),
                "updated" => ("success", "Grupo contable de cliente modificado satisfactoriamente."),
                "deleted" => ("success", "Grupo contable de cliente eliminado satisfactoriamente."),
                _ => ("info", null)
            };
        }

        if (DeleteId.HasValue && canDelete)
        {
            try
            {
                itemToDelete = await GrupoClienteContableApiClient.GetByIdAsync(DeleteId.Value);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load grupo cliente contable {DeleteId} from API.", DeleteId);
            }
        }

        var editarId = EditId ?? (UpdateInput.Id != Guid.Empty ? UpdateInput.Id : null);
        if (editarId.HasValue && canModify)
        {
            try
            {
                grupoEnEdicion = await GrupoClienteContableApiClient.GetByIdAsync(editarId.Value);
                // Solo se rellena con lo guardado cuando NO llegó un formulario de modificación.
                if (grupoEnEdicion is not null && UpdateInput.Id == Guid.Empty)
                {
                    UpdateInput.Id = grupoEnEdicion.Id;
                    UpdateInput.Codigo = grupoEnEdicion.Codigo;
                    UpdateInput.Descripcion = grupoEnEdicion.Descripcion;
                    UpdateInput.CuentaCxCId = grupoEnEdicion.CuentaCxCId;
                    UpdateInput.CuentaDescuentoId = grupoEnEdicion.CuentaDescuentoId;
                    UpdateInput.CuentaInteresId = grupoEnEdicion.CuentaInteresId;
                    UpdateInput.Xmin = grupoEnEdicion.Xmin;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load grupo cliente contable {EditId} from API.", editarId);
                Show("danger", "No fue posible cargar el grupo a modificar.");
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var filter = new GrupoContableSearchFilter(EmptyAsNull(SearchCodigo), EmptyAsNull(SearchDescripcion));
            if (Pagina < 1) Pagina = 1;
            var pagina = await GrupoClienteContableApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto, Descendente: false));
            if (pagina.TotalPaginas == 0)
            {
                Pagina = 1;
            }
            else if (Pagina > pagina.TotalPaginas)
            {
                Pagina = pagina.TotalPaginas;
                pagina = await GrupoClienteContableApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto, Descendente: false));
            }

            grupos = pagina.Items;
            total = pagina.Total;
            totalPaginas = pagina.TotalPaginas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load grupos cliente contable from API.");
            Show("danger", "No fue posible cargar los grupos contables de cliente.");
        }
    }

    /// <summary>Todas las cuentas de Posteo no bloqueadas (todas las páginas), con un tiempo máximo común.</summary>
    private async Task CargarCuentasAsync()
    {
        using var cts = new CancellationTokenSource(ProductoOpciones.TiempoMaximo);
        try
        {
            var todas = new List<CuentaContableResponse>();
            var filtro = new CuentaContableSearchFilter(null, null, TipoCuentaContable.Posteo, null, Bloqueada: false);
            for (var pagina = 1; ; pagina++)
            {
                var resultado = await CuentaContableApiClient.ListAsync(filtro, new PageRequest(pagina, PageRequest.TamanoMaximo, "Numero", Descendente: false), cts.Token);
                todas.AddRange(resultado.Items);
                if (resultado.Items.Count == 0 || pagina >= resultado.TotalPaginas)
                {
                    break;
                }
            }

            cuentas = todas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load cuentas contables options from API.");
            cuentasCargaFallida = true;
        }
    }

    private RenderFragment CamposCuentas(GrupoClienteContableForm model, string prefix, GrupoClienteContableResponse? vigente) => __builder =>
    {
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{prefix}_CuentaCxCId")">Cuenta por cobrar <span class="text-red-500">*</span></label>
                <select id="@($"{prefix}_CuentaCxCId")" name="@($"{prefix}.CuentaCxCId")" class="@InputCss">
                    <option value="" selected="@(model.CuentaCxCId is null)">— Seleccione —</option>
                    @OpcionVigente(model.CuentaCxCId, vigente?.CuentaCxCId, vigente?.CuentaCxCNumero, vigente?.CuentaCxCNombre)
                    @foreach (var cuenta in cuentas)
                    {
                        <option value="@cuenta.Id" selected="@(cuenta.Id == model.CuentaCxCId)">@cuenta.Numero — @cuenta.Nombre</option>
                    }
                </select>
                <ValidationMessage For="() => model.CuentaCxCId" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{prefix}_CuentaDescuentoId")">Cuenta de descuentos</label>
                <select id="@($"{prefix}_CuentaDescuentoId")" name="@($"{prefix}.CuentaDescuentoId")" class="@InputCss">
                    <option value="" selected="@(model.CuentaDescuentoId is null)">— Ninguna —</option>
                    @OpcionVigente(model.CuentaDescuentoId, vigente?.CuentaDescuentoId, vigente?.CuentaDescuentoNumero, vigente?.CuentaDescuentoNombre)
                    @foreach (var cuenta in cuentas)
                    {
                        <option value="@cuenta.Id" selected="@(cuenta.Id == model.CuentaDescuentoId)">@cuenta.Numero — @cuenta.Nombre</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{prefix}_CuentaInteresId")">Cuenta de intereses</label>
                <select id="@($"{prefix}_CuentaInteresId")" name="@($"{prefix}.CuentaInteresId")" class="@InputCss">
                    <option value="" selected="@(model.CuentaInteresId is null)">— Ninguna —</option>
                    @OpcionVigente(model.CuentaInteresId, vigente?.CuentaInteresId, vigente?.CuentaInteresNumero, vigente?.CuentaInteresNombre)
                    @foreach (var cuenta in cuentas)
                    {
                        <option value="@cuenta.Id" selected="@(cuenta.Id == model.CuentaInteresId)">@cuenta.Numero — @cuenta.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <p class="mt-2 text-xs text-slate-400">Solo se ofrecen cuentas de posteo no bloqueadas.</p>
    };

    // La cuenta seleccionada se ofrece SIEMPRE aunque ya no sea elegible (bloqueada o de otro tipo): sin esto el <select>
    // no reflejaría la cuenta guardada y guardar la cambiaría en silencio.
    private RenderFragment OpcionVigente(Guid? seleccion, Guid? vigenteId, string? numero, string? nombre) => __builder =>
    {
        if (seleccion is { } id && cuentas.All(c => c.Id != id))
        {
            <option value="@id" selected="selected">@(vigenteId == id && !string.IsNullOrWhiteSpace(numero) ? $"{numero} — {nombre} (no elegible)" : $"Cuenta no disponible ({id})")</option>
        }
    };

    private string BuildListUrl(int? pagina = null, Guid? editId = null, Guid? deleteId = null)
    {
        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(SearchCodigo)) parameters.Add($"codigo={Uri.EscapeDataString(SearchCodigo)}");
        if (!string.IsNullOrWhiteSpace(SearchDescripcion)) parameters.Add($"descripcion={Uri.EscapeDataString(SearchDescripcion)}");
        var paginaEfectiva = pagina ?? Pagina;
        if (paginaEfectiva > 1) parameters.Add($"pagina={paginaEfectiva}");
        if (editId.HasValue) parameters.Add($"editId={editId.Value}");
        if (deleteId.HasValue) parameters.Add($"deleteId={deleteId.Value}");
        return parameters.Count == 0 ? "/grupos-cliente-contable" : $"/grupos-cliente-contable?{string.Join("&", parameters)}";
    }

    private async Task CreateAsync()
    {
        // Defensa en profundidad: sin cuentas fiables no se envía nada aunque el botón no se haya renderizado.
        if (cuentasCargaFallida) return;
        await ExecuteAsync(() => GrupoClienteContableApiClient.CreateAsync(ToInput(SaveInput!)), "created");
    }

    private async Task UpdateAsync()
    {
        if (cuentasCargaFallida) return;
        if (UpdateInput!.Id == Guid.Empty)
        {
            Show("warning", "Seleccione primero un registro a modificar desde la tabla.");
            return;
        }

        await ExecuteAsync(() => GrupoClienteContableApiClient.UpdateAsync(UpdateInput.Id, ToInput(UpdateInput), UpdateInput.Xmin), "updated");
    }

    private async Task DeleteAsync() => await ExecuteAsync(() => GrupoClienteContableApiClient.DeleteAsync(DeleteInput!.Id), "deleted");

    private async Task ExecuteAsync(Func<Task<GrupoOperationResult>> operation, string successCode)
    {
        try
        {
            var result = await operation();
            if (result.Succeeded)
            {
                Nav.NavigateTo($"/grupos-cliente-contable?ok={successCode}");
            }
            else
            {
                errores = result.Errors ?? [];
                Show("warning", result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not complete grupo cliente contable operation.");
            Show("danger", "No fue posible completar la operación.");
        }
    }

    private void Show(string type, string text) { messageType = type; message = text; }

    private static GrupoClienteContableInput ToInput(GrupoClienteContableForm form) => new(
        form.Codigo.Trim(), form.Descripcion.Trim(), form.CuentaCxCId ?? Guid.Empty, form.CuentaDescuentoId, form.CuentaInteresId);

    private static string Cuenta(Guid? id, string? numero, string? nombre) =>
        id is null ? "—" : string.IsNullOrWhiteSpace(numero) ? $"No disponible ({id})" : $"{numero} — {nombre}";

    private static string? EmptyAsNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public sealed class DeleteForm
    {
        public Guid Id { get; set; }
    }
}
