@page "/terminos-pago"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.TerminosPago.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@inject ITerminoPagoApiClient TerminoPagoApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<TerminosPago> Logger
@inject NavigationManager Nav

<PageTitle>Términos de Pago – AxionERP</PageTitle>

<PageToolbar Titulo="Términos de Pago" Subtitulo="Condiciones de vencimiento y descuento por pronto pago."
             Migas="@Migas" Permisos="@permisos"
             NuevoHref="@RetornoLocal.ConRetorno("/terminos-pago/nuevo", UrlActual)"
             SeleccionId="@SeleccionValida?.ToString()"
             EditarUrl="@EditarHref"
             EliminarUrl="@(id => BuildListUrl(deleteId: Guid.Parse(id)))" />

@* Un fallo de borrado se muestra solo dentro del diálogo (donde el usuario está mirando), no también en la página. *@
@if (!string.IsNullOrWhiteSpace(message) && !(DeleteId.HasValue && canDelete && messageType != "success"))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" />
        }
    </div>
}

<!-- ── Filtros ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/terminos-pago" data-enhance class="p-4 sm:p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2 max-w-2xl">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroCodigo">Código</label>
                    <input id="filtroCodigo" type="text" name="codigo" value="@SearchCodigo" placeholder="ej. NET30"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroDescripcion">Descripción</label>
                    <input id="filtroDescripcion" type="text" name="descripcion" value="@SearchDescripcion" placeholder="ej. neto"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m0 0A7.95 7.95 0 1 0 5.4 5.4a7.95 7.95 0 0 0 11.25 11.25Z" /></svg>
                    Consultar
                </button>
                <a href="/terminos-pago" title="Limpiar campos" class="btn-press inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                    Limpiar campos
                </a>
            </div>
        </div>
    </form>
</div>

<!-- ── Tabla de términos de pago ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-700">Registros actuales</h2>
        <p class="mt-1 text-xs text-slate-500">@totalTerminos resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1).</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3"><span class="sr-only">Seleccionar</span></th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Código</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Descripción</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Días vencimiento</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Días descuento</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">% Descuento</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actualizado</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (terminos.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="px-6 py-8 text-center text-slate-400 text-sm">
                            No hay términos de pago registrados con esos criterios.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var termino in terminos)
                    {
                        var marcada = termino.Id == SeleccionValida;
                        <tr @key="termino.Id" class="@SeleccionFila.ClaseFila transition-colors @(marcada ? SeleccionFila.ClaseFilaSeleccionada : null)">
                            <td class="px-4 py-3"><SeleccionFila Href="@BuildListUrl(sel: termino.Id)" Seleccionada="@marcada" Etiqueta="@termino.Codigo" /></td>
                            <td class="px-6 py-3 font-mono text-xs font-semibold text-brand-700">@termino.Codigo</td>
                            <td class="px-6 py-3 text-slate-700">@termino.Descripcion</td>
                            <td class="px-6 py-3 text-right text-slate-700">@termino.DiasVencimiento</td>
                            <td class="px-6 py-3 text-right text-slate-700">@termino.DiasDescuento</td>
                            <td class="px-6 py-3 text-right text-slate-700">@termino.PorcentajeDescuento.ToString("0.##")%</td>
                            <td class="px-6 py-3 text-slate-400 text-xs">
                                @(termino.UpdatedAtUtc?.ToLocalTime().ToString("g") ?? termino.CreatedAtUtc.ToLocalTime().ToString("g"))
                            </td>
                            <td class="px-6 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @if (canModify)
                                    {
                                        <a href="@EditarHref(termino.Id.ToString())" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-amber-200 bg-amber-50 text-amber-600 hover:bg-amber-100" title="Editar término de pago">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z" /></svg>
                                        </a>
                                    }
                                    @if (canDelete)
                                    {
                                        <a href="@BuildListUrl(deleteId: termino.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100" title="Eliminar término de pago">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79" /></svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
            <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
            <div class="flex items-center gap-2">
                @if (Pagina > 1)
                {
                    <a href="@BuildListUrl(pagina: Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                }
                @if (Pagina < totalPaginas)
                {
                    <a href="@BuildListUrl(pagina: Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                }
            </div>
        </div>
    }
</div>

@if (DeleteId.HasValue && canDelete)
{
    var itemToDelete = terminos.FirstOrDefault(t => t.Id == DeleteId.Value);
    <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará el término de pago seleccionado y no se puede deshacer." Variant="danger" CancelHref="@UrlActual">
        @if (!string.IsNullOrWhiteSpace(message) && messageType != "success")
        {
            <div class="mb-4"><MessageBox Type="@messageType" Message="@message" /></div>
        }
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-mono text-red-900">@((itemToDelete is null) ? DeleteId.Value.ToString() : $"{itemToDelete.Codigo} — {itemToDelete.Descripcion}")</p>
        <EditForm Model="DeleteInput" FormName="delete-terminopago" OnValidSubmit="DeleteAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.Id" value="@DeleteId" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, eliminar</button>
            <a href="@UrlActual" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@code {
    [SupplyParameterFromForm(FormName = "delete-terminopago")]
    private DeleteForm? DeleteInput { get; set; }

    [SupplyParameterFromQuery(Name = "codigo")]
    private string? SearchCodigo { get; set; }

    [SupplyParameterFromQuery(Name = "descripcion")]
    private string? SearchDescripcion { get; set; }

    // Solo para redirigir la ruta antigua ?editId= a la página-tarjeta de edición (Fix-Features B2).
    [SupplyParameterFromQuery(Name = "editId")]
    private Guid? EditId { get; set; }

    [SupplyParameterFromQuery(Name = "sel")]
    private Guid? Sel { get; set; }

    [SupplyParameterFromQuery(Name = "deleteId")]
    private Guid? DeleteId { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int Pagina { get; set; } = 1;

    private IReadOnlyList<TerminoPagoResponse> terminos = [];
    private long totalTerminos;
    private int totalPaginas;
    private string? message;
    private string messageType = "info";

    // Permisos cargados una vez (PermisosPagina); la barra los recibe ya cargados.
    private PermisosPagina? permisos;
    private bool canModify => permisos?.CanModify == true;
    private bool canDelete => permisos?.CanDelete == true;

    private static readonly IReadOnlyList<Miga> Migas = [new("Configuración", "/modulos/configuracion"), new("Términos de pago")];

    // Solo cuenta la selección si el registro está en la página cargada (Review Focus 4: selección obsoleta => vacía).
    private Guid? SeleccionValida => Sel is { } s && terminos.Any(x => x.Id == s) ? s : null;

    // Única URL de vuelta del listado (filtros, página y selección; nunca ok/deleteId/editId).
    private string UrlActual => RetornoLocal.SinTransitorios(BuildListUrl());

    private string EditarHref(string id) => RetornoLocal.ConRetorno($"/terminos-pago/{id}/editar", UrlActual);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (EditId is { } editId)
        {
            // Ruta antigua ?editId= (Fix-Features B2): la edición vive ahora en su página-tarjeta. UrlActual no lleva editId.
            Nav.NavigateTo(RetornoLocal.ConRetorno($"/terminos-pago/{editId}/editar", UrlActual), replace: true);
            return;
        }

        DeleteInput ??= new();
        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);

        await LoadAsync();

        if (Ok is not null)
        {
            (messageType, message) = Ok switch
            {
                "created" => ("success", "Término de pago creado satisfactoriamente."),
                "updated" => ("success", "Término de pago modificado satisfactoriamente."),
                "deleted" => ("success", "Término de pago eliminado satisfactoriamente."),
                _ => ("info", null)
            };
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var filter = new TerminoPagoSearchFilter(EmptyAsNull(SearchCodigo), EmptyAsNull(SearchDescripcion));
            if (Pagina < 1) Pagina = 1;
            var pagina = await TerminoPagoApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto));

            // Normaliza una página fuera de rango (p. ej. ?pagina=2 con una sola página) para no
            // mostrar "página 2 de 1" ni una tabla vacía con registros existentes.
            if (pagina.TotalPaginas == 0)
            {
                Pagina = 1;
            }
            else if (Pagina > pagina.TotalPaginas)
            {
                Pagina = pagina.TotalPaginas;
                pagina = await TerminoPagoApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto));
            }

            terminos = pagina.Items;
            totalTerminos = pagina.Total;
            totalPaginas = pagina.TotalPaginas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load terminos de pago from API.");
            Show("danger", "No fue posible cargar los términos de pago.");
        }
    }

    private string BuildListUrl(int? pagina = null, Guid? sel = null, Guid? deleteId = null)
    {
        var parameters = new List<string>();
        AddParameter(parameters, "codigo", SearchCodigo);
        AddParameter(parameters, "descripcion", SearchDescripcion);
        var paginaEfectiva = pagina ?? Pagina;
        if (paginaEfectiva > 1) parameters.Add($"pagina={paginaEfectiva}");
        if ((sel ?? Sel) is { } seleccion) parameters.Add($"sel={seleccion}");
        if (deleteId.HasValue) parameters.Add($"deleteId={deleteId.Value}");
        return parameters.Count == 0 ? "/terminos-pago" : $"/terminos-pago?{string.Join("&", parameters)}";
    }

    private static void AddParameter(List<string> parameters, string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value)) parameters.Add($"{key}={Uri.EscapeDataString(value)}");
    }

    private async Task DeleteAsync() => await ExecuteAsync(() => TerminoPagoApiClient.DeleteAsync(DeleteInput!.Id), "deleted");

    private async Task ExecuteAsync(Func<Task<TerminoPagoOperationResult>> operation, string successCode)
    {
        TerminoPagoOperationResult result;
        try
        {
            result = await operation();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not complete termino de pago operation.");
            Show("danger", "No fue posible completar la operación.");
            return;
        }

        if (result.Succeeded)
        {
            // Fuera del try/catch: si NavigateTo lanza NavigationException (host sin BlazorDisableThrowNavigationException,
            // p. ej. el de pruebas), el catch no debe convertir la redirección en un error.
            Nav.NavigateTo(RetornoLocal.ConParametro(UrlActual, "ok", successCode));
            return;
        }

        Show("warning", result.Message);
    }

    private void Show(string type, string text) { messageType = type; message = text; }

    private static string? EmptyAsNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    public sealed class TerminoPagoForm
    {
        public Guid Id { get; set; }

        [Required(ErrorMessage = "El código es obligatorio.")]
        [MaxLength(20, ErrorMessage = "El código no puede superar los 20 caracteres.")]
        public string Codigo { get; set; } = string.Empty;

        [Required(ErrorMessage = "La descripción es obligatoria.")]
        [MaxLength(200, ErrorMessage = "La descripción no puede superar los 200 caracteres.")]
        public string Descripcion { get; set; } = string.Empty;

        [Range(0, int.MaxValue, ErrorMessage = "Los días de vencimiento no pueden ser negativos.")]
        public int DiasVencimiento { get; set; }

        [Range(0, int.MaxValue, ErrorMessage = "Los días de descuento no pueden ser negativos.")]
        public int DiasDescuento { get; set; }

        [Range(0, 100, ErrorMessage = "El porcentaje de descuento debe estar entre 0 y 100.")]
        public decimal PorcentajeDescuento { get; set; }
    }

    public sealed class DeleteForm
    {
        public Guid Id { get; set; }
    }
}
