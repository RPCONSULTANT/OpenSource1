}

@code {
    private static readonly (string Key, string Label)[] FilterableFields =
    [
        ("codigo", "Código"),
        ("categoriaCodigo", "Código de categoría"),
        ("categoriaNombre", "Nombre de categoría"),
        ("unidadMedidaCodigo", "Código de unidad"),
        ("unidadMedidaNombre", "Nombre de unidad"),
        ("precioVenta", "Precio de venta"),
        ("existencia", "Existencia"),
        ("estado", "Estado de existencia"),
    ];

    [SupplyParameterFromQuery(Name = "nombre")] private string? SearchNombre { get; set; }
    [SupplyParameterFromQuery(Name = "codigo")] private string? SearchCodigo { get; set; }
    [SupplyParameterFromQuery(Name = "categoriaCodigo")] private string? SearchCategoriaCodigo { get; set; }
    [SupplyParameterFromQuery(Name = "categoriaNombre")] private string? SearchCategoriaNombre { get; set; }
    [SupplyParameterFromQuery(Name = "unidadMedidaCodigo")] private string? SearchUnidadMedidaCodigo { get; set; }
    [SupplyParameterFromQuery(Name = "unidadMedidaNombre")] private string? SearchUnidadMedidaNombre { get; set; }
    [SupplyParameterFromQuery(Name = "precioVenta")] private string? SearchPrecioVenta { get; set; }
    [SupplyParameterFromQuery(Name = "existencia")] private string? SearchExistencia { get; set; }
    // Estado de existencia (KPI "Sin existencia" del inicio y del grupo, y campo "Estado de existencia" del panel de filtros):
    // solo "with" o "without" (ProductoSearchFilter.StockState); cualquier otro valor se ignora. Un único ?estado=, con o sin campo activo.
    [SupplyParameterFromQuery(Name = "estado")] private string? SearchEstado { get; set; }
    private string? EstadoExistencia => SearchEstado is "with" or "without" ? SearchEstado : null;
    [SupplyParameterFromQuery(Name = "filters")] private string? FiltersRaw { get; set; }
    [SupplyParameterFromQuery(Name = "addField")] private string? AddField { get; set; }
    [SupplyParameterFromQuery(Name = "view")] private string? View { get; set; }
    [SupplyParameterFromQuery(Name = "showFilters")] private bool ShowFilters { get; set; }
    [SupplyParameterFromQuery(Name = "report")] private bool ShowReport { get; set; }
    // Selección de la barra (Fix-Features B2c): ?sel= sustituye a ?focusId=; la ficha lateral "Detalles" se muestra con ella.
    [SupplyParameterFromQuery(Name = "sel")] private Guid? Sel { get; set; }
    // Solo para redirigir la ruta antigua ?editId= a /productos/{id}/editar.
    [SupplyParameterFromQuery(Name = "editId")] private Guid? EditId { get; set; }
    // Solo para mapear la ruta antigua ?focusId= (marcadores anteriores a B2c) a ?sel=.
    [SupplyParameterFromQuery(Name = "focusId")] private Guid? FocusId { get; set; }
    [SupplyParameterFromQuery(Name = "deleteId")] private Guid? DeleteId { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] private int Pagina { get; set; } = 1;
    [SupplyParameterFromForm(FormName = "delete-producto-list")] private DeleteConfirmForm? DeleteInput { get; set; }
    private IReadOnlyList<ProductoResponse> productos = [];
    private long totalProductos;
    private int totalPaginas;
    private List<string> ActiveFilterFields = [];
    private string? message; private string messageType = "info"; private string? modalError; private bool IsListView => string.Equals(View, "list", StringComparison.OrdinalIgnoreCase); private bool ShowFactbox => SeleccionValida.HasValue; [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private PermisosPagina? permisos;
    private bool CanModify => permisos?.CanModify == true;
    private bool CanDelete => permisos?.CanDelete == true;
    private static readonly IReadOnlyList<Miga> migas = [new("Productos", "/modulos/productos"), new("Productos")];
    // Selección obsoleta (Review Focus 4): un ?sel= que no está en la página cargada no cuenta como selección.
    private Guid? SeleccionValida => Sel is { } s && productos.Any(p => p.Id == s) ? s : null;
    // Única URL de vuelta del listado (filtros, estado, página, vista y selección; nunca ok/deleteId/editId).
    // Tampoco lleva el diálogo de reporte ni el panel de filtros abiertos: volver de editar no debe reabrirlos.
    private string UrlActual => RetornoLocal.SinTransitorios(BuildListUrl(report: false, showFilters: false));
    private const string EntityFabOnChange = "(function(cb){var fab=document.getElementById('producto-detail-fab');var link=document.getElementById('producto-detail-fab-link');if(!fab||!link)return;if(cb.checked){fab.dataset.lastId=cb.value;}else if(fab.dataset.lastId===cb.value){var form=cb.closest('form');var sc=form?form.querySelector('input[name=SelectedIds]:checked'):null;fab.dataset.lastId=sc?sc.value:'';}var base_=fab.getAttribute('data-base-url');var sep=base_.indexOf('?')===-1?'?':'&';var href=fab.dataset.lastId?(base_+sep+'sel='+fab.dataset.lastId):base_;link.setAttribute('href',href);if(fab.getAttribute('data-auto-nav')==='true'){window.location.href=href;return;}if(fab.dataset.lastId){fab.classList.remove('hidden');}else{fab.classList.add('hidden');}})(this)";
    private string GridColsClass => (ShowFactbox, ShowFilters) switch { (true, true) => "xl:grid-cols-[280px_minmax(0,1fr)_320px]", (true, false) => "xl:grid-cols-[280px_minmax(0,1fr)]", (false, true) => "xl:grid-cols-[minmax(0,1fr)_320px]", (false, false) => "xl:grid-cols-1" };
    private List<(string Key, string Label)> AvailableFields => [.. FilterableFields.Where(f => !ActiveFilterFields.Contains(f.Key))];
    private static string FieldLabel(string key) => FilterableFields.FirstOrDefault(f => f.Key == key).Label ?? key;
    protected override async Task OnInitializedAsync()
    {
        DeleteInput ??= new();
        ActiveFilterFields = ParseActiveFields(FiltersRaw);
        if (EditId is { } editId)
        {
            // Ruta antigua ?editId=: la modificación vive en /productos/{id}/editar (UrlActual no lleva editId: sin bucle).
            Nav.NavigateTo(RetornoLocal.ConRetorno($"/productos/{editId}/editar", UrlActual), replace: true);
            return;
        }
        if (FocusId is { } focusId && Sel is null)
        {
            // Ruta antigua ?focusId=: la selección es ?sel= (BuildListUrl no emite focusId); el aviso ok= se conserva.
            var destino = BuildListUrl(sel: focusId);
            Nav.NavigateTo(Ok is null ? destino : RetornoLocal.ConParametro(destino, "ok", Ok), replace: true);
            return;
        }
        if (!string.IsNullOrWhiteSpace(AddField) && FilterableFields.Any(f => f.Key == AddField) && !ActiveFilterFields.Contains(AddField))
        {
            Nav.NavigateTo(BuildListUrl(activeFiltersOverride: [.. ActiveFilterFields, AddField]), replace: true);
            return;
        }
        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);
        await LoadAsync();
        if(Ok is not null){(messageType, message)=Ok switch {"created"=>("success","Producto creado satisfactoriamente."),"updated"=>("success","Producto modificado satisfactoriamente."),"deleted"=>("success","Producto eliminado satisfactoriamente."),"report-select-required"=>("warning","Seleccione al menos un producto para generar el reporte."),"report-no-data"=>("warning","No hay datos para generar el reporte solicitado."),_ =>("info",null)};}
    }
    private async Task LoadAsync(){if (Pagina < 1) Pagina = 1; try{var pagina=await ProductoApiClient.ListAsync(new ProductoSearchFilter(GetActiveValue("codigo", SearchCodigo), EmptyAsNull(SearchNombre), GetActiveValue("categoriaCodigo", SearchCategoriaCodigo), GetActiveValue("categoriaNombre", SearchCategoriaNombre), GetActiveValue("unidadMedidaCodigo", SearchUnidadMedidaCodigo), GetActiveValue("unidadMedidaNombre", SearchUnidadMedidaNombre), GetActiveValue("precioVenta", SearchPrecioVenta), GetActiveValue("existencia", SearchExistencia), EstadoExistencia), new PageRequest(Pagina, PageRequest.TamanoPorDefecto)); productos=pagina.Items; totalProductos=pagina.Total; totalPaginas=pagina.TotalPaginas;} catch(Exception ex){Logger.LogWarning(ex,"Could not load productos from API."); message="No fue posible cargar los productos."; messageType="danger";}}
    private async Task DeleteAsync(){if(!DeleteId.HasValue){modalError="No se pudo identificar el producto. Intente de nuevo."; return;} var result=await ProductoApiClient.DeleteAsync(DeleteId.Value); if(result.Succeeded) Nav.NavigateTo(RetornoLocal.ConParametro(UrlActual, "ok", "deleted")); else modalError=result.Message;}
    // Acciones de cada tarjeta (vista Tarjetas): Ficha y Editar visibles; en el menú ⋯ las de Crear/Ver del producto (C2) y Eliminar.
    private RenderFragment TarjetaAccionesDe(ProductoResponse p) => __builder =>
    {
        <TarjetaAcciones Id="@p.Id.ToString()" Permisos="@permisos" RetornoUrl="@UrlActual"
                         Rapidas="@([new AccionPagina("Ficha", IconosModulo.Cubo, id => $"/productos/{id}"),
                                    new AccionPagina("Editar", IconosModulo.Lista, id => RetornoLocal.ConRetorno($"/productos/{id}/editar", UrlActual), ApplicationPolicies.CanModify)])"
                         Resto="@([.. AccionesProducto.Crear, .. AccionesProducto.VerDesdeFicha,
                                  new AccionPagina("Eliminar", IconosModulo.Lista, id => BuildListUrl(deleteId: Guid.Parse(id!)), ApplicationPolicies.CanDelete)])" />
    };
    // Campo "Estado de existencia" del panel de filtros y del reporte: el mismo ?estado= que los KPI (with/without).
    private RenderFragment SelectorEstado() => __builder =>
    {
        <select name="estado" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
            <option value="" selected="@(EstadoExistencia is null)">Todos</option>
            <option value="with" selected="@(EstadoExistencia == "with")">Con existencia</option>
            <option value="without" selected="@(EstadoExistencia == "without")">Sin existencia</option>
        </select>
    };
    private string? GetActiveValue(string key, string? value) => ActiveFilterFields.Contains(key) ? EmptyAsNull(value) : null;
    private string? GetFieldValue(string key) => key switch { "codigo" => SearchCodigo, "categoriaCodigo" => SearchCategoriaCodigo, "categoriaNombre" => SearchCategoriaNombre, "unidadMedidaCodigo" => SearchUnidadMedidaCodigo, "unidadMedidaNombre" => SearchUnidadMedidaNombre, "precioVenta" => SearchPrecioVenta, "existencia" => SearchExistencia, "estado" => EstadoExistencia, _ => null };
    private static List<string> ParseActiveFields(string? raw) => string.IsNullOrWhiteSpace(raw) ? [] : [.. raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Where(f => FilterableFields.Any(field => field.Key == f)).Distinct()];
    // Conserva filtros, estado, vista, página y la selección (por defecto el Sel actual; sinSeleccion la quita). Nunca emite ok ni editId.
    private string BuildListUrl(Guid? deleteId=null, bool? showFilters=null, string? view=null, bool? report=null, Guid? sel=null, IReadOnlyList<string>? activeFiltersOverride=null, int? pagina=null, bool sinEstado=false, bool sinSeleccion=false)
    {
        var activeFields = activeFiltersOverride ?? ActiveFilterFields;
        var parameters=new List<string>();
        AddParameter(parameters,"nombre",SearchNombre);
        // Quitar el campo "Estado de existencia" del panel (o "Limpiar todo" con ese campo activo) también quita el estado; con el
        // estado llegado de un KPI sin el campo activo, "Limpiar todo" lo conserva y se quita con la ✕ de su chip.
        var quitaEstado = sinEstado || (ActiveFilterFields.Contains("estado") && !activeFields.Contains("estado"));
        if (!quitaEstado) AddParameter(parameters,"estado",EstadoExistencia);
        if (activeFields.Contains("codigo")) AddParameter(parameters,"codigo",SearchCodigo);
        if (activeFields.Contains("categoriaCodigo")) AddParameter(parameters,"categoriaCodigo",SearchCategoriaCodigo);
        if (activeFields.Contains("categoriaNombre")) AddParameter(parameters,"categoriaNombre",SearchCategoriaNombre);
        if (activeFields.Contains("unidadMedidaCodigo")) AddParameter(parameters,"unidadMedidaCodigo",SearchUnidadMedidaCodigo);
        if (activeFields.Contains("unidadMedidaNombre")) AddParameter(parameters,"unidadMedidaNombre",SearchUnidadMedidaNombre);
        if (activeFields.Contains("precioVenta")) AddParameter(parameters,"precioVenta",SearchPrecioVenta);
        if (activeFields.Contains("existencia")) AddParameter(parameters,"existencia",SearchExistencia);
        if (activeFields.Count > 0) parameters.Add($"filters={Uri.EscapeDataString(string.Join(",", activeFields))}");
        AddParameter(parameters,"view", view ?? View);
        if(showFilters ?? ShowFilters) parameters.Add("showFilters=true");
        if(report ?? ShowReport) parameters.Add("report=true");
        var selEfectiva = sinSeleccion ? null : sel ?? Sel;
        if(selEfectiva.HasValue) AddParameter(parameters,"sel",selEfectiva.Value.ToString());
        if(deleteId.HasValue) AddParameter(parameters,"deleteId",deleteId.Value.ToString());
        var paginaEfectiva = pagina ?? Pagina;
        if (paginaEfectiva > 1) parameters.Add($"pagina={paginaEfectiva}");
        return parameters.Count==0 ? "/productos" : $"/productos?{string.Join("&",parameters)}";
    }
    private static void AddParameter(List<string> parameters,string key,string? value){if(!string.IsNullOrWhiteSpace(value)) parameters.Add($"{key}={Uri.EscapeDataString(value)}");}
    private static string? EmptyAsNull(string? value)=>string.IsNullOrWhiteSpace(value)?null:value;
    private sealed class DeleteConfirmForm{}
}
