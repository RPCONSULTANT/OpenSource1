@page "/setups-contables"
@page "/setups-contables/nuevo"
@page "/setups-contables/{Id:guid}/editar"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.CuentasContables.Dtos
@using OpenSource1.Application.Features.SetupsContables
@using OpenSource1.Application.Features.SetupsContables.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@using OpenSource1.Core.Enums
@inject ISetupContableApiClient SetupApiClient
@inject IGrupoContableApiClient GrupoContableApiClient
@inject IAlmacenApiClient AlmacenApiClient
@inject ICuentaContableApiClient CuentaContableApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<SetupsContables> Logger
@inject NavigationManager Nav

@*
    Mantenimiento de los tres setups contables (Task 5.4) con selector de tipo en ?tipo=general|iva|inventario (texto, no enum:
    [SupplyParameterFromQuery] no admite enums). Un solo formulario para los tres tipos (SetupContableForm): el eje secundario
    vacío es el COMODÍN ("cualquiera") y las cuentas van en ranuras cuyo rótulo da el tipo. Los formularios hacen POST a la URL
    vigente, así que el tipo viaja con ellos. Si las opciones (grupos, almacenes o cuentas) no cargan, no se puede guardar.

    Fix-Features B2b, variante "mismo componente": el alta (/setups-contables/nuevo?tipo=…) y la edición
    (/setups-contables/{id}/editar?tipo=…) se sirven como página-tarjeta desde ESTE componente, porque comparten con el listado
    CargarOpcionesAsync (también alimenta los filtros), LeerAsync (también lo usa el borrado) y los records Ranura/Vigente/Fila.
    En la página-tarjeta los dos EditForm (save/update) están SIEMPRE en el árbol (vacíos si el permiso o la rama los ocultan);
    en el listado ya no existen.
*@

@if (!EsPaginaTarjeta)
{
    <PageTitle>Setups contables – AxionERP</PageTitle>

    <PageToolbar Titulo="@Descriptor.NombrePlural" Migas="@([new("Configuración", "/modulos/configuracion"), new(Descriptor.NombrePlural)])" Permisos="@permisos"
                 Subtitulo="Intersecciones de grupos de las que se derivan las cuentas al postear. Un eje vacío (cualquiera) es el comodín: se usa cuando no hay una fila exacta."
                 NuevoHref="@RetornoLocal.ConRetorno($"/setups-contables/nuevo?tipo={Descriptor.Ruta}", UrlActual)"
                 SeleccionId="@SeleccionValida?.ToString()"
                 EditarUrl="@(id => EditarUrl(Guid.Parse(id)))"
                 EliminarUrl="@(id => BuildListUrl(deleteId: Guid.Parse(id)))" />

    @* ── Selector de tipo ── *@
    <nav class="mb-6 flex flex-wrap gap-2" aria-label="Tipo de setup contable" data-testid="selector-tipo">
        @foreach (var descriptor in TiposSetupContable.Todos)
        {
            var activo = descriptor.Tipo == Tipo;
            <a href="/setups-contables?tipo=@descriptor.Ruta" aria-current="@(activo ? "page" : null)"
               class="@(activo ? "rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white shadow-sm" : "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50")">
                @descriptor.NombrePlural
            </a>
        }
    </nav>

    if (tipoInvalido)
    {
        <div class="mb-6"><MessageBox Type="warning" Message="@($"El tipo de setup '{TipoRuta}' no existe; se muestra el {Descriptor.NombrePlural.ToLowerInvariant()}.")" /></div>
    }

    if (opcionesCargaFallida)
    {
        <div class="mb-6"><MessageBox Type="warning" Message="No fue posible cargar los grupos o almacenes de los filtros; recargue la página." /></div>
    }

    if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="mb-6">
            @if (messageType == "success")
            {
                <ActionFeedback Type="success" Message="@message" />
            }
            else
            {
                <MessageBox Type="@messageType" Message="@message" Errors="@errores" />
            }
        </div>
    }

    @* ── Filtros ── *@
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
        <form method="get" action="/setups-contables" data-enhance class="p-4 sm:p-6">
            <input type="hidden" name="tipo" value="@Descriptor.Ruta" />
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2 max-w-3xl">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroSecundario">@Descriptor.RotuloSecundario</label>
                        <select id="filtroSecundario" name="secundario" class="@FiltroCss">
                            <option value="" selected="@(FiltroSecundario is null)">— Todos —</option>
                            @OpcionesEje(opcionesSecundario, FiltroSecundario, null)
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroPrincipal">@Descriptor.RotuloPrincipal</label>
                        <select id="filtroPrincipal" name="principal" class="@FiltroCss">
                            <option value="" selected="@(FiltroPrincipal is null)">— Todos —</option>
                            @OpcionesEje(opcionesPrincipal, FiltroPrincipal, null)
                        </select>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Consultar</button>
                    <a href="@($"/setups-contables?tipo={Descriptor.Ruta}")" title="Limpiar campos" class="btn-press inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Limpiar campos</a>
                </div>
            </div>
        </form>
    </div>

    @* ── Tabla ── *@
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="text-sm font-semibold text-slate-700">@Descriptor.NombrePlural</h2>
            <p class="mt-1 text-xs text-slate-500">@total resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1).</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3"><span class="sr-only">Seleccionar</span></th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Descriptor.RotuloPrincipal</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Descriptor.RotuloSecundario</th>
                        @if (Tipo == TipoSetupContable.Iva)
                        {
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">IVA</th>
                        }
                        @foreach (var ranura in Ranuras)
                        {
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@ranura.Rotulo</th>
                        }
                        <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 bg-white">
                    @if (filas.Count == 0)
                    {
                        <tr><td colspan="@(Ranuras.Count + (Tipo == TipoSetupContable.Iva ? 5 : 4))" class="px-6 py-8 text-center text-slate-400 text-sm">No hay setups registrados con esos criterios.</td></tr>
                    }
                    else
                    {
                        @foreach (var fila in filas)
                        {
                            var marcada = fila.Id == SeleccionValida;
                            <tr @key="fila.Id" class="@SeleccionFila.ClaseFila transition-colors @(marcada ? SeleccionFila.ClaseFilaSeleccionada : null)">
                                <td class="px-4 py-3"><SeleccionFila Href="@BuildListUrl(sel: fila.Id)" Seleccionada="@marcada" Etiqueta="@($"{fila.Principal} × {fila.Secundario ?? "cualquiera"}")" /></td>
                                <td class="px-6 py-3 font-mono text-xs font-semibold text-brand-700">@fila.Principal</td>
                                <td class="px-6 py-3 font-mono text-xs @(fila.Secundario is null ? "italic text-slate-400" : "text-slate-700")">@(fila.Secundario ?? "cualquiera")</td>
                                @if (Tipo == TipoSetupContable.Iva)
                                {
                                    <td class="px-6 py-3 text-xs text-slate-700">@fila.Detalle</td>
                                }
                                @foreach (var cuenta in fila.Cuentas)
                                {
                                    <td class="px-6 py-3 text-xs text-slate-600">@cuenta</td>
                                }
                                <td class="px-6 py-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (canModify)
                                        {
                                            <a href="@EditarUrl(fila.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-amber-200 bg-amber-50 text-amber-600 hover:bg-amber-100" title="Editar setup">✎</a>
                                        }
                                        @if (canDelete)
                                        {
                                            <a href="@BuildListUrl(deleteId: fila.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100" title="Eliminar setup">🗑</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (totalPaginas > 1)
        {
            <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
                <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
                <div class="flex items-center gap-2">
                    @if (Pagina > 1)
                    {
                        <a href="@BuildListUrl(pagina: Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                    }
                    @if (Pagina < totalPaginas)
                    {
                        <a href="@BuildListUrl(pagina: Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                    }
                </div>
            </div>
        }
    </div>

    if (DeleteId.HasValue && canDelete)
    {
        <ConfirmDialog Title="Confirmar eliminación" Message="@($"Esta acción eliminará la fila seleccionada del {Descriptor.NombrePlural.ToLowerInvariant()} y no se puede deshacer.")" Variant="danger" CancelHref="@UrlActual">
            <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-mono text-red-900">@(filaABorrar is null ? DeleteId.Value.ToString() : $"{filaABorrar.Principal} × {filaABorrar.Secundario ?? "cualquiera"}")</p>
            <EditForm Model="DeleteInput" FormName="delete-setup-contable" OnValidSubmit="DeleteAsync" class="mt-4">
                <input type="hidden" name="DeleteInput.Id" value="@DeleteId" />
                <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, eliminar</button>
                <a href="@UrlActual" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
            </EditForm>
        </ConfirmDialog>
    }
    else
    {
        @* Diálogo oculto (sin CanDelete o sin deleteId): EditForm vacío con el MISMO FormName para que un POST obsoleto o
           forzado llegue al handler y reciba el mensaje real de la API, no el 400 genérico de Blazor. *@
        <EditForm Model="DeleteInput" FormName="delete-setup-contable" OnValidSubmit="DeleteAsync"></EditForm>
    }
}
else
{
    <EntityFormPage Titulo="@(EsPaginaEdicion ? $"Modificar fila del {Descriptor.NombrePlural.ToLowerInvariant()}" : $"Agregar fila al {Descriptor.NombrePlural.ToLowerInvariant()}")"
                    Migas="@([new("Configuración", "/modulos/configuracion"), new(Descriptor.NombrePlural, Volver), new(EsPaginaEdicion ? "Modificar" : "Nueva")])"
                    Mensaje="@message" TipoMensaje="@messageType" Errores="@errores">
        @if (tipoInvalido)
        {
            <div class="mb-4"><MessageBox Type="warning" Message="@($"El tipo de setup '{TipoRuta}' no existe; se usa el {Descriptor.NombrePlural.ToLowerInvariant()}.")" /></div>
        }
        @if (EsPaginaEdicion ? !canModify : !canAdd)
        {
            <MessageBox Type="warning" Message="No tiene permiso para realizar esta acción." />
        }
        else if (EsPaginaEdicion && vigente is null)
        {
            @* Si la carga falló no se sabe si existe: solo el aviso de fallo (Mensaje), no el de "no encontrado". *@
            @if (!edicionCargaFallida)
            {
                <MessageBox Type="warning" Message="No se encontró el setup seleccionado. Puede haber sido eliminado por otro usuario." />
            }
        }
        else
        {
            @if (opcionesCargaFallida)
            {
                <div class="mb-4"><MessageBox Type="danger" Message="No fue posible cargar los grupos, almacenes o cuentas contables. Por seguridad no se puede agregar ni modificar un setup hasta que carguen; recargue la página." /></div>
            }
            @if (EsPaginaEdicion)
            {
                <EditForm Model="UpdateInput" FormName="update-setup-contable" OnValidSubmit="UpdateAsync" Enhance="true">
                    <DataAnnotationsValidator />
                    <input type="hidden" name="UpdateInput.Id" value="@UpdateInput!.Id" />
                    <input type="hidden" name="UpdateInput.Xmin" value="@UpdateInput.Xmin" />
                    @Campos(UpdateInput, "UpdateInput", vigente)
                    <FormularioAcciones CancelarHref="@Volver" LimpiarHref="@Nav.Uri" TextoGuardar="Guardar cambios" Deshabilitado="@opcionesCargaFallida" />
                </EditForm>
            }
            else
            {
                <EditForm Model="SaveInput" FormName="save-setup-contable" OnValidSubmit="CreateAsync" Enhance="true">
                    <DataAnnotationsValidator />
                    @Campos(SaveInput!, "SaveInput", null)
                    <FormularioAcciones CancelarHref="@Volver" LimpiarHref="@Nav.Uri" Deshabilitado="@opcionesCargaFallida" />
                </EditForm>
            }
        }
    </EntityFormPage>

    @if (!(EsPaginaAlta && canAdd))
    {
        <EditForm Model="SaveInput" FormName="save-setup-contable" OnValidSubmit="CreateAsync"></EditForm>
    }
    @if (!(EsPaginaEdicion && canModify && vigente is not null))
    {
        <EditForm Model="UpdateInput" FormName="update-setup-contable" OnValidSubmit="UpdateAsync"></EditForm>
    }
}

@code {
    private const string InputCss = "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20";
    private const string FiltroCss = "block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20";

    /// <summary>Ranura de cuenta del formulario: su número (Cuenta1Id..Cuenta4Id), rótulo y si es obligatoria para el tipo.</summary>
    private sealed record Ranura(int Numero, string Rotulo, bool Obligatoria);

    /// <summary>Fila de la tabla, común a los tres tipos. <c>Secundario</c> null = comodín.</summary>
    private sealed record Fila(Guid Id, string Principal, string? Secundario, IReadOnlyList<string> Cuentas, string? Detalle);

    /// <summary>La fila en edición tal como está guardada: rotula los valores vigentes aunque ya no sean elegibles.</summary>
    private sealed record Vigente(Guid? SecundarioId, string? SecundarioCodigo, Guid PrincipalId, string PrincipalCodigo, IReadOnlyDictionary<int, (Guid? Id, string? Numero, string? Nombre)> Cuentas);

    private static readonly IReadOnlyDictionary<TipoSetupContable, IReadOnlyList<Ranura>> RanurasPorTipo = new Dictionary<TipoSetupContable, IReadOnlyList<Ranura>>
    {
        [TipoSetupContable.General] = [new(1, "Ventas", true), new(2, "Costo de ventas", true), new(3, "Descuentos sobre ventas", true), new(4, "Ajuste de inventario", true)],
        [TipoSetupContable.Iva] = [new(1, "IVA en ventas", true), new(2, "IVA en compras", false)],
        [TipoSetupContable.Inventario] = [new(1, "Inventario", true), new(2, "Ajuste de inventario", true), new(3, "Variación de costo", true)],
    };

    [SupplyParameterFromForm(FormName = "save-setup-contable")]
    private SetupContableForm? SaveInput { get; set; }

    [SupplyParameterFromForm(FormName = "update-setup-contable")]
    private SetupContableForm? UpdateInput { get; set; }

    [SupplyParameterFromForm(FormName = "delete-setup-contable")]
    private DeleteForm? DeleteInput { get; set; }

    [SupplyParameterFromQuery(Name = "tipo")]
    private string? TipoRuta { get; set; }

    [SupplyParameterFromQuery(Name = "secundario")]
    private Guid? FiltroSecundario { get; set; }

    [SupplyParameterFromQuery(Name = "principal")]
    private Guid? FiltroPrincipal { get; set; }

    /// <summary>Id de la ruta /setups-contables/{id}/editar (página-tarjeta de edición).</summary>
    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    // Solo para redirigir la ruta antigua ?editId= al editor en página propia.
    [SupplyParameterFromQuery(Name = "editId")]
    private Guid? EditId { get; set; }

    // Tolerante (ola final Fix-Features): un ?sel= ilegible se ignora como selección vacía; con Guid? el binder lanzaría.
    [SupplyParameterFromQuery(Name = "sel")]
    private string? SelTexto { get; set; }
    private Guid? Sel => InventarioVistasOpciones.ParseGuid(SelTexto);

    [SupplyParameterFromQuery(Name = "deleteId")]
    private Guid? DeleteId { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int Pagina { get; set; } = 1;

    // Tipo vigente: el de ?tipo= si existe; si falta o no existe, el general.
    private TipoSetupContable Tipo => TiposSetupContable.DesdeRuta(TipoRuta) ?? TipoSetupContable.General;
    private TiposSetupContable.Descriptor Descriptor => TiposSetupContable.De(Tipo);
    private IReadOnlyList<Ranura> Ranuras => RanurasPorTipo[Tipo];
    private bool tipoInvalido;
    /// <summary>La carga de la fila a modificar falló (API caída): no se sabe si existe, así que no se dice "no encontrado".</summary>
    private bool edicionCargaFallida;

    private bool EsPaginaAlta => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/').EndsWith("setups-contables/nuevo", StringComparison.OrdinalIgnoreCase);
    private bool EsPaginaEdicion => Id.HasValue;
    private bool EsPaginaTarjeta => EsPaginaAlta || EsPaginaEdicion;
    // Vuelta de la página-tarjeta: el returnUrl local (sin transitorios) o la lista del tipo vigente.
    private string Volver => RetornoLocal.Volver(ReturnUrl, $"/setups-contables?tipo={Descriptor.Ruta}");
    // Selección obsoleta (no está en la página cargada) => null: la barra deshabilita Editar/Eliminar.
    private Guid? SeleccionValida => Sel is { } s && filas.Any(f => f.Id == s) ? s : null;
    private string UrlActual => RetornoLocal.SinTransitorios(BuildListUrl());
    private string EditarUrl(Guid id) => RetornoLocal.ConRetorno($"/setups-contables/{id}/editar?tipo={Descriptor.Ruta}", UrlActual);

    private IReadOnlyList<Fila> filas = [];
    private Fila? filaABorrar;
    private Vigente? vigente;
    private IReadOnlyList<GrupoOpcion> opcionesSecundario = [];
    private IReadOnlyList<GrupoOpcion> opcionesPrincipal = [];
    // Cuentas elegibles: de Posteo y no bloqueadas (las únicas que la API acepta al asignar o cambiar una cuenta).
    private IReadOnlyList<CuentaContableResponse> cuentas = [];
    private bool opcionesCargaFallida;
    private long total;
    private int totalPaginas;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string> errores = [];
    private PermisosPagina? permisos;
    private bool canAdd;
    private bool canModify;
    private bool canDelete;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (EditId is { } editId)
        {
            Nav.NavigateTo(RetornoLocal.ConRetorno($"/setups-contables/{editId}/editar?tipo={Descriptor.Ruta}", UrlActual), replace: true);
            return;
        }

        SaveInput ??= new();
        UpdateInput ??= new();
        DeleteInput ??= new();
        tipoInvalido = !string.IsNullOrWhiteSpace(TipoRuta) && TiposSetupContable.DesdeRuta(TipoRuta) is null;

        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);
        canAdd = permisos.CanAdd;
        canModify = permisos.CanModify;
        canDelete = permisos.CanDelete;

        // En la página-tarjeta sin permiso solo se muestra el aviso: no se piden opciones (el POST forzado no las necesita).
        if (!EsPaginaTarjeta || (EsPaginaEdicion ? canModify : canAdd))
        {
            await CargarOpcionesAsync();
        }

        if (EsPaginaTarjeta)
        {
            await CargarEdicionAsync();
            return;
        }

        await LoadAsync();

        if (Ok is not null)
        {
            (messageType, message) = Ok switch
            {
                "created" => ("success", "Setup contable agregado satisfactoriamente."),
                "updated" => ("success", "Setup contable modificado satisfactoriamente."),
                "deleted" => ("success", "Setup contable eliminado satisfactoriamente."),
                _ => ("info", null)
            };
        }

        if (DeleteId.HasValue && canDelete)
        {
            try
            {
                filaABorrar = (await LeerAsync(DeleteId.Value)).Fila;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load setup contable {DeleteId} from API.", DeleteId);
            }
        }
    }

    /// <summary>Página-tarjeta de edición: la fila guardada (valores vigentes) y, si no llegó un formulario, el formulario relleno.</summary>
    private async Task CargarEdicionAsync()
    {
        if (Id is not { } id || !canModify)
        {
            return;
        }

        try
        {
            var (_, guardado, formulario) = await LeerAsync(id);
            vigente = guardado;
            // Solo se rellena con lo guardado cuando NO llegó un formulario de modificación.
            if (formulario is not null && UpdateInput!.Id == Guid.Empty)
            {
                UpdateInput = formulario;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load setup contable {Id} from API.", id);
            edicionCargaFallida = true;
            Show("danger", "No fue posible cargar el setup a modificar.");
        }
    }

    /// <summary>Opciones de los dos ejes (siempre: también las usan los filtros) y, en la página-tarjeta con permiso, las cuentas elegibles.</summary>
    private async Task CargarOpcionesAsync()
    {
        using var cts = new CancellationTokenSource(ProductoOpciones.TiempoMaximo);
        try
        {
            var (secundario, principal) = Tipo switch
            {
                TipoSetupContable.General => (TipoGrupoContable.Negocio, TipoGrupoContable.Producto),
                TipoSetupContable.Iva => (TipoGrupoContable.IvaNegocio, TipoGrupoContable.IvaProducto),
                _ => ((TipoGrupoContable?)null, TipoGrupoContable.Inventario)
            };

            opcionesPrincipal = GruposOpciones.Mapear(await GrupoContableApiClient.ListAllAsync(principal, cts.Token));
            opcionesSecundario = secundario is { } tipoSecundario
                ? GruposOpciones.Mapear(await GrupoContableApiClient.ListAllAsync(tipoSecundario, cts.Token))
                : await CargarAlmacenesAsync(cts.Token);

            if (EsPaginaTarjeta && (EsPaginaEdicion ? canModify : canAdd))
            {
                var todas = new List<CuentaContableResponse>();
                var filtro = new CuentaContableSearchFilter(null, null, TipoCuentaContable.Posteo, null, Bloqueada: false);
                for (var pagina = 1; ; pagina++)
                {
                    var resultado = await CuentaContableApiClient.ListAsync(filtro, new PageRequest(pagina, PageRequest.TamanoMaximo, "Numero", Descendente: false), cts.Token);
                    todas.AddRange(resultado.Items);
                    if (resultado.Items.Count == 0 || pagina >= resultado.TotalPaginas)
                    {
                        break;
                    }
                }

                cuentas = todas;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load setup contable options from API.");
            opcionesCargaFallida = true;
        }
    }

    private async Task<IReadOnlyList<GrupoOpcion>> CargarAlmacenesAsync(CancellationToken cancellationToken)
    {
        var todos = new List<GrupoOpcion>();
        for (var pagina = 1; ; pagina++)
        {
            var resultado = await AlmacenApiClient.ListAsync(null, new PageRequest(pagina, PageRequest.TamanoMaximo, "Codigo", Descendente: false), cancellationToken);
            todos.AddRange(resultado.Items.Select(a => new GrupoOpcion(a.Id, a.Codigo, a.Nombre)));
            if (resultado.Items.Count == 0 || pagina >= resultado.TotalPaginas)
            {
                return todos;
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            if (Pagina < 1) Pagina = 1;
            var pagina = await ListarAsync();
            if (pagina.TotalPaginas == 0)
            {
                Pagina = 1;
            }
            else if (Pagina > pagina.TotalPaginas)
            {
                Pagina = pagina.TotalPaginas;
                pagina = await ListarAsync();
            }

            filas = pagina.Items;
            total = pagina.Total;
            totalPaginas = pagina.TotalPaginas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load setups contables from API.");
            Show("danger", "No fue posible cargar los setups contables.");
        }
    }

    private async Task<PagedResult<Fila>> ListarAsync()
    {
        // Descendente: false explícito (el default de PageRequest es true); la API ordena por el eje principal y el comodín primero.
        var peticion = new PageRequest(Pagina, PageRequest.TamanoPorDefecto, Descendente: false);
        return Tipo switch
        {
            TipoSetupContable.General => Mapear(await SetupApiClient.ListAsync<SetupGeneralResponse>(Tipo, FiltroSecundario, FiltroPrincipal, peticion), AFila),
            TipoSetupContable.Iva => Mapear(await SetupApiClient.ListAsync<SetupIvaResponse>(Tipo, FiltroSecundario, FiltroPrincipal, peticion), AFila),
            _ => Mapear(await SetupApiClient.ListAsync<SetupInventarioResponse>(Tipo, FiltroSecundario, FiltroPrincipal, peticion), AFila),
        };
    }

    private static PagedResult<Fila> Mapear<T>(PagedResult<T> pagina, Func<T, Fila> mapa) =>
        new([.. pagina.Items.Select(mapa)], pagina.Pagina, pagina.TamanoPagina, pagina.Total);

    /// <summary>La fila guardada: su fila de tabla, sus valores vigentes y el formulario de edición relleno (null si no existe).</summary>
    private async Task<(Fila? Fila, Vigente? Vigente, SetupContableForm? Formulario)> LeerAsync(Guid id)
    {
        switch (Tipo)
        {
            case TipoSetupContable.General:
                var g = await SetupApiClient.GetByIdAsync<SetupGeneralResponse>(Tipo, id);
                return g is null ? default : (AFila(g), new Vigente(g.GrupoNegocioId, g.GrupoNegocioCodigo, g.GrupoProductoId, g.GrupoProductoCodigo, new Dictionary<int, (Guid?, string?, string?)>
                {
                    [1] = (g.CuentaVentasId, g.CuentaVentasNumero, g.CuentaVentasNombre),
                    [2] = (g.CuentaCostoVentasId, g.CuentaCostoVentasNumero, g.CuentaCostoVentasNombre),
                    [3] = (g.CuentaDescuentoVentasId, g.CuentaDescuentoVentasNumero, g.CuentaDescuentoVentasNombre),
                    [4] = (g.CuentaAjusteInventarioId, g.CuentaAjusteInventarioNumero, g.CuentaAjusteInventarioNombre),
                }), new SetupContableForm
                {
                    Id = g.Id, Xmin = g.Xmin, SecundarioId = g.GrupoNegocioId, PrincipalId = g.GrupoProductoId,
                    Cuenta1Id = g.CuentaVentasId, Cuenta2Id = g.CuentaCostoVentasId, Cuenta3Id = g.CuentaDescuentoVentasId, Cuenta4Id = g.CuentaAjusteInventarioId
                });
            case TipoSetupContable.Iva:
                var i = await SetupApiClient.GetByIdAsync<SetupIvaResponse>(Tipo, id);
                return i is null ? default : (AFila(i), new Vigente(i.GrupoIvaNegocioId, i.GrupoIvaNegocioCodigo, i.GrupoIvaProductoId, i.GrupoIvaProductoCodigo, new Dictionary<int, (Guid?, string?, string?)>
                {
                    [1] = (i.CuentaIvaVentasId, i.CuentaIvaVentasNumero, i.CuentaIvaVentasNombre),
                    [2] = (i.CuentaIvaComprasId, i.CuentaIvaComprasNumero, i.CuentaIvaComprasNombre),
                }), new SetupContableForm
                {
                    Id = i.Id, Xmin = i.Xmin, SecundarioId = i.GrupoIvaNegocioId, PrincipalId = i.GrupoIvaProductoId,
                    Cuenta1Id = i.CuentaIvaVentasId, Cuenta2Id = i.CuentaIvaComprasId, PorcentajeIvaTexto = SetupContableForm.FormatearPorcentaje(i.PorcentajeIva),
                    IdentificadorIva = i.IdentificadorIva, TipoCalculoIva = (int)i.TipoCalculoIva
                });
            default:
                var v = await SetupApiClient.GetByIdAsync<SetupInventarioResponse>(Tipo, id);
                return v is null ? default : (AFila(v), new Vigente(v.AlmacenId, v.AlmacenCodigo, v.GrupoInventarioId, v.GrupoInventarioCodigo, new Dictionary<int, (Guid?, string?, string?)>
                {
                    [1] = (v.CuentaInventarioId, v.CuentaInventarioNumero, v.CuentaInventarioNombre),
                    [2] = (v.CuentaAjusteInventarioId, v.CuentaAjusteInventarioNumero, v.CuentaAjusteInventarioNombre),
                    [3] = (v.CuentaVariacionCostoId, v.CuentaVariacionCostoNumero, v.CuentaVariacionCostoNombre),
                }), new SetupContableForm
                {
                    Id = v.Id, Xmin = v.Xmin, SecundarioId = v.AlmacenId, PrincipalId = v.GrupoInventarioId,
                    Cuenta1Id = v.CuentaInventarioId, Cuenta2Id = v.CuentaAjusteInventarioId, Cuenta3Id = v.CuentaVariacionCostoId
                });
        }
    }

    private static Fila AFila(SetupGeneralResponse x) => new(x.Id, x.GrupoProductoCodigo, Eje(x.GrupoNegocioId, x.GrupoNegocioCodigo),
        [Cuenta(x.CuentaVentasNumero, x.CuentaVentasNombre), Cuenta(x.CuentaCostoVentasNumero, x.CuentaCostoVentasNombre),
         Cuenta(x.CuentaDescuentoVentasNumero, x.CuentaDescuentoVentasNombre), Cuenta(x.CuentaAjusteInventarioNumero, x.CuentaAjusteInventarioNombre)], null);

    private static Fila AFila(SetupIvaResponse x) => new(x.Id, x.GrupoIvaProductoCodigo, Eje(x.GrupoIvaNegocioId, x.GrupoIvaNegocioCodigo),
        [Cuenta(x.CuentaIvaVentasNumero, x.CuentaIvaVentasNombre), x.CuentaIvaComprasId is null ? "—" : Cuenta(x.CuentaIvaComprasNumero, x.CuentaIvaComprasNombre)],
        $"{SetupContableForm.FormatearPorcentaje(x.PorcentajeIva)} % · {x.IdentificadorIva} · {(x.TipoCalculoIva == TipoCalculoIva.Exento ? "Exento" : "Normal")}");

    private static Fila AFila(SetupInventarioResponse x) => new(x.Id, x.GrupoInventarioCodigo, Eje(x.AlmacenId, x.AlmacenCodigo),
        [Cuenta(x.CuentaInventarioNumero, x.CuentaInventarioNombre), Cuenta(x.CuentaAjusteInventarioNumero, x.CuentaAjusteInventarioNombre),
         Cuenta(x.CuentaVariacionCostoNumero, x.CuentaVariacionCostoNombre)], null);

    // Eje secundario: null = comodín; un Id cuyo código ya no se encuentra (grupo borrado) se señala.
    private static string? Eje(Guid? id, string? codigo) => id is null ? null : string.IsNullOrWhiteSpace(codigo) ? "(no disponible)" : codigo;

    private static string Cuenta(string? numero, string? nombre) => string.IsNullOrWhiteSpace(numero) ? "No disponible" : $"{numero} — {nombre}";

    private RenderFragment Campos(SetupContableForm model, string prefix, Vigente? actual) => __builder =>
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{prefix}_PrincipalId")">@Descriptor.RotuloPrincipal <span class="text-red-500">*</span></label>
                <select id="@($"{prefix}_PrincipalId")" name="@($"{prefix}.PrincipalId")" class="@InputCss">
                    <option value="" selected="@(model.PrincipalId is null)">— Seleccione —</option>
                    @OpcionesEje(opcionesPrincipal, model.PrincipalId, actual is null ? null : (actual.PrincipalId, actual.PrincipalCodigo))
                </select>
                <ValidationMessage For="() => model.PrincipalId" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{prefix}_SecundarioId")">@Descriptor.RotuloSecundario</label>
                <select id="@($"{prefix}_SecundarioId")" name="@($"{prefix}.SecundarioId")" class="@InputCss">
                    <option value="" selected="@(model.SecundarioId is null)">— Cualquiera (comodín) —</option>
                    @OpcionesEje(opcionesSecundario, model.SecundarioId, actual?.SecundarioId is { } s ? (s, actual.SecundarioCodigo) : null)
                </select>
            </div>
        </div>
        @if (Tipo == TipoSetupContable.Iva)
        {
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{prefix}_PorcentajeIvaTexto")">Porcentaje de IVA <span class="text-red-500">*</span></label>
                    <input id="@($"{prefix}_PorcentajeIvaTexto")" type="text" inputmode="decimal" name="@($"{prefix}.PorcentajeIvaTexto")" value="@model.PorcentajeIvaTexto" placeholder="18.00" class="@InputCss" />
                    <ValidationMessage For="() => model.PorcentajeIvaTexto" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{prefix}_IdentificadorIva")">Identificador <span class="text-red-500">*</span></label>
                    <input id="@($"{prefix}_IdentificadorIva")" type="text" name="@($"{prefix}.IdentificadorIva")" value="@model.IdentificadorIva" placeholder="ej. ITBIS18" maxlength="20" class="@InputCss" />
                    <ValidationMessage For="() => model.IdentificadorIva" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{prefix}_TipoCalculoIva")">Tipo de cálculo</label>
                    <select id="@($"{prefix}_TipoCalculoIva")" name="@($"{prefix}.TipoCalculoIva")" class="@InputCss">
                        <option value="@((int)TipoCalculoIva.Normal)" selected="@(model.TipoCalculoIva == (int)TipoCalculoIva.Normal)">Normal</option>
                        <option value="@((int)TipoCalculoIva.Exento)" selected="@(model.TipoCalculoIva == (int)TipoCalculoIva.Exento)">Exento (porcentaje 0)</option>
                    </select>
                </div>
            </div>
        }
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            @foreach (var ranura in Ranuras)
            {
                var seleccion = model.Cuenta(ranura.Numero);
                var cuentaVigente = actual is not null && actual.Cuentas.TryGetValue(ranura.Numero, out var c) ? c : default;
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{prefix}_Cuenta{ranura.Numero}Id")">Cuenta de @ranura.Rotulo.ToLowerInvariant() @if (ranura.Obligatoria) {<span class="text-red-500">*</span>}</label>
                    <select id="@($"{prefix}_Cuenta{ranura.Numero}Id")" name="@($"{prefix}.Cuenta{ranura.Numero}Id")" class="@InputCss">
                        <option value="" selected="@(seleccion is null)">@(ranura.Obligatoria ? "— Seleccione —" : "— Ninguna —")</option>
                        @if (seleccion is { } id && cuentas.All(x => x.Id != id))
                        {
                            <option value="@id" selected="selected">@(cuentaVigente.Id == id && !string.IsNullOrWhiteSpace(cuentaVigente.Numero) ? $"{cuentaVigente.Numero} — {cuentaVigente.Nombre} (no elegible)" : $"Cuenta no disponible ({id})")</option>
                        }
                        @foreach (var cuenta in cuentas)
                        {
                            <option value="@cuenta.Id" selected="@(cuenta.Id == seleccion)">@cuenta.Numero — @cuenta.Nombre</option>
                        }
                    </select>
                </div>
            }
        </div>
        <p class="mt-2 text-xs text-slate-400">Solo se ofrecen cuentas de posteo no bloqueadas. Deje el @Descriptor.RotuloSecundario.ToLowerInvariant() en «Cualquiera» para la fila comodín.</p>
    };

    // El valor seleccionado se ofrece SIEMPRE aunque ya no esté entre las opciones (grupo/almacén borrado): sin esto el <select> no
    // reflejaría el valor guardado y guardar lo cambiaría en silencio.
    private RenderFragment OpcionesEje(IReadOnlyList<GrupoOpcion> opciones, Guid? seleccion, (Guid Id, string? Codigo)? actual) => __builder =>
    {
        if (seleccion is { } id && opciones.All(o => o.Id != id))
        {
            <option value="@id" selected="selected">@(actual?.Id == id && !string.IsNullOrWhiteSpace(actual?.Codigo) ? $"{actual?.Codigo} (no disponible)" : $"No disponible ({id})")</option>
        }
        foreach (var opcion in opciones)
        {
            <option value="@opcion.Id" selected="@(opcion.Id == seleccion)">@opcion.Rotulo</option>
        }
    };

    private string BuildListUrl(int? pagina = null, Guid? sel = null, Guid? deleteId = null)
    {
        var parameters = new List<string> { $"tipo={Descriptor.Ruta}" };
        if (FiltroSecundario.HasValue) parameters.Add($"secundario={FiltroSecundario.Value}");
        if (FiltroPrincipal.HasValue) parameters.Add($"principal={FiltroPrincipal.Value}");
        var paginaEfectiva = pagina ?? Pagina;
        if (paginaEfectiva > 1) parameters.Add($"pagina={paginaEfectiva}");
        if ((sel ?? Sel) is { } seleccion) parameters.Add($"sel={seleccion}");
        if (deleteId.HasValue) parameters.Add($"deleteId={deleteId.Value}");
        return $"/setups-contables?{string.Join("&", parameters)}";
    }

    /// <summary>Cuerpo de la API para el tipo vigente. Siempre el valor completo: una cuenta obligatoria vacía viaja como Guid vacío (la
    /// API responde "obligatoria") y la de IVA en compras vacía también (en el PUT = quitarla; en el alta = sin cuenta).</summary>
    private object Cuerpo(SetupContableForm f) => Tipo switch
    {
        TipoSetupContable.General => new
        {
            GrupoNegocioId = f.SecundarioId, GrupoProductoId = f.PrincipalId ?? Guid.Empty,
            CuentaVentasId = f.Cuenta1Id ?? Guid.Empty, CuentaCostoVentasId = f.Cuenta2Id ?? Guid.Empty,
            CuentaDescuentoVentasId = f.Cuenta3Id ?? Guid.Empty, CuentaAjusteInventarioId = f.Cuenta4Id ?? Guid.Empty, f.Xmin
        },
        TipoSetupContable.Iva => new
        {
            GrupoIvaNegocioId = f.SecundarioId, GrupoIvaProductoId = f.PrincipalId ?? Guid.Empty, f.PorcentajeIva,
            CuentaIvaVentasId = f.Cuenta1Id ?? Guid.Empty, CuentaIvaComprasId = f.Cuenta2Id ?? Guid.Empty,
            IdentificadorIva = f.IdentificadorIva?.Trim() ?? string.Empty, TipoCalculoIva = (TipoCalculoIva)f.TipoCalculoIva, f.Xmin
        },
        _ => new
        {
            AlmacenId = f.SecundarioId, GrupoInventarioId = f.PrincipalId ?? Guid.Empty,
            CuentaInventarioId = f.Cuenta1Id ?? Guid.Empty, CuentaAjusteInventarioId = f.Cuenta2Id ?? Guid.Empty,
            CuentaVariacionCostoId = f.Cuenta3Id ?? Guid.Empty, f.Xmin
        },
    };

    private async Task CreateAsync()
    {
        // Defensa en profundidad: sin opciones fiables no se envía nada aunque el botón no se haya renderizado.
        if (opcionesCargaFallida) return;
        await ExecuteAsync(() => SetupApiClient.CreateAsync(Tipo, Cuerpo(SaveInput!)), "created");
    }

    private async Task UpdateAsync()
    {
        if (opcionesCargaFallida) return;
        if (Id is not { } id)
        {
            Show("warning", "Seleccione primero un registro a modificar desde la tabla.");
            return;
        }

        await ExecuteAsync(() => SetupApiClient.UpdateAsync(Tipo, id, Cuerpo(UpdateInput!)), "updated");
    }

    private async Task DeleteAsync() => await ExecuteAsync(() => SetupApiClient.DeleteAsync(Tipo, DeleteInput!.Id), "deleted");

    private async Task ExecuteAsync(Func<Task<GrupoOperationResult>> operation, string successCode)
    {
        // La navegación va FUERA del try: si NavigateTo lanza NavigationException (SSR sin el switch que la desactiva),
        // el catch genérico no debe tragársela como un fallo de la operación.
        string? destino = null;
        try
        {
            var result = await operation();
            if (result.Succeeded)
            {
                // Alta/edición vuelven al returnUrl (filtros, página y selección); el borrado, a la lista vigente.
                destino = RetornoLocal.ConParametro(successCode == "deleted" ? UrlActual : Volver, "ok", successCode);
            }
            else
            {
                Show("warning", result.Message, result.Errors);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not complete setup contable operation.");
            Show("danger", "No fue posible completar la operación.");
        }

        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private void Show(string type, string? text, IReadOnlyList<string>? errors = null)
    {
        messageType = type;
        message = text;
        errores = errors ?? [];
    }

    public sealed class DeleteForm
    {
        public Guid Id { get; set; }
    }
