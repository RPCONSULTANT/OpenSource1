@page "/clientes"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Clientes.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@inject IClienteApiClient ClienteApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<Clientes> Logger
@inject NavigationManager Nav

<PageTitle>Clientes – AxionERP</PageTitle>

<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div>
        <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Mantenimiento</p>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Clientes</h1>
        <p class="text-sm text-slate-500 mt-1">Listado principal con búsqueda, filtros y reportería.</p>
    </div>
    <div class="flex items-center gap-3 flex-wrap">
        <a href="@BuildListUrl(view: "grid")" title="Vista cuadrícula" class="btn-press inline-flex items-center justify-center size-10 rounded-lg border shadow-sm @(IsListView ? "border-slate-300 bg-white text-slate-600 hover:bg-slate-50" : "border-brand-200 bg-brand-50 text-brand-700")">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 8.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 8.25 20.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" /></svg>
        </a>
        <a href="@BuildListUrl(view: "list")" title="Vista lista" class="btn-press inline-flex items-center justify-center size-10 rounded-lg border shadow-sm @(IsListView ? "border-brand-200 bg-brand-50 text-brand-700" : "border-slate-300 bg-white text-slate-600 hover:bg-slate-50")">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12m-12 5.25h12m-12 5.25h12M3.75 6.75h.008v.008H3.75V6.75Zm0 5.25h.008v.008H3.75V12Zm0 5.25h.008v.008H3.75v-.008Z" /></svg>
        </a>
        <a href="@BuildListUrl(report: true)" class="btn-press inline-flex items-center gap-2 rounded-lg border border-brand-200 bg-brand-50 px-4 py-2 text-sm font-semibold text-brand-700 shadow-sm hover:bg-brand-100">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 21V5.25A2.25 2.25 0 0 0 17.25 3H6.75A2.25 2.25 0 0 0 4.5 5.25V21m15 0h1.125a1.125 1.125 0 1 0 0-2.25H19.5M4.5 21H3.375a1.125 1.125 0 1 1 0-2.25H4.5m3-13.5h9m-9 4.5h9m-9 4.5h5.25" /></svg>
            Reporte
        </a>
        @if (canAdd)
        {
            <a href="/clientes/new" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                Nuevo
            </a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" />
        }
    </div>
}

<div class="mb-8 grid grid-cols-1 gap-6 items-start @GridColsClass">
    @if (ShowFactbox)
    {
        var factCliente = clientes.FirstOrDefault(x => x.Id == FocusClienteId!.Value);
        <aside class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden sticky top-24">
            <div class="px-5 py-4 border-b border-slate-100 bg-slate-50 flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-sm font-bold uppercase tracking-wide text-slate-800">Factbox</h2>
                    <p class="mt-1 text-xs text-slate-500">Resumen visual del registro enfocado.</p>
                </div>
                <a href="@BuildListUrl()" title="Cerrar factbox" class="btn-press inline-flex items-center justify-center size-7 rounded-lg border border-slate-200 bg-white text-slate-500 hover:bg-slate-50">✕</a>
            </div>
            <div class="p-5">
                @if (factCliente is null)
                {
                    <div class="flex h-48 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-sm text-slate-400">Sin registro</div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(factCliente.ImagePath))
                    {
                        <img src="@factCliente.ImagePath" alt="Imagen del cliente" class="h-48 w-full rounded-2xl object-cover border border-slate-200 bg-slate-50" />
                    }
                    else
                    {
                        <div class="flex h-48 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-sm text-slate-400">Sin imagen</div>
                    }
                    <div class="mt-5 space-y-4 text-sm">
                        <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">General</p><p class="mt-1.5 text-base font-semibold text-slate-800">@factCliente.Nombre @factCliente.Apellido</p></div>
                        <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Correo</p><p class="mt-1 text-slate-700 break-all">@factCliente.Email</p></div>
                        <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Teléfono</p><p class="mt-1 text-slate-700">@(string.IsNullOrWhiteSpace(factCliente.Telefono) ? "No indicado" : factCliente.Telefono)</p></div>
                        <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Dirección</p><p class="mt-1 text-slate-700">@(string.IsNullOrWhiteSpace(factCliente.Direccion) ? "No indicada" : factCliente.Direccion)</p></div>
                    </div>
                }
            </div>
        </aside>
    }

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <form method="get" action="/clientes" data-enhance class="border-b border-slate-100 p-4 sm:p-6">
            <input type="hidden" name="showFilters" value="@(ShowFilters ? "true" : "false")" />
            <input type="hidden" name="view" value="@(View ?? "grid")" />
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                <div class="relative flex-1 max-w-2xl">
                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">🔎</span>
                    <input type="text" name="nombre" value="@SearchNombre" placeholder="Buscar por nombre" class="block w-full rounded-xl border border-slate-300 bg-slate-50 py-3 pl-10 pr-4 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
                <div class="flex items-center gap-3">
                    <button type="submit" title="Buscar" class="btn-press inline-flex items-center justify-center size-11 rounded-lg bg-brand-600 text-white shadow-sm hover:bg-brand-700"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m0 0A7.95 7.95 0 1 0 5.4 5.4a7.95 7.95 0 0 0 11.25 11.25Z" /></svg></button>
                    <a href="@BuildListUrl(showFilters: !ShowFilters)" title="@(ShowFilters ? "Ocultar filtros" : "Filtros")" class="btn-press inline-flex items-center justify-center size-11 rounded-lg border shadow-sm @(ShowFilters ? "border-brand-200 bg-brand-50 text-brand-700" : "border-slate-300 bg-white text-slate-600 hover:bg-slate-50")"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h18M6.75 12h10.5m-7.5 7.5h4.5" /></svg></a>
                    <a href="/clientes" title="Limpiar" class="inline-flex items-center justify-center size-11 rounded-lg border border-slate-300 bg-white text-slate-600 hover:bg-slate-50"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg></a>
                </div>
            </div>
        </form>

        <div class="flex items-center justify-between gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/70">
            <div>
                <h2 class="text-sm font-bold text-slate-800">Listado de clientes</h2>
                <p class="text-xs text-slate-500 mt-0.5">@clientes.Count resultado(s) encontrados.</p>
            </div>
        </div>

        @if (clientes.Count == 0)
        {
            <div class="px-6 py-14 text-center text-slate-400"><p class="font-semibold text-slate-500">No encontramos clientes con esos criterios.</p></div>
        }
        else
        {
            <form id="clientes-report-form" method="post" action="/reports/clientes/selected" class="@(IsListView ? "block" : "grid grid-cols-1 sm:grid-cols-2 2xl:grid-cols-3 gap-4 p-4 sm:p-6")">
                <AntiforgeryToken />
                @if (IsListView)
                {
                    <div class="overflow-x-auto p-4 sm:p-6">
                        <table class="min-w-full divide-y divide-slate-100 text-sm">
                            <thead class="bg-slate-50">
                                <tr>
                                    <th class="px-4 py-3 text-left"><span class="sr-only">Seleccionar</span></th>
                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">ID</th>
                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Nombre</th>
                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Apellido</th>
                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Correo</th>
                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Teléfono</th>
                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Dirección</th>
                                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50 bg-white">
                                @foreach (var cliente in clientes)
                                {
                                    <tr @key="cliente.Id" class="hover:bg-slate-50">
                                        <td class="px-4 py-3"><input type="checkbox" name="SelectedIds" value="@cliente.Id" class="size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-600" /></td>
                                        <td class="px-4 py-3 text-slate-700">@cliente.Id</td>
                                        <td class="px-4 py-3 font-semibold text-slate-800">@cliente.Nombre</td>
                                        <td class="px-4 py-3 text-slate-700">@cliente.Apellido</td>
                                        <td class="px-4 py-3 text-slate-700">@cliente.Email</td>
                                        <td class="px-4 py-3 text-slate-700">@(string.IsNullOrWhiteSpace(cliente.Telefono) ? "—" : cliente.Telefono)</td>
                                        <td class="px-4 py-3 text-slate-700">@(string.IsNullOrWhiteSpace(cliente.Direccion) ? "—" : cliente.Direccion)</td>
                                        <td class="px-4 py-3 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <a href="/clientes/@cliente.Id" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50" title="Ver ficha">👁</a>
                                                @if (canModify)
                                                {
                                                    <a href="/clientes/@cliente.Id?edit=true" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100" title="Editar ficha">✎</a>
                                                }
                                                @if (canDelete)
                                                {
                                                    <a href="@BuildListUrl(deleteId: cliente.Id)" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100" title="Eliminar desde listado">🗑</a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    @foreach (var cliente in clientes)
                    {
                        <article @key="cliente.Id" class="rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md hover:border-brand-200 transition-all duration-200 overflow-hidden">
                            <div class="p-6 lg:p-7">
                                <div class="flex items-start justify-between gap-6">
                                    <div class="flex-1">
                                        <p class="text-xs font-bold uppercase tracking-wide text-slate-400 mb-2">General</p>
                                        <h3 class="text-xl font-extrabold text-slate-900">@cliente.Nombre @cliente.Apellido</h3>
                                        <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                                            <div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4"><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Correo</p><p class="mt-1.5 text-slate-700 break-all">@cliente.Email</p></div>
                                            <div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4"><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Teléfono</p><p class="mt-1.5 text-slate-700">@(string.IsNullOrWhiteSpace(cliente.Telefono) ? "No indicado" : cliente.Telefono)</p></div>
                                            <div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 md:col-span-2"><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Dirección</p><p class="mt-1.5 text-slate-700">@(string.IsNullOrWhiteSpace(cliente.Direccion) ? "No indicada" : cliente.Direccion)</p></div>
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-center gap-2">
                                        <label class="inline-flex items-center justify-center size-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 cursor-pointer" title="Seleccionar para reporte"><input type="checkbox" name="SelectedIds" value="@cliente.Id" class="size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-600" /></label>
                                        <a href="@BuildListUrl(focusId: cliente.Id)" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50" title="Ver resumen">🖼</a>
                                        <a href="/clientes/@cliente.Id" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50" title="Ver ficha">👁</a>
                                        @if (canModify)
                                        {
                                            <a href="/clientes/@cliente.Id?edit=true" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100" title="Editar ficha">✎</a>
                                        }
                                        @if (canDelete)
                                        {
                                            <a href="@BuildListUrl(deleteId: cliente.Id)" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100" title="Eliminar desde listado">🗑</a>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="border-t border-slate-100 px-6 py-4 bg-slate-50/60 flex items-center justify-between gap-3"><p class="text-xs text-slate-400">Actualizado: @(cliente.UpdatedAtUtc?.ToLocalTime().ToString("g") ?? cliente.CreatedAtUtc.ToLocalTime().ToString("g"))</p><div class="flex items-center gap-4"><a href="@BuildListUrl(focusId: cliente.Id)" class="text-sm font-semibold text-slate-600 hover:text-slate-800">Ver resumen</a><a href="/clientes/@cliente.Id" class="text-sm font-semibold text-brand-600 hover:text-brand-700">Abrir ficha</a></div></div>
                        </article>
                    }
                }
            </form>
        }
    </div>

    @if (ShowFilters)
    {
        <aside class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-fade-in sticky top-24">
            <form method="get" action="/clientes" data-enhance class="p-5 space-y-4">
                <input type="hidden" name="showFilters" value="true" />
                <input type="hidden" name="view" value="@(View ?? "grid")" />
                <input type="hidden" name="filters" value="@string.Join(",", ActiveFilterFields)" />
                <div><h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide">Filtros</h2><p class="mt-1 text-xs text-slate-500">Agregue campos a la lista y combine valores con <code>*</code> (comodín), <code>||</code> (o) y <code>&amp;&amp;</code> (y).</p></div>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Nombre</label><input type="text" name="nombre" value="@SearchNombre" placeholder="ej: maria, *car*, juan||maria" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20" /></div>
                @foreach (var field in ActiveFilterFields)
                {
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block text-sm font-semibold text-slate-700">@FieldLabel(field)</label>
                            <a href="@BuildListUrl(activeFiltersOverride: ActiveFilterFields.Where(f => f != field).ToList())" title="Quitar campo" class="text-xs font-semibold text-red-600 hover:text-red-700">✕ quitar</a>
                        </div>
                        <input type="text" name="@field" value="@GetFieldValue(field)" placeholder="ej: maria, *car*, juan||maria, a&&b" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                    </div>
                }
                @if (AvailableFields.Count > 0)
                {
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Agregar campo</label>
                        <select name="addField" onchange="this.form.requestSubmit()" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20">
                            <option value="">-- Seleccionar campo --</option>
                            @foreach (var field in AvailableFields)
                            {
                                <option value="@field.Key">@field.Label</option>
                            }
                        </select>
                    </div>
                }
                <div class="flex items-center gap-3 pt-2"><button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Aplicar</button><a href="@BuildListUrl(activeFiltersOverride: [])" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Limpiar todo</a></div>
            </form>
        </aside>
    }
</div>

@if (ShowReport)
{
    <ConfirmDialog Title="Generar reporte de clientes" Message="Seleccione el filtro para el reporte de clientes seleccionados." Variant="success" CancelHref="@BuildListUrl(report: false)">
        <form method="post" action="/reports/clientes/selected" class="mt-4">
            <AntiforgeryToken />
            @foreach (var cliente in clientes)
            {
                <input type="hidden" name="SelectedIds" value="@cliente.Id" />
            }
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Estado</label>
            <select name="Status" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20">
                <option value="all">Todos</option>
                <option value="active">Activos</option>
                <option value="inactive">Inactivos</option>
            </select>
            <div class="mt-4 flex items-center gap-3"><button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Generar PDF</button><a href="@BuildListUrl(report: false)" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Cancelar</a></div>
        </form>
    </ConfirmDialog>
}

@if (DeleteId.HasValue && canDelete)
{
    var item = clientes.FirstOrDefault(c => c.Id == DeleteId.Value);
    <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará el cliente seleccionado y no se puede deshacer." Variant="danger" CancelHref="@BuildListUrl()"><p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-semibold text-red-900">@((item is null) ? "Cliente seleccionado" : $"{item.Nombre} {item.Apellido}")</p>@if (!string.IsNullOrWhiteSpace(modalError)){<div class="mt-4"><MessageBox Type="warning" Message="@modalError" /></div>}<EditForm Model="DeleteInput" FormName="delete-cliente-list" OnValidSubmit="DeleteAsync" class="mt-4" Enhance="true"><button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">Sí, eliminar</button><a href="@BuildListUrl()" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Cancelar</a></EditForm></ConfirmDialog>
}

@code {
    private static readonly (string Key, string Label)[] FilterableFields =
    [
        ("apellido", "Apellido"),
        ("email", "Correo"),
        ("telefono", "Teléfono"),
        ("direccion", "Dirección"),
    ];

    [SupplyParameterFromQuery(Name = "nombre")] private string? SearchNombre { get; set; }
    [SupplyParameterFromQuery(Name = "apellido")] private string? SearchApellido { get; set; }
    [SupplyParameterFromQuery(Name = "email")] private string? SearchEmail { get; set; }
    [SupplyParameterFromQuery(Name = "telefono")] private string? SearchTelefono { get; set; }
    [SupplyParameterFromQuery(Name = "direccion")] private string? SearchDireccion { get; set; }
    [SupplyParameterFromQuery(Name = "filters")] private string? FiltersRaw { get; set; }
    [SupplyParameterFromQuery(Name = "addField")] private string? AddField { get; set; }
    [SupplyParameterFromQuery(Name = "view")] private string? View { get; set; }
    [SupplyParameterFromQuery(Name = "showFilters")] private bool ShowFilters { get; set; }
    [SupplyParameterFromQuery(Name = "report")] private bool ShowReport { get; set; }
    [SupplyParameterFromQuery(Name = "focusId")] private Guid? FocusClienteId { get; set; }
    [SupplyParameterFromQuery(Name = "deleteId")] private Guid? DeleteId { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    [SupplyParameterFromForm(FormName = "delete-cliente-list")] private DeleteConfirmForm? DeleteInput { get; set; }
    private IReadOnlyList<ClienteResponse> clientes = [];
    private List<string> ActiveFilterFields = [];
    private string? message; private string messageType = "info"; private string? modalError; private bool canAdd; private bool canModify; private bool canDelete; private bool IsListView => string.Equals(View, "list", StringComparison.OrdinalIgnoreCase); private bool ShowFactbox => !IsListView && FocusClienteId.HasValue; [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private string GridColsClass => (ShowFactbox, ShowFilters) switch { (true, true) => "xl:grid-cols-[280px_minmax(0,1fr)_320px]", (true, false) => "xl:grid-cols-[280px_minmax(0,1fr)]", (false, true) => "xl:grid-cols-[minmax(0,1fr)_320px]", (false, false) => "xl:grid-cols-1" };
    private List<(string Key, string Label)> AvailableFields => [.. FilterableFields.Where(f => !ActiveFilterFields.Contains(f.Key))];
    private static string FieldLabel(string key) => FilterableFields.FirstOrDefault(f => f.Key == key).Label ?? key;
    protected override async Task OnInitializedAsync()
    {
        DeleteInput ??= new();
        ActiveFilterFields = ParseActiveFields(FiltersRaw);
        if (!string.IsNullOrWhiteSpace(AddField) && FilterableFields.Any(f => f.Key == AddField) && !ActiveFilterFields.Contains(AddField))
        {
            Nav.NavigateTo(BuildListUrl(activeFiltersOverride: [.. ActiveFilterFields, AddField]), replace: true);
            return;
        }
        if(AuthenticationStateTask is not null){var user=(await AuthenticationStateTask).User; canAdd=(await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanAdd)).Succeeded; canModify=(await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanModify)).Succeeded; canDelete=(await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanDelete)).Succeeded;}
        await LoadAsync();
        if(Ok is not null){(messageType, message)=Ok switch {"created"=>("success","Cliente creado satisfactoriamente."),"updated"=>("success","Cliente modificado satisfactoriamente."),"deleted"=>("success","Cliente eliminado satisfactoriamente."),"report-select-required"=>("warning","Seleccione al menos un cliente para generar el reporte."),"report-no-data"=>("warning","No hay datos para generar el reporte solicitado."),_ =>("info",null)};}
    }
    private async Task LoadAsync(){try{clientes=await ClienteApiClient.ListAsync(new ClienteSearchFilter(EmptyAsNull(SearchNombre), GetActiveValue("apellido", SearchApellido), GetActiveValue("email", SearchEmail), GetActiveValue("telefono", SearchTelefono), GetActiveValue("direccion", SearchDireccion)));} catch(Exception ex){Logger.LogWarning(ex,"Could not load clientes from API."); message="No fue posible cargar los clientes."; messageType="danger";}}
    private async Task DeleteAsync(){if(!DeleteId.HasValue){modalError="No se pudo identificar el cliente. Intente de nuevo."; return;} var result=await ClienteApiClient.DeleteAsync(DeleteId.Value); if(result.Succeeded) Nav.NavigateTo(BuildListUrl(ok:"deleted")); else modalError=result.Message;}
    private string? GetActiveValue(string key, string? value) => ActiveFilterFields.Contains(key) ? EmptyAsNull(value) : null;
    private string? GetFieldValue(string key) => key switch { "apellido" => SearchApellido, "email" => SearchEmail, "telefono" => SearchTelefono, "direccion" => SearchDireccion, _ => null };
    private static List<string> ParseActiveFields(string? raw) => string.IsNullOrWhiteSpace(raw) ? [] : [.. raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Where(f => FilterableFields.Any(field => field.Key == f)).Distinct()];
    private string BuildListUrl(Guid? deleteId = null, bool? showFilters = null, string? ok = null, string? view = null, bool? report = null, Guid? focusId = null, IReadOnlyList<string>? activeFiltersOverride = null)
    {
        var activeFields = activeFiltersOverride ?? ActiveFilterFields;
        var parameters=new List<string>();
        AddParameter(parameters,"nombre",SearchNombre);
        if (activeFields.Contains("apellido")) AddParameter(parameters,"apellido",SearchApellido);
        if (activeFields.Contains("email")) AddParameter(parameters,"email",SearchEmail);
        if (activeFields.Contains("telefono")) AddParameter(parameters,"telefono",SearchTelefono);
        if (activeFields.Contains("direccion")) AddParameter(parameters,"direccion",SearchDireccion);
        if (activeFields.Count > 0) parameters.Add($"filters={Uri.EscapeDataString(string.Join(",", activeFields))}");
        AddParameter(parameters,"view", view ?? View);
        if(showFilters ?? ShowFilters) parameters.Add("showFilters=true");
        if(report ?? ShowReport) parameters.Add("report=true");
        if(focusId.HasValue) AddParameter(parameters,"focusId",focusId.Value.ToString());
        if(deleteId.HasValue) AddParameter(parameters,"deleteId",deleteId.Value.ToString());
        AddParameter(parameters,"ok",ok);
        return parameters.Count==0 ? "/clientes" : $"/clientes?{string.Join("&",parameters)}";
    }
    private static void AddParameter(List<string> parameters,string key,string? value){if(!string.IsNullOrWhiteSpace(value)) parameters.Add($"{key}={Uri.EscapeDataString(value)}");}
    private static string? EmptyAsNull(string? value)=>string.IsNullOrWhiteSpace(value)?null:value;
    private sealed class DeleteConfirmForm{}
}
