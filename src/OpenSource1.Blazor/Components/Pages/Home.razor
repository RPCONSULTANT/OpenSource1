@page "/"
@using OpenSource1.Application.Security

<PageTitle>Inicio – AxionERP</PageTitle>

<!-- ══════════════════════════════════════════════════════════════
     HERO
═══════════════════════════════════════════════════════════════ -->
<div class="relative rounded-2xl bg-gradient-to-br from-brand-700 via-brand-600 to-brand-800 text-white px-8 py-12 mb-6 shadow-lg overflow-hidden animate-fade-in">
    <div class="absolute top-0 right-0 w-72 h-72 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>

    <div class="relative z-10">
        <div class="flex items-center gap-3 mb-4 animate-slide-in-left">
            <div class="flex size-12 items-center justify-center rounded-xl bg-white/15 backdrop-blur-sm animate-pulse-glow">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="white" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
                </svg>
            </div>
            <div>
                <p class="text-xs font-bold tracking-widest uppercase text-brand-200">Sistema Integral</p>
                <h1 class="text-2xl font-extrabold tracking-tight leading-tight">AxionERP</h1>
            </div>
        </div>
        <p class="text-brand-100 text-sm max-w-xl leading-relaxed animate-slide-up">
            Centralice la operación de su empresa: equipo, procesos y registros en un único panel
            con acceso controlado por roles y trazabilidad completa.
        </p>
    </div>
</div>

<AuthorizeView>

    <!-- ══════════════════════════════════════════════════════════
         VISTA AUTENTICADA
    ═══════════════════════════════════════════════════════════ -->
    <Authorized Context="auth">

        <!-- Bienvenida + Rol -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="md:col-span-2 rounded-2xl border border-slate-200 bg-white shadow-sm px-6 py-5 animate-slide-up flex items-center gap-4">
                <div class="flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5">Sesión activa</p>
                    <p class="text-lg font-bold text-slate-900">Bienvenido, @auth.User.Identity?.Name</p>
                    <p class="text-sm text-slate-500">Tiene acceso habilitado según los permisos de su rol.</p>
                </div>
            </div>
            <div class="rounded-2xl border border-brand-200 bg-brand-50 shadow-sm px-6 py-5 animate-pop flex flex-col justify-center">
                <p class="text-xs font-bold tracking-widest uppercase text-brand-500 mb-2">Rol asignado</p>
                @foreach (var role in auth.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))
                {
                    <div class="flex items-center gap-2 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-brand-600 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                        </svg>
                        <span class="text-base font-extrabold text-brand-800">@role</span>
                    </div>
                }
            </div>
        </div>

        <!-- ── Área de trabajo ── -->
        <div class="mb-2 flex items-center gap-2 animate-fade-in">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-brand-500 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
            </svg>
            <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wide">Tu área de trabajo</h2>
        </div>

        <!-- ── Grid de módulos ── -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">

            <!-- MÓDULO: Gestión de Usuarios — solo Administrador -->
            <AuthorizeView Roles="@ApplicationRoles.Administrator">
                <Authorized>
                    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md hover:border-brand-200 transition-all duration-200 flex flex-col overflow-hidden animate-pop">
                        <div class="h-1 bg-gradient-to-r from-brand-400 to-brand-600"></div>
                        <div class="p-5 flex-1">
                            <div class="flex items-start justify-between mb-3">
                                <div class="flex size-10 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                                    </svg>
                                </div>
                                <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-semibold text-green-700">Disponible</span>
                            </div>
                            <p class="font-bold text-slate-900 mb-1 text-sm">Gestión de Usuarios</p>
                            <p class="text-xs text-slate-500 mb-4 leading-relaxed">Administre el equipo del sistema: revise cuentas, asigne roles por área y controle quién tiene acceso al sistema.</p>
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-2.5 space-y-1.5 select-none pointer-events-none mb-4">
                                @foreach (var initial in new[]{"C","A","M"})
                                {
                                    <div class="flex items-center gap-2 bg-white rounded-lg border border-slate-100 px-2 py-1.5">
                                        <div class="size-6 rounded-full bg-brand-100 flex items-center justify-center text-[9px] font-bold text-brand-600 shrink-0">@initial</div>
                                        <div class="flex-1 min-w-0">
                                            <div class="h-1.5 bg-slate-200 rounded w-20 mb-0.5"></div>
                                            <div class="h-1 bg-slate-100 rounded w-28"></div>
                                        </div>
                                        <div class="h-4 w-12 rounded-md bg-brand-500 opacity-50"></div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="border-t border-slate-100 px-5 py-3">
                            <a href="/admin/users" class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-xs font-semibold text-white hover:bg-brand-700 transition-all duration-150">
                                Ir al módulo
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                            </a>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>

        </div>

        <!-- ── Guía de inicio rápido ── -->
        <div class="rounded-2xl border border-brand-100 bg-brand-50/50 px-6 py-6 animate-slide-up-slow">
            <div class="flex items-center gap-2 mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-brand-500 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" />
                </svg>
                <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wide">¿Cómo empezar?</h2>
            </div>

            <!-- Guía Administrador -->
            <AuthorizeView Roles="@ApplicationRoles.Administrator">
                <Authorized>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        @foreach (var (num, title, desc) in new[]{
                            ("1", "Revise las cuentas registradas",   "Acceda a Gestión de Usuarios y verifique que todas las cuentas estén activas y tengan el rol correcto asignado."),
                            ("2", "Asigne roles por responsabilidad", "Abra el perfil de cada usuario y asigne el rol que corresponde a su área: Supervisor o Ejecutor."),
                            ("3", "Gestione catálogos operativos",    "Use los módulos activos del sistema para registrar, consultar y mantener la información que soporte su operación diaria.")
                        })
                        {
                            <div class="flex gap-3 bg-white rounded-xl border border-brand-100 p-4 shadow-sm">
                                <span class="flex size-7 items-center justify-center rounded-full bg-brand-600 text-white text-xs font-extrabold shrink-0 mt-0.5">@num</span>
                                <div>
                                    <p class="text-sm font-bold text-slate-800 mb-1">@title</p>
                                    <p class="text-xs text-slate-500 leading-relaxed">@desc</p>
                                </div>
                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>

            <!-- Guía Supervisor -->
            <AuthorizeView Roles="@ApplicationRoles.Supervisor">
                <Authorized>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var (num, title, desc) in new[]{
                            ("1", "Consulte los catálogos",          "Revise clientes y productos para confirmar que la información operativa esté correcta."),
                            ("2", "Modifique cuando sea necesario",  "Actualice registros existentes desde los módulos activos según la necesidad del negocio.")
                        })
                        {
                            <div class="flex gap-3 bg-white rounded-xl border border-brand-100 p-4 shadow-sm">
                                <span class="flex size-7 items-center justify-center rounded-full bg-brand-600 text-white text-xs font-extrabold shrink-0 mt-0.5">@num</span>
                                <div>
                                    <p class="text-sm font-bold text-slate-800 mb-1">@title</p>
                                    <p class="text-xs text-slate-500 leading-relaxed">@desc</p>
                                </div>
                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>

            <!-- Guía Ejecutor -->
            <AuthorizeView Roles="@ApplicationRoles.Executor">
                <Authorized>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var (num, title, desc) in new[]{
                            ("1", "Consulte la información",         "Acceda a clientes y productos para revisar la información disponible del sistema."),
                            ("2", "Agregue nuevos registros",       "Si necesita registrar nuevos datos, use los formularios de agregar dentro de los módulos activos.")
                        })
                        {
                            <div class="flex gap-3 bg-white rounded-xl border border-brand-100 p-4 shadow-sm">
                                <span class="flex size-7 items-center justify-center rounded-full bg-brand-600 text-white text-xs font-extrabold shrink-0 mt-0.5">@num</span>
                                <div>
                                    <p class="text-sm font-bold text-slate-800 mb-1">@title</p>
                                    <p class="text-xs text-slate-500 leading-relaxed">@desc</p>
                                </div>
                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>

        </div>

    </Authorized>

    <!-- ══════════════════════════════════════════════════════════
         VISTA PÚBLICA
    ═══════════════════════════════════════════════════════════ -->
    <NotAuthorized>
        <!-- CTA -->
        <div class="rounded-2xl border border-slate-200 bg-white px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm animate-slide-up mb-6">
            <div>
                <h2 class="text-lg font-bold text-slate-800 mb-1">Bienvenido a AxionERP</h2>
                <p class="text-sm text-slate-500 max-w-sm leading-relaxed">
                    Inicie sesión para acceder a su panel de trabajo según el rol que le fue asignado.
                </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 shrink-0">
                <a href="/account/register"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-brand-200 bg-brand-50 px-5 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-100 transition-all duration-150">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                    </svg>
                    Registrarse
                </a>
                <a href="/account/login"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition-all duration-150 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15M12 9l3 3m0 0-3 3m3-3H2.25" />
                    </svg>
                    Iniciar Sesión
                </a>
            </div>
        </div>

        <!-- Cards de características (operacionales) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-slide-up-slow">
            <div class="rounded-xl border border-slate-200 bg-white px-5 py-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
                <div class="flex size-10 items-center justify-center rounded-lg bg-brand-50 text-brand-600 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />
                    </svg>
                </div>
                <p class="font-bold text-slate-800 mb-1">Gestión Operativa Centralizada</p>
                <p class="text-xs text-slate-500 leading-relaxed">Administre clientes, proveedores, operaciones y registros del negocio desde un único panel de control.</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-5 py-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
                <div class="flex size-10 items-center justify-center rounded-lg bg-violet-50 text-violet-600 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                    </svg>
                </div>
                <p class="font-bold text-slate-800 mb-1">Acceso por Área y Responsabilidad</p>
                <p class="text-xs text-slate-500 leading-relaxed">Cada colaborador accede únicamente a las funciones que corresponden a su área, evitando modificaciones no autorizadas.</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-5 py-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
                <div class="flex size-10 items-center justify-center rounded-lg bg-green-50 text-green-600 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
                    </svg>
                </div>
                <p class="font-bold text-slate-800 mb-1">Trazabilidad y Registro de Actividad</p>
                <p class="text-xs text-slate-500 leading-relaxed">Cada operación queda registrada con fecha, responsable y estado. Ante cualquier incidencia, siempre hay un historial consultable.</p>
            </div>
        </div>
    </NotAuthorized>

</AuthorizeView>
