@page "/notas-credito-venta/nueva"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.MovimientosCliente.Dtos
@using OpenSource1.Application.Features.SociosNegocio.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Enums
@inject INotaCreditoVentaApiClient NotaApiClient
@inject ICobroApiClient CobroApiClient
@inject ISocioNegocioApiClient SocioApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<NotaCreditoNueva> Logger
@inject NavigationManager Nav

@* Alta de un borrador de nota de crédito por cliente (Fix-Features C3): se elige el cliente y después una de sus facturas
   posteadas con importe pendiente (movimientos abiertos de tipo Factura con restante > 0). La API valida el resto. *@
<EntityFormPage Titulo="Nueva nota de crédito" Subtitulo="Elija una factura posteada del cliente con importe pendiente."
                Migas="@Migas" Mensaje="@message" TipoMensaje="@messageType" Errores="@errores">
    @if (!canAdd)
    {
        <p class="text-sm text-slate-600 dark:text-slate-300">No tiene permiso para realizar esta acción.</p>
    }
    else if (SocioId is null)
    {
        <form method="get" action="/notas-credito-venta/nueva" data-enhance class="mb-4 flex flex-wrap items-end gap-2" data-testid="buscar-socio">
            @if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            }
            <div class="min-w-60 flex-1">
                <label class="mb-1 block text-xs font-semibold text-slate-500" for="socioQuery">Buscar cliente por nombre</label>
                <input id="socioQuery" type="text" name="socioQuery" value="@SocioQuery" placeholder="ej. Comercial" class="@VentasCss.Filtro" />
            </div>
            <button type="submit" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Buscar</button>
            <p class="w-full text-xs text-slate-400">Se muestran los primeros @VentasOpciones.MaximoSocios clientes por nombre@(string.IsNullOrWhiteSpace(SocioQuery) ? "" : $" que contienen «{SocioQuery}»").</p>
        </form>
        @if (socios.CargaFallida)
        {
            <MessageBox Type="danger" Message="No fue posible cargar los clientes; recargue la página." />
        }
        else if (socios.Items.Count == 0)
        {
            <MessageBox Type="info" Message="No hay clientes con ese nombre." />
        }
        else
        {
            <ul class="divide-y divide-slate-100 rounded-xl border border-slate-200 dark:divide-slate-700 dark:border-slate-700" data-testid="elegir-cliente">
                @foreach (var s in socios.Items)
                {
                    <li><a href="@UrlConSocio(s.Id)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700/40">@s.Codigo — @s.NombreComercial</a></li>
                }
            </ul>
        }
    }
    else
    {
        <p class="mb-4 text-sm text-slate-600 dark:text-slate-300" data-testid="cliente-nota">
            Cliente: <strong>@(socio is null ? SocioId.ToString() : $"{socio.Codigo} — {socio.NombreComercial}")</strong>
            · <a href="@CambiarClienteHref" class="font-semibold text-brand-600 hover:text-brand-700">Cambiar cliente</a>
        </p>
        @if (!cargaFallida && facturas.Count == 0)
        {
            <MessageBox Type="info" Message="El cliente no tiene facturas posteadas con importe pendiente." />
        }
        else if (facturas.Count > 0)
        {
            <EditForm Model="NotaInput" FormName="nueva-nota-socio" OnValidSubmit="CrearAsync" Enhance="true">
                <DataAnnotationsValidator />
                <fieldset class="mb-4" data-testid="facturas-acreditables">
                    <legend class="mb-2 text-sm font-medium text-slate-700 dark:text-slate-300">Factura <span class="text-red-500">*</span></legend>
                    @foreach (var f in facturas)
                    {
                        <label class="flex items-center gap-2 py-1 text-sm text-slate-700 dark:text-slate-200">
                            <input type="radio" name="NotaInput.FacturaVentaNumero" value="@f.NumeroDocumento" checked="@(f.NumeroDocumento == NotaInput!.FacturaVentaNumero)" />
                            <span class="font-mono font-semibold">@f.NumeroDocumento</span>
                            <span class="text-xs text-slate-500">@EntradaFecha.Formatear(f.FechaRegistro) · pendiente @VentasOpciones.Importe(f.ImporteRestante)</span>
                        </label>
                    }
                    <ValidationMessage For="() => NotaInput!.FacturaVentaNumero" />
                </fieldset>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="NotaInput_FechaRegistroTexto">Fecha de registro</label>
                        <input id="NotaInput_FechaRegistroTexto" type="date" name="NotaInput.FechaRegistroTexto" value="@NotaInput!.FechaRegistroTexto" class="@VentasCss.Input" />
                        <ValidationMessage For="() => NotaInput.FechaRegistroTexto" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="NotaInput_FechaDocumentoTexto">Fecha de documento</label>
                        <input id="NotaInput_FechaDocumentoTexto" type="date" name="NotaInput.FechaDocumentoTexto" value="@NotaInput.FechaDocumentoTexto" class="@VentasCss.Input" />
                        <ValidationMessage For="() => NotaInput.FechaDocumentoTexto" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="mb-1 block text-sm font-medium text-slate-700" for="NotaInput_Descripcion">Descripción</label>
                        <input id="NotaInput_Descripcion" type="text" name="NotaInput.Descripcion" value="@NotaInput.Descripcion" maxlength="200" class="@VentasCss.Input" />
                        <ValidationMessage For="() => NotaInput.Descripcion" />
                    </div>
                </div>
                <label class="mt-4 flex items-center gap-2 text-sm text-slate-700 dark:text-slate-200" for="NotaInput_CopiarLineas">
                    <input id="NotaInput_CopiarLineas" type="checkbox" name="NotaInput.CopiarLineas" value="true" checked="@NotaInput.CopiarLineas" class="rounded border-slate-300" />
                    Copiar todo lo pendiente de la factura (nota total)
                </label>
                <label class="mt-2 flex items-center gap-2 text-sm text-slate-700 dark:text-slate-200" for="NotaInput_DevolverInventario">
                    <input id="NotaInput_DevolverInventario" type="checkbox" name="NotaInput.DevolverInventario" value="true" checked="@NotaInput.DevolverInventario" class="rounded border-slate-300" />
                    Devolver al inventario las líneas de producto copiadas
                </label>
                <p class="mt-2 text-xs text-slate-400">Fechas vacías: registro = hoy, documento = registro. La fecha de registro no puede ser anterior a la de la factura.</p>
                <FormularioAcciones CancelarHref="@Volver" LimpiarHref="@Nav.Uri" TextoGuardar="Crear borrador" />
            </EditForm>
        }
    }
</EntityFormPage>

@* El formulario se mantiene en el árbol aunque el permiso, el cliente o sus facturas no lo muestren: un POST obsoleto o
   forzado llega al handler y recibe el mensaje real de la API (403/400). *@
@if (!MuestraFormulario)
{
    <EditForm Model="NotaInput" FormName="nueva-nota-socio" OnValidSubmit="CrearAsync"></EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "socioId")] private Guid? SocioId { get; set; }
    [SupplyParameterFromQuery(Name = "socioQuery")] private string? SocioQuery { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }
    [SupplyParameterFromForm(FormName = "nueva-nota-socio")] private NuevaNotaForm? NotaInput { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private OpcionesCargadas<SocioNegocioResponse> socios = OpcionesCargadas<SocioNegocioResponse>.SinCargar;
    private SocioNegocioResponse? socio;
    private IReadOnlyList<MovimientoClienteResponse> facturas = [];
    private bool cargaFallida;
    private PermisosPagina? permisos;
    private bool canAdd;
    private string? message;
    private string messageType = "warning";
    private IReadOnlyList<string> errores = [];

    private bool MuestraFormulario => canAdd && SocioId is not null && facturas.Count > 0;
    private string Volver => RetornoLocal.Volver(ReturnUrl, "/notas-credito-venta/borradores");
    private IReadOnlyList<Miga> Migas => [new("Facturación", "/modulos/facturacion"), new("Borradores de nota de crédito", Volver), new("Nueva nota de crédito")];

    // Cambiar de cliente conserva la vuelta (returnUrl) si la hay.
    private string CambiarClienteHref => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "/notas-credito-venta/nueva"
        : RetornoLocal.ConRetorno("/notas-credito-venta/nueva", Volver);

    private string UrlConSocio(Guid socioId) => RetornoLocal.ConParametro(CambiarClienteHref, "socioId", socioId.ToString());

    protected override async Task OnInitializedAsync()
    {
        // El modelo existe antes de cualquier carga asíncrona: el primer render no puede encontrarlo en null.
        NotaInput ??= new() { CopiarLineas = true };
        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);
        canAdd = permisos.CanAdd;
        if (!canAdd)
        {
            return;
        }

        if (SocioId is not { } socioId)
        {
            socios = await VentasOpciones.SociosAsync(SocioApiClient, SocioQuery, Logger);
            return;
        }

        try
        {
            socio = await SocioApiClient.GetByIdAsync(socioId);
            if (socio is null)
            {
                Show("warning", "No se encontró el cliente indicado; elija otro.");
                return;
            }

            var abiertos = await CobroApiClient.ListMovimientosAbiertosAsync(socioId) ?? [];
            // Solo facturas posteadas con importe pendiente (restante > 0), en orden cronológico.
            facturas = [.. abiertos
                .Where(m => m.TipoDocumento == TipoDocumentoCliente.Factura && m.ImporteRestante > 0)
                .OrderBy(m => m.FechaRegistro).ThenBy(m => m.NumeroDocumento, StringComparer.Ordinal)];
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load facturas pendientes of socio {Id}.", socioId);
            cargaFallida = true;
            Show("danger", "No fue posible cargar las facturas pendientes del cliente; recargue la página.");
        }
    }

    private async Task CrearAsync()
    {
        var f = NotaInput!;
        // R17: la navegación va FUERA del try (NavigateTo puede lanzar NavigationException y el catch se la tragaría).
        string? destino = null;
        try
        {
            var result = await NotaApiClient.CreateBorradorAsync(new NotaCreditoBorradorInput(
                f.FacturaVentaNumero.Trim(), f.FechaRegistro, f.FechaDocumento,
                string.IsNullOrWhiteSpace(f.Descripcion) ? null : f.Descripcion.Trim(), f.CopiarLineas, f.DevolverInventario));
            if (result.Succeeded)
            {
                destino = $"/notas-credito-venta/borradores/{result.Valor!.Id}?ok=creado";
            }
            else
            {
                Show("warning", result.Message, result.Errors);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not create nota de crédito from factura {Numero}.", f.FacturaVentaNumero);
            Show("danger", "No fue posible crear el borrador de nota de crédito.");
        }

        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private void Show(string type, string? text, IReadOnlyList<string>? errors = null)
    {
        messageType = type;
        message = text;
        errores = errors ?? [];
    }

    public sealed class NuevaNotaForm : IValidatableObject
    {
        [Required(ErrorMessage = "Seleccione la factura.")]
        public string FacturaVentaNumero { get; set; } = string.Empty;

        public string? FechaRegistroTexto { get; set; }

        public string? FechaDocumentoTexto { get; set; }

        [MaxLength(200, ErrorMessage = "La descripción admite como máximo 200 caracteres.")]
        public string? Descripcion { get; set; }

        public bool CopiarLineas { get; set; }

        public bool DevolverInventario { get; set; }

        public DateOnly? FechaRegistro => Fecha(FechaRegistroTexto);

        public DateOnly? FechaDocumento => Fecha(FechaDocumentoTexto);

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            foreach (var (texto, campo, etiqueta) in new[]
                     {
                         (FechaRegistroTexto, nameof(FechaRegistroTexto), "La fecha de registro"),
                         (FechaDocumentoTexto, nameof(FechaDocumentoTexto), "La fecha de documento"),
                     })
            {
                if (!string.IsNullOrWhiteSpace(texto) && !EntradaFecha.TryParse(texto, out _, out var error, etiqueta))
                {
                    yield return new ValidationResult(error ?? $"{etiqueta} no es válida.", [campo]);
                }
            }
        }

        private static DateOnly? Fecha(string? texto) =>
            !string.IsNullOrWhiteSpace(texto) && EntradaFecha.TryParse(texto, out var valor, out _) ? valor : null;
    }
}
