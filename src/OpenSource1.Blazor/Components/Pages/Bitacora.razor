@page "/bitacora"
@attribute [Authorize(Roles = $"{ApplicationRoles.Administrator},{ApplicationRoles.Supervisor}")]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@inject IClienteApiClient ClienteApiClient
@inject IProductoApiClient ProductoApiClient
@inject ILogger<Bitacora> Logger

<PageTitle>Bitácora – AxionERP</PageTitle>

<div class="mb-6 animate-fade-in">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Trazabilidad</p>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight dark:text-slate-100">Bitácora de actividad</h1>
    <p class="text-sm text-slate-500 mt-1 dark:text-slate-400">Quién creó o modificó cada cliente y producto, y cuándo. Use el buscador para encontrar un registro por nombre, código o usuario responsable.</p>
</div>

<form method="get" action="/bitacora" data-enhance class="mb-6 rounded-2xl border border-slate-200 bg-white shadow-sm p-4 flex flex-wrap items-end gap-3 animate-slide-up dark:border-slate-700 dark:bg-slate-800">
    <div class="flex-1 min-w-[14rem]">
        <label class="block text-xs font-semibold text-slate-700 mb-1 dark:text-slate-300">Buscar</label>
        <input type="text" name="search" value="@Search" placeholder="Nombre, código o usuario" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-200" />
    </div>
    <div class="w-40">
        <label class="block text-xs font-semibold text-slate-700 mb-1 dark:text-slate-300">Entidad</label>
        <select name="tipo" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
            <option value="" selected="@(string.IsNullOrEmpty(Tipo))">Todas</option>
            <option value="cliente" selected="@(Tipo == "cliente")">Cliente</option>
            <option value="producto" selected="@(Tipo == "producto")">Producto</option>
        </select>
    </div>
    <div class="flex items-center gap-2">
        <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Buscar</button>
        <a href="/bitacora" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Limpiar</a>
    </div>
</form>

@if (loadError is not null)
{
    <MessageBox Type="danger" Message="@loadError" />
}
else
{
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-slide-up dark:border-slate-700 dark:bg-slate-800">
        <div class="flex items-center justify-between gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/70 dark:border-slate-700/60 dark:bg-slate-900/40">
            <div>
                <h2 class="text-sm font-bold text-slate-800 dark:text-slate-200">Historial de cambios</h2>
                <p class="text-xs text-slate-500 mt-0.5 dark:text-slate-400">@filteredEntries.Count registro(s) encontrados.</p>
            </div>
        </div>
        @if (filteredEntries.Count == 0)
        {
            <div class="px-6 py-14 text-center text-slate-400 dark:text-slate-500"><p class="font-semibold text-slate-500 dark:text-slate-400">No encontramos actividad con esos criterios.</p></div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-100 text-sm dark:divide-slate-700/60">
                    <thead class="bg-slate-50 dark:bg-slate-900/40">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Entidad</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Registro</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Acción</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Por</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Fecha</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 bg-white dark:divide-slate-700/40 dark:bg-slate-800">
                        @foreach (var entry in filteredEntries)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/60">
                                <td class="px-4 py-3"><span class="inline-flex items-center rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700 dark:bg-brand-500/10 dark:text-brand-400">@entry.Tipo</span></td>
                                <td class="px-4 py-3 font-semibold text-slate-800 dark:text-slate-200">@entry.Descripcion</td>
                                <td class="px-4 py-3">
                                    @if (entry.Accion == "Creado")
                                    {
                                        <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800">Creado</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">Actualizado</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@entry.Usuario</td>
                                <td class="px-4 py-3 text-slate-500 dark:text-slate-400">@entry.Fecha.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "search")] private string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "tipo")] private string? Tipo { get; set; }

    private string? loadError;
    private List<BitacoraEntry> entries = [];
    private List<BitacoraEntry> filteredEntries = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var clientes = await ClienteApiClient.ListAsync();
            var productos = await ProductoApiClient.ListAsync();

            entries = clientes
                .Select(c => new BitacoraEntry("Cliente", $"{c.Nombre} {c.Apellido}",
                    c.UpdatedAtUtc.HasValue ? "Actualizado" : "Creado",
                    c.UpdatedAtUtc.HasValue ? (c.UpdatedBy ?? c.CreatedBy) : c.CreatedBy,
                    c.UpdatedAtUtc ?? c.CreatedAtUtc))
                .Concat(productos.Select(p => new BitacoraEntry("Producto", $"{p.Nombre} ({p.Codigo})",
                    p.UpdatedAtUtc.HasValue ? "Actualizado" : "Creado",
                    p.UpdatedAtUtc.HasValue ? (p.UpdatedBy ?? p.CreatedBy) : p.CreatedBy,
                    p.UpdatedAtUtc ?? p.CreatedAtUtc)))
                .OrderByDescending(e => e.Fecha)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load bitacora data.");
            loadError = "No fue posible cargar la bitácora en este momento.";
        }

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<BitacoraEntry> query = entries;

        if (!string.IsNullOrWhiteSpace(Tipo))
        {
            query = query.Where(e => string.Equals(e.Tipo, Tipo, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(Search))
        {
            var term = Search.Trim();
            query = query.Where(e =>
                e.Descripcion.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                e.Usuario.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        filteredEntries = query.ToList();
    }

    private sealed record BitacoraEntry(string Tipo, string Descripcion, string Accion, string Usuario, DateTime Fecha);
}
