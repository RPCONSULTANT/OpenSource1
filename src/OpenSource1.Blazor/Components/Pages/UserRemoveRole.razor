@page "/admin/users/remove-role"
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@inject IUserAdminApiClient UserAdminApi
@inject NavigationManager Nav

@code {
    [SupplyParameterFromForm]
    private string? UserId { get; set; }

    [SupplyParameterFromForm]
    private string? Role { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Role))
        {
            Nav.NavigateTo("/admin/users?err=Datos+incompletos.");
            return;
        }

        var (success, error) = await UserAdminApi.RemoveRoleAsync(UserId, Role);
        var redirectUrl = success
            ? $"/admin/users?ok=Rol+'{Uri.EscapeDataString(Role)}'+removido+correctamente."
            : $"/admin/users?err={Uri.EscapeDataString(error ?? "Error al remover el rol.")}";

        Nav.NavigateTo(redirectUrl);
    }
}
