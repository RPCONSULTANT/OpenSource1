@page "/admin/users"
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@using OpenSource1.Application.Security
@using OpenSource1.Application.Features.Users.Dtos
@using OpenSource1.Blazor.Services
@inject IUserAdminApiClient UserAdminApi
@inject NavigationManager Nav

<PageTitle>Gestión de Usuarios – AxionERP</PageTitle>

<PageToolbar Titulo="Gestión de Usuarios" Subtitulo="Busque, filtre y administre roles y estado de los usuarios."
             Migas="@Migas" NuevoHref="/admin/users/nuevo" NuevoTexto="Nuevo usuario" NuevoPermiso="@null"
             SeleccionId="@SeleccionValida" EditarUrl="@(id => $"/admin/users/{Uri.EscapeDataString(id)}/editar")" EditarPermiso="@null" />

<!-- ── Buscador y filtros ── -->
<form method="get" action="/admin/users" data-enhance class="mb-6 rounded-2xl border border-slate-200 bg-white shadow-sm p-4 flex flex-wrap items-end gap-3 dark:border-slate-700 dark:bg-slate-800">
    <div class="flex-1 min-w-[14rem]">
        <label class="block text-xs font-semibold text-slate-700 mb-1 dark:text-slate-300">Buscar</label>
        <input type="text" name="search" value="@Search" placeholder="Nombre o correo" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-200" />
    </div>
    <div class="w-44">
        <label class="block text-xs font-semibold text-slate-700 mb-1 dark:text-slate-300">Rol</label>
        <select name="role" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
            <option value="" selected="@(string.IsNullOrEmpty(Role))">Todos</option>
            @foreach (var role in ApplicationRoles.All)
            {
                <option value="@role" selected="@(Role == role)">@role</option>
            }
        </select>
    </div>
    <div class="w-40">
        <label class="block text-xs font-semibold text-slate-700 mb-1 dark:text-slate-300">Estado</label>
        <select name="isActive" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
            <option value="" selected="@(IsActiveFilter is null)">Todos</option>
            <option value="true" selected="@(IsActiveFilter == true)">Activo</option>
            <option value="false" selected="@(IsActiveFilter == false)">Inactivo</option>
        </select>
    </div>
    <div class="flex items-center gap-2">
        <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Buscar</button>
        <a href="/admin/users" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Limpiar</a>
    </div>
</form>

<!-- ── Feedback global ── -->
@if (feedbackMessage is not null)
{
    <div class="mb-4">
        @if (feedbackType == "success")
        {
            <ActionFeedback Type="success" Message="@feedbackMessage" />
        }
        else
        {
            <MessageBox Type="@feedbackType" Message="@feedbackMessage" />
        }
    </div>
}

@if (loadError is not null)
{
    <MessageBox Type="danger" Message="@loadError" />
}
else if (users is null)
{
    <!-- Skeleton loader -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 animate-pulse">
        @for (int i = 0; i < 6; i++)
        {
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-5 dark:border-slate-700 dark:bg-slate-800">
                <div class="flex items-center gap-3 mb-4">
                    <div class="size-12 rounded-full bg-slate-200 shrink-0"></div>
                    <div class="flex-1 space-y-2">
                        <div class="h-4 bg-slate-200 rounded w-2/3"></div>
                        <div class="h-3 bg-slate-200 rounded w-full"></div>
                    </div>
                </div>
                <div class="h-3 bg-slate-200 rounded w-1/2 mb-4"></div>
                <div class="h-9 bg-slate-200 rounded-lg"></div>
            </div>
        }
    </div>
}
else if (users.Count == 0)
{
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm px-8 py-12 text-center text-slate-400 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-500">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-12 mx-auto mb-3 text-slate-300">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
        <p class="font-semibold">No hay usuarios registrados.</p>
    </div>
}
else
{
    <!-- ── Grid de cards ── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var user in users)
        {
            var marcada = user.Id == SeleccionValida;
            @* Tarjeta seleccionable entera (R13): marcador "fila-seleccionable" + enlace de selección estirado; los enlaces de la
               tarjeta quedan por encima. Sin overflow-hidden en la tarjeta. *@
            <div class="@SeleccionFila.ClaseMarcadorFila group rounded-2xl border bg-white shadow-sm hover:shadow-md hover:border-brand-200 transition-all duration-200 flex flex-col dark:bg-slate-800 @(marcada ? "border-brand-500 ring-2 ring-brand-500/30" : "border-slate-200 dark:border-slate-700")">
                <div class="p-5 flex-1">
                    <!-- Avatar + nombre -->
                    <div class="flex items-center gap-3 mb-3">
                        <SeleccionFila Href="@BuildListUrl(sel: user.Id)" Seleccionada="@marcada" Etiqueta="@user.FullName" />
                        <div class="flex size-12 items-center justify-center rounded-full bg-brand-100 text-brand-700 font-bold text-lg shrink-0 group-hover:bg-brand-200 transition-colors dark:text-brand-400">
                            @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                        </div>
                        <div class="min-w-0">
                            <p class="font-semibold text-slate-900 truncate dark:text-slate-100">@user.FullName</p>
                            <p class="text-xs text-slate-400 truncate dark:text-slate-500">@user.Email</p>
                        </div>
                    </div>

                    <!-- Estado -->
                    <div class="mb-3">
                        @if (user.IsActive)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800">
                                <span class="size-1.5 rounded-full bg-green-500 inline-block"></span>
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-semibold text-red-700">
                                <span class="size-1.5 rounded-full bg-red-400 inline-block"></span>
                                Inactivo
                            </span>
                        }
                    </div>

                    <!-- Roles -->
                    <div class="flex flex-wrap gap-1.5 min-h-[1.5rem]">
                        @if (user.Roles.Count == 0)
                        {
                            <span class="text-xs text-slate-400 italic dark:text-slate-500">Sin rol asignado</span>
                        }
                        else
                        {
                            @foreach (var role in user.Roles)
                            {
                                <span class="inline-flex items-center rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-semibold text-brand-800 dark:text-brand-400">@role</span>
                            }
                        }
                    </div>
                </div>

                <!-- Acción: ir al perfil -->
                <div class="border-t border-slate-100 px-5 py-3 dark:border-slate-700/60">
                    <a href="/admin/users/@user.Id"
                       class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 active:scale-95 transition-all duration-150">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                        </svg>
                        Ver Perfil
                    </a>
                    <a href="/admin/users/@user.Id/editar" class="btn-press mt-2 flex w-full items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50">Editar</a>
                </div>
            </div>
        }
    </div>
}

@code {
    private static readonly IReadOnlyList<Miga> Migas = [new("Administración", "/modulos/administracion"), new("Usuarios")];

    private IReadOnlyList<UserSummaryResponse>? users;
    private string? loadError;
    private string feedbackType = "success";
    private string? feedbackMessage;

    [SupplyParameterFromQuery(Name = "ok")]
    private string? OkMessage { get; set; }

    [SupplyParameterFromQuery(Name = "err")]
    private string? ErrMessage { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    private string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "role")]
    private string? Role { get; set; }

    [SupplyParameterFromQuery(Name = "isActive")]
    private bool? IsActiveFilter { get; set; }

    [SupplyParameterFromQuery(Name = "sel")]
    private string? Sel { get; set; }

    // Solo para redirigir la ruta antigua (/admin/users?new=true) a /admin/users/nuevo.
    [SupplyParameterFromQuery(Name = "new")]
    private bool IsNewUser { get; set; }

    /// <summary>Selección (?sel=) solo si el usuario está en la lista cargada; si no, la barra la trata como vacía.</summary>
    private string? SeleccionValida => Sel is { } s && users is not null && users.Any(u => u.Id == s) ? s : null;

    protected override async Task OnInitializedAsync()
    {
        if (IsNewUser)
        {
            Nav.NavigateTo("/admin/users/nuevo", replace: true);
            return;
        }

        if (OkMessage is not null)
        {
            feedbackType = "success";
            feedbackMessage = Uri.UnescapeDataString(OkMessage);
        }
        else if (ErrMessage is not null)
        {
            feedbackType = "danger";
            feedbackMessage = Uri.UnescapeDataString(ErrMessage);
        }

        var (result, error) = await UserAdminApi.ListUsersAsync(Search, Role, IsActiveFilter);
        if (error is not null)
            loadError = error;
        else
            users = result;
    }

    /// <summary>La lista con sus filtros y la selección dada (sin ok/err).</summary>
    private string BuildListUrl(string? sel = null)
    {
        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(Search)) parameters.Add($"search={Uri.EscapeDataString(Search)}");
        if (!string.IsNullOrWhiteSpace(Role)) parameters.Add($"role={Uri.EscapeDataString(Role)}");
        if (IsActiveFilter is { } activo) parameters.Add($"isActive={(activo ? "true" : "false")}");
        var selEfectiva = sel ?? Sel;
        if (!string.IsNullOrWhiteSpace(selEfectiva)) parameters.Add($"sel={Uri.EscapeDataString(selEfectiva)}");
        return parameters.Count == 0 ? "/admin/users" : $"/admin/users?{string.Join("&", parameters)}";
    }
}
