@page "/account/login"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using OpenSource1.Application.Services.Auth.Dtos
@using OpenSource1.Blazor.Security
@using OpenSource1.Blazor.Services
@inject IAuthApiClient AuthApiClient
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión – AxionERP</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-slate-100 via-brand-50 to-white flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md animate-fade-in">

        <!-- ── Marca ── -->
        <div class="text-center mb-8 animate-slide-up">
            <div class="inline-flex items-center justify-center size-16 rounded-2xl bg-brand-600 shadow-lg mb-4 animate-float">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="white" class="size-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
                </svg>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">AxionERP</h1>
            <p class="mt-1 text-sm text-slate-500">Sistema Integral de Gestión Empresarial</p>
        </div>

        <!-- ── Tarjeta ── -->
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden animate-pop">
            <div class="h-1 w-full bg-gradient-to-r from-brand-500 to-brand-700"></div>

            <div class="px-8 py-8">
                <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-5">Acceso seguro</p>

                @* MessageBox: cuenta registrada *@
                @if (JustRegistered)
                {
                    <div class="mb-5">
                        <MessageBox Type="success" Message="¡Cuenta creada exitosamente! Inicie sesión con sus credenciales." />
                    </div>
                }

                @* MessageBox: sesión cerrada correctamente *@
                @if (LoggedOut)
                {
                    <div class="mb-5">
                        <MessageBox Type="info" Message="La sesión fue cerrada correctamente. Puede iniciar sesión nuevamente." />
                    </div>
                }

                @* MessageBox: errores de autenticación (con lista de mensajes) *@
                @if (errors.Count > 0)
                {
                    <div class="mb-5">
                        <MessageBox Type="danger" Errors="errors" />
                    </div>
                }

                <EditForm Model="Input" FormName="login" OnValidSubmit="LoginAsync" autocomplete="off" novalidate>
                    <DataAnnotationsValidator />

                    <!-- Campo: Usuario -->
                    <div class="mb-5">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="userNameOrEmail">
                            <span class="flex items-center gap-1.5">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4 text-slate-400">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                                </svg>
                                Usuario o correo electrónico
                            </span>
                        </label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                                </svg>
                            </span>
                            <InputText id="userNameOrEmail"
                                       class="block w-full rounded-lg border border-slate-300 bg-slate-50 py-2.5 pl-10 pr-3 text-sm text-slate-800 placeholder-slate-400 shadow-sm transition focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25"
                                       @bind-Value="Input!.UserNameOrEmail"
                                       autocomplete="username"
                                       placeholder="admin, supervisor o ejecutor" />
                        </div>
                        <ValidationMessage For="() => Input!.UserNameOrEmail" />
                    </div>

                    <!-- Campo: Contraseña (oculta) -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="password">
                            <span class="flex items-center gap-1.5">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4 text-slate-400">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                                </svg>
                                Contraseña
                            </span>
                        </label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                                </svg>
                            </span>
                            <InputText id="password"
                                       type="password"
                                       class="block w-full rounded-lg border border-slate-300 bg-slate-50 py-2.5 pl-10 pr-11 text-sm text-slate-800 placeholder-slate-400 shadow-sm transition focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25"
                                       @bind-Value="Input!.Password"
                                       autocomplete="current-password"
                                       placeholder="••••••••" />
                            <!-- Botón ojo: toggle nativo sin JS interop -->
                            <button type="button"
                                    title="Mostrar / ocultar contraseña"
                                    onclick="(function(btn){var inp=document.getElementById('password');if(inp){inp.type=inp.type==='password'?'text':'password';btn.querySelector('.eye-show').classList.toggle('hidden');btn.querySelector('.eye-hide').classList.toggle('hidden');}})(this)"
                                    class="absolute inset-y-0 right-3 flex items-center text-slate-400 hover:text-brand-600 transition-colors focus:outline-none">
                                <!-- ojo abierto (visible por defecto) -->
                                <svg class="eye-show size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                </svg>
                                <!-- ojo tachado (oculto por defecto) -->
                                <svg class="eye-hide size-4 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                                </svg>
                            </button>
                        </div>
                        <ValidationMessage For="() => Input!.Password" />
                        <div class="mt-2 text-right">
                            <a href="/account/forgot-password" class="text-xs font-semibold text-brand-600 hover:text-brand-700 hover:underline">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>
                        <p class="mt-1.5 text-xs text-slate-400 flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-3">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                            </svg>
                            La cuenta se bloquea tras 3 intentos fallidos consecutivos.
                        </p>
                    </div>

                    <!-- Botones -->
                    <div class="flex flex-col-reverse sm:flex-row gap-3">
                        <!-- Botón Salir -->
                        <a href="/"
                           class="flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50 hover:text-slate-800 transition-all duration-150 w-full sm:w-auto">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                            </svg>
                            Salir
                        </a>
                        <!-- Botón Iniciar Sesión -->
                        <button type="submit"
                                class="flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 active:scale-95 transition-all duration-150 w-full sm:flex-1">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15M12 9l3 3m0 0-3 3m3-3H2.25" />
                            </svg>
                            Iniciar Sesión
                        </button>
                    </div>
                </EditForm>
            </div>

            <!-- Pie de tarjeta: enlace a registro -->
            <div class="border-t border-slate-100 bg-slate-50 px-8 py-4 text-center text-sm text-slate-500">
                ¿No tiene cuenta?
                <a href="/account/register" class="font-semibold text-brand-600 hover:text-brand-700 hover:underline transition-colors ml-1">
                    Registrarse
                </a>
            </div>
        </div>

        <p class="text-center text-xs text-slate-400 mt-6">
            &copy; 2026 AxionERP — Acceso protegido mediante cookie HttpOnly
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "login")]
    private LoginInput? Input { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "loggedOut")]
    private bool LoggedOut { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    private bool JustRegistered { get; set; }

    private IReadOnlyList<string> errors = [];

    protected override void OnInitialized() => Input ??= new();

    private async Task LoginAsync()
    {
        errors = [];

        var result = await AuthApiClient.LoginAsync(new LoginRequest
        {
            UserNameOrEmail = Input!.UserNameOrEmail.Trim(),
            Password = Input.Password
        });

        if (!result.Succeeded || result.Response is null)
        {
            errors = result.Errors.Count > 0 ? result.Errors : ["Usuario o contraseña incorrectos."];
            return;
        }

        var httpContext = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("No hay HttpContext disponible para iniciar sesión.");

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, result.Response.UserId),
            new(ClaimTypes.Name, result.Response.FullName),
            new(ClaimTypes.Email, result.Response.Email)
        };

        claims.AddRange(result.Response.Roles.Select(r => new Claim(ClaimTypes.Role, r)));
        claims.AddRange(result.Response.Permissions.Select(p => new Claim("permission", p)));

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        await httpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal, new AuthenticationProperties
        {
            IsPersistent = false,
            ExpiresUtc = result.Response.ExpiresAtUtc,
            AllowRefresh = true
        });

        httpContext.Session.SetString(AuthSessionKeys.AccessToken, result.Response.AccessToken);
        httpContext.Session.SetString(AuthSessionKeys.ExpiresAtUtc, result.Response.ExpiresAtUtc.ToString("O"));

        var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : $"/{ReturnUrl.TrimStart('/')}";
        Navigation.NavigateTo(target, forceLoad: true);
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Debe ingresar su usuario o correo electrónico.")]
        [MaxLength(256)]
        public string UserNameOrEmail { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe ingresar su contraseña.")]
        [MaxLength(100)]
        public string Password { get; set; } = string.Empty;
    }
}
