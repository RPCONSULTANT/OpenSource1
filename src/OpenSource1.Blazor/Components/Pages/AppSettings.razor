@attribute [Obsolete("Modulo de prueba obsoleto. No usar AppSettings para nuevos desarrollos.")]
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.AppSettings.Dtos
@using OpenSource1.Blazor.Services
@inject IAppSettingsApiClient AppSettingsApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<AppSettings> Logger
@inject NavigationManager Nav

<PageTitle>Configuraciones – OpenSource1</PageTitle>

<!-- Encabezado de sección -->
<div class="mb-6">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Operaciones protegidas</p>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
        <!-- heroicon: cog-6-tooth -->
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-7 text-brand-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
        Configuraciones de aplicación
    </h1>
    <p class="text-sm text-slate-500 mt-1">Las acciones se habilitan según la política del rol. El API valida el JWT en cada operación.</p>
</div>

@* MessageBox global de operaciones *@
@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" />
        }
    </div>
}

<!-- ── Tabla de configuraciones ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-slate-400">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h1.5C5.496 19.5 6 18.996 6 18.375m-3.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-1.5A1.125 1.125 0 0 1 18 18.375M20.625 4.5H3.375m17.25 0c.621 0 1.125.504 1.125 1.125M20.625 4.5h-1.5C18.504 4.5 18 5.004 18 5.625m3.75 0v1.5c0 .621-.504 1.125-1.125 1.125M3.375 4.5c-.621 0-1.125.504-1.125 1.125M3.375 4.5h1.5C5.496 4.5 6 5.004 6 5.625m-3.75 0v1.5c0 .621.504 1.125 1.125 1.125m0 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m1.5-3.75C5.496 8.25 6 8.754 6 9.375v1.5m0-5.25v5.25m0-5.25C6 5.004 6.504 4.5 7.125 4.5h9.75c.621 0 1.125.504 1.125 1.125m1.125 2.625h1.5m-1.5 0A1.125 1.125 0 0 1 18 7.875v1.5m1.125-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M18 5.625v5.25M7.125 12h9.75m-9.75 0A1.125 1.125 0 0 1 6 10.875M7.125 12C6.504 12 6 12.504 6 13.125m0-2.25C6 11.496 5.496 12 4.875 12M18 10.875c0 .621-.504 1.125-1.125 1.125M18 10.875c0 .621.504 1.125 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-9.75 0h9.75" />
        </svg>
        <h2 class="text-sm font-semibold text-slate-700">Registros actuales</h2>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Clave</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Valor</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Descripción</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actualizado</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (settings.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-slate-400 text-sm">
                            No hay configuraciones registradas aún.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var setting in settings)
                    {
                        <tr @key="setting.Id" class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-3 font-mono text-xs font-semibold text-brand-700">@setting.Key</td>
                            <td class="px-6 py-3 text-slate-700">@setting.Value</td>
                            <td class="px-6 py-3 text-slate-500">@setting.Description</td>
                            <td class="px-6 py-3 text-slate-400 text-xs">
                                @(setting.UpdatedAtUtc?.ToLocalTime().ToString("g") ?? setting.CreatedAtUtc.ToLocalTime().ToString("g"))
                            </td>
                            <td class="px-6 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @if (canModify)
                                    {
                                        <a href="/app-settings?editKey=@Uri.EscapeDataString(setting.Key)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-amber-200 bg-amber-50 text-amber-600 hover:bg-amber-100" title="Editar configuración">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z" /></svg>
                                        </a>
                                    }
                                    @if (canDelete)
                                    {
                                        <a href="/app-settings?deleteKey=@Uri.EscapeDataString(setting.Key)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100" title="Eliminar configuración">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79" /></svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ── Formularios de operación ── -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

    <!-- Agregar -->
    @if (canAdd)
    {
        <div id="agregar" class="rounded-2xl border border-green-200 bg-white shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-green-50 border-b border-green-100 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-green-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <h2 class="text-sm font-bold text-green-800">Agregar configuración</h2>
            </div>
            <div class="px-6 py-5">
                <EditForm Model="SaveInput" FormName="save-setting" OnValidSubmit="PrepareCreateConfirmation">
                    <DataAnnotationsValidator />
                    <SettingFields Model="SaveInput!" Prefix="SaveInput" />
                    <div class="mt-5">
                        <button type="submit"
                                class="btn-press flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 transition-colors shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            Revisar y agregar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Modificar -->
    @if (canModify)
    {
        <div id="modificar" class="rounded-2xl border border-amber-200 bg-white shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-amber-50 border-b border-amber-100 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-amber-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                </svg>
                <h2 class="text-sm font-bold text-amber-800">Modificar configuración</h2>
            </div>
            <div class="px-6 py-5">
                <EditForm Model="UpdateInput" FormName="update-setting" OnValidSubmit="PrepareUpdateConfirmation">
                    <DataAnnotationsValidator />
                    <SettingFields Model="UpdateInput!" Prefix="UpdateInput" />
                    <div class="mt-5">
                        <button type="submit"
                                class="btn-press flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600 transition-colors shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                            </svg>
                            Revisar modificación
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

</div>

@if (showCreateConfirmation)
{
    <ConfirmDialog Title="Confirmar creación" Message="Está a punto de crear una configuración de aplicación." Variant="success" CancelHref="/app-settings">
        <p class="rounded-xl border border-green-100 bg-green-50 px-4 py-3 text-sm font-mono text-green-900">@SaveInput!.Key</p>
        <EditForm Model="ConfirmSaveInput" FormName="confirm-save-setting" OnValidSubmit="CreateAsync" class="mt-4">
            <input type="hidden" name="ConfirmSaveInput.Key" value="@SaveInput.Key" />
            <input type="hidden" name="ConfirmSaveInput.Value" value="@SaveInput.Value" />
            <input type="hidden" name="ConfirmSaveInput.Description" value="@SaveInput.Description" />
            <button type="submit" class="btn-press rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-700">Sí, crear configuración</button>
            <a href="/app-settings" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@if (showUpdateConfirmation)
{
    <ConfirmDialog Title="Confirmar modificación" Message="Está a punto de modificar una configuración de aplicación." Variant="warning" CancelHref="/app-settings">
        <p class="rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm font-mono text-amber-900">@UpdateInput!.Key</p>
        <EditForm Model="ConfirmUpdateInput" FormName="confirm-update-setting" OnValidSubmit="UpdateAsync" class="mt-4">
            <input type="hidden" name="ConfirmUpdateInput.Key" value="@UpdateInput.Key" />
            <input type="hidden" name="ConfirmUpdateInput.Value" value="@UpdateInput.Value" />
            <input type="hidden" name="ConfirmUpdateInput.Description" value="@UpdateInput.Description" />
            <button type="submit" class="btn-press rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-700">Sí, guardar cambios</button>
            <a href="/app-settings" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@if (!string.IsNullOrWhiteSpace(DeleteKey) && canDelete)
{
    <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará la configuración seleccionada y no se puede deshacer." Variant="danger" CancelHref="/app-settings">
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-mono text-red-900">@DeleteKey</p>
        <EditForm Model="DeleteInput" FormName="delete-setting" OnValidSubmit="DeleteAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.Key" value="@DeleteKey" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, eliminar</button>
            <a href="/app-settings" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@code {
    [SupplyParameterFromForm(FormName = "save-setting")]
    private SettingForm? SaveInput { get; set; }

    [SupplyParameterFromForm(FormName = "confirm-save-setting")]
    private SettingForm? ConfirmSaveInput { get; set; }

    [SupplyParameterFromForm(FormName = "update-setting")]
    private SettingForm? UpdateInput { get; set; }

    [SupplyParameterFromForm(FormName = "confirm-update-setting")]
    private SettingForm? ConfirmUpdateInput { get; set; }

    [SupplyParameterFromForm(FormName = "delete-setting")]
    private DeleteForm? DeleteInput { get; set; }

    [SupplyParameterFromQuery(Name = "editKey")]
    private string? EditKey { get; set; }

    [SupplyParameterFromQuery(Name = "deleteKey")]
    private string? DeleteKey { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }

    private IReadOnlyList<AppSettingResponse> settings = [];
    private string? message;
    private string messageType = "info";
    private bool showCreateConfirmation;
    private bool showUpdateConfirmation;

    // Permisos computados sincrónicamente en OnInitializedAsync
    private bool canAdd;
    private bool canModify;
    private bool canDelete;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        SaveInput   ??= new();
        ConfirmSaveInput ??= new();
        UpdateInput ??= new();
        ConfirmUpdateInput ??= new();
        DeleteInput ??= new();

        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            var user = authState.User;
            canAdd    = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanAdd)).Succeeded;
            canModify = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanModify)).Succeeded;
            canDelete = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanDelete)).Succeeded;
        }

        await LoadAsync();

        if (Ok is not null)
        {
            (messageType, message) = Ok switch
            {
                "created" => ("success", "Configuración creada satisfactoriamente."),
                "updated" => ("success", "Configuración modificada satisfactoriamente."),
                "deleted" => ("success", "Configuración eliminada satisfactoriamente."),
                _ => ("info", null)
            };
        }

        if (!string.IsNullOrWhiteSpace(EditKey) && string.IsNullOrWhiteSpace(UpdateInput.Key))
        {
            var setting = settings.FirstOrDefault(s => s.Key == EditKey);
            if (setting is not null)
            {
                UpdateInput.Key = setting.Key;
                UpdateInput.Value = setting.Value;
                UpdateInput.Description = setting.Description;
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            settings = await AppSettingsApiClient.ListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load app settings from API.");
            Show("danger", "No fue posible cargar las configuraciones.");
        }
    }

    private Task PrepareCreateConfirmation() { showCreateConfirmation = true; return Task.CompletedTask; }
    private Task PrepareUpdateConfirmation() { showUpdateConfirmation = true; return Task.CompletedTask; }

    private async Task CreateAsync() => await ExecuteAsync(() => AppSettingsApiClient.CreateAsync(ToInput(ConfirmSaveInput!)), "created");
    private async Task UpdateAsync() => await ExecuteAsync(() => AppSettingsApiClient.UpdateAsync(ToInput(ConfirmUpdateInput!)), "updated");
    private async Task DeleteAsync() => await ExecuteAsync(() => AppSettingsApiClient.DeleteAsync(DeleteInput!.Key.Trim()), "deleted");

    private async Task ExecuteAsync(Func<Task<AppSettingOperationResult>> operation, string successCode)
    {
        try
        {
            var result = await operation();
            if (result.Succeeded)
                Nav.NavigateTo($"/app-settings?ok={successCode}");
            else
                Show("warning", result.Message);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not complete app setting operation.");
            Show("danger", "No fue posible completar la operación.");
        }
    }

    private void Show(string type, string text) { messageType = type; message = text; }

    private static AppSettingInput ToInput(SettingForm form) => new(form.Key.Trim(), form.Value.Trim(), form.Description);

    public sealed class SettingForm
    {
        [Required(ErrorMessage = "La clave es obligatoria.")]
        [MaxLength(100)]
        public string Key { get; set; } = string.Empty;

        [Required(ErrorMessage = "El valor es obligatorio.")]
        [MaxLength(512)]
        public string Value { get; set; } = string.Empty;

        [MaxLength(512)]
        public string? Description { get; set; }
    }

    public sealed class DeleteForm
    {
        [Required(ErrorMessage = "La clave es obligatoria.")]
        [MaxLength(100)]
        public string Key { get; set; } = string.Empty;
    }
}
