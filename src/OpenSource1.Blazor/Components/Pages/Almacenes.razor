@page "/almacenes"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Almacenes.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@inject IAlmacenApiClient AlmacenApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<Almacenes> Logger
@inject NavigationManager Nav

<PageTitle>Almacenes – AxionERP</PageTitle>

<div class="mb-6">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Mantenimiento</p>
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Almacenes</h1>
    <p class="text-sm text-slate-500 mt-1">Catálogo de almacenes para el libro de inventario.</p>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" Errors="@errores" />
        }
    </div>
}

<!-- ── Filtros ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/almacenes" data-enhance class="p-4 sm:p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-3 max-w-3xl">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroCodigo">Código</label>
                    <input id="filtroCodigo" type="text" name="codigo" value="@SearchCodigo" placeholder="ej. PRINCIPAL"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroNombre">Nombre</label>
                    <input id="filtroNombre" type="text" name="nombre" value="@SearchNombre" placeholder="ej. Almacén Principal"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroBloqueado">Bloqueo</label>
                    <select id="filtroBloqueado" name="bloqueado"
                            class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20">
                        <option value="" selected="@(SearchBloqueado is null)">Todos</option>
                        <option value="false" selected="@(SearchBloqueado == false)">No bloqueados</option>
                        <option value="true" selected="@(SearchBloqueado == true)">Bloqueados</option>
                    </select>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m0 0A7.95 7.95 0 1 0 5.4 5.4a7.95 7.95 0 0 0 11.25 11.25Z" /></svg>
                    Consultar
                </button>
                <a href="/almacenes" title="Limpiar campos" class="btn-press inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                    Limpiar campos
                </a>
            </div>
        </div>
    </form>
</div>

<!-- ── Tabla de almacenes ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-700">Registros actuales</h2>
        <p class="mt-1 text-xs text-slate-500">@totalAlmacenes resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1).</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Código</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Nombre</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Ciudad / País</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Estado</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actualizado</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (almacenes.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-slate-400 text-sm">
                            No hay almacenes registrados con esos criterios.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var almacen in almacenes)
                    {
                        <tr @key="almacen.Id" class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-3 font-mono text-xs font-semibold text-brand-700">@almacen.Codigo</td>
                            <td class="px-6 py-3 text-slate-700">@almacen.Nombre</td>
                            <td class="px-6 py-3 text-slate-500 text-xs">
                                @(string.IsNullOrWhiteSpace(almacen.Ciudad) ? "—" : almacen.Ciudad)@(string.IsNullOrWhiteSpace(almacen.PaisCodigo) ? "" : $" · {almacen.PaisCodigo}")
                            </td>
                            <td class="px-6 py-3">
                                <div class="flex flex-wrap items-center gap-1.5">
                                    @if (almacen.EsPredeterminado)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-700">Predeterminado</span>
                                    }
                                    @if (almacen.Bloqueado)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-semibold text-red-700">Bloqueado</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-3 text-slate-400 text-xs">
                                @(almacen.UpdatedAtUtc?.ToLocalTime().ToString("g") ?? almacen.CreatedAtUtc.ToLocalTime().ToString("g"))
                            </td>
                            <td class="px-6 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @if (canModify)
                                    {
                                        <a href="@BuildListUrl(editId: almacen.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-amber-200 bg-amber-50 text-amber-600 hover:bg-amber-100" title="Editar almacén">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z" /></svg>
                                        </a>
                                    }
                                    @if (canDelete && !almacen.EsPredeterminado)
                                    {
                                        <a href="@BuildListUrl(deleteId: almacen.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100" title="Eliminar almacén">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79" /></svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
            <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
            <div class="flex items-center gap-2">
                @if (Pagina > 1)
                {
                    <a href="@BuildListUrl(pagina: Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                }
                @if (Pagina < totalPaginas)
                {
                    <a href="@BuildListUrl(pagina: Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                }
            </div>
        </div>
    }
</div>

<!-- ── Formularios de operación ── -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Agregar -->
    @if (canAdd)
    {
        <div id="agregar" class="rounded-2xl border border-green-200 bg-white shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-green-50 border-b border-green-100 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-green-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <h2 class="text-sm font-bold text-green-800">Agregar almacén</h2>
            </div>
            <div class="px-6 py-5">
                <EditForm Model="SaveInput" FormName="save-almacen" OnValidSubmit="CreateAsync" Enhance="true">
                    <DataAnnotationsValidator />
                    <AlmacenFields Model="SaveInput!" Prefix="SaveInput" />
                    <div class="mt-5">
                        <button type="submit"
                                class="btn-press flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 transition-colors shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            Agregar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Modificar -->
    @if (canModify)
    {
        <div id="modificar" class="rounded-2xl border border-amber-200 bg-white shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-amber-50 border-b border-amber-100 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-amber-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                </svg>
                <h2 class="text-sm font-bold text-amber-800">Modificar almacén</h2>
            </div>
            <div class="px-6 py-5">
                @if (EditId.HasValue && UpdateInput?.Id != EditId)
                {
                    <MessageBox Type="warning" Message="No se encontró el almacén seleccionado. Puede haber sido eliminado por otro usuario." />
                }
                <EditForm Model="UpdateInput" FormName="update-almacen" OnValidSubmit="UpdateAsync" Enhance="true">
                    <DataAnnotationsValidator />
                    <input type="hidden" name="UpdateInput.Id" value="@UpdateInput!.Id" />
                    <AlmacenFields Model="UpdateInput!" Prefix="UpdateInput" />
                    <div class="mt-5">
                        <button type="submit"
                                class="btn-press flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600 transition-colors shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                            </svg>
                            Guardar cambios
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

</div>

@if (DeleteId.HasValue && canDelete)
{
    <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará el almacén seleccionado y no se puede deshacer." Variant="danger" CancelHref="/almacenes">
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-mono text-red-900">@((itemToDelete is null) ? DeleteId.Value.ToString() : $"{itemToDelete.Codigo} — {itemToDelete.Nombre}")</p>
        @if (itemToDelete is { EsPredeterminado: true })
        {
            <div class="mt-3">
                <MessageBox Type="warning" Message="Este es el almacén predeterminado; la API rechazará la eliminación." />
            </div>
        }
        <EditForm Model="DeleteInput" FormName="delete-almacen" OnValidSubmit="DeleteAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.Id" value="@DeleteId" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, eliminar</button>
            <a href="/almacenes" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@code {
    [SupplyParameterFromForm(FormName = "save-almacen")]
    private AlmacenForm? SaveInput { get; set; }

    [SupplyParameterFromForm(FormName = "update-almacen")]
    private AlmacenForm? UpdateInput { get; set; }

    [SupplyParameterFromForm(FormName = "delete-almacen")]
    private DeleteForm? DeleteInput { get; set; }

    [SupplyParameterFromQuery(Name = "codigo")]
    private string? SearchCodigo { get; set; }

    [SupplyParameterFromQuery(Name = "nombre")]
    private string? SearchNombre { get; set; }

    [SupplyParameterFromQuery(Name = "bloqueado")]
    private bool? SearchBloqueado { get; set; }

    [SupplyParameterFromQuery(Name = "editId")]
    private Guid? EditId { get; set; }

    [SupplyParameterFromQuery(Name = "deleteId")]
    private Guid? DeleteId { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int Pagina { get; set; } = 1;

    private IReadOnlyList<AlmacenResponse> almacenes = [];
    // Registro a eliminar, cargado fresco con GetByIdAsync (no buscado en la página de la lista).
    private AlmacenResponse? itemToDelete;
    private long totalAlmacenes;
    private int totalPaginas;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string> errores = [];

    // Permisos computados sincrónicamente en OnInitializedAsync
    private bool canAdd;
    private bool canModify;
    private bool canDelete;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        SaveInput ??= new();
        UpdateInput ??= new();
        DeleteInput ??= new();

        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            var user = authState.User;
            canAdd = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanAdd)).Succeeded;
            canModify = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanModify)).Succeeded;
            canDelete = (await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanDelete)).Succeeded;
        }

        await LoadAsync();

        if (Ok is not null)
        {
            (messageType, message) = Ok switch
            {
                "created" => ("success", "Almacén creado satisfactoriamente."),
                "updated" => ("success", "Almacén modificado satisfactoriamente."),
                "deleted" => ("success", "Almacén eliminado satisfactoriamente."),
                _ => ("info", null)
            };
        }

        if (DeleteId.HasValue && canDelete)
        {
            try
            {
                itemToDelete = await AlmacenApiClient.GetByIdAsync(DeleteId.Value);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load almacén {DeleteId} from API.", DeleteId);
            }
        }

        if (EditId.HasValue && UpdateInput.Id == Guid.Empty)
        {
            try
            {
                var almacen = await AlmacenApiClient.GetByIdAsync(EditId.Value);
                if (almacen is not null)
                {
                    UpdateInput.Id = almacen.Id;
                    UpdateInput.Codigo = almacen.Codigo;
                    UpdateInput.Nombre = almacen.Nombre;
                    UpdateInput.DireccionLinea1 = almacen.DireccionLinea1;
                    UpdateInput.DireccionLinea2 = almacen.DireccionLinea2;
                    UpdateInput.Ciudad = almacen.Ciudad;
                    UpdateInput.PaisCodigo = almacen.PaisCodigo;
                    UpdateInput.Bloqueado = almacen.Bloqueado;
                    UpdateInput.EsPredeterminado = almacen.EsPredeterminado;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load almacén {EditId} from API.", EditId);
                Show("danger", "No fue posible cargar el almacén a modificar.");
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var filter = new AlmacenSearchFilter(EmptyAsNull(SearchCodigo), EmptyAsNull(SearchNombre), SearchBloqueado);
            if (Pagina < 1) Pagina = 1;
            var pagina = await AlmacenApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto));

            // Normaliza una página fuera de rango (p. ej. ?pagina=2 con una sola página) para no
            // mostrar "página 2 de 1" ni una tabla vacía con registros existentes.
            if (pagina.TotalPaginas == 0)
            {
                Pagina = 1;
            }
            else if (Pagina > pagina.TotalPaginas)
            {
                Pagina = pagina.TotalPaginas;
                pagina = await AlmacenApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto));
            }

            almacenes = pagina.Items;
            totalAlmacenes = pagina.Total;
            totalPaginas = pagina.TotalPaginas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load almacenes from API.");
            Show("danger", "No fue posible cargar los almacenes.");
        }
    }

    private string BuildListUrl(int? pagina = null, Guid? editId = null, Guid? deleteId = null)
    {
        var parameters = new List<string>();
        AddParameter(parameters, "codigo", SearchCodigo);
        AddParameter(parameters, "nombre", SearchNombre);
        if (SearchBloqueado.HasValue) parameters.Add($"bloqueado={(SearchBloqueado.Value ? "true" : "false")}");
        var paginaEfectiva = pagina ?? Pagina;
        if (paginaEfectiva > 1) parameters.Add($"pagina={paginaEfectiva}");
        if (editId.HasValue) parameters.Add($"editId={editId.Value}");
        if (deleteId.HasValue) parameters.Add($"deleteId={deleteId.Value}");
        return parameters.Count == 0 ? "/almacenes" : $"/almacenes?{string.Join("&", parameters)}";
    }

    private static void AddParameter(List<string> parameters, string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value)) parameters.Add($"{key}={Uri.EscapeDataString(value)}");
    }

    private async Task CreateAsync() => await ExecuteAsync(() => AlmacenApiClient.CreateAsync(ToInput(SaveInput!)), "created");

    private async Task UpdateAsync()
    {
        if (UpdateInput!.Id == Guid.Empty)
        {
            Show("warning", "Seleccione primero un registro a modificar desde la tabla.");
            return;
        }

        await ExecuteAsync(() => AlmacenApiClient.UpdateAsync(UpdateInput.Id, ToInput(UpdateInput)), "updated");
    }

    private async Task DeleteAsync() => await ExecuteAsync(() => AlmacenApiClient.DeleteAsync(DeleteInput!.Id), "deleted");

    private async Task ExecuteAsync(Func<Task<AlmacenOperationResult>> operation, string successCode)
    {
        try
        {
            var result = await operation();
            if (result.Succeeded)
            {
                Nav.NavigateTo($"/almacenes?ok={successCode}");
            }
            else
            {
                errores = result.Errors ?? [];
                Show("warning", result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not complete almacén operation.");
            Show("danger", "No fue posible completar la operación.");
        }
    }

    private void Show(string type, string text) { messageType = type; message = text; }

    // OJO: a diferencia del filtro (donde "" debe volverse null para no filtrar), aquí "" se envía
    // TAL CUAL (nunca se convierte a null) para Dirección/Ciudad/País. La API trata null como
    // "conservar el valor actual" en el PUT (ver UpdateAlmacenCommand); como este formulario es de
    // un solo paso y reenvía siempre el valor visible, "" significa que el usuario dejó/dejó vacío
    // el campo y debe limpiarlo (el handler normaliza "" a null internamente), no "no tocar". El
    // binder de formularios SSR ya entrega "" (nunca null) para un input de texto vacío, así que no
    // hace falta normalizar aquí.
    private static AlmacenInput ToInput(AlmacenForm form) => new(
        form.Codigo.Trim(),
        form.Nombre.Trim(),
        form.DireccionLinea1?.Trim() ?? string.Empty,
        form.DireccionLinea2?.Trim() ?? string.Empty,
        form.Ciudad?.Trim() ?? string.Empty,
        form.PaisCodigo?.Trim() ?? string.Empty,
        form.Bloqueado,
        form.EsPredeterminado);

    private static string? EmptyAsNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public sealed class AlmacenForm
    {
        public Guid Id { get; set; }

