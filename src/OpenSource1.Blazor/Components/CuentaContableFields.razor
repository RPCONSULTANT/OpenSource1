@using OpenSource1.Blazor.Components.Pages
@using OpenSource1.Core.Enums

@*
    CuentaContableFields — campos reutilizables para crear / modificar una CuentaContable.

    Requiere el parámetro Prefix con el nombre exacto de la propiedad
    [SupplyParameterFromForm] del componente padre:
      - Agregar:   Prefix="SaveInput"
      - Modificar: Prefix="UpdateInput"

    El FormDataMapper de Blazor SSR usa el nombre del parámetro como prefijo.
*@

<div class="space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_Numero")">
                Número <span class="text-red-500">*</span>
            </label>
            <input id="@($"{Prefix}_Numero")"
                   type="text"
                   name="@($"{Prefix}.Numero")"
                   value="@Model.Numero"
                   maxlength="20"
                   placeholder="ej. 1101"
                   class="@InputCss" />
            <ValidationMessage For="() => Model.Numero" />
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_Sangria")">Sangría (0-10)</label>
            <input id="@($"{Prefix}_Sangria")"
                   type="number"
                   name="@($"{Prefix}.Sangria")"
                   value="@Model.Sangria"
                   min="0"
                   max="10"
                   class="@InputCss" />
            <ValidationMessage For="() => Model.Sangria" />
        </div>
    </div>

    <div>
        <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_Nombre")">
            Nombre <span class="text-red-500">*</span>
        </label>
        <input id="@($"{Prefix}_Nombre")"
               type="text"
               name="@($"{Prefix}.Nombre")"
               value="@Model.Nombre"
               maxlength="100"
               placeholder="ej. Caja"
               class="@InputCss" />
        <ValidationMessage For="() => Model.Nombre" />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_TipoCuenta")">Tipo de cuenta</label>
            <select id="@($"{Prefix}_TipoCuenta")" name="@($"{Prefix}.TipoCuenta")" class="@InputCss">
                @foreach (var tipo in Enum.GetValues<TipoCuentaContable>())
                {
                    <option value="@((int)tipo)" selected="@(tipo == Model.TipoCuenta)">@DescribirTipoCuenta(tipo)</option>
                }
            </select>
            <ValidationMessage For="() => Model.TipoCuenta" />
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_TipoResultado")">Tipo de resultado</label>
            <select id="@($"{Prefix}_TipoResultado")" name="@($"{Prefix}.TipoResultado")" class="@InputCss">
                @foreach (var tipo in Enum.GetValues<TipoResultadoCuenta>())
                {
                    <option value="@((int)tipo)" selected="@(tipo == Model.TipoResultado)">@tipo</option>
                }
            </select>
            <ValidationMessage For="() => Model.TipoResultado" />
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_PosteoDirecto")">Posteo directo</label>
            <select id="@($"{Prefix}_PosteoDirecto")" name="@($"{Prefix}.PosteoDirecto")" class="@InputCss">
                <option value="false" selected="@(!Model.PosteoDirecto)">No — solo el sistema</option>
                <option value="true" selected="@Model.PosteoDirecto">Sí — un usuario puede postear</option>
            </select>
            <ValidationMessage For="() => Model.PosteoDirecto" />
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1" for="@($"{Prefix}_Bloqueada")">Bloqueo</label>
            <select id="@($"{Prefix}_Bloqueada")" name="@($"{Prefix}.Bloqueada")" class="@InputCss">
                <option value="false" selected="@(!Model.Bloqueada)">No bloqueada</option>
                <option value="true" selected="@Model.Bloqueada">Bloqueada</option>
            </select>
            <ValidationMessage For="() => Model.Bloqueada" />
        </div>
    </div>
</div>

@code {
    private const string InputCss = "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20";

    [Parameter, EditorRequired] public CuentasContables.CuentaContableForm Model { get; set; } = default!;
    /// <summary>
    /// Nombre exacto del parámetro [SupplyParameterFromForm] en el componente padre.
    /// Ej: "SaveInput" o "UpdateInput"
    /// </summary>
    [Parameter, EditorRequired] public string Prefix { get; set; } = default!;

    private static string DescribirTipoCuenta(TipoCuentaContable tipo) => tipo switch
    {
        TipoCuentaContable.Posteo => "Posteo",
        TipoCuentaContable.Encabezado => "Encabezado",
        TipoCuentaContable.Total => "Total",
        TipoCuentaContable.InicioTotal => "Inicio de total",
        TipoCuentaContable.FinTotal => "Fin de total",
        _ => tipo.ToString()
    };
}
