@* MessageBox – alerta con icono Heroicon, soporte mensaje único o lista de errores *@
@if (!string.IsNullOrWhiteSpace(Message) || (Errors != null && Errors.Count > 0))
{
    <div class="flex items-start gap-3 rounded-xl border px-4 py-3 text-sm @ContainerClass" role="alert">
        <!-- icono -->
        <span class="mt-0.5 shrink-0 @IconClass" aria-hidden="true">
            @if (Type == "success")
            {
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
            }
            else if (Type == "danger")
            {
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
            }
            else if (Type == "warning")
            {
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                </svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                </svg>
            }
        </span>

        <!-- contenido -->
        <div class="flex-1 font-medium">
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <p>@Message</p>
            }
            @if (Errors != null && Errors.Count > 0)
            {
                @if (Errors.Count == 1)
                {
                    <p>@Errors[0]</p>
                }
                else
                {
                    <ul class="list-disc list-inside space-y-0.5 mt-1">
                        @foreach (var error in Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
            }
        </div>
    </div>
}

@code {
    /// <summary>Tipo de alerta: success | danger | warning | info (default)</summary>
    [Parameter] public string Type { get; set; } = "info";

    /// <summary>Mensaje de texto único.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Lista de errores (se muestra como bullets si hay más de uno).</summary>
    [Parameter] public IReadOnlyList<string>? Errors { get; set; }

    private string ContainerClass => Type?.ToLowerInvariant() switch
    {
        "success" => "bg-green-50 border-green-200 text-green-800 dark:bg-green-500/10 dark:border-green-500/30 dark:text-green-400",
        "danger"  => "bg-red-50  border-red-200  text-red-700 dark:bg-red-500/10 dark:border-red-500/30 dark:text-red-400",
        "warning" => "bg-amber-50 border-amber-200 text-amber-800 dark:bg-amber-500/10 dark:border-amber-500/30 dark:text-amber-400",
        _         => "bg-blue-50  border-blue-200  text-blue-800 dark:bg-blue-500/10 dark:border-blue-500/30 dark:text-blue-400"
    };

    private string IconClass => Type?.ToLowerInvariant() switch
    {
        "success" => "text-green-500 dark:text-green-400",
        "danger"  => "text-red-500 dark:text-red-400",
        "warning" => "text-amber-500 dark:text-amber-400",
        _         => "text-blue-500 dark:text-blue-400"
    };
}
