@page "/admin/users"
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@using OpenSource1.Application.Security
@using OpenSource1.Application.Features.Users.Dtos
@using OpenSource1.Blazor.Services
@inject IUserAdminApiClient UserAdminApi
@inject NavigationManager Nav

<PageTitle>Gestión de Usuarios – AxionERP</PageTitle>

<!-- ── Encabezado ── -->
<div class="flex items-center justify-between mb-6 animate-fade-in">
    <div>
        <h1 class="text-xl font-extrabold text-slate-900 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-6 text-brand-600">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
            </svg>
            Gestión de Usuarios
        </h1>
        <p class="text-sm text-slate-500 mt-0.5">Administre los roles y el estado de las cuentas del sistema.</p>
    </div>
</div>

<!-- ── Feedback global ── -->
@if (feedbackMessage is not null)
{
    <div class="mb-4">
        <MessageBox Type="@feedbackType" Message="@feedbackMessage" />
    </div>
}

@if (loadError is not null)
{
    <MessageBox Type="danger" Message="@loadError" />
}
else if (users is null)
{
    <!-- Skeleton loader -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-pulse">
        @for (int i = 0; i < 4; i++)
        {
            <div class="flex items-center gap-4 px-6 py-4 border-b border-slate-100">
                <div class="size-10 rounded-full bg-slate-200 shrink-0"></div>
                <div class="flex-1 space-y-2">
                    <div class="h-4 bg-slate-200 rounded w-1/3"></div>
                    <div class="h-3 bg-slate-200 rounded w-1/2"></div>
                </div>
                <div class="h-7 bg-slate-200 rounded-full w-24"></div>
            </div>
        }
    </div>
}
else if (users.Count == 0)
{
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm px-8 py-12 text-center text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-12 mx-auto mb-3 text-slate-300">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
        <p class="font-semibold">No hay usuarios registrados.</p>
    </div>
}
else
{
    <!-- ── Tabla de usuarios ── -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-x-auto animate-slide-up">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-slate-200 bg-slate-50 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">
                    <th class="px-6 py-3">Usuario</th>
                    <th class="px-6 py-3">Estado</th>
                    <th class="px-6 py-3">Roles asignados</th>
                    <th class="px-6 py-3">Asignar rol</th>
                    <th class="px-6 py-3 text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var user in users)
                {
                    <tr class="hover:bg-slate-50 transition-colors duration-150">
                        <!-- Nombre / Email -->
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="flex size-9 items-center justify-center rounded-full bg-brand-100 text-brand-700 font-bold text-sm shrink-0">
                                    @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                                </div>
                                <div>
                                    <p class="font-semibold text-slate-900">@user.FullName</p>
                                    <p class="text-xs text-slate-400">@user.Email</p>
                                </div>
                            </div>
                        </td>

                        <!-- Estado activo/inactivo -->
                        <td class="px-6 py-4">
                            @if (user.IsActive)
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800">
                                    <span class="size-1.5 rounded-full bg-green-500 inline-block"></span>
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-semibold text-red-700">
                                    <span class="size-1.5 rounded-full bg-red-400 inline-block"></span>
                                    Inactivo
                                </span>
                            }
                        </td>

                        <!-- Roles con botón de quitar -->
                        <td class="px-6 py-4">
                            <div class="flex flex-wrap gap-1.5">
                                @if (user.Roles.Count == 0)
                                {
                                    <span class="text-xs text-slate-400 italic">Sin rol</span>
                                }
                                else
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-semibold text-brand-800">
                                            @role
                                            <!-- Quitar rol: form POST -->
                                            <form method="post" action="/admin/users/remove-role" class="inline">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="UserId" value="@user.Id" />
                                                <input type="hidden" name="Role" value="@role" />
                                                <button type="submit"
                                                        class="ml-0.5 text-brand-500 hover:text-red-600 transition-colors"
                                                        title="Quitar rol @role">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3">
                                                        <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
                                                    </svg>
                                                </button>
                                            </form>
                                        </span>
                                    }
                                }
                            </div>
                        </td>

                        <!-- Selector de rol a asignar -->
                        <td class="px-6 py-4">
                            <form method="post" action="/admin/users/assign-role" class="flex items-center gap-2">
                                <AntiforgeryToken />
                                <input type="hidden" name="UserId" value="@user.Id" />
                                <select name="Role"
                                        class="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none">
                                    @foreach (var role in ApplicationRoles.All)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                                <button type="submit"
                                        class="rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-brand-700 active:scale-95 transition-all duration-150">
                                    Asignar
                                </button>
                            </form>
                        </td>

                        <!-- Toggle activo -->
                        <td class="px-6 py-4 text-right">
                            <form method="post" action="/admin/users/toggle-active">
                                <AntiforgeryToken />
                                <input type="hidden" name="UserId" value="@user.Id" />
                                <button type="submit"
                                        class="@(user.IsActive
                                            ? "rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100 active:scale-95 transition-all duration-150"
                                            : "rounded-lg border border-green-200 bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-700 hover:bg-green-100 active:scale-95 transition-all duration-150")">
                                    @(user.IsActive ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<UserSummaryResponse>? users;
    private string? loadError;
    private string feedbackType = "success";
    private string? feedbackMessage;

    [SupplyParameterFromQuery(Name = "ok")]
    private string? OkMessage { get; set; }

    [SupplyParameterFromQuery(Name = "err")]
    private string? ErrMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (OkMessage is not null)
        {
            feedbackType = "success";
            feedbackMessage = OkMessage;
        }
        else if (ErrMessage is not null)
        {
            feedbackType = "danger";
            feedbackMessage = ErrMessage;
        }

        var (result, error) = await UserAdminApi.ListUsersAsync();
        if (error is not null)
            loadError = error;
        else
            users = result;
    }
}
