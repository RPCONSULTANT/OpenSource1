@page "/productos"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Productos.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@inject IProductoApiClient ProductoApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<Productos> Logger
@inject NavigationManager Nav

<PageTitle>Productos – AxionERP</PageTitle>

<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between animate-fade-in">
    <div>
        <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Mantenimiento</p>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight dark:text-slate-100">Productos</h1>
        <p class="text-sm text-slate-500 mt-1 dark:text-slate-400">Listado principal con búsqueda, filtros y reportería.</p>
    </div>
    <div class="flex items-center gap-3 flex-wrap">
        <a href="@BuildListUrl(view: "grid")" title="Vista cuadrícula" class="btn-press inline-flex items-center justify-center size-10 rounded-lg border shadow-sm @(IsListView ?"border-slate-300 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60" : "border-brand-200 bg-brand-50 text-brand-700 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-400")"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 8.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 8.25 20.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" /></svg></a>
        <a href="@BuildListUrl(view: "list")" title="Vista lista" class="btn-press inline-flex items-center justify-center size-10 rounded-lg border shadow-sm @(IsListView ?"border-brand-200 bg-brand-50 text-brand-700 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-400" : "border-slate-300 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60")"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12m-12 5.25h12m-12 5.25h12M3.75 6.75h.008v.008H3.75V6.75Zm0 5.25h.008v.008H3.75V12Zm0 5.25h.008v.008H3.75v-.008Z" /></svg></a>
        <a href="@BuildListUrl(report: true)" class="btn-press inline-flex items-center gap-2 rounded-lg border border-brand-200 bg-brand-50 px-4 py-2 text-sm font-semibold text-brand-700 shadow-sm hover:bg-brand-100 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-400 dark:hover:bg-brand-500/20"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 21V5.25A2.25 2.25 0 0 0 17.25 3H6.75A2.25 2.25 0 0 0 4.5 5.25V21m15 0h1.125a1.125 1.125 0 1 0 0-2.25H19.5M4.5 21H3.375a1.125 1.125 0 1 1 0-2.25H4.5m3-13.5h9m-9 4.5h9m-9 4.5h5.25" /></svg>Reporte</a>
        <a href="/dashboard/productos" title="Panel con gráficos de productos" class="btn-press inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>Panel</a>
        <a href="/reports/productos/raw.xlsx" title="Descarga todos los productos con todos los campos, sin filtros (para Power BI u otras herramientas)" class="btn-press inline-flex items-center gap-2 rounded-lg border border-green-200 bg-green-50 px-4 py-2 text-sm font-semibold text-green-700 shadow-sm hover:bg-green-100 dark:border-green-500/30 dark:bg-green-500/10 dark:text-green-400 dark:hover:bg-green-500/20"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>Excel (datos crudos)</a>
        @if (canAdd)
        {
            <a href="/productos/new" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>Nuevo</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">@(messageType == "success" ? (RenderFragment)(@<ActionFeedback Type="success" Message="@message" />) : @<MessageBox Type="@messageType" Message="@message" />)</div>
}

<div class="mb-8 grid grid-cols-1 gap-6 items-start @GridColsClass animate-slide-up">
@if (ShowFactbox)
{
    var factProducto = productos.FirstOrDefault(x => x.Id == FocusProductoId!.Value);
    <aside class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden sticky top-24 dark:border-slate-700 dark:bg-slate-800">
        <div class="px-5 py-4 border-b border-slate-100 bg-slate-50 flex items-start justify-between gap-3 dark:border-slate-700/60 dark:bg-slate-900/40">
            <div>
                <h2 class="text-sm font-bold uppercase tracking-wide text-slate-800 dark:text-slate-200">Detalles</h2>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Detalle visual del registro seleccionado.</p>
            </div>
            <a href="@BuildListUrl()" title="Cerrar detalles" class="btn-press inline-flex items-center justify-center size-7 rounded-lg border border-slate-200 bg-white text-slate-500 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">✕</a>
        </div>
        <div class="p-5">
            @if (factProducto is null)
            {
                <div class="flex h-48 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-sm text-slate-400 dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-500">Sin registro</div>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(factProducto.ImagePath))
                {
                    <img src="@factProducto.ImagePath" alt="Imagen del producto" class="h-48 w-full rounded-2xl object-cover border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-900/40" />
                }
                else
                {
                    <div class="flex h-48 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-sm text-slate-400 dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-500">Sin imagen</div>
                }
                <div class="mt-4 space-y-3 text-sm">
                    <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">General</p><p class="mt-1 font-semibold text-slate-800 dark:text-slate-200">@factProducto.Nombre</p></div>
                    <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Código</p><p class="mt-1 text-slate-700 dark:text-slate-300">@factProducto.Codigo</p></div>
                    <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Precio</p><p class="mt-1 text-slate-700 dark:text-slate-300">@factProducto.Precio.ToString("N2")</p></div>
                    <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Stock</p><p class="mt-1 text-slate-700 dark:text-slate-300">@factProducto.Stock</p></div>
                    <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Categoría</p><p class="mt-1 text-slate-700 dark:text-slate-300">@factProducto.Categoria</p></div>
                </div>
            }
        </div>
    </aside>
}

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden dark:border-slate-700 dark:bg-slate-800">
    <form method="get" action="/productos" data-enhance class="border-b border-slate-100 p-4 sm:p-6 dark:border-slate-700/60">
        <input type="hidden" name="showFilters" value="@(ShowFilters ? "true" : "false")" />
        <input type="hidden" name="view" value="@(View ?? "grid")" />
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="relative flex-1 max-w-2xl">
                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400 dark:text-slate-500">🔎</span>
                <input type="text" name="nombre" value="@SearchNombre" placeholder="Buscar por nombre del producto" class="block w-full rounded-xl border border-slate-300 bg-slate-50 py-3 pl-10 pr-4 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-200" />
            </div>
            <div class="flex items-center gap-3">
                <button type="submit" title="Buscar" class="btn-press inline-flex items-center justify-center size-11 rounded-lg bg-brand-600 text-white shadow-sm hover:bg-brand-700"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m0 0A7.95 7.95 0 1 0 5.4 5.4a7.95 7.95 0 0 0 11.25 11.25Z" /></svg></button>
                <a href="@BuildListUrl(showFilters: !ShowFilters)" title="@(ShowFilters ? "Ocultar filtros" : "Filtros")" class="btn-press inline-flex items-center justify-center size-11 rounded-lg border shadow-sm @(ShowFilters ?"border-brand-200 bg-brand-50 text-brand-700 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-400" : "border-slate-300 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60")"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h18M6.75 12h10.5m-7.5 7.5h4.5" /></svg></a>
                <a href="/productos" title="Limpiar" class="inline-flex items-center justify-center size-11 rounded-lg border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg></a>
            </div>
        </div>
    </form>

    <div class="flex items-center justify-between gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/70 dark:border-slate-700/60 dark:bg-slate-900/40">
        <div>
            <h2 class="text-sm font-bold text-slate-800 dark:text-slate-200">Listado de productos</h2>
            <p class="text-xs text-slate-500 mt-0.5 dark:text-slate-400">@productos.Count resultado(s) encontrados.</p>
        </div>
    </div>

    @if (productos.Count == 0)
    {
        <div class="px-6 py-14 text-center text-slate-400 dark:text-slate-500"><p class="font-semibold text-slate-500 dark:text-slate-400">No encontramos productos con esos criterios.</p></div>
    }
    else
    {
        <form id="productos-report-form" method="post" action="/reports/productos/selected" class="@(IsListView ?"block" : "flex flex-col gap-4 p-4 sm:p-6")">
            <AntiforgeryToken />
            @if (IsListView)
            {
                <div class="overflow-x-auto p-4 sm:p-6">
                    <table class="min-w-full divide-y divide-slate-100 text-sm dark:divide-slate-700/60">
                        <thead class="bg-slate-50 dark:bg-slate-900/40">
                            <tr>
                                <th class="px-4 py-3 text-left"><span class="sr-only">Seleccionar</span></th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Código</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Nombre</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Precio</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Stock</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Categoría</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50 bg-white dark:divide-slate-700/40 dark:bg-slate-800">
                            @foreach (var producto in productos)
                            {
                                <tr @key="producto.Id" class="hover:bg-slate-50 dark:hover:bg-slate-700/60">
                                    <td class="px-4 py-3"><input type="checkbox" name="SelectedIds" value="@producto.Id" checked="@(producto.Id == FocusProductoId)" onchange="@EntityFabOnChange" class="size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-600 dark:border-slate-600" /></td>
                                    <td class="px-4 py-3 font-semibold text-slate-800 dark:text-slate-200">@producto.Codigo</td>
                                    <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@producto.Nombre</td>
                                    <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@producto.Precio.ToString("N2")</td>
                                    <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@producto.Stock</td>
                                    <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@producto.Categoria</td>
                                    <td class="px-4 py-3 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <a href="/productos/@producto.Id" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60" title="Ver ficha">👁</a>
                                            @if (canModify)
                                            {
                                                <a href="/productos/@producto.Id?edit=true" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100" title="Editar ficha">✎</a>
                                            }
                                            @if (canDelete)
                                            {
                                                <a href="@BuildListUrl(deleteId: producto.Id)" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100" title="Eliminar desde listado">🗑</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                @foreach (var producto in productos)
                {
                    <article @key="producto.Id" class="rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md hover:border-brand-200 transition-all duration-200 overflow-hidden dark:border-slate-700 dark:bg-slate-800">
                        <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-start lg:p-6">
                            <div class="min-w-0 sm:w-52 sm:shrink-0">
                                <p class="text-xs font-bold uppercase tracking-wide text-slate-400 mb-1 dark:text-slate-500">General</p>
                                <h3 class="text-lg font-extrabold text-slate-900 truncate dark:text-slate-100" title="@producto.Nombre">@producto.Nombre</h3>
                                <p class="mt-1 text-sm text-slate-500 truncate dark:text-slate-400">Código: <span class="font-semibold text-slate-700 dark:text-slate-300">@producto.Codigo</span></p>
                            </div>
                            <div class="grid min-w-0 flex-1 grid-cols-1 gap-3 text-sm sm:grid-cols-3">
                                <div class="min-w-0 rounded-xl border border-slate-100 bg-slate-50 px-3 py-2.5 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Precio</p><p class="mt-1 truncate text-slate-700 dark:text-slate-300">@producto.Precio.ToString("N2")</p></div>
                                <div class="min-w-0 rounded-xl border border-slate-100 bg-slate-50 px-3 py-2.5 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Stock</p><p class="mt-1 truncate text-slate-700 dark:text-slate-300">@producto.Stock</p></div>
                                <div class="min-w-0 rounded-xl border border-slate-100 bg-slate-50 px-3 py-2.5 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Categoría</p><p class="mt-1 truncate text-slate-700 dark:text-slate-300" title="@producto.Categoria">@producto.Categoria</p></div>
                            </div>
                            <div class="flex shrink-0 items-center gap-2">
                                <label class="inline-flex items-center justify-center size-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 cursor-pointer dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60" title="Seleccionar"><input type="checkbox" name="SelectedIds" value="@producto.Id" checked="@(producto.Id == FocusProductoId)" onchange="@EntityFabOnChange" class="size-4 rounded border-slate-300 text-brand-600 focus:ring-brand-600 dark:border-slate-600" /></label>
                                <a href="/productos/@producto.Id" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60" title="Ver ficha">👁</a>
                                @if (canModify)
                                {
                                    <a href="/productos/@producto.Id?edit=true" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100" title="Editar ficha">✎</a>
                                }
                                @if (canDelete)
                                {
                                    <a href="@BuildListUrl(deleteId: producto.Id)" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100" title="Eliminar desde listado">🗑</a>
                                }
                            </div>
                        </div>
                        <div class="border-t border-slate-100 px-6 py-3 bg-slate-50/60 flex items-center justify-between gap-3 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs text-slate-400 dark:text-slate-500">Actualizado: @(producto.UpdatedAtUtc?.ToLocalTime().ToString("g") ?? producto.CreatedAtUtc.ToLocalTime().ToString("g"))</p><a href="/productos/@producto.Id" class="text-sm font-semibold text-brand-600 hover:text-brand-700">Abrir ficha</a></div>
                    </article>
                }
            }
        </form>
    }
</div>

@if (ShowFilters)
{
    <aside class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-fade-in sticky top-24 dark:border-slate-700 dark:bg-slate-800">
        <form method="get" action="/productos" data-enhance class="p-5 space-y-4">
            <input type="hidden" name="showFilters" value="true" />
            <input type="hidden" name="view" value="@(View ?? "grid")" />
            <input type="hidden" name="filters" value="@string.Join(",", ActiveFilterFields)" />
            <div>
                <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide dark:text-slate-200">Filtros</h2>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Agregue campos a la lista y combine valores con <code>*</code> (comodín), <code>||</code> (o) y <code>&amp;&amp;</code> (y).</p>
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300">Nombre</label>
                <input type="text" name="nombre" value="@SearchNombre" placeholder="ej: mesa, *mesa*, mesa||silla" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200" />
            </div>
            @foreach (var field in ActiveFilterFields)
            {
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300">@FieldLabel(field)</label>
                        <a href="@BuildListUrl(activeFiltersOverride: ActiveFilterFields.Where(f => f != field).ToList())" title="Quitar campo" class="text-xs font-semibold text-red-600 hover:text-red-700">✕ quitar</a>
                    </div>
                    <input type="text" name="@field" value="@GetFieldValue(field)" placeholder="ej: valor, *valor*, a||b, a&&b" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200" />
                </div>
            }
            @if (AvailableFields.Count > 0)
            {
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300">Agregar campo</label>
                    <select name="addField" onchange="this.form.requestSubmit()" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
                        <option value="">-- Seleccionar campo --</option>
                        @foreach (var field in AvailableFields)
                        {
                            <option value="@field.Key">@field.Label</option>
                        }
                    </select>
                </div>
            }
            <div class="flex items-center gap-3 pt-2">
                <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Aplicar</button>
                <a href="@BuildListUrl(activeFiltersOverride: [])" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Limpiar todo</a>
            </div>
        </form>
    </aside>
}
