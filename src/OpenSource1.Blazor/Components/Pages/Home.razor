@page "/"

<PageTitle>Inicio – AxionERP</PageTitle>

<!-- ── Hero animado ── -->
<div class="relative rounded-2xl bg-gradient-to-br from-brand-700 via-brand-600 to-brand-800 text-white px-8 py-12 mb-6 shadow-lg overflow-hidden animate-fade-in">
    <!-- Decoración de fondo -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>

    <div class="relative z-10">
        <div class="flex items-center gap-3 mb-4 animate-slide-in-left">
            <div class="flex size-12 items-center justify-center rounded-xl bg-white/15 backdrop-blur-sm animate-pulse-glow">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="white" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
                </svg>
            </div>
            <div>
                <p class="text-xs font-bold tracking-widest uppercase text-brand-200">Sistema Integral</p>
                <h1 class="text-2xl font-extrabold tracking-tight leading-tight">AxionERP</h1>
            </div>
        </div>
        <p class="text-brand-100 text-sm max-w-xl animate-slide-up">
            Gestión Empresarial con Control de Acceso por Roles · Blazor + API JWT + SQL Server
        </p>
    </div>
</div>

<AuthorizeView>
    <Authorized Context="auth">

        <!-- ── Bienvenida y rol del usuario ── -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

            <!-- Card: bienvenida -->
            <div class="md:col-span-2 rounded-2xl border border-slate-200 bg-white shadow-sm px-6 py-5 animate-slide-up flex items-center gap-4">
                <div class="flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5">Sesión activa</p>
                    <p class="text-lg font-bold text-slate-900">Bienvenido, @auth.User.Identity?.Name</p>
                    <p class="text-sm text-slate-500">Ha iniciado sesión correctamente en el sistema.</p>
                </div>
            </div>

            <!-- Card: rol del usuario -->
            <div class="rounded-2xl border border-brand-200 bg-brand-50 shadow-sm px-6 py-5 animate-pop flex flex-col justify-center">
                <p class="text-xs font-bold tracking-widest uppercase text-brand-500 mb-2">Tu rol actual</p>
                @foreach (var role in auth.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))
                {
                    <div class="flex items-center gap-2 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5 text-brand-600 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                        </svg>
                        <span class="text-base font-extrabold text-brand-800">@role</span>
                    </div>
                }
            </div>
        </div>

        <!-- ── Permisos activos ── -->
        <h2 class="text-sm font-bold text-slate-600 mb-3 flex items-center gap-2 animate-fade-in">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4 text-brand-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
            Acciones habilitadas para tu rol
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
            <AuthorizeView Policy="@ApplicationPolicies.CanConsult">
                <Authorized>
                    <div class="flex flex-col items-center gap-2 rounded-xl border border-blue-200 bg-blue-50 px-4 py-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 animate-pop" style="animation-delay:0.05s">
                        <span class="inline-flex size-10 items-center justify-center rounded-full bg-blue-100 text-blue-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                        </span>
                        <span class="text-sm font-bold text-blue-800">Consultar</span>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="@ApplicationPolicies.CanAdd">
                <Authorized>
                    <div class="flex flex-col items-center gap-2 rounded-xl border border-green-200 bg-green-50 px-4 py-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 animate-pop" style="animation-delay:0.10s">
                        <span class="inline-flex size-10 items-center justify-center rounded-full bg-green-100 text-green-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                        </span>
                        <span class="text-sm font-bold text-green-800">Agregar</span>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="@ApplicationPolicies.CanModify">
                <Authorized>
                    <div class="flex flex-col items-center gap-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 animate-pop" style="animation-delay:0.15s">
                        <span class="inline-flex size-10 items-center justify-center rounded-full bg-amber-100 text-amber-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                            </svg>
                        </span>
                        <span class="text-sm font-bold text-amber-800">Modificar</span>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="@ApplicationPolicies.CanDelete">
                <Authorized>
                    <div class="flex flex-col items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 animate-pop" style="animation-delay:0.20s">
                        <span class="inline-flex size-10 items-center justify-center rounded-full bg-red-100 text-red-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                        </span>
                        <span class="text-sm font-bold text-red-800">Eliminar</span>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <!-- ── Acceso rápido ── -->
        <div class="animate-slide-up-slow">
            <a href="/app-settings"
               class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700 active:scale-95 transition-all duration-150 shadow-md hover:shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>
                Ir a Configuraciones
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
            </a>
        </div>

    </Authorized>

    <NotAuthorized>
        <!-- ── Vista pública: invitación a iniciar sesión ── -->
        <div class="rounded-2xl border border-slate-200 bg-white px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm animate-slide-up mb-6">
            <div>
                <h2 class="text-lg font-bold text-slate-800 mb-1">Bienvenido a AxionERP</h2>
                <p class="text-sm text-slate-500 max-w-sm">
                    Sistema Integral de Gestión Empresarial con control de acceso por roles.
                    Inicie sesión para acceder al panel según sus permisos.
                </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 shrink-0">
                <a href="/account/register"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-brand-200 bg-brand-50 px-5 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-100 transition-all duration-150">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                    </svg>
                    Registrarse
                </a>
                <a href="/account/login"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition-all duration-150 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15M12 9l3 3m0 0-3 3m3-3H2.25" />
                    </svg>
                    Iniciar Sesión
                </a>
            </div>
        </div>

        <!-- ── Características del sistema ── -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-slide-up-slow">
            <div class="rounded-xl border border-slate-200 bg-white px-5 py-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
                <div class="flex size-10 items-center justify-center rounded-lg bg-brand-50 text-brand-600 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                    </svg>
                </div>
                <p class="font-bold text-slate-800 mb-1">Control de Roles</p>
                <p class="text-xs text-slate-500">Administrador, Supervisor y Ejecutor con permisos granulares.</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-5 py-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
                <div class="flex size-10 items-center justify-center rounded-lg bg-green-50 text-green-600 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 2.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                    </svg>
                </div>
                <p class="font-bold text-slate-800 mb-1">CRUD Completo</p>
                <p class="text-xs text-slate-500">Operaciones de creación, lectura, actualización y eliminación.</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-5 py-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
                <div class="flex size-10 items-center justify-center rounded-lg bg-amber-50 text-amber-600 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                    </svg>
                </div>
                <p class="font-bold text-slate-800 mb-1">Acceso Seguro</p>
                <p class="text-xs text-slate-500">JWT + Cookie HttpOnly + bloqueo por intentos fallidos.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
