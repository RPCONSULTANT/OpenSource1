                <button type="submit" formaction="/reports/productos/selected.xlsx" class="btn-press rounded-lg border border-green-200 bg-green-50 px-4 py-2 text-sm font-semibold text-green-700 hover:bg-green-100">Exportar Excel</button>
                <a href="@BuildListUrl(report: false)" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a>
            </div>
        </form>
    </ConfirmDialog>
