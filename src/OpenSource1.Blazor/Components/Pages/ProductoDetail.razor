@page "/productos/{Id:guid}"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Productos.Dtos
@using OpenSource1.Application.Security
@using System.Globalization
@using OpenSource1.Blazor.Services
@inject IProductoApiClient ProductoApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<ProductoDetail> Logger
@inject NavigationManager Nav

<PageTitle>Ficha producto – AxionERP</PageTitle>
@* Barra común (Fix-Features C2): Crear ▾ / Ver ▾ del producto, Editar (vuelve a esta ficha) y Eliminar (confirmación en la ficha).
   Sin producto cargado no hay selección: las acciones salen deshabilitadas. *@
<PageToolbar Titulo="@(producto?.Nombre ?? "Producto")" Subtitulo="@(producto is null ? null : $"Código {producto.Codigo}")"
             Migas="@migas" Permisos="@permisos"
             SeleccionId="@(producto?.Id.ToString())"
             Crear="@AccionesProducto.Crear" Ver="@AccionesProducto.VerDesdeFicha" RetornoUrl="@($"/productos/{Id}")"
             EditarUrl="@(_ => UrlEditar)"
             EliminarUrl="@(_ => BuildDetailUrl(delete: true))" />
@if (!string.IsNullOrWhiteSpace(message) || errores.Count > 0){<div class="mb-6">@(messageType == "success" ? (RenderFragment)(@<ActionFeedback Type="success" Message="@message" />) : @<MessageBox Type="@messageType" Message="@message" Errors="@errores" />)</div>}
@if (loadError is not null){<MessageBox Type="danger" Message="@loadError" />} else if (producto is null){<div class="rounded-2xl border border-slate-200 bg-white px-8 py-12 text-center text-slate-400 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-500"><p class="font-semibold text-slate-500 dark:text-slate-400">No se encontró el producto solicitado.</p></div>} else {<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-5xl dark:border-slate-700 dark:bg-slate-800"><div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex items-start justify-between gap-4 dark:border-slate-700/60 dark:bg-slate-900/40"><div><h2 class="text-xl font-extrabold text-slate-900 dark:text-slate-100">@producto.Nombre</h2><p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Código: <span class="font-semibold text-slate-700 dark:text-slate-300">@producto.Codigo</span></p></div></div><div class="px-6 py-6"><div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-6 items-start"><div><p class="text-sm font-semibold text-slate-700 mb-2 dark:text-slate-300">Imagen</p>@if (!string.IsNullOrWhiteSpace(producto.ImagePath)){<img src="@producto.ImagePath" alt="Imagen del producto" class="h-40 w-40 rounded-2xl object-cover border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-900/40" />} else {<div class="flex h-40 w-40 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-slate-400 text-sm dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-500">Sin imagen</div>}</div><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Precio de venta</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.PrecioVenta.ToString("N2", CultureInfo.InvariantCulture)</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Existencia</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@ProductoEtiquetas.Existencia(producto.Existencia, producto.UnidadMedidaBaseDecimales)</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Categoría</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.CategoriaNombre <span class="text-slate-400 dark:text-slate-500">(@producto.CategoriaCodigo)</span></p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Unidad de medida base</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.UnidadMedidaNombre <span class="text-slate-400 dark:text-slate-500">(@producto.UnidadMedidaCodigo)</span></p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Método de costeo</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@ProductoEtiquetas.Metodo(producto.MetodoCosteo)</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Bloqueo</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@ProductoEtiquetas.Bloqueo(producto.Bloqueado)</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Costo unitario</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.CostoUnitario.ToString("N2", CultureInfo.InvariantCulture) <span class="text-slate-400 dark:text-slate-500">(@(producto.CostoAjustado ? "ajustado" : "pendiente de ajuste"))</span></p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Costo estándar</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.CostoEstandar.ToString("N2", CultureInfo.InvariantCulture)</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 md:col-span-2 dark:border-slate-700/60 dark:bg-slate-900/40" data-testid="producto-grupos"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Clasificación contable</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">Producto: <span class="font-semibold">@RotuloGrupo(producto.GrupoProductoId, producto.GrupoProductoCodigo)</span> · IVA: <span class="font-semibold">@RotuloGrupo(producto.GrupoIvaProductoId, producto.GrupoIvaProductoCodigo)</span> · Inventario: <span class="font-semibold">@RotuloGrupo(producto.GrupoInventarioId, producto.GrupoInventarioCodigo)</span></p></div></div></div></div></div>}
@if (producto is not null){<div class="mt-6 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-5xl dark:border-slate-700 dark:bg-slate-800"><div class="px-6 py-4 border-b border-slate-100 bg-slate-50 dark:border-slate-700/60 dark:bg-slate-900/40"><h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide dark:text-slate-200">Existencia por almacén</h2></div><div class="px-6 py-6">@if (existenciasError is not null){<MessageBox Type="warning" Message="@existenciasError" />} else if (existenciasPorAlmacen is null or { Count: 0 }){<p class="text-sm text-slate-400">Sin movimientos registrados en ningún almacén.</p>} else {<table class="min-w-full divide-y divide-slate-100 text-sm dark:divide-slate-700/60"><thead><tr><th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Almacén</th><th class="px-4 py-2 text-right text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Existencia</th></tr></thead><tbody class="divide-y divide-slate-50 dark:divide-slate-700/40">@foreach (var fila in existenciasPorAlmacen){<tr @key="fila.AlmacenId"><td class="px-4 py-2 text-slate-700 dark:text-slate-300">@fila.AlmacenNombre <span class="text-slate-400 dark:text-slate-500">(@fila.AlmacenCodigo)</span></td><td class="px-4 py-2 text-right text-slate-700 dark:text-slate-300">@ProductoEtiquetas.Existencia(fila.Existencia, producto.UnidadMedidaBaseDecimales)</td></tr>}</tbody></table>}</div></div>}
@if (DeleteMode && producto is not null && permisos?.CanDelete == true){<ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará el producto desde su ficha y no se puede deshacer." Variant="danger" CancelHref="@BuildDetailUrl()"><p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-semibold text-red-900">@producto.Nombre</p>@if (!string.IsNullOrWhiteSpace(deleteError)){<div class="mt-4"><MessageBox Type="warning" Message="@deleteError" /></div>}<EditForm Model="DeleteInput" FormName="producto-delete" OnValidSubmit="DeleteAsync" class="mt-4" Enhance="true"><button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">Sí, eliminar</button><a href="@BuildDetailUrl()" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a></EditForm></ConfirmDialog>}
else
{
    @* Diálogo oculto (sin CanDelete, sin ?delete=true o sin ficha): EditForm vacío con el MISMO FormName para que un POST
       obsoleto o forzado llegue al handler y reciba el mensaje real de la API (arriba, en el aviso de la ficha). *@
    <EditForm Model="DeleteInput" FormName="producto-delete" OnValidSubmit="DeleteAsync"></EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }
    // Solo para redirigir la ruta antigua ?edit=true a /productos/{id}/editar (Fix-Features B2c).
    [SupplyParameterFromQuery(Name = "edit")] private bool EditMode { get; set; }
    [SupplyParameterFromQuery(Name = "delete")] private bool DeleteMode { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    [SupplyParameterFromForm(FormName = "producto-delete")] private DeleteConfirmForm? DeleteInput { get; set; }
    private ProductoResponse? producto; private string? message; private string messageType = "info"; private IReadOnlyList<string> errores = []; private string? loadError; private string? deleteError;
    private IReadOnlyList<OpenSource1.Application.Services.Inventario.ExistenciaAlmacen>? existenciasPorAlmacen; private string? existenciasError;
    private PermisosPagina? permisos; [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private static readonly IReadOnlyList<Miga> migas = [new("Productos", "/modulos/productos"), new("Productos", "/productos"), new("Ficha")];
    // Editar abre la página-tarjeta y vuelve a esta ficha.
    private string UrlEditar => RetornoLocal.ConRetorno($"/productos/{Id}/editar", $"/productos/{Id}");
    protected override async Task OnInitializedAsync(){if(EditMode){Nav.NavigateTo(UrlEditar, replace: true); return;} DeleteInput ??= new(); permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask); await LoadAsync(); if(Ok is not null){(messageType, message)=Ok switch {"created"=>("success","Producto creado satisfactoriamente."),"updated"=>("success","Producto modificado satisfactoriamente."),_ =>("info",null)};}}
    private async Task LoadAsync()
    {
        try
        {
            producto = await ProductoApiClient.GetByIdAsync(Id);
            if (producto is null) return;
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not load producto detail."); loadError = "No fue posible cargar la ficha del producto."; return; }
        // Tabla de existencia por almacén (Task 3.6): un fallo (500, proxy caído, tiempo agotado) muestra un aviso propio sin
        // romper el resto de la ficha (que ya cargó con éxito).
        try
        {
            existenciasPorAlmacen = await ProductoApiClient.GetExistenciasAsync(Id);
            // Corrección 1 (menor a): un 404 (el producto se borró entre cargar la ficha y esta llamada, o la API lo
            // reporta así) devuelve null SIN lanzar. Static SSR no vuelve a renderizar tras esta carga inicial, así que
            // dejar existenciasPorAlmacen en null se vería como "Cargando…" para siempre; se trata como no disponible.
            if (existenciasPorAlmacen is null)
            {
                existenciasError = "No fue posible cargar la existencia por almacén en este momento.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load producto existencias.");
            existenciasError = "No fue posible cargar la existencia por almacén en este momento.";
        }
    }
    private async Task DeleteAsync(){var result=await ProductoApiClient.DeleteAsync(Id); if(result.Succeeded){Nav.NavigateTo("/productos?ok=deleted"); return;} if(DeleteMode && producto is not null && permisos?.CanDelete == true) deleteError=result.Message; else { messageType="warning"; message=result.Message; }}
    private string BuildDetailUrl(bool delete=false,string? ok=null){var parameters=new List<string>(); if(delete) parameters.Add("delete=true"); if(!string.IsNullOrWhiteSpace(ok)) parameters.Add($"ok={Uri.EscapeDataString(ok)}"); return parameters.Count==0 ? $"/productos/{Id}" : $"/productos/{Id}?{string.Join("&",parameters)}";}
    private static string RotuloGrupo(Guid? id, string? codigo) => id is null ? "Sin asignar" : codigo ?? $"No disponible ({id})";
    private sealed class DeleteConfirmForm{}
}
