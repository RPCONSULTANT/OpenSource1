@page "/productos/new"
@attribute [Authorize(Policy = ApplicationPolicies.CanAdd)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Storage
@using OpenSource1.Blazor.Services
@inject IProductoApiClient ProductoApiClient
@inject ICategoriaProductoApiClient CategoriaProductoApiClient
@inject IUnidadMedidaApiClient UnidadMedidaApiClient
@inject IHttpContextAccessor HttpContextAccessor
@inject IFileStorageService FileStorageService
@inject ILogger<ProductoNew> Logger
@inject NavigationManager Nav

<PageTitle>Nuevo producto – AxionERP</PageTitle>

<div class="mb-6 flex items-center justify-between gap-4"><div><p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Ficha</p><h1 class="text-2xl font-extrabold text-slate-900 tracking-tight dark:text-slate-100">Crear producto</h1></div><a href="/productos" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Volver al listado</a></div>
@if (!string.IsNullOrWhiteSpace(message) || errores.Count > 0) { <div class="mb-6"><MessageBox Type="@messageType" Message="@message" Errors="@errores" /></div> }
@if (opciones.CargaFallida) { <div class="mb-6"><MessageBox Type="warning" Message="@ProductoOpciones.MensajeNoDisponiblesAlta" /></div> }
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-4xl dark:border-slate-700 dark:bg-slate-800"><div class="px-6 py-4 border-b border-slate-100 bg-slate-50 dark:border-slate-700/60 dark:bg-slate-900/40"><h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide dark:text-slate-200">Nueva ficha</h2></div><div class="px-6 py-6"><EditForm Model="Input" FormName="producto-new" OnValidSubmit="CreateAsync" Enhance="true" enctype="multipart/form-data"><DataAnnotationsValidator /><div class="mb-6"><label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300">Imagen del producto</label><input type="file" name="ProductImage" accept=".jpg,.jpeg,.png,.webp" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300" /><p class="mt-1 text-xs text-slate-400 dark:text-slate-500">Formatos permitidos: JPG, PNG, WEBP. Máximo 2 MB.</p></div><ProductoFields Model="Input!" Prefix="Input" Categorias="@opciones.Categorias" Unidades="@opciones.Unidades" /><div class="mt-6 flex flex-wrap items-center gap-3"><button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Guardar producto</button><a href="/productos" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a></div></EditForm></div></div>

@code {
    [SupplyParameterFromForm(FormName = "producto-new")] private ProductoEditorForm? Input { get; set; }
    private string? message; private string messageType = "danger";
    private IReadOnlyList<string> errores = [];
    private ProductoOpciones opciones = ProductoOpciones.SinCargar;
    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        // Opciones de los <select> de categoría y unidad; si no cargan el alta sigue siendo posible (categoría General, unidad Unidad).
        opciones = await ProductoOpciones.CargarAsync(CategoriaProductoApiClient, UnidadMedidaApiClient, Logger);
    }
    private async Task CreateAsync()
    {
        string? imagenNueva = null;
        try
        {
            var httpContext = HttpContextAccessor.HttpContext ?? throw new InvalidOperationException("No hay HttpContext disponible para cargar la imagen.");
            // El formulario no envía ninguna ruta que el servidor use: en el alta la imagen vigente es null.
            imagenNueva = await FileStorageService.SaveProductImageAsync(httpContext, "ProductImage", null);
            Input!.ImagePath = imagenNueva;
            var result = await ProductoApiClient.CreateAsync(ToInput(Input!));
            if (result.Succeeded) { Nav.NavigateTo(result.EntityId.HasValue ? $"/productos/{result.EntityId.Value}?ok=created" : "/productos?ok=created"); return; }
            await FileStorageService.DeleteIfExistsAsync(imagenNueva, RutaImagen.CarpetaProductos);
            message = result.Message; errores = result.Errors ?? []; messageType = "warning";
        }
        catch (Exception ex)
        {
            await FileStorageService.DeleteIfExistsAsync(imagenNueva, RutaImagen.CarpetaProductos);
            Logger.LogWarning(ex, "Could not create producto."); message = ex is InvalidOperationException ? ex.Message : "No fue posible crear el producto."; messageType = "danger";
        }
    }
    // Alta: CategoriaId/UnidadMedidaBaseId nulos = categoría General y unidad Unidad por defecto (la API los resuelve).
    private static ProductoInput ToInput(ProductoEditorForm form) => new(
        form.Codigo.Trim(),
        form.Nombre.Trim(),
        form.PrecioVenta,
        form.CategoriaId is { } categoriaId && categoriaId != Guid.Empty ? categoriaId : null,
        form.UnidadMedidaBaseId is { } unidadId && unidadId != Guid.Empty ? unidadId : null,
        form.MetodoCosteo,
        form.CostoEstandar,
        form.Bloqueado,
        form.ImagePath);
}
