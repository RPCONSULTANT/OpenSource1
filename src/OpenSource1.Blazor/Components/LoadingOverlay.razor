@* Global loading overlay shown by progressive JavaScript during SSR form submits/navigation. *@
<div id="global-loading-overlay" class="global-loading-overlay" role="status" aria-live="polite" aria-hidden="true">
    <div class="global-loading-card">
        <div class="global-spinner" aria-hidden="true"></div>
        <div>
            <p class="text-sm font-bold text-slate-900">Procesando acción</p>
            <p class="text-xs text-slate-500">Espere un momento...</p>
        </div>
    </div>
</div>
