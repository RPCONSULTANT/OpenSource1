@page "/productos/{Id:guid}"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Productos.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Application.Storage
@using System.Globalization
@using OpenSource1.Blazor.Services
@inject IProductoApiClient ProductoApiClient
@inject ICategoriaProductoApiClient CategoriaProductoApiClient
@inject IUnidadMedidaApiClient UnidadMedidaApiClient
@inject IHttpContextAccessor HttpContextAccessor
@inject IFileStorageService FileStorageService
@inject IAuthorizationService AuthorizationService
@inject ILogger<ProductoDetail> Logger
@inject NavigationManager Nav

<PageTitle>Ficha producto – AxionERP</PageTitle>
<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between"><div><p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Ficha</p><h1 class="text-2xl font-extrabold text-slate-900 tracking-tight dark:text-slate-100">Producto</h1></div><div class="flex items-center gap-3"><a href="/productos" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Volver al listado</a>@if (producto is not null && !EditMode && canModify){<a href="@BuildDetailUrl(edit: true)" class="btn-press inline-flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-600">Editar</a>}</div></div>
@if (!string.IsNullOrWhiteSpace(message) || errores.Count > 0){<div class="mb-6">@(messageType == "success" ? (RenderFragment)(@<ActionFeedback Type="success" Message="@message" />) : @<MessageBox Type="@messageType" Message="@message" Errors="@errores" />)</div>}
@if (EditMode && canModify && producto is not null && edicionBloqueada){<div class="mb-6"><MessageBox Type="danger" Message="@ProductoOpciones.MensajeNoDisponibles" /></div>}
@if (loadError is not null){<MessageBox Type="danger" Message="@loadError" />} else if (producto is null){<div class="rounded-2xl border border-slate-200 bg-white px-8 py-12 text-center text-slate-400 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-500"><p class="font-semibold text-slate-500 dark:text-slate-400">No se encontró el producto solicitado.</p></div>} else {<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-5xl dark:border-slate-700 dark:bg-slate-800"><div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex items-start justify-between gap-4 dark:border-slate-700/60 dark:bg-slate-900/40"><div><h2 class="text-xl font-extrabold text-slate-900 dark:text-slate-100">@producto.Nombre</h2><p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Código: <span class="font-semibold text-slate-700 dark:text-slate-300">@producto.Codigo</span></p></div><div class="flex items-center gap-2">@if (!EditMode && canModify){<a href="@BuildDetailUrl(edit: true)" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100" title="Editar ficha">✎</a>}@if (canDelete){<a href="@BuildDetailUrl(delete: true)" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100" title="Eliminar producto">🗑</a>}</div></div><div class="px-6 py-6">@if (EditMode && canModify){<EditForm Model="Input" FormName="producto-edit" OnValidSubmit="SaveAsync" Enhance="true" enctype="multipart/form-data"><DataAnnotationsValidator /><div class="mb-6 grid grid-cols-1 md:grid-cols-[220px_1fr] gap-6 items-start"><div><p class="text-sm font-semibold text-slate-700 mb-2 dark:text-slate-300">Imagen actual</p>@if (!string.IsNullOrWhiteSpace(producto.ImagePath)){<img src="@producto.ImagePath" alt="Imagen del producto" class="h-40 w-40 rounded-2xl object-cover border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-900/40" />} else {<div class="flex h-40 w-40 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-slate-400 text-sm dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-500">Sin imagen</div>}</div><div><label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300">Cambiar imagen</label><input type="file" name="ProductImage" accept=".jpg,.jpeg,.png,.webp" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300" /><p class="mt-1 text-xs text-slate-400 dark:text-slate-500">Formatos permitidos: JPG, PNG, WEBP. Máximo 2 MB.</p></div></div><ProductoFields Model="Input!" Prefix="Input" EsEdicion="true" Categorias="@opciones.Categorias" Unidades="@opciones.Unidades" CategoriaActualId="@producto.CategoriaId" CategoriaActualNombre="@($"{producto.CategoriaCodigo} — {producto.CategoriaNombre}")" UnidadActualId="@producto.UnidadMedidaBaseId" UnidadActualNombre="@($"{producto.UnidadMedidaNombre} ({producto.UnidadMedidaCodigo})")" /><div class="mt-6 flex flex-wrap items-center gap-3">@if (!edicionBloqueada){<button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Guardar cambios</button>}<a href="@BuildDetailUrl()" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a></div></EditForm>} else {<div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-6 items-start"><div><p class="text-sm font-semibold text-slate-700 mb-2 dark:text-slate-300">Imagen</p>@if (!string.IsNullOrWhiteSpace(producto.ImagePath)){<img src="@producto.ImagePath" alt="Imagen del producto" class="h-40 w-40 rounded-2xl object-cover border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-900/40" />} else {<div class="flex h-40 w-40 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-slate-400 text-sm dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-500">Sin imagen</div>}</div><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Precio de venta</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.PrecioVenta.ToString("N2", CultureInfo.InvariantCulture)</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Existencia</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@ProductoEtiquetas.Existencia(producto.Existencia, producto.UnidadMedidaBaseDecimales)</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Categoría</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.CategoriaNombre <span class="text-slate-400 dark:text-slate-500">(@producto.CategoriaCodigo)</span></p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Unidad de medida base</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.UnidadMedidaNombre <span class="text-slate-400 dark:text-slate-500">(@producto.UnidadMedidaCodigo)</span></p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Método de costeo</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@ProductoEtiquetas.Metodo(producto.MetodoCosteo)</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Bloqueo</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@ProductoEtiquetas.Bloqueo(producto.Bloqueado)</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Costo unitario</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.CostoUnitario.ToString("N2", CultureInfo.InvariantCulture) <span class="text-slate-400 dark:text-slate-500">(@(producto.CostoAjustado ? "ajustado" : "pendiente de ajuste"))</span></p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Costo estándar</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.CostoEstandar.ToString("N2", CultureInfo.InvariantCulture)</p></div></div></div>}</div></div>}
@if (producto is not null){<div class="mt-6 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-5xl dark:border-slate-700 dark:bg-slate-800"><div class="px-6 py-4 border-b border-slate-100 bg-slate-50 dark:border-slate-700/60 dark:bg-slate-900/40"><h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide dark:text-slate-200">Existencia por almacén</h2></div><div class="px-6 py-6">@if (existenciasError is not null){<MessageBox Type="warning" Message="@existenciasError" />} else if (existenciasPorAlmacen is null){<p class="text-sm text-slate-400">Cargando…</p>} else if (existenciasPorAlmacen.Count == 0){<p class="text-sm text-slate-400">Sin movimientos registrados en ningún almacén.</p>} else {<table class="min-w-full divide-y divide-slate-100 text-sm dark:divide-slate-700/60"><thead><tr><th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Almacén</th><th class="px-4 py-2 text-right text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Existencia</th></tr></thead><tbody class="divide-y divide-slate-50 dark:divide-slate-700/40">@foreach (var fila in existenciasPorAlmacen){<tr @key="fila.AlmacenId"><td class="px-4 py-2 text-slate-700 dark:text-slate-300">@fila.AlmacenNombre <span class="text-slate-400 dark:text-slate-500">(@fila.AlmacenCodigo)</span></td><td class="px-4 py-2 text-right text-slate-700 dark:text-slate-300">@ProductoEtiquetas.Existencia(fila.Existencia, producto.UnidadMedidaBaseDecimales)</td></tr>}</tbody></table>}</div></div>}
@if (DeleteMode && producto is not null && canDelete){<ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará el producto desde su ficha y no se puede deshacer." Variant="danger" CancelHref="@BuildDetailUrl(edit: EditMode)"><p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-semibold text-red-900">@producto.Nombre</p>@if (!string.IsNullOrWhiteSpace(deleteError)){<div class="mt-4"><MessageBox Type="warning" Message="@deleteError" /></div>}<EditForm Model="DeleteInput" FormName="producto-delete" OnValidSubmit="DeleteAsync" class="mt-4" Enhance="true"><button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">Sí, eliminar</button><a href="@BuildDetailUrl(edit: EditMode)" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a></EditForm></ConfirmDialog>}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "edit")] private bool EditMode { get; set; }
    [SupplyParameterFromQuery(Name = "delete")] private bool DeleteMode { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    [SupplyParameterFromForm(FormName = "producto-edit")] private ProductoEditorForm? Input { get; set; }
    [SupplyParameterFromForm(FormName = "producto-delete")] private DeleteConfirmForm? DeleteInput { get; set; }
    private ProductoResponse? producto; private string? message; private string messageType = "info"; private IReadOnlyList<string> errores = []; private string? loadError; private string? deleteError;
    private IReadOnlyList<OpenSource1.Application.Services.Inventario.ExistenciaAlmacen>? existenciasPorAlmacen; private string? existenciasError;
    // Opciones de los <select> de categoría y unidad (solo se cargan al editar). La modificación se bloquea si no son fiables: guardar a ciegas podría cambiar la categoría o la unidad.
    private ProductoOpciones opciones = ProductoOpciones.SinCargar; private bool edicionBloqueada; private bool canModify; private bool canDelete; [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    protected override async Task OnInitializedAsync(){DeleteInput ??= new(); if(AuthenticationStateTask is not null){var user=(await AuthenticationStateTask).User; canModify=(await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanModify)).Succeeded; canDelete=(await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanDelete)).Succeeded;} await LoadAsync(); if(Ok is not null){(messageType, message)=Ok switch {"created"=>("success","Producto creado satisfactoriamente."),"updated"=>("success","Producto modificado satisfactoriamente."),_ =>("info",null)};}}
    private async Task LoadAsync()
    {
        try
        {
            producto = await ProductoApiClient.GetByIdAsync(Id);
            if (producto is null) return;
            // Solo se rellena con lo guardado cuando NO llegó un formulario: si el POST trae valores se conservan tal cual.
            Input ??= new ProductoEditorForm
            {
                Codigo = producto.Codigo, Nombre = producto.Nombre, PrecioVentaTexto = EntradaDecimal.Formatear(producto.PrecioVenta),
                CategoriaId = producto.CategoriaId, UnidadMedidaBaseId = producto.UnidadMedidaBaseId, MetodoCosteo = producto.MetodoCosteo,
                CostoEstandarTexto = EntradaDecimal.Formatear(producto.CostoEstandar), Bloqueado = producto.Bloqueado, ImagePath = producto.ImagePath
            };
            if (EditMode && canModify)
            {
                opciones = await ProductoOpciones.CargarAsync(CategoriaProductoApiClient, UnidadMedidaApiClient, Logger);
                edicionBloqueada = opciones.ModificacionBloqueada;
            }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not load producto detail."); loadError = "No fue posible cargar la ficha del producto."; return; }
        // Tabla de existencia por almacén (Task 3.6): un fallo (500, proxy caído, tiempo agotado) muestra un aviso propio sin
        // romper el resto de la ficha (que ya cargó con éxito).
        try
        {
            existenciasPorAlmacen = await ProductoApiClient.GetExistenciasAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load producto existencias.");
            existenciasError = "No fue posible cargar la existencia por almacén en este momento.";
        }
    }
    private async Task SaveAsync()
    {
        if (producto is null) { message = "No se encontró el producto indicado."; messageType = "warning"; return; }
        // Defensa en profundidad: aunque el botón no se renderice, no se envía un PUT sin opciones de categoría/unidad fiables.
        if (edicionBloqueada) return;
        string? imagenAnterior = producto.ImagePath;
        string? imagenNueva = null;
        try
        {
            var httpContext = HttpContextAccessor.HttpContext ?? throw new InvalidOperationException("No hay HttpContext disponible para cargar la imagen.");
            // La imagen vigente es la GUARDADA en el servidor (nunca un valor del formulario, que el usuario podría manipular);
            // sin fichero subido se conserva (antes se enviaba null y la imagen se perdía).
            imagenNueva = await FileStorageService.SaveProductImageAsync(httpContext, "ProductImage", imagenAnterior);
            Input!.ImagePath = imagenNueva;
            var result = await ProductoApiClient.UpdateAsync(Id, ToInput(Input));
            if (result.Succeeded)
            {
                if (imagenNueva != imagenAnterior) await FileStorageService.DeleteIfExistsAsync(imagenAnterior, RutaImagen.CarpetaProductos);
                Nav.NavigateTo(BuildDetailUrl(ok: "updated"));
                return;
            }
            if (imagenNueva is not null && imagenNueva != imagenAnterior) await FileStorageService.DeleteIfExistsAsync(imagenNueva, RutaImagen.CarpetaProductos);
            message = result.Message; errores = result.Errors ?? []; messageType = "warning";
        }
        catch (Exception ex)
        {
            if (imagenNueva is not null && imagenNueva != imagenAnterior) await FileStorageService.DeleteIfExistsAsync(imagenNueva, RutaImagen.CarpetaProductos);
            Logger.LogWarning(ex, "Could not update producto detail/image.");
            message = ex is InvalidOperationException ? ex.Message : "No fue posible actualizar el producto.";
            messageType = "danger";
        }
    }
    private async Task DeleteAsync(){var result=await ProductoApiClient.DeleteAsync(Id); if(result.Succeeded){Nav.NavigateTo("/productos?ok=deleted"); return;} deleteError=result.Message;}
    private string BuildDetailUrl(bool edit=false,bool delete=false,string? ok=null){var parameters=new List<string>(); if(edit) parameters.Add("edit=true"); if(delete) parameters.Add("delete=true"); if(!string.IsNullOrWhiteSpace(ok)) parameters.Add($"ok={Uri.EscapeDataString(ok)}"); return parameters.Count==0 ? $"/productos/{Id}" : $"/productos/{Id}?{string.Join("&",parameters)}";}
    // Edición: el formulario muestra siempre el valor completo de los campos con semántica parcial en la API (null = conservar), así que se envían todos.
    private static ProductoInput ToInput(ProductoEditorForm form) => new(
        form.Codigo.Trim(), form.Nombre.Trim(), form.PrecioVenta, form.CategoriaId, form.UnidadMedidaBaseId,
        form.MetodoCosteo, form.CostoEstandar, form.Bloqueado, form.ImagePath);
    private sealed class DeleteConfirmForm{}
}
