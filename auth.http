@baseUrl = http://localhost:8081

### Register local user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "local.user@example.com",
  "password": "Password123",
  "fullName": "Local User"
}

### Login local user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "userNameOrEmail": "local.user@example.com",
  "password": "Password123"
}

### Login seeded admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "userNameOrEmail": "admin",
  "password": "Password123"
}

### Current user
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{accessToken}}

### Forgot password
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "userNameOrEmail": "admin"
}

### Reset password
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "userNameOrEmail": "admin",
  "token": "paste-reset-token-here",
  "newPassword": "Password123"
}

### Change password
POST {{baseUrl}}/api/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "Password123",
  "newPassword": "Password1234"
}

### List app settings with JWT
GET {{baseUrl}}/api/app-settings
Authorization: Bearer {{accessToken}}

### Create app setting with JWT
POST {{baseUrl}}/api/app-settings
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "key": "Demo",
  "value": "Enabled",
  "description": "Demo setting"
}
