@page "/inventario/movimientos-valor"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Almacenes.Dtos
@using OpenSource1.Application.Features.Inventario.Consultas
@using OpenSource1.Application.Features.Inventario.Consultas.Dtos
@using OpenSource1.Application.Features.Productos.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@inject IInventarioConsultasApiClient ConsultasApiClient
@inject IProductoApiClient ProductoApiClient
@inject IAlmacenApiClient AlmacenApiClient
@inject ILogger<MovimientosValor> Logger

<PageTitle>Movimientos de valor – AxionERP</PageTitle>

<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div>
        <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Inventario</p>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Movimientos de valor</h1>
        <p class="text-sm text-slate-500 mt-1">Costo de cada movimiento del libro de inventario, ajustes de costo y si ya está contabilizado.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <a href="/inventario/movimientos-producto" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Movimientos de producto</a>
        <a href="/inventario/existencias" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Existencias</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6"><MessageBox Type="@messageType" Message="@message" Errors="@errores" /></div>
}
@if (almacenes.CargaFallida || productos.CargaFallida)
{
    <div class="mb-6"><MessageBox Type="warning" Message="No fue posible cargar las opciones de almacén o de producto; los filtros ya aplicados se siguen usando." /></div>
}

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/inventario/movimientos-valor" data-enhance class="p-4 sm:p-6">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="productoQuery">Buscar producto por nombre</label>
                <input id="productoQuery" type="text" name="productoQuery" value="@ProductoQuery" placeholder="ej. Arroz" class="@FiltroCss" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="productoId">Producto</label>
                <select id="productoId" name="productoId" class="@FiltroCss">
                    <option value="" selected="@(ProductoId is null)">— Todos —</option>
                    @OpcionProductoVigente()
                    @foreach (var p in productos.Items)
                    {
                        <option value="@p.Id" selected="@(p.Id == ProductoId)">@p.Codigo — @p.Nombre</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="almacenId">Almacén</label>
                <select id="almacenId" name="almacenId" class="@FiltroCss">
                    <option value="" selected="@(AlmacenId is null)">— Todos —</option>
                    @if (AlmacenId is { } almacenElegido && almacenes.Items.All(a => a.Id != almacenElegido))
                    {
                        <option value="@almacenElegido" selected="selected">Almacén seleccionado (@almacenElegido)</option>
                    }
                    @foreach (var a in almacenes.Items)
                    {
                        <option value="@a.Id" selected="@(a.Id == AlmacenId)">@a.Codigo — @a.Nombre@(a.Bloqueado ? " (bloqueado)" : "")</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="numeroDocumento">Documento</label>
                <input id="numeroDocumento" type="text" name="numeroDocumento" value="@NumeroDocumento" placeholder="ej. 00000001" class="@FiltroCss" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="desde">Desde (fecha registro)</label>
                <input id="desde" type="date" name="desde" value="@Desde" class="@FiltroCss" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="hasta">Hasta</label>
                <input id="hasta" type="date" name="hasta" value="@Hasta" class="@FiltroCss" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="tipoMovimiento">Tipo de movimiento</label>
                <select id="tipoMovimiento" name="tipoMovimiento" class="@FiltroCss">
                    <option value="" selected="@(TipoMovimiento is null)">— Todos —</option>
                    @foreach (var (valor, etiqueta) in InventarioVistasOpciones.TiposMovimiento)
                    {
                        <option value="@valor" selected="@(valor == TipoMovimiento)">@etiqueta</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="tipoOrigen">Origen</label>
                <select id="tipoOrigen" name="tipoOrigen" class="@FiltroCss">
                    <option value="" selected="@(TipoOrigen is null)">— Todos —</option>
                    @foreach (var (valor, etiqueta) in InventarioVistasOpciones.TiposOrigen)
                    {
                        <option value="@valor" selected="@(valor == TipoOrigen)">@etiqueta</option>
                    }
                </select>
            </div>
            <div class="flex items-end">
                <label class="inline-flex items-center gap-2 text-sm text-slate-700" for="soloAjustes">
                    <input id="soloAjustes" type="checkbox" name="soloAjustes" value="true" checked="@SoloAjustes" class="rounded border-slate-300" />
                    Solo ajustes de costo
                </label>
            </div>
        </div>
        <div class="mt-4 flex items-center gap-2">
            <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Consultar</button>
            <a href="/inventario/movimientos-valor" title="Limpiar campos" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Limpiar campos</a>
        </div>
        <p class="mt-2 text-xs text-slate-400">Busque por nombre y pulse Consultar para acotar la lista de productos (primeros @InventarioVistasOpciones.MaximoProductos); elija el producto y pulse Consultar de nuevo.</p>
    </form>
</div>

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-700">Movimientos de valor</h2>
        <p class="mt-1 text-xs text-slate-500">@total resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1) · orden cronológico. Contabilizado = el importe de costo ya está en el libro contable.</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm" data-testid="tabla-movimientos-valor">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Fecha</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Tipo</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Documento</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Producto</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Almacén</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Cant. valorada</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Importe costo</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Costo/unidad</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Importe venta</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Ajuste</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Tipo valor</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Origen</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Contabilizado</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (movimientos.Count == 0)
                {
                    <tr><td colspan="13" class="px-4 py-8 text-center text-slate-400 text-sm">@(cargaFallida ? "No fue posible cargar los movimientos de valor." : "No hay movimientos de valor con esos criterios.")</td></tr>
                }
                @foreach (var v in movimientos)
                {
                    <tr @key="v.Id" class="hover:bg-slate-50">
                        <td class="px-4 py-3 text-xs text-slate-500 whitespace-nowrap">@EntradaFecha.Formatear(v.FechaRegistro)</td>
                        <td class="px-4 py-3 text-xs text-slate-700">@InventarioVistasOpciones.TipoMovimiento(v.TipoMovimiento)</td>
                        <td class="px-4 py-3 font-mono text-xs text-slate-600">@(v.NumeroDocumento ?? "—")</td>
                        <td class="px-4 py-3 text-slate-700"><span class="font-mono text-xs">@v.ProductoCodigo</span> <span class="text-xs text-slate-400">@v.ProductoNombre</span></td>
                        <td class="px-4 py-3 text-slate-700"><span class="font-mono text-xs">@v.AlmacenCodigo</span> <span class="text-xs text-slate-400">@v.AlmacenNombre</span></td>
                        <td class="px-4 py-3 text-right text-slate-700">@InventarioVistasOpciones.Cantidad(v.CantidadValorada)</td>
                        <td class="px-4 py-3 text-right font-semibold @(v.ImporteCosto < 0 ? "text-red-700" : "text-slate-800")">@VentasOpciones.Importe(v.ImporteCosto)</td>
                        <td class="px-4 py-3 text-right text-slate-600">@InventarioVistasOpciones.CostoUnitario(v.CostoPorUnidad)</td>
                        <td class="px-4 py-3 text-right text-slate-600">@VentasOpciones.Importe(v.ImporteVenta)</td>
                        <td class="px-4 py-3 text-xs @(v.Ajuste ? "font-semibold text-amber-700" : "text-slate-400")">@(v.Ajuste ? "Sí" : "No")</td>
                        <td class="px-4 py-3 text-xs text-slate-500">@InventarioVistasOpciones.TipoValor(v.TipoValor)</td>
                        <td class="px-4 py-3 text-xs text-slate-500">@InventarioVistasOpciones.TipoOrigen(v.TipoOrigen)</td>
                        <td class="px-4 py-3 text-xs @(v.Contabilizado ? "text-emerald-700" : "font-semibold text-amber-700")" data-testid="contabilizado">@(v.Contabilizado ? "Sí" : $"Pendiente ({VentasOpciones.Importe(v.ImporteCostoPosteadoContabilidad)})")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
            <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
            <div class="flex items-center gap-2">
                @if (Pagina > 1)
                {
                    <a href="@BuildUrl(Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                }
                @if (Pagina < totalPaginas)
                {
                    <a href="@BuildUrl(Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                }
            </div>
        </div>
    }
</div>

@code {
    private const string FiltroCss = "block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20";

    [SupplyParameterFromQuery(Name = "productoQuery")] private string? ProductoQuery { get; set; }
    [SupplyParameterFromQuery(Name = "productoId")] private string? ProductoIdTexto { get; set; }
    [SupplyParameterFromQuery(Name = "almacenId")] private string? AlmacenIdTexto { get; set; }
    [SupplyParameterFromQuery(Name = "desde")] private string? Desde { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] private string? Hasta { get; set; }
    [SupplyParameterFromQuery(Name = "tipoMovimiento")] private string? TipoMovimientoTexto { get; set; }
    [SupplyParameterFromQuery(Name = "tipoOrigen")] private string? TipoOrigenTexto { get; set; }
    [SupplyParameterFromQuery(Name = "numeroDocumento")] private string? NumeroDocumento { get; set; }
    [SupplyParameterFromQuery(Name = "soloAjustes")] private string? SoloAjustesTexto { get; set; }

    /// <summary>Casilla de un formulario GET: solo llega (con "true") si está marcada.</summary>
    private bool SoloAjustes => string.Equals(SoloAjustesTexto, "true", StringComparison.OrdinalIgnoreCase);
    [SupplyParameterFromQuery(Name = "pagina")] private string? PaginaTexto { get; set; }

    // Los filtros llegan como texto y se interpretan aquí: un valor manipulado en la URL (Guid o número inválido) da un aviso,
    // no la página de error (el binder de [SupplyParameterFromQuery] lanza con Guid?/int? no interpretables).
    private Guid? ProductoId;
    private Guid? AlmacenId;
    private int? TipoMovimiento;
    private int? TipoOrigen;
    private int Pagina = 1;

    private OpcionesCargadas<AlmacenResponse> almacenes = OpcionesCargadas<AlmacenResponse>.SinCargar;
    private OpcionesCargadas<ProductoResponse> productos = OpcionesCargadas<ProductoResponse>.SinCargar;
    private ProductoResponse? productoVigente;
    private IReadOnlyList<MovimientoValorVistaResponse> movimientos = [];
    private long total;
    private int totalPaginas;
    private bool cargaFallida;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string>? errores;

    protected override async Task OnParametersSetAsync()
    {
        message = null;
        errores = null;
        cargaFallida = false;
        movimientos = [];
        total = 0;
        totalPaginas = 0;
        var filtroInvalido = InventarioVistasOpciones.FiltroInvalido(
            ("productoId", ProductoIdTexto), ("almacenId", AlmacenIdTexto), ("tipoMovimiento", TipoMovimientoTexto), ("tipoOrigen", TipoOrigenTexto));
        ProductoId = InventarioVistasOpciones.ParseGuid(ProductoIdTexto);
        AlmacenId = InventarioVistasOpciones.ParseGuid(AlmacenIdTexto);
        TipoMovimiento = InventarioVistasOpciones.ParseEntero(TipoMovimientoTexto);
        TipoOrigen = InventarioVistasOpciones.ParseEntero(TipoOrigenTexto);
        Pagina = Math.Max(InventarioVistasOpciones.ParseEntero(PaginaTexto) ?? 1, 1);

        almacenes = await InventarioVistasOpciones.AlmacenesAsync(AlmacenApiClient, Logger);
        productos = await InventarioVistasOpciones.ProductosAsync(ProductoApiClient, ProductoQuery, Logger);
        productoVigente = await InventarioVistasOpciones.ProductoVigenteAsync(ProductoApiClient, ProductoId, productos.Items, Logger);

        if (filtroInvalido is not null)
        {
            Show("warning", filtroInvalido);
            return;
        }

        if (!InventarioVistasOpciones.TryFecha(Desde, "La fecha «desde»", out var desde, out var errorFecha)
            || !InventarioVistasOpciones.TryFecha(Hasta, "La fecha «hasta»", out var hasta, out errorFecha))
        {
            Show("warning", errorFecha ?? "La fecha no es válida.");
            return;
        }

        var criterios = new MovimientoValorVistaCriterios(
            ProductoId, AlmacenId, desde, hasta, TipoMovimiento, TipoOrigen, EmptyAsNull(NumeroDocumento), SoloAjustes);
        try
        {
            // Orden explícito: cronológico ascendente.
            var resultado = await ConsultasApiClient.ListMovimientosValorAsync(criterios, Paginacion());
            if (resultado.Succeeded && resultado.Valor!.TotalPaginas > 0 && Pagina > resultado.Valor.TotalPaginas)
            {
                Pagina = resultado.Valor.TotalPaginas;
                resultado = await ConsultasApiClient.ListMovimientosValorAsync(criterios, Paginacion());
            }

            if (!resultado.Succeeded)
            {
                cargaFallida = true;
                Show("warning", resultado.Message, resultado.Errors);
                return;
            }

            movimientos = resultado.Valor!.Items;
            total = resultado.Valor.Total;
            totalPaginas = resultado.Valor.TotalPaginas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load movimientos de valor.");
            cargaFallida = true;
            Show("danger", "No fue posible cargar los movimientos de valor.");
        }
    }

    private PageRequest Paginacion() => new(Pagina, PageRequest.TamanoPorDefecto, "FechaRegistro", Descendente: false);

    private RenderFragment OpcionProductoVigente() => __builder =>
    {
        if (ProductoId is { } id && productos.Items.All(p => p.Id != id))
        {
            <option value="@id" selected="selected">@(productoVigente is null ? $"Producto seleccionado ({id})" : $"{productoVigente.Codigo} — {productoVigente.Nombre}")</option>
        }
    };

    private string BuildUrl(int pagina)
    {
        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(ProductoQuery)) parameters.Add($"productoQuery={Uri.EscapeDataString(ProductoQuery)}");
        if (ProductoId is { } p) parameters.Add($"productoId={p}");
        if (AlmacenId is { } a) parameters.Add($"almacenId={a}");
        if (!string.IsNullOrWhiteSpace(Desde)) parameters.Add($"desde={Uri.EscapeDataString(Desde)}");
        if (!string.IsNullOrWhiteSpace(Hasta)) parameters.Add($"hasta={Uri.EscapeDataString(Hasta)}");
        if (TipoMovimiento is { } tm) parameters.Add($"tipoMovimiento={tm}");
        if (TipoOrigen is { } to) parameters.Add($"tipoOrigen={to}");
        if (!string.IsNullOrWhiteSpace(NumeroDocumento)) parameters.Add($"numeroDocumento={Uri.EscapeDataString(NumeroDocumento)}");
        if (SoloAjustes) parameters.Add("soloAjustes=true");
        if (pagina > 1) parameters.Add($"pagina={pagina}");
        return parameters.Count == 0 ? "/inventario/movimientos-valor" : $"/inventario/movimientos-valor?{string.Join("&", parameters)}";
    }

    private void Show(string type, string text, IReadOnlyList<string>? detalle = null) { messageType = type; message = text; errores = detalle; }

    private static string? EmptyAsNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
