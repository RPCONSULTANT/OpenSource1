@page "/account/login"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using OpenSource1.Application.Services.Auth.Dtos
@using OpenSource1.Blazor.Security
@using OpenSource1.Blazor.Services
@inject IAuthApiClient AuthApiClient
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión – OpenSource1</PageTitle>

<!-- fondo con gradiente sutil -->
<div class="min-h-screen bg-gradient-to-br from-slate-100 via-brand-50 to-white flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        <!-- Logo / marca -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center size-14 rounded-2xl bg-brand-600 shadow-lg mb-4">
                <!-- heroicon: cpu-chip -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke-width="1.8" stroke="white" class="size-7">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Zm.75-12h9v9h-9v-9Z" />
                </svg>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">OpenSource1</h1>
            <p class="mt-1 text-sm text-slate-500">Ingrese sus credenciales para acceder al sistema</p>
        </div>

        <!-- Tarjeta de login -->
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">

            <!-- barra de acento superior -->
            <div class="h-1 w-full bg-gradient-to-r from-brand-500 to-brand-700"></div>

            <div class="px-8 py-8">
                <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-5">Acceso seguro</p>

                @* MessageBox: sesión cerrada *@
                @if (LoggedOut)
                {
                    <div class="mb-5">
                        <MessageBox Type="info" Message="La sesión fue cerrada correctamente." />
                    </div>
                }

                @* MessageBox: error de credenciales *@
                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="mb-5">
                        <MessageBox Type="danger" Message="@message" />
                    </div>
                }

                <EditForm Model="Input" FormName="login" OnValidSubmit="LoginAsync" autocomplete="off" novalidate>
                    <DataAnnotationsValidator />

                    <!-- ── Campo: Usuario ── -->
                    <div class="mb-5">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="userNameOrEmail">
                            <!-- heroicon: user -->
                            <span class="inline-flex items-center gap-1.5">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                     stroke-width="1.8" stroke="currentColor" class="size-4 text-slate-400">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                                </svg>
                                Usuario
                            </span>
                        </label>
                        <div class="relative">
                            <InputText id="userNameOrEmail"
                                       class="block w-full rounded-lg border border-slate-300 bg-slate-50 py-2.5 pl-10 pr-3 text-sm text-slate-800 placeholder-slate-400 shadow-sm transition focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25"
                                       @bind-Value="Input!.UserNameOrEmail"
                                       autocomplete="username"
                                       placeholder="admin, supervisor o ejecutor" />
                            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                     stroke-width="1.8" stroke="currentColor" class="size-4">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                                </svg>
                            </span>
                        </div>
                        <ValidationMessage For="() => Input!.UserNameOrEmail" />
                    </div>

                    <!-- ── Campo: Contraseña ── -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="password">
                            <span class="inline-flex items-center gap-1.5">
                                <!-- heroicon: lock-closed -->
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                     stroke-width="1.8" stroke="currentColor" class="size-4 text-slate-400">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                                </svg>
                                Contraseña
                            </span>
                        </label>
                        <div class="relative">
                            <InputText id="password"
                                       type="password"
                                       class="block w-full rounded-lg border border-slate-300 bg-slate-50 py-2.5 pl-10 pr-3 text-sm text-slate-800 placeholder-slate-400 shadow-sm transition focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25"
                                       @bind-Value="Input!.Password"
                                       autocomplete="current-password"
                                       placeholder="••••••••" />
                            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                     stroke-width="1.8" stroke="currentColor" class="size-4">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                                </svg>
                            </span>
                        </div>
                        <ValidationMessage For="() => Input!.Password" />
                    </div>

                    <!-- ── Botones de acción ── -->
                    <div class="flex flex-col-reverse sm:flex-row gap-3">
                        <!-- Botón Salir -->
                        <a href="/"
                           class="flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50 hover:text-slate-800 transition-colors w-full sm:w-auto">
                            <!-- heroicon: x-mark -->
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                            </svg>
                            Salir
                        </a>

                        <!-- Botón Iniciar Sesión -->
                        <button type="submit"
                                class="flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 active:scale-95 transition-all w-full sm:flex-1">
                            <!-- heroicon: arrow-right-on-rectangle -->
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                 stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15M12 9l3 3m0 0-3 3m3-3H2.25" />
                            </svg>
                            Iniciar Sesión
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>

        <p class="text-center text-xs text-slate-400 mt-6">
            &copy; 2026 OpenSource1 &mdash; Acceso seguro mediante cookie HttpOnly
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "login")]
    private LoginInput? Input { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "loggedOut")]
    private bool LoggedOut { get; set; }

    private string? message;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task LoginAsync()
    {
        var result = await AuthApiClient.LoginAsync(new LoginRequest
        {
            UserNameOrEmail = Input!.UserNameOrEmail.Trim(),
            Password = Input.Password
        });

        if (!result.Succeeded || result.Response is null)
        {
            message = result.Errors.Count > 0
                ? string.Join(" ", result.Errors)
                : "Usuario o contraseña inválidos.";
            return;
        }

        var httpContext = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("No hay HttpContext disponible para iniciar sesión.");

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, result.Response.UserId),
            new(ClaimTypes.Name, result.Response.FullName),
            new(ClaimTypes.Email, result.Response.Email)
        };

        claims.AddRange(result.Response.Roles.Select(role => new Claim(ClaimTypes.Role, role)));
        claims.AddRange(result.Response.Permissions.Select(permission => new Claim("permission", permission)));

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        await httpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal, new AuthenticationProperties
        {
            IsPersistent = false,
            ExpiresUtc = result.Response.ExpiresAtUtc,
            AllowRefresh = true
        });

        httpContext.Session.SetString(AuthSessionKeys.AccessToken, result.Response.AccessToken);
        httpContext.Session.SetString(AuthSessionKeys.ExpiresAtUtc, result.Response.ExpiresAtUtc.ToString("O"));

        var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : $"/{ReturnUrl.TrimStart('/')}";
        Navigation.NavigateTo(target, forceLoad: true);
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Debe indicar el usuario.")]
        [MaxLength(256, ErrorMessage = "El usuario no puede superar 256 caracteres.")]
        public string UserNameOrEmail { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe indicar la contraseña.")]
        [MaxLength(100, ErrorMessage = "La contraseña no puede superar 100 caracteres.")]
        public string Password { get; set; } = string.Empty;
    }
}
