@page "/productos/{Id:guid}"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Productos.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@inject IProductoApiClient ProductoApiClient
@inject IHttpContextAccessor HttpContextAccessor
@inject IFileStorageService FileStorageService
@inject IAuthorizationService AuthorizationService
@inject ILogger<ProductoDetail> Logger
@inject NavigationManager Nav

<PageTitle>Ficha producto – AxionERP</PageTitle>
<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between"><div><p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Ficha</p><h1 class="text-2xl font-extrabold text-slate-900 tracking-tight dark:text-slate-100">Producto</h1></div><div class="flex items-center gap-3"><a href="/productos" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Volver al listado</a>@if (producto is not null && !EditMode && canModify){<a href="@BuildDetailUrl(edit: true)" class="btn-press inline-flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-600">Editar</a>}</div></div>
@if (!string.IsNullOrWhiteSpace(message)){<div class="mb-6">@(messageType == "success" ? (RenderFragment)(@<ActionFeedback Type="success" Message="@message" />) : @<MessageBox Type="@messageType" Message="@message" />)</div>}
@if (loadError is not null){<MessageBox Type="danger" Message="@loadError" />} else if (producto is null){<div class="rounded-2xl border border-slate-200 bg-white px-8 py-12 text-center text-slate-400 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-500"><p class="font-semibold text-slate-500 dark:text-slate-400">No se encontró el producto solicitado.</p></div>} else {<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-5xl dark:border-slate-700 dark:bg-slate-800"><div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex items-start justify-between gap-4 dark:border-slate-700/60 dark:bg-slate-900/40"><div><h2 class="text-xl font-extrabold text-slate-900 dark:text-slate-100">@producto.Nombre</h2><p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Código: <span class="font-semibold text-slate-700 dark:text-slate-300">@producto.Codigo</span></p></div><div class="flex items-center gap-2">@if (!EditMode && canModify){<a href="@BuildDetailUrl(edit: true)" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100" title="Editar ficha">✎</a>}@if (canDelete){<a href="@BuildDetailUrl(delete: true)" class="btn-press inline-flex items-center justify-center size-9 rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100" title="Eliminar producto">🗑</a>}</div></div><div class="px-6 py-6">@if (EditMode && canModify){<EditForm Model="Input" FormName="producto-edit" OnValidSubmit="SaveAsync" Enhance="true" enctype="multipart/form-data"><DataAnnotationsValidator /><div class="mb-6 grid grid-cols-1 md:grid-cols-[220px_1fr] gap-6 items-start"><div><p class="text-sm font-semibold text-slate-700 mb-2 dark:text-slate-300">Imagen actual</p>@if (!string.IsNullOrWhiteSpace(Input?.ImagePath)){<img src="@Input.ImagePath" alt="Imagen del producto" class="h-40 w-40 rounded-2xl object-cover border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-900/40" />} else {<div class="flex h-40 w-40 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-slate-400 text-sm dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-500">Sin imagen</div>}</div><div><label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300">Cambiar imagen</label><input type="file" name="ProductImage" accept=".jpg,.jpeg,.png,.webp" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300" /><p class="mt-1 text-xs text-slate-400 dark:text-slate-500">Formatos permitidos: JPG, PNG, WEBP. Máximo 2 MB.</p></div></div><ProductoFields Model="Input!" Prefix="Input" /><div class="mt-6 flex flex-wrap items-center gap-3"><button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Guardar cambios</button><a href="@BuildDetailUrl()" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a></div></EditForm>} else {<div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-6 items-start"><div><p class="text-sm font-semibold text-slate-700 mb-2 dark:text-slate-300">Imagen</p>@if (!string.IsNullOrWhiteSpace(producto.ImagePath)){<img src="@producto.ImagePath" alt="Imagen del producto" class="h-40 w-40 rounded-2xl object-cover border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-900/40" />} else {<div class="flex h-40 w-40 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-slate-400 text-sm dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-500">Sin imagen</div>}</div><div class="grid grid-cols-1 md:grid-cols-3 gap-4"><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Precio</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.Precio.ToString("N2")</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Stock</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.Stock</p></div><div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-4 dark:border-slate-700/60 dark:bg-slate-900/40"><p class="text-xs font-bold uppercase tracking-wide text-slate-400 dark:text-slate-500">Categoría</p><p class="mt-1 text-sm text-slate-700 dark:text-slate-300">@producto.Categoria</p></div></div></div>}</div></div>}
@if (DeleteMode && producto is not null && canDelete){<ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará el producto desde su ficha y no se puede deshacer." Variant="danger" CancelHref="@BuildDetailUrl(edit: EditMode)"><p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-semibold text-red-900">@producto.Nombre</p>@if (!string.IsNullOrWhiteSpace(deleteError)){<div class="mt-4"><MessageBox Type="warning" Message="@deleteError" /></div>}<EditForm Model="DeleteInput" FormName="producto-delete" OnValidSubmit="DeleteAsync" class="mt-4" Enhance="true"><button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">Sí, eliminar</button><a href="@BuildDetailUrl(edit: EditMode)" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a></EditForm></ConfirmDialog>}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "edit")] private bool EditMode { get; set; }
    [SupplyParameterFromQuery(Name = "delete")] private bool DeleteMode { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    [SupplyParameterFromForm(FormName = "producto-edit")] private ProductoEditorForm? Input { get; set; }
    [SupplyParameterFromForm(FormName = "producto-delete")] private DeleteConfirmForm? DeleteInput { get; set; }
    private ProductoResponse? producto; private string? message; private string messageType = "info"; private string? loadError; private string? deleteError; private bool canModify; private bool canDelete; [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    protected override async Task OnInitializedAsync(){DeleteInput ??= new(); if(AuthenticationStateTask is not null){var user=(await AuthenticationStateTask).User; canModify=(await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanModify)).Succeeded; canDelete=(await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanDelete)).Succeeded;} await LoadAsync(); if(Ok is not null){(messageType, message)=Ok switch {"created"=>("success","Producto creado satisfactoriamente."),"updated"=>("success","Producto modificado satisfactoriamente."),_ =>("info",null)};}}
    private async Task LoadAsync(){try{producto=await ProductoApiClient.GetByIdAsync(Id); if(producto is not null && (Input is null || string.IsNullOrWhiteSpace(Input.Codigo))){Input=new ProductoEditorForm{Codigo=producto.Codigo,Nombre=producto.Nombre,Precio=producto.Precio,Stock=producto.Stock,Categoria=producto.Categoria,ImagePath=producto.ImagePath};}} catch(Exception ex){Logger.LogWarning(ex,"Could not load producto detail."); loadError="No fue posible cargar la ficha del producto.";}}
    private async Task SaveAsync(){try{var httpContext=HttpContextAccessor.HttpContext ?? throw new InvalidOperationException("No hay HttpContext disponible para cargar la imagen."); Input!.ImagePath=await FileStorageService.SaveProductImageAsync(httpContext,"ProductImage",Input.ImagePath); var result=await ProductoApiClient.UpdateAsync(Id, ToInput(Input)); if(result.Succeeded){Nav.NavigateTo(BuildDetailUrl(ok:"updated")); return;} message=result.Message; messageType="warning";} catch(Exception ex){Logger.LogWarning(ex,"Could not update producto detail/image."); message=ex is InvalidOperationException ? ex.Message : "No fue posible actualizar el producto."; messageType="danger";}}
    private async Task DeleteAsync(){var result=await ProductoApiClient.DeleteAsync(Id); if(result.Succeeded){Nav.NavigateTo("/productos?ok=deleted"); return;} deleteError=result.Message;}
    private string BuildDetailUrl(bool edit=false,bool delete=false,string? ok=null){var parameters=new List<string>(); if(edit) parameters.Add("edit=true"); if(delete) parameters.Add("delete=true"); if(!string.IsNullOrWhiteSpace(ok)) parameters.Add($"ok={Uri.EscapeDataString(ok)}"); return parameters.Count==0 ? $"/productos/{Id}" : $"/productos/{Id}?{string.Join("&",parameters)}";}
    private static ProductoInput ToInput(ProductoEditorForm form)=>new(form.Codigo.Trim(), form.Nombre.Trim(), form.Precio, form.Stock, form.Categoria.Trim(), form.ImagePath);
    private sealed class DeleteConfirmForm{}
}
