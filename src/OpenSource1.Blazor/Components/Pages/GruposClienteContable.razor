@page "/grupos-cliente-contable"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.GruposClienteContable.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@inject IGrupoClienteContableApiClient GrupoClienteContableApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<GruposClienteContable> Logger
@inject NavigationManager Nav

<PageTitle>Grupos contables de cliente – AxionERP</PageTitle>

<PageToolbar Titulo="Grupos contables de cliente" Subtitulo="Cuenta por cobrar (y, opcionalmente, de descuentos e intereses) de cada grupo de clientes."
             Migas="@Migas" Permisos="@permisos"
             NuevoHref="@RetornoLocal.ConRetorno("/grupos-cliente-contable/nuevo", UrlActual)"
             SeleccionId="@SeleccionValida?.ToString()"
             EditarUrl="@(id => EditarUrl(Guid.Parse(id)))"
             EliminarUrl="@(id => BuildListUrl(deleteId: Guid.Parse(id)))" />

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" Errors="@errores" />
        }
    </div>
}

<!-- ── Filtros ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/grupos-cliente-contable" data-enhance class="p-4 sm:p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-2 max-w-3xl">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroCodigo">Código</label>
                    <input id="filtroCodigo" type="text" name="codigo" value="@SearchCodigo" placeholder="ej. GENERAL"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroDescripcion">Descripción</label>
                    <input id="filtroDescripcion" type="text" name="descripcion" value="@SearchDescripcion" placeholder="ej. clientes"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Consultar</button>
                <a href="/grupos-cliente-contable" title="Limpiar campos" class="btn-press inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Limpiar campos</a>
            </div>
        </div>
    </form>
</div>

<!-- ── Tabla ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-700">Registros actuales</h2>
        <p class="mt-1 text-xs text-slate-500">@total resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1).</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3"><span class="sr-only">Seleccionar</span></th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Código / Descripción</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Cuenta por cobrar</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Descuentos</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Intereses</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (grupos.Count == 0)
                {
                    <tr><td colspan="6" class="px-6 py-8 text-center text-slate-400 text-sm">No hay grupos registrados con esos criterios.</td></tr>
                }
                else
                {
                    @foreach (var grupo in grupos)
                    {
                        var marcada = grupo.Id == SeleccionValida;
                        <tr @key="grupo.Id" class="@SeleccionFila.ClaseFila transition-colors @(marcada ? SeleccionFila.ClaseFilaSeleccionada : null)">
                            <td class="px-4 py-3"><SeleccionFila Href="@BuildListUrl(sel: grupo.Id)" Seleccionada="@marcada" Etiqueta="@grupo.Codigo" /></td>
                            <td class="px-6 py-3"><span class="font-mono text-xs font-semibold text-brand-700">@grupo.Codigo</span><span class="ml-2 text-slate-700">@grupo.Descripcion</span></td>
                            <td class="px-6 py-3 text-slate-600 text-xs">@Cuenta(grupo.CuentaCxCId, grupo.CuentaCxCNumero, grupo.CuentaCxCNombre)</td>
                            <td class="px-6 py-3 text-slate-600 text-xs">@Cuenta(grupo.CuentaDescuentoId, grupo.CuentaDescuentoNumero, grupo.CuentaDescuentoNombre)</td>
                            <td class="px-6 py-3 text-slate-600 text-xs">@Cuenta(grupo.CuentaInteresId, grupo.CuentaInteresNumero, grupo.CuentaInteresNombre)</td>
                            <td class="px-6 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @if (canModify)
                                    {
                                        <a href="@EditarUrl(grupo.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-amber-200 bg-amber-50 text-amber-600 hover:bg-amber-100" title="Editar grupo">✎</a>
                                    }
                                    @if (canDelete)
                                    {
                                        <a href="@BuildListUrl(deleteId: grupo.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100" title="Eliminar grupo">🗑</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
            <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
            <div class="flex items-center gap-2">
                @if (Pagina > 1)
                {
                    <a href="@BuildListUrl(pagina: Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                }
                @if (Pagina < totalPaginas)
                {
                    <a href="@BuildListUrl(pagina: Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                }
            </div>
        </div>
    }
</div>

@if (DeleteId.HasValue && canDelete)
{
    <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará el grupo contable de cliente seleccionado y no se puede deshacer." Variant="danger" CancelHref="@UrlActual">
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-mono text-red-900">@(itemToDelete is null ? DeleteId.Value.ToString() : $"{itemToDelete.Codigo} — {itemToDelete.Descripcion}")</p>
        <EditForm Model="DeleteInput" FormName="delete-grupo-cliente-contable" OnValidSubmit="DeleteAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.Id" value="@DeleteId" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, eliminar</button>
            <a href="@UrlActual" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}

@code {
    [SupplyParameterFromForm(FormName = "delete-grupo-cliente-contable")]
    private DeleteForm? DeleteInput { get; set; }

    [SupplyParameterFromQuery(Name = "codigo")]
    private string? SearchCodigo { get; set; }

    [SupplyParameterFromQuery(Name = "descripcion")]
    private string? SearchDescripcion { get; set; }

    // Solo para redirigir la ruta antigua ?editId= al editor en página propia.
    [SupplyParameterFromQuery(Name = "editId")]
    private Guid? EditId { get; set; }

    [SupplyParameterFromQuery(Name = "sel")]
    private Guid? Sel { get; set; }

    [SupplyParameterFromQuery(Name = "deleteId")]
    private Guid? DeleteId { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int Pagina { get; set; } = 1;

    private IReadOnlyList<GrupoClienteContableResponse> grupos = [];
    private GrupoClienteContableResponse? itemToDelete;
    private long total;
    private int totalPaginas;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string> errores = [];
    private PermisosPagina? permisos;
    private bool canModify;
    private bool canDelete;

    private static readonly IReadOnlyList<Miga> Migas = [new("Configuración", "/modulos/configuracion"), new("Grupos de cliente contable")];

    // Selección obsoleta (no está en la página cargada) => null: la barra deshabilita Editar/Eliminar.
    private Guid? SeleccionValida => Sel is { } s && grupos.Any(g => g.Id == s) ? s : null;
    private string UrlActual => RetornoLocal.SinTransitorios(BuildListUrl());
    private string EditarUrl(Guid id) => RetornoLocal.ConRetorno($"/grupos-cliente-contable/{id}/editar", UrlActual);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (EditId is { } editId)
        {
            Nav.NavigateTo(RetornoLocal.ConRetorno($"/grupos-cliente-contable/{editId}/editar", UrlActual), replace: true);
            return;
        }

        DeleteInput ??= new();
        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);
        canModify = permisos.CanModify;
        canDelete = permisos.CanDelete;

        await LoadAsync();

        if (Ok is not null)
        {
            (messageType, message) = Ok switch
            {
                "created" => ("success", "Grupo contable de cliente creado satisfactoriamente."),
                "updated" => ("success", "Grupo contable de cliente modificado satisfactoriamente."),
                "deleted" => ("success", "Grupo contable de cliente eliminado satisfactoriamente."),
                _ => ("info", null)
            };
        }

        if (DeleteId.HasValue && canDelete)
        {
            try
            {
                itemToDelete = await GrupoClienteContableApiClient.GetByIdAsync(DeleteId.Value);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load grupo cliente contable {DeleteId} from API.", DeleteId);
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var filter = new GrupoContableSearchFilter(EmptyAsNull(SearchCodigo), EmptyAsNull(SearchDescripcion));
            if (Pagina < 1) Pagina = 1;
            var pagina = await GrupoClienteContableApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto, Descendente: false));
            if (pagina.TotalPaginas == 0)
            {
                Pagina = 1;
            }
            else if (Pagina > pagina.TotalPaginas)
            {
                Pagina = pagina.TotalPaginas;
                pagina = await GrupoClienteContableApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto, Descendente: false));
            }

            grupos = pagina.Items;
            total = pagina.Total;
            totalPaginas = pagina.TotalPaginas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load grupos cliente contable from API.");
            Show("danger", "No fue posible cargar los grupos contables de cliente.");
        }
    }

    private string BuildListUrl(int? pagina = null, Guid? sel = null, Guid? deleteId = null)
    {
        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(SearchCodigo)) parameters.Add($"codigo={Uri.EscapeDataString(SearchCodigo)}");
        if (!string.IsNullOrWhiteSpace(SearchDescripcion)) parameters.Add($"descripcion={Uri.EscapeDataString(SearchDescripcion)}");
        var paginaEfectiva = pagina ?? Pagina;
        if (paginaEfectiva > 1) parameters.Add($"pagina={paginaEfectiva}");
        if ((sel ?? Sel) is { } seleccion) parameters.Add($"sel={seleccion}");
        if (deleteId.HasValue) parameters.Add($"deleteId={deleteId.Value}");
        return parameters.Count == 0 ? "/grupos-cliente-contable" : $"/grupos-cliente-contable?{string.Join("&", parameters)}";
    }

    private async Task DeleteAsync() => await ExecuteAsync(() => GrupoClienteContableApiClient.DeleteAsync(DeleteInput!.Id), "deleted");

    private async Task ExecuteAsync(Func<Task<GrupoOperationResult>> operation, string successCode)
    {
        // La navegación va FUERA del try: si NavigateTo lanza NavigationException (SSR sin el switch que la desactiva),
        // el catch genérico no debe tragársela como un fallo de la operación.
        string? destino = null;
        try
        {
            var result = await operation();
            if (result.Succeeded)
            {
                destino = RetornoLocal.ConParametro(UrlActual, "ok", successCode);
            }
            else
            {
                errores = result.Errors ?? [];
                Show("warning", result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not complete grupo cliente contable operation.");
            Show("danger", "No fue posible completar la operación.");
        }

        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private void Show(string type, string text) { messageType = type; message = text; }

    private static string Cuenta(Guid? id, string? numero, string? nombre) =>
        id is null ? "—" : string.IsNullOrWhiteSpace(numero) ? $"No disponible ({id})" : $"{numero} — {nombre}";

    private static string? EmptyAsNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public sealed class DeleteForm
    {
        public Guid Id { get; set; }
    }
}
