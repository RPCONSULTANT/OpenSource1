@page "/diarios-inventario"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.DiariosInventario.Lotes
@using OpenSource1.Application.Features.DiariosInventario.Lotes.Dtos
@using OpenSource1.Application.Features.DiariosInventario.Plantillas.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@inject IDiarioInventarioApiClient DiarioApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<DiariosInventario> Logger
@inject NavigationManager Nav

<PageTitle>Diarios de inventario – AxionERP</PageTitle>

<PageToolbar Titulo="Diarios de inventario" Subtitulo="Lotes de ajustes y reclasificaciones de inventario. Las líneas y el registro se administran desde la ficha de cada lote."
             Migas="@Migas" Permisos="@permisos"
             NuevoHref="@RetornoLocal.ConRetorno("/diarios-inventario/nuevo", UrlActual)"
             SeleccionId="@SeleccionValida?.ToString()"
             EditarUrl="@(id => RetornoLocal.ConRetorno($"/diarios-inventario/{id}/editar", UrlActual))"
             EliminarUrl="@(id => BuildListUrl(deleteId: Guid.Parse(id)))" />

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" Errors="@errores" />
        }
    </div>
}

@if (plantillasCargaFallida)
{
    <div class="mb-6">
        <MessageBox Type="warning" Message="No fue posible cargar las plantillas de diario. El filtro por plantilla no está disponible hasta que carguen; recargue la página." />
    </div>
}

<!-- ── Filtros ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/diarios-inventario" data-enhance class="p-4 sm:p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-3 max-w-3xl">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroPlantilla">Plantilla</label>
                    <select id="filtroPlantilla" name="plantillaId"
                            class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20">
                        <option value="" selected="@(SearchPlantillaId is null)">Todas</option>
                        @foreach (var plantilla in plantillas)
                        {
                            <option value="@plantilla.Id" selected="@(plantilla.Id == SearchPlantillaId)">@plantilla.Codigo — @plantilla.Nombre</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroCodigo">Código</label>
                    <input id="filtroCodigo" type="text" name="codigo" value="@SearchCodigo" placeholder="ej. AJUSTE-2026-01"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroNombre">Nombre</label>
                    <input id="filtroNombre" type="text" name="nombre" value="@SearchNombre" placeholder="ej. Ajuste enero"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m0 0A7.95 7.95 0 1 0 5.4 5.4a7.95 7.95 0 0 0 11.25 11.25Z" /></svg>
                    Consultar
                </button>
                <a href="/diarios-inventario" title="Limpiar campos" class="btn-press inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                    Limpiar campos
                </a>
            </div>
        </div>
    </form>
</div>

<!-- ── Tabla de lotes ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-700">Registros actuales</h2>
        <p class="mt-1 text-xs text-slate-500">@totalLotes resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1).</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3"><span class="sr-only">Seleccionar</span></th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Código</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Nombre</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Plantilla</th>
                    <th class="px-6 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Líneas</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Estado</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actualizado</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (lotes.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="px-6 py-8 text-center text-slate-400 text-sm">
                            No hay lotes de diario registrados con esos criterios.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var lote in lotes)
                    {
                        var plantilla = plantillas.FirstOrDefault(p => p.Id == lote.PlantillaDiarioId);
                        var marcada = lote.Id == SeleccionValida;
                        <tr @key="lote.Id" class="@SeleccionFila.ClaseFila transition-colors @(marcada ? SeleccionFila.ClaseFilaSeleccionada : null)">
                            <td class="px-4 py-3"><SeleccionFila Href="@BuildListUrl(sel: lote.Id)" Seleccionada="@marcada" Etiqueta="@lote.Codigo" /></td>
                            <td class="px-6 py-3 font-mono text-xs font-semibold text-brand-700">@lote.Codigo</td>
                            <td class="px-6 py-3 text-slate-700">@lote.Nombre</td>
                            <td class="px-6 py-3 text-slate-500 text-xs">@(plantilla is null ? "—" : $"{plantilla.Codigo} — {plantilla.Nombre}")</td>
                            <td class="px-6 py-3 text-center text-slate-700">@lote.NumeroLineas</td>
                            <td class="px-6 py-3">
                                @if (lote.Bloqueado)
                                {
                                    <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-semibold text-red-700">Bloqueado</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-semibold text-green-700">Abierto</span>
                                }
                            </td>
                            <td class="px-6 py-3 text-slate-400 text-xs">
                                @(lote.UpdatedAtUtc?.ToLocalTime().ToString("g") ?? lote.CreatedAtUtc.ToLocalTime().ToString("g"))
                            </td>
                            <td class="px-6 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="@($"/diarios-inventario/{lote.Id}")" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-brand-200 bg-brand-50 text-brand-700 hover:bg-brand-100" title="Ver líneas del lote">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
                                    </a>
                                    @if (permisos?.CanModify == true)
                                    {
                                        <a href="@RetornoLocal.ConRetorno($"/diarios-inventario/{lote.Id}/editar", UrlActual)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-amber-200 bg-amber-50 text-amber-600 hover:bg-amber-100" title="Editar lote">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z" /></svg>
                                        </a>
                                    }
                                    @if (permisos?.CanDelete == true)
                                    {
                                        <a href="@BuildListUrl(deleteId: lote.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100" title="Eliminar lote">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79" /></svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
            <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
            <div class="flex items-center gap-2">
                @if (Pagina > 1)
                {
                    <a href="@BuildListUrl(pagina: Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                }
                @if (Pagina < totalPaginas)
                {
                    <a href="@BuildListUrl(pagina: Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                }
            </div>
        </div>
    }
</div>

@if (MuestraDialogoBorrar)
{
    <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará el lote de diario seleccionado y no se puede deshacer." Variant="danger" CancelHref="@UrlActual">
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-mono text-red-900">@((itemToDelete is null) ? DeleteId?.ToString() : $"{itemToDelete.Codigo} — {itemToDelete.Nombre}")</p>
        @if (itemToDelete is { NumeroLineas: > 0 })
        {
            <div class="mt-3">
                <MessageBox Type="warning" Message="Este lote tiene líneas capturadas; la API rechazará la eliminación." />
            </div>
        }
        <EditForm Model="DeleteInput" FormName="delete-lote-diario" OnValidSubmit="DeleteAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.Id" value="@DeleteId" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, eliminar</button>
            <a href="@UrlActual" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}
else
{
    @* Formulario de borrado siempre en el árbol: un POST obsoleto o forzado recibe el mensaje real de la API. *@
    <EditForm Model="DeleteInput" FormName="delete-lote-diario" OnValidSubmit="DeleteAsync"></EditForm>
}

@code {
    [SupplyParameterFromForm(FormName = "delete-lote-diario")]
    private DeleteForm? DeleteInput { get; set; }

    [SupplyParameterFromQuery(Name = "plantillaId")]
    private Guid? SearchPlantillaId { get; set; }

    [SupplyParameterFromQuery(Name = "codigo")]
    private string? SearchCodigo { get; set; }

    [SupplyParameterFromQuery(Name = "nombre")]
    private string? SearchNombre { get; set; }

    [SupplyParameterFromQuery(Name = "sel")]
    private Guid? Sel { get; set; }

    // Solo para redirigir la ruta antigua (?editId=) al editor propio.
    [SupplyParameterFromQuery(Name = "editId")]
    private Guid? EditId { get; set; }

    [SupplyParameterFromQuery(Name = "deleteId")]
    private Guid? DeleteId { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int Pagina { get; set; } = 1;

    private static readonly IReadOnlyList<Miga> Migas = [new("Inventario", "/modulos/inventario"), new("Diarios de inventario")];

    private IReadOnlyList<LoteDiarioResponse> lotes = [];
    private IReadOnlyList<PlantillaDiarioResponse> plantillas = [];
    private bool plantillasCargaFallida;
    // Registro a eliminar, cargado fresco con GetByIdAsync (no buscado en la página de la lista).
    private LoteDiarioResponse? itemToDelete;
    private long totalLotes;
    private int totalPaginas;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string> errores = [];
    private PermisosPagina? permisos;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>Selección de la lista (?sel=) solo si el lote está en la página cargada; si no, la barra la trata como vacía.</summary>
    private Guid? SeleccionValida => Sel is { } s && lotes.Any(l => l.Id == s) ? s : null;

    private bool MuestraDialogoBorrar => DeleteId.HasValue && permisos?.CanDelete == true;

    /// <summary>URL de vuelta del listado (filtros, página y selección; sin ok/deleteId/editId).</summary>
    private string UrlActual => RetornoLocal.SinTransitorios(BuildListUrl());

    protected override async Task OnInitializedAsync()
    {
        if (EditId is { } editId)
        {
            Nav.NavigateTo(RetornoLocal.ConRetorno($"/diarios-inventario/{editId}/editar", UrlActual), replace: true);
            return;
        }

        DeleteInput ??= new();
        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);

        try
        {
            plantillas = await DiarioApiClient.ListPlantillasAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load plantillas de diario from API.");
            plantillasCargaFallida = true;
        }

        await LoadAsync();

        if (Ok is not null)
        {
            (messageType, message) = Ok switch
            {
                "created" => ("success", "Lote de diario creado satisfactoriamente."),
                "updated" => ("success", "Lote de diario modificado satisfactoriamente."),
                "deleted" => ("success", "Lote de diario eliminado satisfactoriamente."),
                _ => ("info", null)
            };
        }

        if (MuestraDialogoBorrar)
        {
            try
            {
                itemToDelete = await DiarioApiClient.GetLoteByIdAsync(DeleteId!.Value);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load lote de diario {DeleteId} from API.", DeleteId);
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var filter = new LoteDiarioSearchCriteria(SearchPlantillaId, EmptyAsNull(SearchCodigo), EmptyAsNull(SearchNombre));
            if (Pagina < 1) Pagina = 1;
            var pagina = await DiarioApiClient.ListLotesAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto));

            if (pagina.TotalPaginas == 0)
            {
                Pagina = 1;
            }
            else if (Pagina > pagina.TotalPaginas)
            {
                Pagina = pagina.TotalPaginas;
                pagina = await DiarioApiClient.ListLotesAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto));
            }

            lotes = pagina.Items;
            totalLotes = pagina.Total;
            totalPaginas = pagina.TotalPaginas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load lotes de diario from API.");
            Show("danger", "No fue posible cargar los lotes de diario.");
        }
    }

    private string BuildListUrl(int? pagina = null, Guid? sel = null, Guid? deleteId = null)
    {
        var parameters = new List<string>();
        if (SearchPlantillaId.HasValue) parameters.Add($"plantillaId={SearchPlantillaId.Value}");
        AddParameter(parameters, "codigo", SearchCodigo);
        AddParameter(parameters, "nombre", SearchNombre);
        var paginaEfectiva = pagina ?? Pagina;
        if (paginaEfectiva > 1) parameters.Add($"pagina={paginaEfectiva}");
        var selEfectiva = sel ?? Sel;
        if (selEfectiva.HasValue) parameters.Add($"sel={selEfectiva.Value}");
        if (deleteId.HasValue) parameters.Add($"deleteId={deleteId.Value}");
        return parameters.Count == 0 ? "/diarios-inventario" : $"/diarios-inventario?{string.Join("&", parameters)}";
    }

    private static void AddParameter(List<string> parameters, string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value)) parameters.Add($"{key}={Uri.EscapeDataString(value)}");
    }

    private async Task DeleteAsync()
    {
        // R17: la navegación va FUERA del try (NavigateTo puede lanzar NavigationException y el catch se la tragaría).
        string? destino = null;
        try
        {
            var result = await DiarioApiClient.DeleteLoteAsync(DeleteInput!.Id);
            if (result.Succeeded)
            {
                destino = RetornoLocal.ConParametro(UrlActual, "ok", "deleted");
            }
            else
            {
                errores = result.Errors ?? [];
                Show("warning", result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not delete lote de diario.");
            Show("danger", "No fue posible completar la operación.");
        }

        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private void Show(string type, string text) { messageType = type; message = text; }

    private static string? EmptyAsNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public sealed class LoteForm
    {
        public Guid Id { get; set; }

        [Required(ErrorMessage = "La plantilla es obligatoria.")]
        public Guid PlantillaDiarioId { get; set; }

        [Required(ErrorMessage = "El código es obligatorio.")]
        [MaxLength(20, ErrorMessage = "El código no puede superar los 20 caracteres.")]
        public string Codigo { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [MaxLength(100, ErrorMessage = "El nombre no puede superar los 100 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        public bool Bloqueado { get; set; }

        public long Xmin { get; set; }
    }

    public sealed class DeleteForm
    {
        public Guid Id { get; set; }
    }
}
