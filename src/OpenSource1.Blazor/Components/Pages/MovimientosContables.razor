@page "/contabilidad/movimientos"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Contabilidad
@using OpenSource1.Application.Features.Contabilidad.Dtos
@using OpenSource1.Application.Features.CuentasContables.Dtos
@using OpenSource1.Application.Features.SociosNegocio.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@using OpenSource1.Core.Enums
@inject IContabilidadConsultasApiClient ConsultasApiClient
@inject ICuentaContableApiClient CuentaApiClient
@inject ISocioNegocioApiClient SocioApiClient
@inject ILogger<MovimientosContables> Logger

@*
    Movimientos contables (Task 7.4): el libro por cuenta y rango de fechas de registro, con tipo y número de documento, socio
    y registro (el enlace del número de registro muestra el asiento completo). Static SSR: formulario GET y paginación por
    query string; los filtros de la URL se leen como texto (un valor manipulado da un aviso, no la página de error).
*@

<PageTitle>Movimientos contables – AxionERP</PageTitle>

<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div>
        <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Contabilidad</p>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Movimientos contables</h1>
        <p class="text-sm text-slate-500 mt-1">Líneas del libro contable en orden cronológico. El número de registro abre el asiento completo.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <a href="@UrlBalance()" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Balance de comprobación</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6"><MessageBox Type="@messageType" Message="@message" Errors="@errores" /></div>
}
@if (cuentas.CargaFallida)
{
    <div class="mb-6"><MessageBox Type="warning" Message="No fue posible cargar la lista de cuentas; la cuenta ya elegida se sigue usando." /></div>
}
@if (socios.CargaFallida)
{
    <div class="mb-6"><MessageBox Type="warning" Message="No fue posible cargar la lista de socios; el socio ya elegido se sigue usando." /></div>
}

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/contabilidad/movimientos" data-enhance class="p-4 sm:p-6">
        @if (RegistroId is { } registroFiltro)
        {
            <input type="hidden" name="registroId" value="@registroFiltro" />
        }
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div class="lg:col-span-2">
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="cuentaId">Cuenta</label>
                <select id="cuentaId" name="cuentaId" class="@FiltroCss">
                    <option value="" selected="@(CuentaId is null)">— Todas —</option>
                    @if (CuentaId is { } elegida && cuentas.Items.All(c => c.Id != elegida))
                    {
                        <option value="@elegida" selected="selected">@NombreCuenta(elegida)</option>
                    }
                    @foreach (var c in cuentas.Items)
                    {
                        <option value="@c.Id" selected="@(c.Id == CuentaId)">@c.Numero — @c.Nombre@(c.Bloqueada ? " (bloqueada)" : "")</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="desde">Desde (fecha registro)</label>
                <input id="desde" type="date" name="desde" value="@Desde" class="@FiltroCss" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="hasta">Hasta</label>
                <input id="hasta" type="date" name="hasta" value="@Hasta" class="@FiltroCss" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="tipoDocumento">Tipo de documento</label>
                <select id="tipoDocumento" name="tipoDocumento" class="@FiltroCss">
                    <option value="" selected="@(TipoDocumento is null)">— Todos —</option>
                    @foreach (var (valor, etiqueta) in ContabilidadVistasOpciones.TiposDocumento)
                    {
                        <option value="@valor" selected="@(valor == TipoDocumento)">@etiqueta</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="numeroDocumento">Número de documento</label>
                <input id="numeroDocumento" type="text" name="numeroDocumento" value="@NumeroDocumento" placeholder="ej. 00000012" class="@FiltroCss" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="socioQuery">Buscar socio por nombre</label>
                <input id="socioQuery" type="text" name="socioQuery" value="@SocioQuery" placeholder="ej. Comercial" class="@FiltroCss" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="socioId">Socio</label>
                <select id="socioId" name="socioId" class="@FiltroCss">
                    <option value="" selected="@(SocioId is null)">— Todos —</option>
                    @if (SocioId is { } socioElegido && socios.Items.All(s => s.Id != socioElegido))
                    {
                        <option value="@socioElegido" selected="selected">@NombreSocio(socioElegido)</option>
                    }
                    @foreach (var s in socios.Items)
                    {
                        <option value="@s.Id" selected="@(s.Id == SocioId)">@s.Codigo — @s.NombreComercial</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-4 flex items-center gap-2">
            <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Consultar</button>
            <a href="/contabilidad/movimientos" title="Limpiar campos" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Limpiar campos</a>
        </div>
        <p class="mt-2 text-xs text-slate-400">El número de documento se busca por contenido. Busque el socio por nombre y pulse Consultar para acotar la lista (primeros @VentasOpciones.MaximoSocios).</p>
    </form>
</div>

@if (RegistroId is { } registroActivo)
{
    <div class="mb-6 flex flex-wrap items-center gap-3 rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-800" data-testid="filtro-registro">
        <span>Asiento: registro <span class="font-mono font-semibold">@(NumeroRegistro ?? registroActivo.ToString(System.Globalization.CultureInfo.InvariantCulture))</span></span>
        <a class="underline" href="@BuildUrl(1, sinRegistro: true)">Quitar filtro de registro</a>
    </div>
}

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-700">Movimientos</h2>
        <p class="mt-1 text-xs text-slate-500">@total resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1) · orden cronológico (fecha de registro, número de movimiento).</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm" data-testid="tabla-movimientos-contables">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Fecha</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Cuenta</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Tipo doc.</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Documento</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Descripción</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Socio</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Débito</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Crédito</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Registro</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (movimientos.Count == 0)
                {
                    <tr><td colspan="9" class="px-4 py-8 text-center text-slate-400 text-sm">@(cargaFallida ? "No fue posible cargar los movimientos." : "No hay movimientos con esos criterios.")</td></tr>
                }
                @foreach (var m in movimientos)
                {
                    <tr @key="m.Id" class="hover:bg-slate-50">
                        <td class="px-4 py-3 text-xs text-slate-500 whitespace-nowrap">@EntradaFecha.Formatear(m.FechaRegistro)</td>
                        <td class="px-4 py-3 text-xs text-slate-700"><span class="font-mono">@m.NumeroCuenta</span> @(m.NombreCuenta ?? "")</td>
                        <td class="px-4 py-3 text-xs text-slate-700">@ContabilidadVistasOpciones.TipoDocumento(m.TipoDocumento)</td>
                        <td class="px-4 py-3 font-mono text-xs text-slate-600">
                            @if (m.TipoDocumento == TipoDocumentoContable.FacturaVenta && !string.IsNullOrEmpty(m.NumeroDocumento))
                            {
                                <a class="text-brand-700 underline" href="@($"/facturas-venta/{Uri.EscapeDataString(m.NumeroDocumento)}")">@m.NumeroDocumento</a>
                            }
                            else if (m.TipoDocumento == TipoDocumentoContable.NotaCreditoVenta && !string.IsNullOrEmpty(m.NumeroDocumento))
                            {
                                <a class="text-brand-700 underline" href="@($"/notas-credito-venta/{Uri.EscapeDataString(m.NumeroDocumento)}")">@m.NumeroDocumento</a>
                            }
                            else
                            {
                                @(m.NumeroDocumento ?? "—")
                            }
                        </td>
                        <td class="px-4 py-3 text-xs text-slate-500">@m.Descripcion</td>
                        <td class="px-4 py-3 text-xs text-slate-500">@(m.SocioNegocioId is null ? "—" : $"{m.SocioCodigo} {m.SocioNombre}")</td>
                        <td class="px-4 py-3 text-right text-slate-800" data-testid="debito">@(m.Debito == 0 ? "" : VentasOpciones.Importe(m.Debito))</td>
                        <td class="px-4 py-3 text-right text-slate-800" data-testid="credito">@(m.Credito == 0 ? "" : VentasOpciones.Importe(m.Credito))</td>
                        <td class="px-4 py-3 font-mono text-xs"><a class="text-brand-700 underline" href="@($"/contabilidad/movimientos?registroId={m.RegistroContableId}")">@m.NumeroRegistro</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
            <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
            <div class="flex items-center gap-2">
                @if (Pagina > 1)
                {
                    <a href="@BuildUrl(Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                }
                @if (Pagina < totalPaginas)
                {
                    <a href="@BuildUrl(Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                }
            </div>
        </div>
    }
</div>

@code {
    private const string FiltroCss = "block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20";

    [SupplyParameterFromQuery(Name = "cuentaId")] private string? CuentaIdTexto { get; set; }
    [SupplyParameterFromQuery(Name = "desde")] private string? Desde { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] private string? Hasta { get; set; }
    [SupplyParameterFromQuery(Name = "tipoDocumento")] private string? TipoDocumentoTexto { get; set; }
    [SupplyParameterFromQuery(Name = "numeroDocumento")] private string? NumeroDocumento { get; set; }
    [SupplyParameterFromQuery(Name = "socioQuery")] private string? SocioQuery { get; set; }
    [SupplyParameterFromQuery(Name = "socioId")] private string? SocioIdTexto { get; set; }
    [SupplyParameterFromQuery(Name = "registroId")] private string? RegistroIdTexto { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] private string? PaginaTexto { get; set; }

    // Filtros leídos como texto (un valor manipulado en la URL da un aviso, no la página de error del binder).
    private Guid? CuentaId;
    private Guid? SocioId;
    private int? TipoDocumento;
    private long? RegistroId;
    private int Pagina = 1;

    private OpcionesCargadas<CuentaContableResponse> cuentas = OpcionesCargadas<CuentaContableResponse>.SinCargar;
    private OpcionesCargadas<SocioNegocioResponse> socios = OpcionesCargadas<SocioNegocioResponse>.SinCargar;
    private CuentaContableResponse? cuentaActual;
    private SocioNegocioResponse? socioActual;
    private IReadOnlyList<MovimientoContableResponse> movimientos = [];
    private string? NumeroRegistro;
    private long total;
    private int totalPaginas;
    private bool cargaFallida;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string>? errores;

    protected override async Task OnParametersSetAsync()
    {
        message = null;
        errores = null;
        cargaFallida = false;
        movimientos = [];
        NumeroRegistro = null;
        total = 0;
        totalPaginas = 0;

        var filtroInvalido = InventarioVistasOpciones.FiltroInvalido(
                ("cuentaId", CuentaIdTexto), ("socioId", SocioIdTexto), ("tipoDocumento", TipoDocumentoTexto))
            ?? RegistroInvalido(RegistroIdTexto);
        CuentaId = InventarioVistasOpciones.ParseGuid(CuentaIdTexto);
        SocioId = InventarioVistasOpciones.ParseGuid(SocioIdTexto);
        TipoDocumento = InventarioVistasOpciones.ParseEntero(TipoDocumentoTexto);
        RegistroId = long.TryParse(RegistroIdTexto, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var r) ? r : null;
        // Tope para que el OFFSET quepa en un entero: una página enorme en la URL acaba en la última página, no en un 400.
        Pagina = Math.Clamp(InventarioVistasOpciones.ParseEntero(PaginaTexto) ?? 1, 1, int.MaxValue / PageRequest.TamanoPorDefecto);

        cuentas = await ContabilidadVistasOpciones.CuentasPosteoAsync(CuentaApiClient, Logger);
        cuentaActual = await ContabilidadVistasOpciones.CuentaVigenteAsync(CuentaApiClient, CuentaId, cuentas.Items, Logger);
        socios = await VentasOpciones.SociosAsync(SocioApiClient, SocioQuery, Logger);
        socioActual = await EstadoCuentaOpciones.SocioVigenteAsync(SocioApiClient, SocioId, socios.Items, Logger);

        if (filtroInvalido is not null)
        {
            Show("warning", filtroInvalido);
            return;
        }

        if (!InventarioVistasOpciones.TryFecha(Desde, "La fecha «desde»", out var desde, out var errorFecha)
            || !InventarioVistasOpciones.TryFecha(Hasta, "La fecha «hasta»", out var hasta, out errorFecha))
        {
            Show("warning", errorFecha ?? "La fecha no es válida.");
            return;
        }

        var criterios = new MovimientoContableSearchCriteria(
            CuentaId, desde, hasta, TipoDocumento, string.IsNullOrWhiteSpace(NumeroDocumento) ? null : NumeroDocumento.Trim(), SocioId, RegistroId);
        try
        {
            var resultado = await ConsultasApiClient.ListMovimientosAsync(criterios, Paginacion());
            if (resultado.Succeeded && resultado.Valor!.TotalPaginas > 0 && Pagina > resultado.Valor.TotalPaginas)
            {
                Pagina = resultado.Valor.TotalPaginas;
                resultado = await ConsultasApiClient.ListMovimientosAsync(criterios, Paginacion());
            }

            if (!resultado.Succeeded)
            {
                cargaFallida = true;
                Show("warning", resultado.Message, resultado.Errors);
                return;
            }

            movimientos = resultado.Valor!.Items;
            total = resultado.Valor.Total;
            totalPaginas = resultado.Valor.TotalPaginas;
            NumeroRegistro = RegistroId is { } id ? movimientos.FirstOrDefault(m => m.RegistroContableId == id)?.NumeroRegistro : null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load movimientos contables.");
            cargaFallida = true;
            Show("danger", "No fue posible cargar los movimientos contables.");
        }
    }

    private static string? RegistroInvalido(string? texto) =>
        string.IsNullOrWhiteSpace(texto) || long.TryParse(texto, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out _)
            ? null
            : $"El filtro «registroId» de la dirección no es válido ('{texto}').";

    private PageRequest Paginacion() => new(Pagina, PageRequest.TamanoPorDefecto, "FechaRegistro", Descendente: false);

    private string NombreCuenta(Guid id) =>
        cuentaActual?.Id == id ? $"{cuentaActual.Numero} — {cuentaActual.Nombre}" : $"Cuenta seleccionada ({id})";

    private string NombreSocio(Guid id) =>
        socioActual?.Id == id ? $"{socioActual.Codigo} — {socioActual.NombreComercial}" : $"Socio seleccionado ({id})";

    private string UrlBalance()
    {
        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(Desde)) parameters.Add($"desde={Uri.EscapeDataString(Desde)}");
        if (!string.IsNullOrWhiteSpace(Hasta)) parameters.Add($"hasta={Uri.EscapeDataString(Hasta)}");
        return parameters.Count == 0 ? "/contabilidad/balance-comprobacion" : $"/contabilidad/balance-comprobacion?{string.Join("&", parameters)}";
    }

    private string BuildUrl(int pagina, bool sinRegistro = false)
    {
        var parameters = new List<string>();
        if (CuentaId is { } c) parameters.Add($"cuentaId={c}");
        if (!string.IsNullOrWhiteSpace(Desde)) parameters.Add($"desde={Uri.EscapeDataString(Desde)}");
        if (!string.IsNullOrWhiteSpace(Hasta)) parameters.Add($"hasta={Uri.EscapeDataString(Hasta)}");
        if (TipoDocumento is { } t) parameters.Add($"tipoDocumento={t}");
        if (!string.IsNullOrWhiteSpace(NumeroDocumento)) parameters.Add($"numeroDocumento={Uri.EscapeDataString(NumeroDocumento)}");
        if (!string.IsNullOrWhiteSpace(SocioQuery)) parameters.Add($"socioQuery={Uri.EscapeDataString(SocioQuery)}");
        if (SocioId is { } s) parameters.Add($"socioId={s}");
        if (!sinRegistro && RegistroId is { } r) parameters.Add($"registroId={r}");
        if (pagina > 1) parameters.Add($"pagina={pagina}");
        return parameters.Count == 0 ? "/contabilidad/movimientos" : $"/contabilidad/movimientos?{string.Join("&", parameters)}";
    }

    private void Show(string type, string text, IReadOnlyList<string>? detalle = null) { messageType = type; message = text; errores = detalle; }
}
