@page "/contabilidad/balance-comprobacion"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.Contabilidad
@using OpenSource1.Application.Features.Contabilidad.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@inject IContabilidadConsultasApiClient ConsultasApiClient
@inject ILogger<BalanceComprobacion> Logger

@*
    Balance de comprobación (Task 7.4): por rango de fechas de registro, cada cuenta de Posteo con movimientos o saldo lleva su
    saldo inicial (antes de «desde»), débitos y créditos del rango y saldo final; las cuentas de encabezado son títulos con su
    sangría. Sin cierre de ejercicio. Static SSR con formulario GET; el número de cuenta abre sus movimientos del mismo rango.
*@

<PageTitle>Balance de comprobación – AxionERP</PageTitle>

<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div>
        <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Contabilidad</p>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Balance de comprobación</h1>
        <p class="text-sm text-slate-500 mt-1">Saldo inicial, débitos, créditos y saldo final por cuenta en el rango. No hay cierre de ejercicio: las cuentas de resultado acumulan su saldo.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <a href="@UrlMovimientos(null)" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Movimientos contables</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6"><MessageBox Type="@messageType" Message="@message" Errors="@errores" /></div>
}

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/contabilidad/balance-comprobacion" data-enhance class="p-4 sm:p-6">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="desde">Desde (fecha registro)</label>
                <input id="desde" type="date" name="desde" value="@Desde" class="@FiltroCss" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1" for="hasta">Hasta</label>
                <input id="hasta" type="date" name="hasta" value="@Hasta" class="@FiltroCss" />
            </div>
        </div>
        <div class="mt-4 flex items-center gap-2">
            <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Consultar</button>
            <a href="/contabilidad/balance-comprobacion" title="Limpiar campos" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Limpiar campos</a>
        </div>
        <p class="mt-2 text-xs text-slate-400">Ambas fechas incluidas. Sin «desde», el rango empieza con el libro (saldo inicial cero); sin «hasta», llega hasta el último movimiento.</p>
    </form>
</div>

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-sm font-semibold text-slate-700">@Rango()</h2>
            <p class="mt-1 text-xs text-slate-500">@cuentasPosteo cuenta(s) con movimientos o saldo.</p>
        </div>
        @if (balance is not null)
        {
            @if (Cuadra)
            {
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700" data-testid="cuadre">El balance cuadra</span>
            }
            else
            {
                <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700" data-testid="cuadre">El balance NO cuadra</span>
            }
        }
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm" data-testid="tabla-balance">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Cuenta</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Nombre</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Tipo</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Saldo inicial</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Débitos</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Créditos</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Saldo final</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (balance is null || balance.Filas.Count == 0)
                {
                    <tr><td colspan="7" class="px-4 py-8 text-center text-slate-400 text-sm">@(cargaFallida ? "No fue posible cargar el balance de comprobación." : "No hay cuentas que mostrar.")</td></tr>
                }
                else
                {
                    @foreach (var f in balance.Filas)
                    {
                        var sangria = $"padding-left: {(1 + Math.Clamp(f.Sangria, 0, 10) * 1.25m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}rem";
                        if (f.EsEncabezado)
                        {
                            <tr @key="f.CuentaContableId" class="bg-slate-50/60" data-testid="fila-encabezado">
                                <td class="px-4 py-2 font-mono text-xs font-bold text-slate-800" style="@sangria">@f.Numero</td>
                                <td class="px-4 py-2 text-xs font-bold uppercase tracking-wide text-slate-700" colspan="6" style="@sangria">@f.Nombre</td>
                            </tr>
                        }
                        else
                        {
                            <tr @key="f.CuentaContableId" class="hover:bg-slate-50" data-testid="fila-cuenta">
                                <td class="px-4 py-3 font-mono text-xs" style="@sangria"><a class="text-brand-700 underline" href="@UrlMovimientos(f.CuentaContableId)">@f.Numero</a></td>
                                <td class="px-4 py-3 text-xs text-slate-700" style="@sangria">@f.Nombre@(f.Borrada ? " (borrada)" : "")</td>
                                <td class="px-4 py-3 text-xs text-slate-500">@ContabilidadVistasOpciones.TipoResultado(f.TipoResultado)</td>
                                <td class="px-4 py-3 text-right text-slate-700">@Importe(f.SaldoInicial)</td>
                                <td class="px-4 py-3 text-right text-slate-700">@Importe(f.Debitos)</td>
                                <td class="px-4 py-3 text-right text-slate-700">@Importe(f.Creditos)</td>
                                <td class="px-4 py-3 text-right font-semibold text-slate-900">@Importe(f.SaldoFinal)</td>
                            </tr>
                        }
                    }
                }
            </tbody>
            @if (balance is not null)
            {
                <tfoot class="bg-slate-50 border-t-2 border-slate-200" data-testid="totales-balance">
                    <tr>
                        <td colspan="3" class="px-4 py-3 text-xs font-bold uppercase text-slate-600">Totales</td>
                        <td class="px-4 py-3 text-right font-bold text-slate-900">@VentasOpciones.Importe(balance.Totales.SaldoInicial)</td>
                        <td class="px-4 py-3 text-right font-bold text-slate-900">@VentasOpciones.Importe(balance.Totales.Debitos)</td>
                        <td class="px-4 py-3 text-right font-bold text-slate-900">@VentasOpciones.Importe(balance.Totales.Creditos)</td>
                        <td class="px-4 py-3 text-right font-bold text-slate-900">@VentasOpciones.Importe(balance.Totales.SaldoFinal)</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

@code {
    private const string FiltroCss = "block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20";

    [SupplyParameterFromQuery(Name = "desde")] private string? Desde { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] private string? Hasta { get; set; }

    private BalanceComprobacionResponse? balance;
    private int cuentasPosteo;
    private bool cargaFallida;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string>? errores;

    /// <summary>Σ saldos iniciales = Σ saldos finales = 0 y Σ débitos = Σ créditos.</summary>
    private bool Cuadra => balance is { Totales: var t } && t.SaldoInicial == 0m && t.SaldoFinal == 0m && t.Debitos == t.Creditos;

    protected override async Task OnParametersSetAsync()
    {
        message = null;
        errores = null;
        cargaFallida = false;
        balance = null;
        cuentasPosteo = 0;

        if (!InventarioVistasOpciones.TryFecha(Desde, "La fecha «desde»", out var desde, out var errorFecha)
            || !InventarioVistasOpciones.TryFecha(Hasta, "La fecha «hasta»", out var hasta, out errorFecha))
        {
            Show("warning", errorFecha ?? "La fecha no es válida.");
            return;
        }

        try
        {
            var resultado = await ConsultasApiClient.GetBalanceComprobacionAsync(new BalanceComprobacionCriterios(desde, hasta));
            if (!resultado.Succeeded)
            {
                cargaFallida = true;
                Show("warning", resultado.Message, resultado.Errors);
                return;
            }

            balance = resultado.Valor;
            cuentasPosteo = balance!.Filas.Count(f => !f.EsEncabezado);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load balance de comprobación.");
            cargaFallida = true;
            Show("danger", "No fue posible cargar el balance de comprobación.");
        }
    }

    private static string Importe(decimal? valor) => valor is { } v ? VentasOpciones.Importe(v) : "";

    private string Rango() => balance is null
        ? "Balance"
        : (balance.Desde, balance.Hasta) switch
        {
            (null, null) => "Todo el libro",
            ({ } d, null) => $"Desde el {EntradaFecha.Formatear(d)}",
            (null, { } h) => $"Hasta el {EntradaFecha.Formatear(h)}",
            ({ } d, { } h) => $"Del {EntradaFecha.Formatear(d)} al {EntradaFecha.Formatear(h)}",
        };

    private string UrlMovimientos(Guid? cuentaId)
    {
        var parameters = new List<string>();
        if (cuentaId is { } c) parameters.Add($"cuentaId={c}");
        if (!string.IsNullOrWhiteSpace(Desde)) parameters.Add($"desde={Uri.EscapeDataString(Desde)}");
        if (!string.IsNullOrWhiteSpace(Hasta)) parameters.Add($"hasta={Uri.EscapeDataString(Hasta)}");
        return parameters.Count == 0 ? "/contabilidad/movimientos" : $"/contabilidad/movimientos?{string.Join("&", parameters)}";
    }

    private void Show(string type, string text, IReadOnlyList<string>? detalle = null) { messageType = type; message = text; errores = detalle; }
}
