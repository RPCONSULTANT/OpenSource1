@code {
    private static readonly (string Key, string Label)[] FilterableFields =
    [
        ("codigo", "Código"),
        ("categoria", "Categoría"),
        ("precio", "Precio"),
        ("stock", "Stock"),
    ];

    [SupplyParameterFromQuery(Name = "nombre")] private string? SearchNombre { get; set; }
    [SupplyParameterFromQuery(Name = "codigo")] private string? SearchCodigo { get; set; }
    [SupplyParameterFromQuery(Name = "categoria")] private string? SearchCategoria { get; set; }
    [SupplyParameterFromQuery(Name = "precio")] private string? SearchPrecio { get; set; }
    [SupplyParameterFromQuery(Name = "stock")] private string? SearchStock { get; set; }
    [SupplyParameterFromQuery(Name = "filters")] private string? FiltersRaw { get; set; }
    [SupplyParameterFromQuery(Name = "addField")] private string? AddField { get; set; }
    [SupplyParameterFromQuery(Name = "view")] private string? View { get; set; }
    [SupplyParameterFromQuery(Name = "showFilters")] private bool ShowFilters { get; set; }
    [SupplyParameterFromQuery(Name = "report")] private bool ShowReport { get; set; }
    [SupplyParameterFromQuery(Name = "focusId")] private Guid? FocusProductoId { get; set; }
    [SupplyParameterFromQuery(Name = "deleteId")] private Guid? DeleteId { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    [SupplyParameterFromForm(FormName = "delete-producto-list")] private DeleteConfirmForm? DeleteInput { get; set; }
    private IReadOnlyList<ProductoResponse> productos = [];
    private List<string> ActiveFilterFields = [];
    private string? message; private string messageType = "info"; private string? modalError; private bool canAdd; private bool canModify; private bool canDelete; private bool IsListView => string.Equals(View, "list", StringComparison.OrdinalIgnoreCase); private bool ShowFactbox => FocusProductoId.HasValue; [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private const string EntityFabOnChange = "(function(cb){var fab=document.getElementById('producto-detail-fab');var link=document.getElementById('producto-detail-fab-link');if(!fab||!link)return;if(cb.checked){fab.dataset.lastId=cb.value;}else if(fab.dataset.lastId===cb.value){var form=cb.closest('form');var sc=form?form.querySelector('input[name=SelectedIds]:checked'):null;fab.dataset.lastId=sc?sc.value:'';}var base_=fab.getAttribute('data-base-url');var sep=base_.indexOf('?')===-1?'?':'&';var href=fab.dataset.lastId?(base_+sep+'focusId='+fab.dataset.lastId):base_;link.setAttribute('href',href);if(fab.getAttribute('data-auto-nav')==='true'){window.location.href=href;return;}if(fab.dataset.lastId){fab.classList.remove('hidden');}else{fab.classList.add('hidden');}})(this)";
    private string GridColsClass => (ShowFactbox, ShowFilters) switch { (true, true) => "xl:grid-cols-[280px_minmax(0,1fr)_320px]", (true, false) => "xl:grid-cols-[280px_minmax(0,1fr)]", (false, true) => "xl:grid-cols-[minmax(0,1fr)_320px]", (false, false) => "xl:grid-cols-1" };
    private List<(string Key, string Label)> AvailableFields => [.. FilterableFields.Where(f => !ActiveFilterFields.Contains(f.Key))];
    private static string FieldLabel(string key) => FilterableFields.FirstOrDefault(f => f.Key == key).Label ?? key;
    protected override async Task OnInitializedAsync()
    {
        DeleteInput ??= new();
        ActiveFilterFields = ParseActiveFields(FiltersRaw);
        if (!string.IsNullOrWhiteSpace(AddField) && FilterableFields.Any(f => f.Key == AddField) && !ActiveFilterFields.Contains(AddField))
        {
            Nav.NavigateTo(BuildListUrl(activeFiltersOverride: [.. ActiveFilterFields, AddField]), replace: true);
            return;
        }
        if(AuthenticationStateTask is not null){var user=(await AuthenticationStateTask).User; canAdd=(await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanAdd)).Succeeded; canModify=(await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanModify)).Succeeded; canDelete=(await AuthorizationService.AuthorizeAsync(user, ApplicationPolicies.CanDelete)).Succeeded;}
        await LoadAsync();
        if(Ok is not null){(messageType, message)=Ok switch {"created"=>("success","Producto creado satisfactoriamente."),"updated"=>("success","Producto modificado satisfactoriamente."),"deleted"=>("success","Producto eliminado satisfactoriamente."),"report-select-required"=>("warning","Seleccione al menos un producto para generar el reporte."),"report-no-data"=>("warning","No hay datos para generar el reporte solicitado."),_ =>("info",null)};}
    }
    private async Task LoadAsync(){try{productos=await ProductoApiClient.ListAsync(new ProductoSearchFilter(GetActiveValue("codigo", SearchCodigo), EmptyAsNull(SearchNombre), GetActiveValue("categoria", SearchCategoria), GetActiveValue("precio", SearchPrecio), GetActiveValue("stock", SearchStock)));} catch(Exception ex){Logger.LogWarning(ex,"Could not load productos from API."); message="No fue posible cargar los productos."; messageType="danger";}}
    private async Task DeleteAsync(){if(!DeleteId.HasValue){modalError="No se pudo identificar el producto. Intente de nuevo."; return;} var result=await ProductoApiClient.DeleteAsync(DeleteId.Value); if(result.Succeeded) Nav.NavigateTo(BuildListUrl(ok:"deleted")); else modalError=result.Message;}
    private string? GetActiveValue(string key, string? value) => ActiveFilterFields.Contains(key) ? EmptyAsNull(value) : null;
    private string? GetFieldValue(string key) => key switch { "codigo" => SearchCodigo, "categoria" => SearchCategoria, "precio" => SearchPrecio, "stock" => SearchStock, _ => null };
    private static List<string> ParseActiveFields(string? raw) => string.IsNullOrWhiteSpace(raw) ? [] : [.. raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Where(f => FilterableFields.Any(field => field.Key == f)).Distinct()];
    private string BuildListUrl(Guid? deleteId=null, bool? showFilters=null, string? ok=null, string? view=null, bool? report=null, Guid? focusId=null, IReadOnlyList<string>? activeFiltersOverride=null)
    {
        var activeFields = activeFiltersOverride ?? ActiveFilterFields;
        var parameters=new List<string>();
        AddParameter(parameters,"nombre",SearchNombre);
        if (activeFields.Contains("codigo")) AddParameter(parameters,"codigo",SearchCodigo);
        if (activeFields.Contains("categoria")) AddParameter(parameters,"categoria",SearchCategoria);
        if (activeFields.Contains("precio")) AddParameter(parameters,"precio",SearchPrecio);
        if (activeFields.Contains("stock")) AddParameter(parameters,"stock",SearchStock);
        if (activeFields.Count > 0) parameters.Add($"filters={Uri.EscapeDataString(string.Join(",", activeFields))}");
        AddParameter(parameters,"view", view ?? View);
        if(showFilters ?? ShowFilters) parameters.Add("showFilters=true");
        if(report ?? ShowReport) parameters.Add("report=true");
        if(focusId.HasValue) AddParameter(parameters,"focusId",focusId.Value.ToString());
        if(deleteId.HasValue) AddParameter(parameters,"deleteId",deleteId.Value.ToString());
        AddParameter(parameters,"ok",ok);
        return parameters.Count==0 ? "/productos" : $"/productos?{string.Join("&",parameters)}";
    }
    private static void AddParameter(List<string> parameters,string key,string? value){if(!string.IsNullOrWhiteSpace(value)) parameters.Add($"{key}={Uri.EscapeDataString(value)}");}
    private static string? EmptyAsNull(string? value)=>string.IsNullOrWhiteSpace(value)?null:value;
    private sealed class DeleteConfirmForm{}
}
