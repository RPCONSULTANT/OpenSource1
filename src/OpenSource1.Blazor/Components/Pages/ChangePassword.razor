@page "/account/change-password"
@page "/account/profile"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using OpenSource1.Application.Services.Auth.Dtos
@using OpenSource1.Blazor.Services
@inject IAuthApiClient AuthApiClient
@inject IHttpContextAccessor HttpContextAccessor
@inject IFileStorageService FileStorageService

<PageTitle>Mi perfil – AxionERP</PageTitle>

<div class="mx-auto max-w-4xl">
    <div class="mb-6">
        <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Cuenta</p>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight dark:text-slate-100">Mi perfil</h1>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Revise su información de acceso y gestione la seguridad de su cuenta.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 animate-slide-up">
        <aside class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden lg:col-span-1 dark:border-slate-700 dark:bg-slate-800">
            <div class="h-1.5 bg-gradient-to-r from-brand-400 to-brand-600"></div>
            <div class="p-6 text-center">
                @if (!string.IsNullOrWhiteSpace(ProfileImagePath))
                {
                    <img src="@ProfileImagePath" alt="Foto de perfil" class="mx-auto mb-4 h-20 w-20 rounded-full object-cover border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-900/40" />
                }
                else
                {
                    <div class="mx-auto mb-4 flex size-20 items-center justify-center rounded-full bg-brand-100 text-brand-700 font-extrabold text-3xl dark:text-brand-400">
                        @ProfileInitial
                    </div>
                }
                <p class="text-lg font-extrabold text-slate-900 mb-0.5 dark:text-slate-100">@DisplayName</p>
                <p class="text-sm text-slate-400 break-all dark:text-slate-500">@Email</p>
                <div class="mt-4 flex flex-wrap justify-center gap-1.5">
                    @foreach (var role in Roles)
                    {
                        <span class="inline-flex items-center rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-semibold text-brand-800 dark:text-brand-400">@role</span>
                    }
                </div>
            </div>
        </aside>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden lg:col-span-2 dark:border-slate-700 dark:bg-slate-800">
        <div class="border-b border-slate-100 bg-slate-50 px-6 py-4 dark:border-slate-700/60 dark:bg-slate-900/40">
            <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide dark:text-slate-200">Seguridad y foto de perfil</h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Actualice su contraseña e imagen de perfil.</p>
        </div>
        <div class="px-6 py-5">
            @if (errors.Count > 0)
            {
                <div class="mb-5"><MessageBox Type="danger" Errors="errors" /></div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="mb-5"><ActionFeedback Type="success" Message="@successMessage" /></div>
            }

            <form method="post" action="/account/profile/image" enctype="multipart/form-data" data-enhance class="mb-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900/40">
                <AntiforgeryToken />
                <label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300">Foto de perfil</label>
                <input type="file" name="ProfileImage" accept=".jpg,.jpeg,.png,.webp" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300" />
                <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">Formatos permitidos: JPG, PNG, WEBP. Máximo 2 MB.</p>
                <div class="mt-3">
                    <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Guardar imagen</button>
                </div>
            </form>

            <EditForm Model="Input" FormName="change-password" OnValidSubmit="SubmitAsync" Enhance="true">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300" for="currentPassword">Contraseña actual</label>
                    <InputText id="currentPassword" type="password" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 shadow-sm focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25 dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-200" @bind-Value="Input!.CurrentPassword" autocomplete="current-password" />
                    <ValidationMessage For="() => Input!.CurrentPassword" />
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300" for="newPassword">Nueva contraseña</label>
                    <InputText id="newPassword" type="password" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 shadow-sm focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25 dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-200" @bind-Value="Input!.NewPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => Input!.NewPassword" />
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5 dark:text-slate-300" for="confirmPassword">Confirmar nueva contraseña</label>
                    <InputText id="confirmPassword" type="password" class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 shadow-sm focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25 dark:border-slate-600 dark:bg-slate-900/40 dark:text-slate-200" @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => Input!.ConfirmPassword" />
                </div>

                <div class="flex items-center gap-3">
                    <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 transition-colors">
                        Guardar nueva contraseña
                    </button>
                    <a href="/" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-colors shadow-sm dark:border-slate-600 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60">Cancelar</a>
                </div>
            </EditForm>
        </div>
    </section>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordInput? Input { get; set; }

    private IReadOnlyList<string> errors = [];
    private string? successMessage;
    private string DisplayName { get; set; } = "Usuario";
    private string Email { get; set; } = string.Empty;
    private string? ProfileImagePath { get; set; }
    private IReadOnlyList<string> Roles { get; set; } = [];
    private string ProfileInitial => string.IsNullOrWhiteSpace(DisplayName) ? "?" : DisplayName[0].ToString().ToUpperInvariant();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            var principal = state.User;
            DisplayName = principal.Identity?.Name ?? "Usuario";
            Email = principal.FindFirstValue(ClaimTypes.Email) ?? principal.FindFirstValue("email") ?? string.Empty;
            Roles = principal.FindAll(ClaimTypes.Role).Select(c => c.Value).ToArray();
        }

        var currentUser = await AuthApiClient.GetCurrentUserAsync();
        ProfileImagePath = currentUser?.ProfileImagePath;
    }

    private async Task SubmitAsync()
    {
        errors = [];
        successMessage = null;

        var result = await AuthApiClient.ChangePasswordAsync(new ChangePasswordRequest
        {
            CurrentPassword = Input!.CurrentPassword,
            NewPassword = Input.NewPassword
        });

        if (!result.Succeeded || result.Response is null)
        {
            errors = result.Errors.Count > 0 ? result.Errors : ["No fue posible cambiar la contraseña."];
            return;
        }

        successMessage = result.Response.Message;
        Input = new();
    }

    private sealed class ChangePasswordInput
    {
        [Required(ErrorMessage = "Debe ingresar su contraseña actual.")]
        [MaxLength(100)]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe ingresar la nueva contraseña.")]
        [MinLength(8, ErrorMessage = "La contraseña debe tener al menos 8 caracteres.")]
        [MaxLength(100)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe confirmar la nueva contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
