@page "/notas-credito-venta"
@page "/notas-credito-venta/{Numero}"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.NotasCreditoVenta.Posteadas
@using OpenSource1.Application.Features.NotasCreditoVenta.Posteadas.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@using OpenSource1.Core.Enums
@inject INotaCreditoVentaApiClient NotaApiClient
@inject ILogger<NotasCreditoVenta> Logger

<PageTitle>@(Numero is null ? "Notas de crédito" : $"Nota de crédito {Numero}") – AxionERP</PageTitle>

<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div>
        <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-1">Ventas</p>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">@(Numero is null ? "Notas de crédito" : $"Nota de crédito {Numero}")</h1>
        <p class="text-sm text-slate-500 mt-1">@(Numero is null ? "Notas de crédito de venta posteadas (documento legal, sin modificación)." : "Documento legal posteado: cabecera, líneas y líneas de IVA.")</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        @if (Numero is not null)
        {
            <a href="/notas-credito-venta" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Volver al listado</a>
        }
        <a href="/notas-credito-venta/borradores" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Borradores</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Title="Nota de crédito posteada" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" />
        }
    </div>
}

@if (Numero is null)
{
    <!-- ── Filtros ── -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
        <form method="get" action="/notas-credito-venta" data-enhance class="p-4 sm:p-6">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-5 max-w-6xl">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroNumero">Número</label>
                        <input id="filtroNumero" type="text" name="numero" value="@SearchNumero" placeholder="ej. 00000001" class="@FiltroCss" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroFactura">Factura</label>
                        <input id="filtroFactura" type="text" name="factura" value="@SearchFactura" placeholder="ej. 00000001" class="@FiltroCss" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroNombre">Nombre de facturación</label>
                        <input id="filtroNombre" type="text" name="nombre" value="@SearchNombre" class="@FiltroCss" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroDesde">Desde (fecha registro)</label>
                        <input id="filtroDesde" type="date" name="desde" value="@SearchDesde" class="@FiltroCss" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroHasta">Hasta</label>
                        <input id="filtroHasta" type="date" name="hasta" value="@SearchHasta" class="@FiltroCss" />
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="submit" class="btn-press rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Consultar</button>
                    <a href="/notas-credito-venta" title="Limpiar campos" class="btn-press rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Limpiar campos</a>
                </div>
            </div>
        </form>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="text-sm font-semibold text-slate-700">Notas de crédito posteadas</h2>
            <p class="mt-1 text-xs text-slate-500">@total resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1).</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100 text-sm" data-testid="tabla-notas">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Número</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Factura</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Facturar a</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Fecha reg.</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Sin IVA</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">IVA</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Total</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Asiento</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 bg-white">
                    @if (notas.Count == 0)
                    {
                        <tr><td colspan="8" class="px-4 py-8 text-center text-slate-400 text-sm">No hay notas de crédito con esos criterios.</td></tr>
                    }
                    @foreach (var n in notas)
                    {
                        <tr @key="n.Numero" class="hover:bg-slate-50">
                            <td class="px-4 py-3"><a href="@($"/notas-credito-venta/{Uri.EscapeDataString(n.Numero)}")" class="font-mono text-xs font-semibold text-brand-700 hover:underline">@n.Numero</a></td>
                            <td class="px-4 py-3"><a href="@($"/facturas-venta/{Uri.EscapeDataString(n.FacturaVentaNumero)}")" class="font-mono text-xs text-brand-700 hover:underline">@n.FacturaVentaNumero</a></td>
                            <td class="px-4 py-3 text-slate-700">@n.SocioNegocioFacturarACodigo <span class="text-xs text-slate-400">@n.NombreFacturacion</span></td>
                            <td class="px-4 py-3 text-xs text-slate-500">@EntradaFecha.Formatear(n.FechaRegistro)</td>
                            <td class="px-4 py-3 text-right text-slate-700">@VentasOpciones.Importe(n.ImporteSinIva)</td>
                            <td class="px-4 py-3 text-right text-slate-700">@VentasOpciones.Importe(n.ImporteIva)</td>
                            <td class="px-4 py-3 text-right font-semibold text-slate-900">@VentasOpciones.Importe(n.ImporteTotal)</td>
                            <td class="px-4 py-3 font-mono text-xs text-slate-500">@(n.NumeroRegistroContable ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPaginas > 1)
        {
            <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
                <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
                <div class="flex items-center gap-2">
                    @if (Pagina > 1)
                    {
                        <a href="@BuildListUrl(Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                    }
                    @if (Pagina < totalPaginas)
                    {
                        <a href="@BuildListUrl(Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                    }
                </div>
            </div>
        }
    </div>
}
else if (detalle is null)
{
    @if (!detalleCargaFallida)
    {
        <div class="rounded-2xl border border-slate-200 bg-white px-8 py-12 text-center text-slate-400 shadow-sm"><p class="font-semibold text-slate-500">No se encontró la nota de crédito @Numero.</p></div>
    }
}
else
{
    var c = detalle.Cabecera;
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm mb-6 px-6 py-5" data-testid="cabecera-nota">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 text-sm">
            <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Facturar a</p>
                <p class="mt-1 text-slate-700"><a class="hover:underline" href="@($"/clientes/{c.SocioNegocioFacturarAId}")">@c.SocioNegocioFacturarACodigo — @c.NombreFacturacion</a></p>
                <p class="text-xs text-slate-400">@c.RazonSocialFacturacion @c.NumeroDocumentoFiscal</p></div>
            <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Factura acreditada</p>
                <p class="mt-1"><a class="font-mono text-brand-700 underline" href="@($"/facturas-venta/{Uri.EscapeDataString(c.FacturaVentaNumero)}")" data-testid="factura-nota">@c.FacturaVentaNumero</a></p>
                <p class="text-xs text-slate-400">Borrador de origen: @c.NumeroBorrador</p></div>
            <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Fechas</p><p class="mt-1 text-slate-700">Reg. @EntradaFecha.Formatear(c.FechaRegistro) · Doc. @EntradaFecha.Formatear(c.FechaDocumento)</p></div>
            <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Asiento</p>
                <p class="mt-1 text-xs font-mono text-slate-500" data-testid="registro-contable">@(c.NumeroRegistroContable ?? "Sin asiento (total 0)")</p></div>
            @if (!string.IsNullOrWhiteSpace(c.Descripcion))
            {
                <div class="sm:col-span-2 lg:col-span-4"><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Descripción</p><p class="mt-1 text-slate-700">@c.Descripcion</p></div>
            }
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
        <div class="px-6 py-4 border-b border-slate-100"><h2 class="text-sm font-semibold text-slate-700">Líneas</h2><p class="mt-1 text-xs text-slate-500">El número de línea es el de la factura acreditada.</p></div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100 text-sm" data-testid="lineas-nota">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">#</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Tipo</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Producto / Cuenta</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Descripción</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Almacén</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Cantidad</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Precio</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Descuento</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Importe</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">IVA</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Devolución</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 bg-white">
                    @foreach (var l in detalle.Lineas.OrderBy(x => x.NumeroLinea))
                    {
                        <tr @key="l.Id">
                            <td class="px-4 py-3 text-xs text-slate-400">@l.NumeroLinea</td>
                            <td class="px-4 py-3 text-xs text-slate-700">@VentasOpciones.TipoLinea(l.Tipo)</td>
                            <td class="px-4 py-3 text-xs text-slate-700">@(l.ProductoCodigo ?? l.CuentaContableNumero ?? "—")</td>
                            <td class="px-4 py-3 text-slate-700">@l.Descripcion</td>
                            <td class="px-4 py-3 text-xs text-slate-500">@(l.AlmacenCodigo ?? "—")</td>
                            <td class="px-4 py-3 text-right text-slate-700">@l.Cantidad.ToString("0.######", CultureInfo.InvariantCulture) <span class="text-xs text-slate-400">@l.UnidadMedidaCodigo</span></td>
                            <td class="px-4 py-3 text-right text-slate-700">@l.PrecioUnitario.ToString("0.00##", CultureInfo.InvariantCulture)</td>
                            <td class="px-4 py-3 text-right text-slate-500">@(l.ImporteDescuentoLinea == 0 ? "—" : $"{VentasOpciones.Importe(l.ImporteDescuentoLinea)} ({l.PorcentajeDescuentoLinea.ToString("0.#####", CultureInfo.InvariantCulture)}%)")</td>
                            <td class="px-4 py-3 text-right font-semibold text-slate-800">@VentasOpciones.Importe(l.ImporteLinea)</td>
                            <td class="px-4 py-3 text-xs text-slate-500">@l.IdentificadorIva @l.PorcentajeIva.ToString("0.##", CultureInfo.InvariantCulture)%</td>
                            <td class="px-4 py-3 text-xs @(l.DevolverInventario ? "font-semibold text-emerald-700" : "text-slate-400")">
                                @if (l.DevolverInventario && l.ProductoId is { } productoId)
                                {
                                    <a class="underline" href="@($"/inventario/movimientos-producto?productoId={productoId}&tipoOrigen={(int)TipoOrigenMovimiento.NotaCreditoVenta}")">Sí</a>
                                }
                                else
                                {
                                    @("No")
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100"><h2 class="text-sm font-semibold text-slate-700">Líneas de IVA</h2></div>
            <table class="min-w-full text-sm" data-testid="lineas-iva">
                <thead class="bg-slate-50"><tr>
                    <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 uppercase">Identificador</th>
                    <th class="px-4 py-2 text-right text-xs font-semibold text-slate-500 uppercase">%</th>
                    <th class="px-4 py-2 text-right text-xs font-semibold text-slate-500 uppercase">Base</th>
                    <th class="px-4 py-2 text-right text-xs font-semibold text-slate-500 uppercase">IVA</th>
                    <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 uppercase">Cuenta</th>
                </tr></thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var iva in detalle.LineasIva)
                    {
                        <tr @key="iva.Id">
                            <td class="px-4 py-2 text-slate-700">@iva.IdentificadorIva</td>
                            <td class="px-4 py-2 text-right text-slate-500">@iva.PorcentajeIva.ToString("0.#####", CultureInfo.InvariantCulture)</td>
                            <td class="px-4 py-2 text-right">@VentasOpciones.Importe(iva.BaseImponible)</td>
                            <td class="px-4 py-2 text-right">@VentasOpciones.Importe(iva.ImporteIva)</td>
                            <td class="px-4 py-2 font-mono text-xs text-slate-500">@iva.CuentaIvaNumero</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm px-6 py-5">
            <dl class="text-sm space-y-2" data-testid="totales-nota">
                <div class="flex justify-between"><dt class="text-slate-500">Importe sin IVA</dt><dd class="font-semibold text-slate-800">@VentasOpciones.Importe(c.ImporteSinIva)</dd></div>
                <div class="flex justify-between"><dt class="text-slate-500">IVA</dt><dd class="font-semibold text-slate-800">@VentasOpciones.Importe(c.ImporteIva)</dd></div>
                <div class="flex justify-between border-t border-slate-100 pt-2"><dt class="font-bold text-slate-700">Total acreditado</dt><dd class="text-lg font-extrabold text-slate-900">@VentasOpciones.Importe(c.ImporteTotal)</dd></div>
            </dl>
            <p class="mt-4 text-xs"><a class="text-brand-700 underline" href="@($"/ventas/movimientos-cliente?socioId={c.SocioNegocioFacturarAId}")">Movimientos del cliente</a></p>
        </div>
    </div>
}

@code {
    private const string FiltroCss = "block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20";

    [Parameter] public string? Numero { get; set; }

    [SupplyParameterFromQuery(Name = "numero")] private string? SearchNumero { get; set; }
    [SupplyParameterFromQuery(Name = "factura")] private string? SearchFactura { get; set; }
    [SupplyParameterFromQuery(Name = "nombre")] private string? SearchNombre { get; set; }
    [SupplyParameterFromQuery(Name = "desde")] private string? SearchDesde { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] private string? SearchHasta { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] private int Pagina { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "registro")] private string? Registro { get; set; }
    [SupplyParameterFromQuery(Name = "aplicado")] private string? Aplicado { get; set; }

    private IReadOnlyList<NotaCreditoVentaResponse> notas = [];
    private long total;
    private int totalPaginas;
    private NotaCreditoVentaDetalleResponse? detalle;
    private bool detalleCargaFallida;
    private string? message;
    private string messageType = "info";

    protected override async Task OnParametersSetAsync()
    {
        message = null;
        if (Numero is null)
        {
            await CargarListadoAsync();
            return;
        }

        try
        {
            detalle = await NotaApiClient.GetNotaAsync(Numero);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load nota de crédito {Numero}.", Numero);
            detalleCargaFallida = true;
            Show("danger", "No fue posible cargar la nota de crédito.");
            return;
        }

        if (Ok == "posteada" && detalle is not null)
        {
            var c = detalle.Cabecera;
            var registro = Registro ?? c.NumeroRegistroContable;
            var aplicado = decimal.TryParse(Aplicado, NumberStyles.Number, CultureInfo.InvariantCulture, out var a) ? a : (decimal?)null;
            Show("success", $"Nota de crédito {c.Numero} posteada por {VentasOpciones.Importe(c.ImporteTotal)} sobre la factura {c.FacturaVentaNumero}. " +
                (registro is null
                    ? "Total 0 (devolución sin importe): sin movimiento de cliente ni registro contable."
                    : $"{(aplicado is { } ap ? $"Aplicado a la factura: {VentasOpciones.Importe(ap)}. " : "")}Registro contable {registro}."));
        }
    }

    private async Task CargarListadoAsync()
    {
        DateOnly? desde = null, hasta = null;
        if (!string.IsNullOrWhiteSpace(SearchDesde))
        {
            if (EntradaFecha.TryParse(SearchDesde, out var d, out _)) desde = d;
            else { Show("warning", "La fecha «desde» no es válida."); return; }
        }

        if (!string.IsNullOrWhiteSpace(SearchHasta))
        {
            if (EntradaFecha.TryParse(SearchHasta, out var h, out _)) hasta = h;
            else { Show("warning", "La fecha «hasta» no es válida."); return; }
        }

        try
        {
            var filtro = new NotaCreditoVentaSearchCriteria(EmptyAsNull(SearchNumero), EmptyAsNull(SearchFactura), EmptyAsNull(SearchNombre), null, desde, hasta);
            if (Pagina < 1) Pagina = 1;
            // Orden explícito: por número descendente (lo último posteado primero).
            var pagina = await NotaApiClient.ListNotasAsync(filtro, new PageRequest(Pagina, PageRequest.TamanoPorDefecto, "Numero", Descendente: true));
            if (pagina.TotalPaginas > 0 && Pagina > pagina.TotalPaginas)
            {
                Pagina = pagina.TotalPaginas;
                pagina = await NotaApiClient.ListNotasAsync(filtro, new PageRequest(Pagina, PageRequest.TamanoPorDefecto, "Numero", Descendente: true));
            }

            notas = pagina.Items;
            total = pagina.Total;
            totalPaginas = pagina.TotalPaginas;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            Logger.LogWarning(ex, "Invalid filters for notas de crédito.");
            Show("warning", "La fecha «desde» no puede ser posterior a «hasta».");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load notas de crédito.");
            Show("danger", "No fue posible cargar las notas de crédito.");
        }
    }

    private string BuildListUrl(int pagina)
    {
        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(SearchNumero)) parameters.Add($"numero={Uri.EscapeDataString(SearchNumero)}");
        if (!string.IsNullOrWhiteSpace(SearchFactura)) parameters.Add($"factura={Uri.EscapeDataString(SearchFactura)}");
        if (!string.IsNullOrWhiteSpace(SearchNombre)) parameters.Add($"nombre={Uri.EscapeDataString(SearchNombre)}");
        if (!string.IsNullOrWhiteSpace(SearchDesde)) parameters.Add($"desde={Uri.EscapeDataString(SearchDesde)}");
        if (!string.IsNullOrWhiteSpace(SearchHasta)) parameters.Add($"hasta={Uri.EscapeDataString(SearchHasta)}");
        if (pagina > 1) parameters.Add($"pagina={pagina}");
        return parameters.Count == 0 ? "/notas-credito-venta" : $"/notas-credito-venta?{string.Join("&", parameters)}";
    }

    private void Show(string type, string text) { messageType = type; message = text; }

    private static string? EmptyAsNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
