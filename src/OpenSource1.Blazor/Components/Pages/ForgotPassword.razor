@page "/account/forgot-password"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using OpenSource1.Application.Services.Auth.Dtos
@using OpenSource1.Blazor.Services
@inject IAuthApiClient AuthApiClient

<PageTitle>Recuperar contraseña – AxionERP</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-slate-100 via-brand-50 to-white flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md animate-fade-in">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
            <div class="h-1 w-full bg-gradient-to-r from-brand-500 to-brand-700"></div>
            <div class="px-8 py-8">
                <p class="text-xs font-bold tracking-widest uppercase text-brand-600 mb-2">Recuperación de acceso</p>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">¿Olvidó su contraseña?</h1>
                <p class="mt-2 text-sm text-slate-500">Ingrese su usuario o correo. Si la cuenta existe, enviaremos instrucciones para restablecer la contraseña por un canal seguro.</p>

                @if (errors.Count > 0)
                {
                    <div class="mt-5"><MessageBox Type="danger" Errors="errors" /></div>
                }

                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="mt-5"><MessageBox Type="success" Message="@successMessage" /></div>
                }

                <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="SubmitAsync" class="mt-6" Enhance="true">
                    <DataAnnotationsValidator />

                    <div class="mb-5">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="userNameOrEmail">Usuario o correo electrónico</label>
                        <InputText id="userNameOrEmail"
                                   class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-800 placeholder-slate-400 shadow-sm focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/25"
                                   @bind-Value="Input!.UserNameOrEmail"
                                   autocomplete="username"
                                   placeholder="admin@empresa.com o admin" />
                        <ValidationMessage For="() => Input!.UserNameOrEmail" />
                    </div>

                    <button type="submit" class="btn-press w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 transition-colors">
                        Solicitar recuperación
                    </button>
                </EditForm>
            </div>
            <div class="border-t border-slate-100 bg-slate-50 px-8 py-4 text-center text-sm text-slate-500">
                <a href="/account/login" class="font-semibold text-brand-600 hover:text-brand-700 hover:underline">Volver a iniciar sesión</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "forgot-password")]
    private ForgotPasswordInput? Input { get; set; }

    private IReadOnlyList<string> errors = [];
    private string? successMessage;

    protected override void OnInitialized() => Input ??= new();

    private async Task SubmitAsync()
    {
        errors = [];
        successMessage = null;

        var result = await AuthApiClient.ForgotPasswordAsync(new ForgotPasswordRequest
        {
            UserNameOrEmail = Input!.UserNameOrEmail.Trim()
        });

        if (!result.Succeeded || result.Response is null)
        {
            errors = result.Errors.Count > 0 ? result.Errors : ["No fue posible generar la solicitud."];
            return;
        }

        successMessage = "Si la cuenta existe, recibirá instrucciones para restablecer su contraseña.";
    }

    private sealed class ForgotPasswordInput
    {
        [Required(ErrorMessage = "Debe ingresar su usuario o correo electrónico.")]
        [MaxLength(256)]
        public string UserNameOrEmail { get; set; } = string.Empty;
    }
}
