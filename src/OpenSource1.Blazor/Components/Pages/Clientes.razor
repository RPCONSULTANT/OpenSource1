@code {
    private static readonly (string Key, string Label)[] FilterableFields =
    [
        ("codigo", "Código"),
        ("tipo", "Tipo"),
        ("documento", "Documento fiscal"),
        ("email", "Correo"),
        ("telefono", "Teléfono"),
        ("direccion", "Dirección"),
        ("sector", "Sector"),
        ("pais", "País"),
    ];

    [SupplyParameterFromQuery(Name = "nombre")] private string? SearchNombre { get; set; }
    [SupplyParameterFromQuery(Name = "codigo")] private string? SearchCodigo { get; set; }
    [SupplyParameterFromQuery(Name = "tipo")] private string? SearchTipo { get; set; }
    [SupplyParameterFromQuery(Name = "documento")] private string? SearchDocumento { get; set; }
    [SupplyParameterFromQuery(Name = "email")] private string? SearchEmail { get; set; }
    [SupplyParameterFromQuery(Name = "telefono")] private string? SearchTelefono { get; set; }
    [SupplyParameterFromQuery(Name = "direccion")] private string? SearchDireccion { get; set; }
    [SupplyParameterFromQuery(Name = "sector")] private string? SearchSector { get; set; }
    [SupplyParameterFromQuery(Name = "pais")] private string? SearchPais { get; set; }
    [SupplyParameterFromQuery(Name = "filters")] private string? FiltersRaw { get; set; }
    [SupplyParameterFromQuery(Name = "addField")] private string? AddField { get; set; }
    [SupplyParameterFromQuery(Name = "view")] private string? View { get; set; }
    [SupplyParameterFromQuery(Name = "showFilters")] private bool ShowFilters { get; set; }
    [SupplyParameterFromQuery(Name = "report")] private bool ShowReport { get; set; }
    // Selección de la barra (Fix-Features B2c): ?sel= sustituye a ?focusId=; la ficha lateral "Detalles" se muestra con ella.
    [SupplyParameterFromQuery(Name = "sel")] private Guid? Sel { get; set; }
    // Solo para redirigir la ruta antigua ?editId= a /clientes/{id}/editar.
    [SupplyParameterFromQuery(Name = "editId")] private Guid? EditId { get; set; }
    // Solo para mapear la ruta antigua ?focusId= (marcadores anteriores a B2c) a ?sel=.
    [SupplyParameterFromQuery(Name = "focusId")] private Guid? FocusId { get; set; }
    [SupplyParameterFromQuery(Name = "deleteId")] private Guid? DeleteId { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] private int Pagina { get; set; } = 1;
    [SupplyParameterFromForm(FormName = "delete-cliente-list")] private DeleteConfirmForm? DeleteInput { get; set; }
    private IReadOnlyList<SocioNegocioResponse> clientes = [];
    private IReadOnlyList<SocioNegocioResponse> reporteClientes = [];
    private long totalClientes;
    private int totalPaginas;
    private List<string> ActiveFilterFields = [];
    private string? message; private string messageType = "info"; private string? modalError; private bool IsListView => string.Equals(View, "list", StringComparison.OrdinalIgnoreCase); private bool ShowFactbox => SeleccionValida.HasValue; [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private PermisosPagina? permisos;
    private bool CanModify => permisos?.CanModify == true;
    private bool CanDelete => permisos?.CanDelete == true;
    private static readonly IReadOnlyList<Miga> migas = [new("Clientes", "/modulos/clientes"), new("Clientes")];
    // Selección obsoleta (Review Focus 4): un ?sel= que no está en la página cargada no cuenta como selección.
    private Guid? SeleccionValida => Sel is { } s && clientes.Any(c => c.Id == s) ? s : null;
    // Única URL de vuelta del listado (filtros, página, vista y selección; nunca ok/deleteId/editId).
    // Tampoco lleva el diálogo de reporte ni el panel de filtros abiertos: volver de editar no debe reabrirlos.
    private string UrlActual => RetornoLocal.SinTransitorios(BuildListUrl(report: false, showFilters: false));
    private const string EntityFabOnChange = "(function(cb){var fab=document.getElementById('cliente-detail-fab');var link=document.getElementById('cliente-detail-fab-link');if(!fab||!link)return;if(cb.checked){fab.dataset.lastId=cb.value;}else if(fab.dataset.lastId===cb.value){var form=cb.closest('form');var sc=form?form.querySelector('input[name=SelectedIds]:checked'):null;fab.dataset.lastId=sc?sc.value:'';}var base_=fab.getAttribute('data-base-url');var sep=base_.indexOf('?')===-1?'?':'&';var href=fab.dataset.lastId?(base_+sep+'sel='+fab.dataset.lastId):base_;link.setAttribute('href',href);if(fab.getAttribute('data-auto-nav')==='true'){window.location.href=href;return;}if(fab.dataset.lastId){fab.classList.remove('hidden');}else{fab.classList.add('hidden');}})(this)";
    private string GridColsClass => (ShowFactbox, ShowFilters) switch { (true, true) => "xl:grid-cols-[280px_minmax(0,1fr)_320px]", (true, false) => "xl:grid-cols-[280px_minmax(0,1fr)]", (false, true) => "xl:grid-cols-[minmax(0,1fr)_320px]", (false, false) => "xl:grid-cols-1" };
    private List<(string Key, string Label)> AvailableFields => [.. FilterableFields.Where(f => !ActiveFilterFields.Contains(f.Key))];
    private static string FieldLabel(string key) => FilterableFields.FirstOrDefault(f => f.Key == key).Label ?? key;
    protected override async Task OnInitializedAsync()
    {
        DeleteInput ??= new();
        ActiveFilterFields = ParseActiveFields(FiltersRaw);
        if (EditId is { } editId)
        {
            // Ruta antigua ?editId=: la modificación vive en /clientes/{id}/editar (UrlActual no lleva editId: sin bucle).
            Nav.NavigateTo(RetornoLocal.ConRetorno($"/clientes/{editId}/editar", UrlActual), replace: true);
            return;
        }
        if (FocusId is { } focusId && Sel is null)
        {
            // Ruta antigua ?focusId=: la selección es ?sel= (BuildListUrl no emite focusId); el aviso ok= se conserva.
            var destino = BuildListUrl(sel: focusId);
            Nav.NavigateTo(Ok is null ? destino : RetornoLocal.ConParametro(destino, "ok", Ok), replace: true);
            return;
        }
        if (!string.IsNullOrWhiteSpace(AddField) && FilterableFields.Any(f => f.Key == AddField) && !ActiveFilterFields.Contains(AddField))
        {
            Nav.NavigateTo(BuildListUrl(activeFiltersOverride: [.. ActiveFilterFields, AddField]), replace: true);
            return;
        }
        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);
        await LoadAsync();
        if (ActiveFilterFields.Contains("tipo") && !string.IsNullOrWhiteSpace(SearchTipo) && ActiveTipo() is null) { message = "El tipo indicado en el filtro no es válido; se ignoró ese filtro."; messageType = "warning"; }
        if(Ok is not null){(messageType, message)=Ok switch {"created"=>("success","Cliente creado satisfactoriamente."),"updated"=>("success","Cliente modificado satisfactoriamente."),"deleted"=>("success","Cliente eliminado satisfactoriamente."),"report-select-required"=>("warning","Seleccione al menos un cliente para generar el reporte."),"report-no-data"=>("warning","No hay datos para generar el reporte solicitado."),_ =>("info",null)};}
    }
    private SocioNegocioSearchFilter BuildFilter() => new(EmptyAsNull(SearchNombre), GetActiveValue("email", SearchEmail), GetActiveValue("telefono", SearchTelefono), GetActiveValue("direccion", SearchDireccion), GetActiveValue("sector", SearchSector), GetActiveValue("pais", SearchPais), GetActiveValue("codigo", SearchCodigo), ActiveTipo(), GetActiveValue("documento", SearchDocumento));
    private async Task LoadAsync()
    {
        try
        {
            var filtro = BuildFilter();
            if (Pagina < 1) Pagina = 1;
            var pagina = await SocioNegocioApiClient.ListAsync(filtro, new PageRequest(Pagina, PageRequest.TamanoPorDefecto));
            // Una página fuera de rango (p. ej. ?pagina=9 con dos páginas) se normaliza a la última en vez de mostrar una tabla vacía.
            if (pagina.TotalPaginas == 0) { Pagina = 1; }
            else if (Pagina > pagina.TotalPaginas)
            {
                Pagina = pagina.TotalPaginas;
                pagina = await SocioNegocioApiClient.ListAsync(filtro, new PageRequest(Pagina, PageRequest.TamanoPorDefecto));
            }
            clientes = pagina.Items; totalClientes = pagina.Total; totalPaginas = pagina.TotalPaginas;
            // El reporte incluye TODOS los clientes que coinciden con los filtros, no solo la página visible.
            reporteClientes = ShowReport ? await SocioNegocioApiClient.ListAllAsync(filtro) : clientes;
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not load clientes from API."); message = "No fue posible cargar los clientes."; messageType = "danger"; }
    }
    private async Task DeleteAsync(){if(!DeleteId.HasValue){modalError="No se pudo identificar el cliente. Intente de nuevo."; return;} var result=await SocioNegocioApiClient.DeleteAsync(DeleteId.Value); if(result.Succeeded) Nav.NavigateTo(RetornoLocal.ConParametro(UrlActual, "ok", "deleted")); else modalError=result.Message;}
    // Acciones de cada tarjeta (vista Tarjetas): Ficha y Editar visibles; en ⋯ las de Crear/Ver del cliente (Fix-Features C1,
    // las mismas que la barra y la ficha; "Ficha" ya es acción rápida) y Eliminar.
    private RenderFragment TarjetaAccionesDe(SocioNegocioResponse c) => __builder =>
    {
        <TarjetaAcciones Id="@c.Id.ToString()" Permisos="@permisos" RetornoUrl="@UrlActual"
                         Rapidas="@([new AccionPagina("Ficha", IconosModulo.Persona, id => $"/clientes/{id}"),
                                    new AccionPagina("Editar", IconosModulo.Lista, id => RetornoLocal.ConRetorno($"/clientes/{id}/editar", UrlActual), ApplicationPolicies.CanModify)])"
                         Resto="@([.. AccionesCliente.Crear, .. AccionesCliente.VerSinFicha,
                                  new AccionPagina("Eliminar", IconosModulo.Lista, id => BuildListUrl(deleteId: Guid.Parse(id!)), ApplicationPolicies.CanDelete)])" />
    };
    private string? GetActiveValue(string key, string? value) => ActiveFilterFields.Contains(key) ? EmptyAsNull(value) : null;
    // Tipo: solo si el campo está activo y el valor es un tipo válido (1, 2 o 3); un valor inválido no se envía a la API.
    private TipoSocioNegocio? ActiveTipo() => ActiveFilterFields.Contains("tipo") && short.TryParse(SearchTipo, out var t) && Enum.IsDefined((TipoSocioNegocio)t) ? (TipoSocioNegocio)t : null;
    private RenderFragment RenderFilterInput(string field, bool compact) => @<text>
        @if (field == "tipo")
        {
            <select name="tipo" class="@(compact ? FilterCompactCss : FilterCss)">
                <option value="">Todos</option>
                @foreach (var tipo in SocioNegocioEtiquetas.Tipos)
                {
                    <option value="@((short)tipo)" selected="@(SearchTipo == ((short)tipo).ToString())">@SocioNegocioEtiquetas.Tipo(tipo)</option>
                }
            </select>
        }
        else
        {
            <input type="text" name="@field" value="@GetFieldValue(field)" placeholder="@(field == "codigo" ? "ej: 000012, 0000*" : "ej: valor, *valor*, a||b, a&&b")" class="@(compact ? FilterCompactCss : FilterCss)" />
        }
    </text>;
    private const string FilterCss = "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/20 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200";
    private const string FilterCompactCss = FilterCss;
    private RenderFragment BloqueoBadge(SocioNegocioResponse c) => c.Bloqueado == BloqueoSocioNegocio.Ninguno
        ? @<span class="text-slate-400 dark:text-slate-500">—</span>
        : @<span class="inline-flex items-center rounded-full border border-red-200 bg-red-50 px-2 py-0.5 text-xs font-semibold text-red-700 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-400">@SocioNegocioEtiquetas.Bloqueo(c.Bloqueado)</span>;
    private string? GetFieldValue(string key) => key switch { "codigo" => SearchCodigo, "tipo" => SearchTipo, "documento" => SearchDocumento, "email" => SearchEmail, "telefono" => SearchTelefono, "direccion" => SearchDireccion, "sector" => SearchSector, "pais" => SearchPais, _ => null };
    private static string DireccionDisplay(SocioNegocioResponse cliente) => string.IsNullOrWhiteSpace(cliente.DireccionLinea1) ? "—" : (string.IsNullOrWhiteSpace(cliente.DireccionLinea2) ? cliente.DireccionLinea1 : $"{cliente.DireccionLinea1}, {cliente.DireccionLinea2}");
    private static List<string> ParseActiveFields(string? raw) => string.IsNullOrWhiteSpace(raw) ? [] : [.. raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Where(f => FilterableFields.Any(field => field.Key == f)).Distinct()];
    // Conserva filtros, vista, página y la selección (por defecto el Sel actual; sinSeleccion la quita). Nunca emite editId.
    private string BuildListUrl(Guid? deleteId = null, bool? showFilters = null, string? view = null, bool? report = null, Guid? sel = null, IReadOnlyList<string>? activeFiltersOverride = null, int? pagina = null, bool sinSeleccion = false)
    {
        var activeFields = activeFiltersOverride ?? ActiveFilterFields;
        var parameters=new List<string>();
        AddParameter(parameters,"nombre",SearchNombre);
        if (activeFields.Contains("codigo")) AddParameter(parameters,"codigo",SearchCodigo);
        if (activeFields.Contains("tipo")) AddParameter(parameters,"tipo",SearchTipo);
        if (activeFields.Contains("documento")) AddParameter(parameters,"documento",SearchDocumento);
        if (activeFields.Contains("email")) AddParameter(parameters,"email",SearchEmail);
        if (activeFields.Contains("telefono")) AddParameter(parameters,"telefono",SearchTelefono);
        if (activeFields.Contains("direccion")) AddParameter(parameters,"direccion",SearchDireccion);
        if (activeFields.Contains("sector")) AddParameter(parameters,"sector",SearchSector);
        if (activeFields.Contains("pais")) AddParameter(parameters,"pais",SearchPais);
        if (activeFields.Count > 0) parameters.Add($"filters={Uri.EscapeDataString(string.Join(",", activeFields))}");
        AddParameter(parameters,"view", view ?? View);
        if(showFilters ?? ShowFilters) parameters.Add("showFilters=true");
        if(report ?? ShowReport) parameters.Add("report=true");
        var selEfectiva = sinSeleccion ? null : sel ?? Sel;
        if(selEfectiva.HasValue) AddParameter(parameters,"sel",selEfectiva.Value.ToString());
        if(deleteId.HasValue) AddParameter(parameters,"deleteId",deleteId.Value.ToString());
        var paginaEfectiva = pagina ?? Pagina;
        if (paginaEfectiva > 1) parameters.Add($"pagina={paginaEfectiva}");
        return parameters.Count==0 ? "/clientes" : $"/clientes?{string.Join("&",parameters)}";
    }
    private static void AddParameter(List<string> parameters,string key,string? value){if(!string.IsNullOrWhiteSpace(value)) parameters.Add($"{key}={Uri.EscapeDataString(value)}");}
    private static string? EmptyAsNull(string? value)=>string.IsNullOrWhiteSpace(value)?null:value;
    private sealed class DeleteConfirmForm{}
}
