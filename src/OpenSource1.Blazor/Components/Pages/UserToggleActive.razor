@page "/admin/users/toggle-active"
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@inject IUserAdminApiClient UserAdminApi
@inject NavigationManager Nav

@code {
    [SupplyParameterFromForm]
    private string? UserId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId))
        {
            Nav.NavigateTo("/admin/users?err=Datos+incompletos.");
            return;
        }

        var (success, error) = await UserAdminApi.ToggleActiveAsync(UserId);
        var redirectUrl = success
            ? "/admin/users?ok=Estado+del+usuario+actualizado+correctamente."
            : $"/admin/users?err={Uri.EscapeDataString(error ?? "Error al cambiar el estado.")}";

        Nav.NavigateTo(redirectUrl);
    }
}
