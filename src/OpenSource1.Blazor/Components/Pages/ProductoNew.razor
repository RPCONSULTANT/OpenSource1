@page "/productos/new"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Nav

@code {
    // Ruta antigua (Fix-Features B2c): el alta vive en /productos/nuevo. La query (p. ej. returnUrl) se conserva.
    protected override void OnInitialized() => Nav.NavigateTo("/productos/nuevo" + new Uri(Nav.Uri).Query, replace: true);
}
