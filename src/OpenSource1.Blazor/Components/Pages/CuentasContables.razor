@page "/cuentas-contables"
@attribute [Authorize(Policy = ApplicationPolicies.CanConsult)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OpenSource1.Application.Features.CuentasContables.Dtos
@using OpenSource1.Application.Security
@using OpenSource1.Blazor.Services
@using OpenSource1.Core.Common
@using OpenSource1.Core.Enums
@inject ICuentaContableApiClient CuentaContableApiClient
@inject IAuthorizationService AuthorizationService
@inject ILogger<CuentasContables> Logger
@inject NavigationManager Nav

<PageTitle>Plan de Cuentas – AxionERP</PageTitle>

<PageToolbar Titulo="Plan de Cuentas" Subtitulo="Catálogo de cuentas contables para el libro contable." Migas="@Migas" Permisos="@permisos"
             NuevoHref="@RetornoLocal.ConRetorno("/cuentas-contables/nuevo", UrlActual)"
             SeleccionId="@SeleccionValida?.ToString()"
             EditarUrl="@(id => EditarUrl(Guid.Parse(id)))"
             EliminarUrl="@(id => BuildListUrl(deleteId: Guid.Parse(id)))" />

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="mb-6">
        @if (messageType == "success")
        {
            <ActionFeedback Type="success" Message="@message" />
        }
        else
        {
            <MessageBox Type="@messageType" Message="@message" Errors="@errores" />
        }
    </div>
}

<!-- ── Filtros ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
    <form method="get" action="/cuentas-contables" data-enhance class="p-4 sm:p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="grid flex-1 grid-cols-1 gap-3 sm:grid-cols-3 lg:grid-cols-5 max-w-5xl">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroNumero">Número</label>
                    <input id="filtroNumero" type="text" name="numero" value="@SearchNumero" placeholder="ej. 1101"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroNombre">Nombre</label>
                    <input id="filtroNombre" type="text" name="nombre" value="@SearchNombre" placeholder="ej. Caja"
                           class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroTipoCuenta">Tipo de cuenta</label>
                    <select id="filtroTipoCuenta" name="tipoCuenta"
                            class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20">
                        <option value="" selected="@(SearchTipoCuenta is null)">Todos</option>
                        @foreach (var tipo in Enum.GetValues<TipoCuentaContable>())
                        {
                            <option value="@((int)tipo)" selected="@(SearchTipoCuenta == tipo)">@tipo</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroTipoResultado">Tipo de resultado</label>
                    <select id="filtroTipoResultado" name="tipoResultado"
                            class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20">
                        <option value="" selected="@(SearchTipoResultado is null)">Todos</option>
                        @foreach (var tipo in Enum.GetValues<TipoResultadoCuenta>())
                        {
                            <option value="@((int)tipo)" selected="@(SearchTipoResultado == tipo)">@tipo</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1" for="filtroBloqueada">Bloqueo</label>
                    <select id="filtroBloqueada" name="bloqueada"
                            class="block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 shadow-sm focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-600/20">
                        <option value="" selected="@(SearchBloqueada is null)">Todas</option>
                        <option value="false" selected="@(SearchBloqueada == false)">No bloqueadas</option>
                        <option value="true" selected="@(SearchBloqueada == true)">Bloqueadas</option>
                    </select>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn-press inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m0 0A7.95 7.95 0 1 0 5.4 5.4a7.95 7.95 0 0 0 11.25 11.25Z" /></svg>
                    Consultar
                </button>
                <a href="/cuentas-contables" title="Limpiar campos" class="btn-press inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                    Limpiar campos
                </a>
            </div>
        </div>
    </form>
</div>

<!-- ── Tabla de cuentas contables ── -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-700">Registros actuales</h2>
        <p class="mt-1 text-xs text-slate-500">@totalCuentas resultado(s) · página @Pagina de @Math.Max(totalPaginas, 1).</p>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3"><span class="sr-only">Seleccionar</span></th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Número / Nombre</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Tipo</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Resultado</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Estado</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actualizado</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50 bg-white">
                @if (cuentas.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-slate-400 text-sm">
                            No hay cuentas contables registradas con esos criterios.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cuenta in cuentas)
                    {
                        var marcada = cuenta.Id == SeleccionValida;
                        <tr @key="cuenta.Id" class="@SeleccionFila.ClaseFila transition-colors @(marcada ? SeleccionFila.ClaseFilaSeleccionada : null)">
                            <td class="px-4 py-3"><SeleccionFila Href="@BuildListUrl(sel: cuenta.Id)" Seleccionada="@marcada" Etiqueta="@cuenta.Numero" /></td>
                            <td class="px-6 py-3">
                                <div style="padding-left: @(cuenta.Sangria * 1.25)rem;">
                                    <span class="font-mono text-xs font-semibold text-brand-700">@cuenta.Numero</span>
                                    <span class="ml-2 text-slate-700">@cuenta.Nombre</span>
                                </div>
                            </td>
                            <td class="px-6 py-3 text-slate-500 text-xs">
                                @cuenta.TipoCuenta
                                @if (cuenta.TipoCuenta == TipoCuentaContable.Posteo)
                                {
                                    <span class="ml-1 text-slate-400">(@(cuenta.PosteoDirecto ? "directo" : "solo sistema"))</span>
                                }
                            </td>
                            <td class="px-6 py-3 text-slate-500 text-xs">@cuenta.TipoResultado</td>
                            <td class="px-6 py-3">
                                @if (cuenta.Bloqueada)
                                {
                                    <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-semibold text-red-700">Bloqueada</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-xs font-semibold text-green-700">Activa</span>
                                }
                            </td>
                            <td class="px-6 py-3 text-slate-400 text-xs">
                                @(cuenta.UpdatedAtUtc?.ToLocalTime().ToString("g") ?? cuenta.CreatedAtUtc.ToLocalTime().ToString("g"))
                            </td>
                            <td class="px-6 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @if (canModify)
                                    {
                                        <a href="@EditarUrl(cuenta.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-amber-200 bg-amber-50 text-amber-600 hover:bg-amber-100" title="Editar cuenta">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z" /></svg>
                                        </a>
                                    }
                                    @if (canDelete)
                                    {
                                        <a href="@BuildListUrl(deleteId: cuenta.Id)" class="btn-press inline-flex items-center justify-center size-8 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100" title="Eliminar cuenta">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79" /></svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
            <p class="text-xs text-slate-500">Página @Pagina de @totalPaginas</p>
            <div class="flex items-center gap-2">
                @if (Pagina > 1)
                {
                    <a href="@BuildListUrl(pagina: Pagina - 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">« Anterior</a>
                }
                @if (Pagina < totalPaginas)
                {
                    <a href="@BuildListUrl(pagina: Pagina + 1)" class="btn-press rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Siguiente »</a>
                }
            </div>
        </div>
    }
</div>

@if (DeleteId.HasValue && canDelete)
{
    <ConfirmDialog Title="Confirmar eliminación" Message="Esta acción eliminará la cuenta contable seleccionada y no se puede deshacer." Variant="danger" CancelHref="@UrlActual">
        <p class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-mono text-red-900">@((itemToDelete is null) ? DeleteId.Value.ToString() : $"{itemToDelete.Numero} — {itemToDelete.Nombre}")</p>
        <EditForm Model="DeleteInput" FormName="delete-cuenta-contable" OnValidSubmit="DeleteAsync" class="mt-4">
            <input type="hidden" name="DeleteInput.Id" value="@DeleteId" />
            <button type="submit" class="btn-press rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Sí, eliminar</button>
            <a href="@UrlActual" class="btn-press ml-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm hover:bg-slate-50">Cancelar</a>
        </EditForm>
    </ConfirmDialog>
}
else
{
    @* Diálogo oculto (sin CanDelete o sin deleteId): EditForm vacío con el MISMO FormName para que un POST obsoleto o
       forzado llegue al handler y reciba el mensaje real de la API, no el 400 genérico de Blazor. *@
    <EditForm Model="DeleteInput" FormName="delete-cuenta-contable" OnValidSubmit="DeleteAsync"></EditForm>
}

@code {
    [SupplyParameterFromForm(FormName = "delete-cuenta-contable")]
    private DeleteForm? DeleteInput { get; set; }

    [SupplyParameterFromQuery(Name = "numero")]
    private string? SearchNumero { get; set; }

    [SupplyParameterFromQuery(Name = "nombre")]
    private string? SearchNombre { get; set; }

    // [SupplyParameterFromQuery] no admite enums (ni Nullable<enum>) directamente — falla en runtime con
    // "Querystring values cannot be parsed as type ...": se recibe como int? y se traduce a mano.
    [SupplyParameterFromQuery(Name = "tipoCuenta")]
    private int? SearchTipoCuentaRaw { get; set; }

    [SupplyParameterFromQuery(Name = "tipoResultado")]
    private int? SearchTipoResultadoRaw { get; set; }

    private TipoCuentaContable? SearchTipoCuenta =>
        SearchTipoCuentaRaw is { } valor && Enum.IsDefined((TipoCuentaContable)valor) ? (TipoCuentaContable)valor : null;

    private TipoResultadoCuenta? SearchTipoResultado =>
        SearchTipoResultadoRaw is { } valor && Enum.IsDefined((TipoResultadoCuenta)valor) ? (TipoResultadoCuenta)valor : null;

    [SupplyParameterFromQuery(Name = "bloqueada")]
    private bool? SearchBloqueada { get; set; }

    // Solo para redirigir la ruta antigua ?editId= al editor en página propia.
    [SupplyParameterFromQuery(Name = "editId")]
    private Guid? EditId { get; set; }

    // Tolerante (ola final Fix-Features): un ?sel= ilegible se ignora como selección vacía; con Guid? el binder lanzaría.
    [SupplyParameterFromQuery(Name = "sel")]
    private string? SelTexto { get; set; }
    private Guid? Sel => InventarioVistasOpciones.ParseGuid(SelTexto);

    [SupplyParameterFromQuery(Name = "deleteId")]
    private Guid? DeleteId { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "pagina")]
    private int Pagina { get; set; } = 1;

    private IReadOnlyList<CuentaContableResponse> cuentas = [];
    // Registro a eliminar, cargado fresco con GetByIdAsync (no buscado en la página de la lista).
    private CuentaContableResponse? itemToDelete;
    private long totalCuentas;
    private int totalPaginas;
    private string? message;
    private string messageType = "info";
    private IReadOnlyList<string> errores = [];

    private PermisosPagina? permisos;
    private bool canModify;
    private bool canDelete;

    private static readonly IReadOnlyList<Miga> Migas = [new("Contabilidad", "/modulos/contabilidad"), new("Plan de cuentas")];

    // Selección obsoleta (no está en la página cargada) => null: la barra deshabilita Editar/Eliminar.
    private Guid? SeleccionValida => Sel is { } s && cuentas.Any(c => c.Id == s) ? s : null;
    private string UrlActual => RetornoLocal.SinTransitorios(BuildListUrl());
    private string EditarUrl(Guid id) => RetornoLocal.ConRetorno($"/cuentas-contables/{id}/editar", UrlActual);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (EditId is { } editId)
        {
            Nav.NavigateTo(RetornoLocal.ConRetorno($"/cuentas-contables/{editId}/editar", UrlActual), replace: true);
            return;
        }

        DeleteInput ??= new();
        permisos = await PermisosPagina.CargarAsync(AuthorizationService, AuthenticationStateTask);
        canModify = permisos.CanModify;
        canDelete = permisos.CanDelete;

        await LoadAsync();

        if (Ok is not null)
        {
            (messageType, message) = Ok switch
            {
                "created" => ("success", "Cuenta contable creada satisfactoriamente."),
                "updated" => ("success", "Cuenta contable modificada satisfactoriamente."),
                "deleted" => ("success", "Cuenta contable eliminada satisfactoriamente."),
                _ => ("info", null)
            };
        }

        if (DeleteId.HasValue && canDelete)
        {
            try
            {
                itemToDelete = await CuentaContableApiClient.GetByIdAsync(DeleteId.Value);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not load cuenta contable {DeleteId} from API.", DeleteId);
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var filter = new CuentaContableSearchFilter(
                EmptyAsNull(SearchNumero), EmptyAsNull(SearchNombre), SearchTipoCuenta, SearchTipoResultado, SearchBloqueada);
            if (Pagina < 1) Pagina = 1;
            // Descendente: false explícito — el default de PageRequest es true (pensado para listados por fecha de
            // alta como Almacenes), pero el plan de cuentas se lee en su orden natural (Numero ascendente).
            var pagina = await CuentaContableApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto, Descendente: false));

            // Normaliza una página fuera de rango (p. ej. ?pagina=2 con una sola página) para no
            // mostrar "página 2 de 1" ni una tabla vacía con registros existentes.
            if (pagina.TotalPaginas == 0)
            {
                Pagina = 1;
            }
            else if (Pagina > pagina.TotalPaginas)
            {
                Pagina = pagina.TotalPaginas;
                pagina = await CuentaContableApiClient.ListAsync(filter, new PageRequest(Pagina, PageRequest.TamanoPorDefecto, Descendente: false));
            }

            cuentas = pagina.Items;
            totalCuentas = pagina.Total;
            totalPaginas = pagina.TotalPaginas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load cuentas contables from API.");
            Show("danger", "No fue posible cargar las cuentas contables.");
        }
    }

    private string BuildListUrl(int? pagina = null, Guid? sel = null, Guid? deleteId = null)
    {
        var parameters = new List<string>();
        AddParameter(parameters, "numero", SearchNumero);
        AddParameter(parameters, "nombre", SearchNombre);
        if (SearchTipoCuenta.HasValue) parameters.Add($"tipoCuenta={(int)SearchTipoCuenta.Value}");
        if (SearchTipoResultado.HasValue) parameters.Add($"tipoResultado={(int)SearchTipoResultado.Value}");
        if (SearchBloqueada.HasValue) parameters.Add($"bloqueada={(SearchBloqueada.Value ? "true" : "false")}");
        var paginaEfectiva = pagina ?? Pagina;
        if (paginaEfectiva > 1) parameters.Add($"pagina={paginaEfectiva}");
        if ((sel ?? Sel) is { } seleccion) parameters.Add($"sel={seleccion}");
        if (deleteId.HasValue) parameters.Add($"deleteId={deleteId.Value}");
        return parameters.Count == 0 ? "/cuentas-contables" : $"/cuentas-contables?{string.Join("&", parameters)}";
    }

    private static void AddParameter(List<string> parameters, string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value)) parameters.Add($"{key}={Uri.EscapeDataString(value)}");
    }

    private async Task DeleteAsync() => await ExecuteAsync(() => CuentaContableApiClient.DeleteAsync(DeleteInput!.Id), "deleted");

    private async Task ExecuteAsync(Func<Task<CuentaContableOperationResult>> operation, string successCode)
    {
        // La navegación va FUERA del try: si NavigateTo lanza NavigationException (SSR sin el switch que la desactiva),
        // el catch genérico no debe tragársela como un fallo de la operación.
        string? destino = null;
        try
        {
            var result = await operation();
            if (result.Succeeded)
            {
                destino = RetornoLocal.ConParametro(UrlActual, "ok", successCode);
            }
            else
            {
                errores = result.Errors ?? [];
                Show("warning", result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not complete cuenta contable operation.");
            Show("danger", "No fue posible completar la operación.");
        }

        if (destino is not null)
        {
            Nav.NavigateTo(destino);
        }
    }

    private void Show(string type, string text) { messageType = type; message = text; }

    private static string? EmptyAsNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public sealed class CuentaContableForm
    {
        public Guid Id { get; set; }

        [Required(ErrorMessage = "El número es obligatorio.")]
        [MaxLength(20, ErrorMessage = "El número no puede superar los 20 caracteres.")]
        public string Numero { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [MaxLength(100, ErrorMessage = "El nombre no puede superar los 100 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        public TipoCuentaContable TipoCuenta { get; set; } = TipoCuentaContable.Posteo;

        public TipoResultadoCuenta TipoResultado { get; set; } = TipoResultadoCuenta.Balance;

        public bool PosteoDirecto { get; set; }

        public bool Bloqueada { get; set; }

        [Range(0, 10, ErrorMessage = "La sangría debe estar entre 0 y 10.")]
        public int Sangria { get; set; }

        public long Xmin { get; set; }
    }

    public sealed class DeleteForm
    {
        public Guid Id { get; set; }
    }
}
